struct Document {
    uri: str
    text: str
    analysis: FrontendDocument
}

struct AnalysisJob {
    uri: str
    text: str
    module_name: str
    source_name: str
    generation: usize
    workspace: bool
    ready_at_ms: u64
    cache_path: str
}

struct AnalysisTask {
    job: AnalysisJob
    handle: JoinHandle[PreparedLightweightModule]
}

struct SemanticAnalysisTask {
    uri: str
    generation: usize
    handle: JoinHandle[Vec[FrontendDiagnostic]]
}

struct SemanticAnalysisResult {
    uri: str
    generation: usize
    diagnostics: Vec[FrontendDiagnostic]
}

struct ProjectGraphTask {
    root: str
    entry: str
    import_fingerprint: u64
    generation: usize
    handle: JoinHandle[PreparedProjectGraph]
}

struct ProjectGraphRequest {
    root: str
    entry: str
    source: str
    import_fingerprint: u64
    generation: usize
}

struct ProjectGraphSource {
    module_name: str
    source_name: str
    source: str
}

struct PreparedProjectGraph {
    sources: Vec[ProjectGraphSource]
    modules: Vec[PreparedLightweightModule]
    diagnostics: Vec[FrontendDiagnostic]
}

struct ProjectGraphState {
    root: str
    entry: str
    import_fingerprint: u64
    generation: usize
    ready: bool
    sources: Vec[ProjectGraphSource]
    diagnostics: Vec[FrontendDiagnostic]
}

struct DocumentRevision {
    uri: str
    generation: usize
    client_version: Json
}

struct ProjectRoot {
    root: str
    name: str
}

struct AutoimportScope {
    owner: str
    root: str
    name: str
}

struct ModuleRef {
    project_root: str
    project_name: str
    source_dir: str
    module_name: str
    uri: str
    path: str
}

struct ImportRequest {
    source: str
    target: str
    alias: Option[str]
    wildcard: bool
    line: usize
    column: usize
    length: usize
}

struct ExpandedImportTarget {
    target: str
    alias: Option[str]
    wildcard: bool
}

struct ResolvedReference {
    id: str
    label: str
    uri: str
    range: Json
    hover: str
    callable: Option[FrontendCallable]
    rename_id: str
}

struct ServerState {
    initialized: bool
    shutdown_requested: bool
    analysis: AnalysisDatabase
    documents: Vec[Document]
    workspace_roots: Vec[str]
    discovered_workspace_roots: Vec[str]
    workspace_projects: Vec[ProjectRoot]
    indexed_project_roots: Vec[str]
    workspace_documents: Vec[Document]
    analysis_queue: Vec[AnalysisJob]
    analysis_tasks: Vec[AnalysisTask]
    semantic_tasks: Vec[SemanticAnalysisTask]
    semantic_results: Vec[SemanticAnalysisResult]
    project_graph_tasks: Vec[ProjectGraphTask]
    project_graph_queue: Vec[ProjectGraphRequest]
    project_graphs: Vec[ProjectGraphState]
    document_revisions: Vec[DocumentRevision]
    deferred_requests: Vec[Json]
    next_generation: usize
    max_analysis_tasks: usize
    analysis_debounce_ms: usize
    cache_enabled: bool
    cache_root: str
    completion_documents: Vec[Document]
    semantic_token_cache: Vec[SemanticTokenCache]
    resolve_completion_documentation: bool
    autoimport_scopes: Vec[AutoimportScope]
    supports_document_changes: bool
}

struct SemanticTokenCache {
    uri: str
    generation: usize
    token_count: usize
    symbol_count: usize
    response: Json
}

impl for Document {
    fn new(uri: str, text: str) -> Self {
        ret Self {
            uri, text, FrontendDocument::outline("document", text)
        }
    }
}

impl for ServerState {
    fn new() -> Self {
        ret Self {
            false,
            false,
            AnalysisDatabase::new(),
            Vec[Document]::new(),
            Vec[str]::new(),
            Vec[str]::new(),
            Vec[ProjectRoot]::new(),
            Vec[str]::new(),
            Vec[Document]::new(),
            Vec[AnalysisJob]::new(),
            Vec[AnalysisTask]::new(),
            Vec[SemanticAnalysisTask]::new(),
            Vec[SemanticAnalysisResult]::new(),
            Vec[ProjectGraphTask]::new(),
            Vec[ProjectGraphRequest]::new(),
            Vec[ProjectGraphState]::new(),
            Vec[DocumentRevision]::new(),
            Vec[Json]::new(),
            1_usize,
            analysis_worker_count(),
            configured_usize("ENCORE_LSP_DEBOUNCE_MS", 35_usize),
            configured_bool("ENCORE_LSP_CACHE", true),
            unsafe {
                encore_os_getenv("ENCORE_LSP_CACHE_DIR")
            }
            ,
            Vec[Document]::new(),
            Vec[SemanticTokenCache]::new(),
            false,
            Vec[AutoimportScope]::new(),
            false
        }
    }

    fn upsert_pending_document(self: mut Self, uri: str, text: str) ->() {
        let outline = FrontendDocument::outline(analysis_module_name(self, uri), text)
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        self.documents.set(index, Document {
                                uri, text, outline
                            }
                            ,
                        )
                        ret()
                    }
                }
                Option[Document]::None => {
                }
            }
            index += 1_usize
        }
        self.documents.push(Document {
                uri, text, outline
            }
            ,
        )
        ret()
    }

    fn remove_document(self: mut Self, uri: str) ->() {
        self.analysis.remove_module(analysis_module_name(self, uri))
        let mut next = Vec[Document]::new()
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri != uri {
                        next.push(doc)
                    }
                }
                Option[Document]::None => {
                }
            }
            index += 1_usize
        }
        self.documents = next
        ret()
    }

    fn document(self: Self, uri: str) -> Option[Document] {
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        ret Option[Document]::Some(doc)
                    }
                }
                Option[Document]::None => {
                }
            }
            index += 1_usize
        }
        let mut workspace_index = 0_usize
        while workspace_index < self.workspace_documents.len() {
            match self.workspace_documents.get(workspace_index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        ret Option[Document]::Some(doc)
                    }
                }
                Option[Document]::None => {
                }
            }
            workspace_index += 1_usize
        }
        ret Option[Document]::None
    }

    fn add_workspace_root(self: mut Self, root: str) ->() {
        if root == "" {
            ret()
        }
        let mut index = 0_usize
        while index < self.workspace_roots.len() {
            match self.workspace_roots.get(index) {
                Option[str]::Some(existing) => {
                    if existing == root {
                        ret()
                    }
                }
                Option[str]::None => {
                }
            }
            index += 1_usize
        }
        self.workspace_roots.push(root)
        ret()
    }

    fn upsert_ready_document(self: mut Self, uri: str, text: str, analyzed: FrontendDocument) ->() {
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        self.documents.set(index, Document {
                                uri, text, analyzed
                            }
                            ,
                        )
                        ret()
                    }
                }
                Option[Document]::None => {
                }
            }
            index += 1_usize
        }
        ret()
    }

    fn upsert_ready_workspace_document(self: mut Self, uri: str, text: str, analyzed: FrontendDocument) ->() {
        let mut index = 0_usize
        while index < self.workspace_documents.len() {
            match self.workspace_documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        self.workspace_documents.set(index, Document {
                                uri, text, analyzed
                            }
                            ,
                        )
                        ret()
                    }
                }
                Option[Document]::None => {
                }
            }
            index += 1_usize
        }
        self.workspace_documents.push(Document {
                uri, text, analyzed
            }
            ,
        )
        ret()
    }

    fn cache_workspace_document_uri(self: mut Self, uri: str) ->() {
        match self.document(uri) {
            Option[Document]::Some(_doc) => {
                ret()
            }
            Option[Document]::None => {
            }
        }
        let path = uri_to_path(uri)
        if file_exists(path) {
            queue_workspace_analysis(self, uri, read_file(path))
        }
        ret()
    }

    fn set_workspace_projects(self: mut Self, projects: Vec[ProjectRoot]) ->() {
        self.workspace_projects = projects
        ret()
    }

}

fn analysis_worker_count() -> usize {
    let configured = configured_usize("ENCORE_LSP_JOBS", 0_usize)
    if configured > 0_usize {
        ret configured
    }
    let parallelism = available_parallelism()
    if parallelism <= 1_usize {
        ret 1_usize
    }
    // Interactive tooling shares the machine with the editor and build tools.
    // Explicit ENCORE_LSP_JOBS / initialization options still take precedence.
    ret min_usize(4_usize,(parallelism + 1_usize) / 2_usize)
}

fn configured_usize(name: str, fallback: usize) -> usize {
    let raw = unsafe {
        encore_os_getenv(name)
    }
    if raw == "" {
        ret fallback
    }
    let parsed = parse_usize(raw)
    if parsed == 0_usize {
        ret fallback
    }
    ret parsed
}

fn configured_bool(name: str, fallback: bool) -> bool {
    let raw = unsafe {
        encore_os_getenv(name)
    }
    if raw == "" {
        ret fallback
    }
    ret raw != "0" && raw != "false" && raw != "off"
}

fn analysis_cache_path(state: ServerState, uri: str) -> str {
    if !state.cache_enabled {
        ret ""
    }
    let mut root = state.cache_root
    if root == "" {
        match project_root_for_path(uri_to_path(uri)) {
            Some(project_root) => {
                root = join_path(join_path(project_root, ".encore_cache"), "lsp/v1")
            }
            None => {
                ret ""
            }
        }
    }
    ret join_path(root, Debug::fmt(uri_to_path(uri).hash()) + ".json")
}

fn prepare_analysis_job(module_name: str, source_name: str, source: str, cache_path: str) -> sending PreparedLightweightModule {
    match load(cache_path, module_name, source) {
        Some(document) => {
            ret prepare_cached_lightweight_module(module_name, source_name, source, document)
        }
        None => {
        }
    }
    let prepared = prepare_lightweight_module(module_name, source_name, source)
    save(cache_path, module_name, source, prepared.document())
    ret prepared
}

fn check_semantic_job(prepared: sending PreparedSemanticWorkspace) -> sending Vec[FrontendDiagnostic] {
    ret check_prepared_semantic_workspace(prepared)
}

fn prepare_project_graph(root: str, entry: str, source: str) -> sending PreparedProjectGraph {
    let mut diagnostics = Vec[FrontendDiagnostic]::new()
    match try_load_cached_entry_workspace_source(Path::new(root), Path::new(entry), source) {
        Result[ProjectWorkspace, ProjectFailure]::Ok(workspace) => {
            ret prepare_loaded_project_graph(workspace)
        }
        Result[ProjectWorkspace, ProjectFailure]::Err(failure) => {
            diagnostics.push(FrontendDiagnostic::new(1_usize, failure.code, failure.message,
                    0_usize, 0_usize, 1_usize,))
            ret PreparedProjectGraph {
                Vec[ProjectGraphSource]::new(),
                Vec[PreparedLightweightModule]::new(), diagnostics
            }
        }
    }
    ret PreparedProjectGraph {
        Vec[ProjectGraphSource]::new(), Vec[PreparedLightweightModule]::new(), diagnostics
    }
}

fn prepare_loaded_project_graph(workspace: ProjectWorkspace) -> sending PreparedProjectGraph {
    let diagnostics = Vec[FrontendDiagnostic]::new()
    let mut sources = Vec[ProjectGraphSource]::new()
    let mut prepared = Vec[PreparedLightweightModule]::new()
    for module in workspace.loaded_modules() {
        sources.push(ProjectGraphSource {
                module.analysis_name(), module.path(), module.source_text()
            }
            ,
        )
        prepared.push(prepare_lightweight_module(module.analysis_name(), module.path(), module.source_text()))
    }
    ret PreparedProjectGraph {
        sources, prepared, diagnostics
    }
}

fn analysis_is_pending(state: ServerState) -> bool {
    ret state.analysis_queue.len() > 0_usize || state.analysis_tasks.len() > 0_usize
    || state.semantic_tasks.len() > 0_usize || state.project_graph_tasks.len() > 0_usize
    || state.project_graph_queue.len() > 0_usize
}

fn project_graph_ready(state: ServerState, entry: str) -> bool {
    for graph in state.project_graphs {
        if graph.entry == entry {
            ret graph.ready
        }
    }
    ret false
}

fn project_graph_generation(state: ServerState, entry: str) -> usize {
    for graph in state.project_graphs {
        if graph.entry == entry {
            ret graph.generation
        }
    }
    ret 0_usize
}

fn import_fingerprint(source: str) -> u64 {
    let mut imports = ""
    let mut line_start = 0_usize
    let mut index = 0_usize
    while index <= source.byte_len() {
        if index == source.byte_len() || source.byte_at(index) == 10_u8 {
            let line = trim_spaces(source.slice_bytes(line_start, index - line_start))
            if starts_with(line, "import ") {
                imports += line + "\n"
            }
            line_start = index + 1_usize
        }
        index += 1_usize
    }
    ret imports.hash()
}

fn queue_project_graph(state: mut ServerState, root: str, entry: str, source: str) ->() {
    if root == "" || entry == "" {
        ret()
    }
    let fingerprint = import_fingerprint(source)
    let mut index = 0_usize
    while index < state.project_graphs.len() {
        match state.project_graphs.get(index) {
            Some(graph) => {
                if graph.entry == entry {
                    if graph.import_fingerprint == fingerprint {
                        ret()
                    }
                    let generation = state.next_generation
                    state.next_generation += 1_usize
                    state.project_graphs.set(index, ProjectGraphState {
                            root, entry, fingerprint, generation, false, Vec[ProjectGraphSource]::new(), Vec[FrontendDiagnostic]::new()
                        }
                        ,)
                    state.project_graph_queue.push(ProjectGraphRequest {
                            root, entry, source, fingerprint, generation
                        }
                        ,)
                    ret()
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    let generation = state.next_generation
    state.next_generation += 1_usize
    state.project_graphs.push(ProjectGraphState {
            root, entry, fingerprint, generation, false, Vec[ProjectGraphSource]::new(), Vec[FrontendDiagnostic]::new()
        }
        ,
    )
    state.project_graph_queue.push(ProjectGraphRequest {
            root, entry, source, fingerprint, generation
        }
        ,)
    ret()
}

fn project_graph_ready_for_uri(state: ServerState, uri: str) -> bool {
    match project_root_for_path(uri_to_path(uri)) {
        Some(_root) => {
            ret project_graph_ready(state, uri_to_path(uri))
        }
        None => {
            ret true
        }
    }
}

fn project_graph_pending_for_uri(state: ServerState, uri: str) -> bool {
    let entry = uri_to_path(uri)
    ret project_graph_generation(state, entry) != 0_usize && !project_graph_ready(state, entry)
}

fn invalidate_project_graph_on_import_change(state: mut ServerState, uri: str, source: str) ->() {
    let entry = uri_to_path(uri)
    let fingerprint = import_fingerprint(source)
    let mut retained = Vec[ProjectGraphState]::new()
    for graph in state.project_graphs {
        if graph.entry != entry || graph.import_fingerprint == fingerprint {
            retained.push(graph)
        }
    }
    state.project_graphs = retained
    ret()
}

fn document_generation(state: ServerState, uri: str) -> usize {
    for revision in state.document_revisions {
        if revision.uri == uri {
            ret revision.generation
        }
    }
    ret 0_usize
}

fn advance_document_generation(state: mut ServerState, uri: str) -> usize {
    let generation = state.next_generation
    state.next_generation += 1_usize
    let mut index = 0_usize
    while index < state.document_revisions.len() {
        match state.document_revisions.get(index) {
            Some(revision) => {
                if revision.uri == uri {
                    state.document_revisions.set(index, DocumentRevision {
                            uri, generation, revision.client_version
                        }
                        ,
                    )
                    ret generation
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    state.document_revisions.push(DocumentRevision {
            uri, generation, Json::Null
        }
        ,
    )
    ret generation
}

fn set_client_document_version(state: mut ServerState, uri: str, version: Json) ->() {
    let mut index = 0_usize
    for revision in state.document_revisions {
        if revision.uri == uri {
            state.document_revisions.set(index, DocumentRevision {
                    uri, revision.generation, version
                }
                ,
            )
            ret()
        }
        index += 1_usize
    }
    ret()
}

fn client_document_version(state: ServerState, uri: str) -> Json {
    for revision in state.document_revisions {
        if revision.uri == uri {
            ret revision.client_version
        }
    }
    ret Json::Null
}

fn remove_queued_analysis_for_uri(state: mut ServerState, uri: str) ->() {
    let mut retained = Vec[AnalysisJob]::new()
    while state.analysis_queue.len() > 0_usize {
        match state.analysis_queue.pop() {
            Some(job) => {
                if job.uri != uri {
                    retained.push(job)
                }
            }
            None => {
            }
        }
    }
    while retained.len() > 0_usize {
        match retained.pop() {
            Some(job) => state.analysis_queue.push(job)
            None => {
            }
        }
    }
    ret()
}

fn analysis_pending_for_uri(state: ServerState, uri: str) -> bool {
    let current = document_generation(state, uri)
    for job in state.analysis_queue {
        if job.uri == uri && job.generation == current {
            ret true
        }
    }
    for task in state.analysis_tasks {
        if task.job.uri == uri && task.job.generation == current {
            ret true
        }
    }
    ret false
}

fn semantic_pending_for_uri(state: ServerState, uri: str) -> bool {
    let current = document_generation(state, uri)
    for task in state.semantic_tasks {
        if task.uri == uri && task.generation == current {
            ret true
        }
    }
    ret false
}

fn semantic_result_for_uri(state: ServerState, uri: str) -> Option[Vec[FrontendDiagnostic]] {
    let current = document_generation(state, uri)
    for result in state.semantic_results {
        if result.uri == uri && result.generation == current {
            ret Option[Vec[FrontendDiagnostic]]::Some(result.diagnostics)
        }
    }
    ret Option[Vec[FrontendDiagnostic]]::None
}

fn project_semantic_workspace(state: ServerState, uri: str, module_name: str,
    source: str,) -> Option[PreparedSemanticWorkspace] {
    let entry = uri_to_path(uri)
    for graph in state.project_graphs {
        if graph.entry == entry && graph.ready {
            if graph.diagnostics.len() > 0_usize {
                ret Option[PreparedSemanticWorkspace]::None
            }
            let mut sources = Vec[AnalysisSourceSnapshot]::new()
            let mut replaced = false
            for graph_source in graph.sources {
                if graph_source.module_name == module_name {
                    sources.push(AnalysisSourceSnapshot::new(module_name, entry, source))
                    replaced = true
                } else {
                    sources.push(AnalysisSourceSnapshot::new(graph_source.module_name, graph_source.source_name,
                            graph_source.source,))
                }
            }
            if !replaced {
                sources.push(AnalysisSourceSnapshot::new(module_name, entry, source))
            }
            ret Option[PreparedSemanticWorkspace]::Some(prepare_semantic_workspace_from_sources(module_name,
                    sources,))
        }
    }
    ret Option[PreparedSemanticWorkspace]::None
}

fn queue_semantic_analysis(state: mut ServerState, uri: str) -> bool {
    if semantic_pending_for_uri(state, uri) {
        ret true
    }
    if state.analysis_tasks.len() + state.semantic_tasks.len() >= state.max_analysis_tasks {
        ret false
    }
    let module_name = analysis_module_name(state, uri)
    let source = match state.document(uri) {
        Some(doc) => doc.text
        None => {
            ret false
        }
    }
    let prepared = match project_semantic_workspace(state, uri, module_name, source) {
        Some(value) => value
        None => {
            ret false
        }
    }
    let mut spawned = Option[JoinHandle[Vec[FrontendDiagnostic]]]::None
    spawned = Option[JoinHandle[Vec[FrontendDiagnostic]]]::Some(spawn check_semantic_job(prepared))
    match spawned {
        Some(handle) => {
            state.semantic_tasks.push(SemanticAnalysisTask {
                    uri, document_generation(state, uri), handle
                }
                ,)
            ret true
        }
        None => {
        }
    }
    ret false
}

fn queue_open_analysis(state: mut ServerState, uri: str, text: str, cache_allowed: bool) ->() {
    invalidate_project_graph_on_import_change(state, uri, text)
    let generation = advance_document_generation(state, uri)
    remove_queued_analysis_for_uri(state, uri)
    state.upsert_pending_document(uri, text)
    state.analysis_queue.push(AnalysisJob {
            uri,
            text,
            analysis_module_name(state, uri),
            uri_to_path(uri),
            generation,
            false,
            perf_counter_ms() + state.analysis_debounce_ms as u64,
            if cache_allowed {
                analysis_cache_path(state, uri)
            } else {
                ""
            }
        }
        ,)
    ret()
}

fn queue_workspace_analysis(state: mut ServerState, uri: str, text: str) ->() {
    if analysis_pending_for_uri(state, uri) {
        ret()
    }
    match state.document(uri) {
        Some(_document) => {
            ret()
        }
        None => {
        }
    }
    let generation = advance_document_generation(state, uri)
    state.analysis_queue.push(AnalysisJob {
            uri,
            text,
            analysis_module_name(state, uri),
            uri_to_path(uri),
            generation,
            true,
            perf_counter_ms(),
            analysis_cache_path(state, uri)
        }
        ,)
    ret()
}

fn start_analysis_tasks(state: mut ServerState, include_workspace: bool) ->() {
    let now = perf_counter_ms()
    let mut deferred = Vec[AnalysisJob]::new()
    while state.analysis_tasks.len() + state.semantic_tasks.len() < state.max_analysis_tasks
    && state.analysis_queue.len() > 0_usize {
        match state.analysis_queue.pop() {
            Some(job) => {
                if job.workspace && !include_workspace {
                    state.analysis_queue.push(job)
                    break
                } elif job.ready_at_ms > now {
                    deferred.push(job)
                } else {
                    let mut spawned = Option[JoinHandle[PreparedLightweightModule]]::None
                    spawned = Option[JoinHandle[PreparedLightweightModule]]::Some(spawn prepare_analysis_job(job.module_name,
                            job.source_name, job.text, job.cache_path,))
                    match spawned {
                        Some(handle) => {
                            state.analysis_tasks.push(AnalysisTask {
                                    job, handle
                                }
                                ,
                            )
                        }
                        None => {
                        }
                    }
                }
            }
            None => {
            }
        }
    }
    while deferred.len() > 0_usize {
        match deferred.pop() {
            Some(job) => state.analysis_queue.push(job)
            None => {
            }
        }
    }
    ret()
}

fn schedule_open_semantic_analysis(state: mut ServerState) ->() {
    if state.shutdown_requested {
        ret()
    }
    for doc in state.documents {
        if state.analysis_tasks.len() + state.semantic_tasks.len() >= state.max_analysis_tasks {
            ret()
        }
        if !analysis_pending_for_uri(state, doc.uri)
        && !semantic_pending_for_uri(state, doc.uri)
        && semantic_result_for_uri(state, doc.uri).is_none()
        && project_graph_ready_for_uri(state, doc.uri)
        && doc.analysis.parsed
        && doc.analysis.diagnostics.len() == 0_usize {
            let _scheduled = queue_semantic_analysis(state, doc.uri)
        }
    }
    ret()
}

fn finish_project_graph_task(state: mut ServerState, task: ProjectGraphTask) ->() {
    if project_graph_generation(state, task.entry) != task.generation {
        let _discarded = task.handle.join()
        ret()
    }
    let graph_result = task.handle.join()
    for prepared in graph_result.modules {
        state.analysis.apply_prepared_lightweight(prepared)
    }
    let mut index = 0_usize
    while index < state.project_graphs.len() {
        match state.project_graphs.get(index) {
            Some(graph) => {
                if graph.entry == task.entry && graph.generation == task.generation {
                    state.project_graphs.set(index, ProjectGraphState {
                            graph.root, graph.entry, graph.import_fingerprint, graph.generation, true,
                            graph_result.sources, graph_result.diagnostics
                        }
                        ,)
                    break
                }
            }
            None => {
            }
        }
        index += 1_usize
    }

    // The graph used the source present when its worker started. Re-apply the
    // latest editor buffer so body-only edits made meanwhile remain authoritative.
    for doc in state.documents {
        if uri_to_path(doc.uri) == task.entry {
            queue_open_analysis(state, doc.uri, doc.text, false)
            break
        }
    }
    ret()
}

fn start_project_graph_task(state: mut ServerState) ->() {
    if state.project_graph_tasks.len() > 0_usize {
        ret()
    }
    while state.project_graph_queue.len() > 0_usize {
        match state.project_graph_queue.pop() {
            Some(request) => {
                if project_graph_generation(state, request.entry) == request.generation {
                    let mut spawned = Option[JoinHandle[PreparedProjectGraph]]::None
                    spawned = Option[JoinHandle[PreparedProjectGraph]]::Some(spawn prepare_project_graph(request.root,
                            request.entry, request.source,))
                    match spawned {
                        Some(handle) => state.project_graph_tasks.push(ProjectGraphTask {
                                request.root, request.entry, request.import_fingerprint, request.generation, handle
                            }
                            ,)
                        None => {
                        }
                    }
                    ret()
                }
            }
            None => {
            }
        }
    }
    ret()
}

fn drive_project_graph_tasks(state: mut ServerState) ->() {
    let mut pending = Vec[ProjectGraphTask]::new()
    while state.project_graph_tasks.len() > 0_usize {
        match state.project_graph_tasks.pop() {
            Some(task) => {
                if task.handle.is_finished() {
                    finish_project_graph_task(state, task)
                } else {
                    pending.push(task)
                }
            }
            None => {
            }
        }
    }
    while pending.len() > 0_usize {
        match pending.pop() {
            Some(task) => state.project_graph_tasks.push(task)
            None => {
            }
        }
    }
    start_project_graph_task(state)
    ret()
}

fn finish_analysis_task(state: mut ServerState, task: AnalysisTask) ->() {
    let prepared = task.handle.join()
    if document_generation(state, task.job.uri) != task.job.generation {
        ret()
    }
    let document = prepared.document()
    if !document.parsed {
        state.analysis.remove_module(task.job.module_name)
        if task.job.workspace {
            state.upsert_ready_workspace_document(task.job.uri, task.job.text, document)
        } else {
            state.upsert_ready_document(task.job.uri, task.job.text, document)
            state.upsert_ready_workspace_document(task.job.uri, task.job.text, document)
            publish_diagnostics_for_uri(state, task.job.uri)
        }
    } else {
        state.analysis.apply_prepared_lightweight(prepared)
        if task.job.workspace {
            state.upsert_ready_workspace_document(task.job.uri, task.job.text, document)
        } else {
            state.upsert_ready_document(task.job.uri, task.job.text, document)
            state.upsert_ready_workspace_document(task.job.uri, task.job.text, document)
            publish_diagnostics_for_uri(state, task.job.uri)
        }
    }
    if !task.job.workspace {
        match state.document(task.job.uri) {
            Some(doc) => {
                // The workspace loader is the strict compiler entry point:
                // never pass a buffer with known syntax errors to it.
                // The lightweight document now includes recoverable parser diagnostics.
                if doc.analysis.parsed && doc.analysis.diagnostics.len() == 0_usize
                && tolerant_import_diagnostics(state, doc).len() == 0_usize {
                    match project_root_for_path(uri_to_path(doc.uri)) {
                        Some(root) => queue_project_graph(state, root, uri_to_path(doc.uri), doc.text)
                        None => {
                        }
                    }
                }
            }
            None => {
            }
        }
    }
    ret()
}

fn drive_analysis(state: mut ServerState) ->() {
    drive_project_graph_tasks(state)
    let mut pending = Vec[AnalysisTask]::new()
    while state.analysis_tasks.len() > 0_usize {
        match state.analysis_tasks.pop() {
            Some(task) => {
                if task.handle.is_finished() {
                    finish_analysis_task(state, task)
                } else {
                    pending.push(task)
                }
            }
            None => {
            }
        }
    }
    while pending.len() > 0_usize {
        match pending.pop() {
            Some(task) => state.analysis_tasks.push(task)
            None => {
            }
        }
    }
    drive_semantic_tasks(state)
    // Ready editor buffers run before semantic work or background indexing.
    start_analysis_tasks(state, false)
    // Requests for the active document take precedence over background
    // workspace indexing when a worker slot becomes available.
    drive_deferred_requests(state)
    schedule_open_semantic_analysis(state)
    start_analysis_tasks(state, true)
    ret()
}

fn store_semantic_result(state: mut ServerState, uri: str, generation: usize,
    diagnostics: Vec[FrontendDiagnostic],) ->() {
    let mut index = 0_usize
    while index < state.semantic_results.len() {
        match state.semantic_results.get(index) {
            Some(existing) => {
                if existing.uri == uri {
                    state.semantic_results.set(index, SemanticAnalysisResult {
                            uri, generation, diagnostics
                        }
                        ,
                    )
                    ret()
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    state.semantic_results.push(SemanticAnalysisResult {
            uri, generation, diagnostics
        }
        ,
    )
    ret()
}

fn drive_semantic_tasks(state: mut ServerState) ->() {
    let mut pending = Vec[SemanticAnalysisTask]::new()
    while state.semantic_tasks.len() > 0_usize {
        match state.semantic_tasks.pop() {
            Some(task) => {
                if task.handle.is_finished() {
                    let diagnostics = task.handle.join()
                    if document_generation(state, task.uri) == task.generation {
                        store_semantic_result(state, task.uri, task.generation, diagnostics)
                        publish_semantic_diagnostics_for_uri(state, task.uri)
                    }
                } else {
                    pending.push(task)
                }
            }
            None => {
            }
        }
    }
    while pending.len() > 0_usize {
        match pending.pop() {
            Some(task) => state.semantic_tasks.push(task)
            None => {
            }
        }
    }
    ret()
}

fn drive_deferred_requests(state: mut ServerState) ->() {
    let mut retained = Vec[Json]::new()
    while state.deferred_requests.len() > 0_usize {
        match state.deferred_requests.pop() {
            Some(message) => {
                let uri = request_uri(json_get(message, "params"))
                if analysis_pending_for_uri(state, uri) {
                    retained.push(message)
                } else {
                    match semantic_result_for_uri(state, uri) {
                        Some(_diagnostics) => {
                            let _handled = handle_message(state, message)
                        }
                        None => {
                            let mut scheduled = semantic_pending_for_uri(state, uri)
                            if !semantic_pending_for_uri(state, uri) {
                                scheduled = queue_semantic_analysis(state, uri)
                            }
                            if scheduled || project_graph_pending_for_uri(state, uri) {
                                retained.push(message)
                            } else {
                                let _handled = handle_message(state, message)
                            }
                        }
                    }
                }
            }
            None => {
            }
        }
    }
    while retained.len() > 0_usize {
        match retained.pop() {
            Some(message) => state.deferred_requests.push(message)
            None => {
            }
        }
    }
    ret()
}

fn main() -> u32 {
    let mut state = ServerState::new()
    loop {
        drive_analysis(state)
        if analysis_is_pending(state) && !wait_readable(stdin_fd(), 10_usize) {
            continue
        }
        match read_lsp_message() {
            Option[Json]::Some(message) => {
                if !handle_message(state, message) {
                    ret 0_u32
                }
            }
            Option[Json]::None => {
                ret 0_u32
            }
        }
    }
    ret 0_u32
}

fn handle_message(state: mut ServerState, message: Json) -> bool {
    let method = json_get_str(message, "method", "")
    if method == "" {
        // Responses to requests initiated by the server have no method.
        ret true
    }

    if method == "initialize" {
        if state.initialized {
            send_error(json_get(message, "id"), "-32600", "Initialize request received more than once")
            ret true
        }
        configure_server(state, json_get(message, "params"))
        handle_initialize_workspace(state, json_get(message, "params"))
        state.initialized = true
        send_response(json_get(message, "id"), initialize_result())
        ret true
    }
    if method == "initialized" {
        index_workspace_roots_shallow(state)
        register_project_file_watchers()
        ret true
    }
    if method == "shutdown" {
        state.shutdown_requested = true
        send_response(json_get(message, "id"), Json::Null)
        ret true
    }
    if method == "exit" {
        if state.shutdown_requested {
            exit_process(0_i32)
            ret false
        }
        exit_process(1_i32)
        ret false
    }
    if method == "$/cancelRequest" || method == "$/setTrace" {
        ret true
    }
    if !state.initialized {
        send_error(json_get(message, "id"), "-32002", "Server not initialized")
        ret true
    }
    if state.shutdown_requested {
        send_error(json_get(message, "id"), "-32600", "Request received after shutdown")
        ret true
    }

    if method == "textDocument/didOpen" {
        handle_did_open(state, json_get(message, "params"))
        ret true
    }
    if method == "textDocument/didChange" {
        handle_did_change(state, json_get(message, "params"))
        ret true
    }
    if method == "textDocument/didClose" {
        handle_did_close(state, json_get(message, "params"))
        ret true
    }
    if method == "textDocument/didSave" {
        handle_did_save(state, json_get(message, "params"))
        ret true
    }
    if method == "workspace/didChangeWorkspaceFolders" {
        handle_workspace_folders_changed(state, json_get(message, "params"))
        ret true
    }
    if method == "workspace/didChangeWatchedFiles" {
        handle_project_files_changed(state)
        ret true
    }

    if method == "textDocument/documentSymbol" {
        send_response(json_get(message, "id"), document_symbols(state, json_get(message, "params")))
        ret true
    }
    if method == "workspace/symbol" {
        send_response(json_get(message, "id"), workspace_symbols(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/definition" || method == "textDocument/declaration" {
        send_response(json_get(message, "id"), definition_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/implementation" {
        send_response(json_get(message, "id"), implementation_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/hover" {
        send_response(json_get(message, "id"), hover_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/signatureHelp" {
        send_response(json_get(message, "id"), signature_help_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/references" {
        send_response(json_get(message, "id"), references_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/documentHighlight" {
        send_response(json_get(message, "id"), document_highlight_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/prepareRename" {
        send_response(json_get(message, "id"), prepare_rename_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/rename" {
        match rename_result(state, json_get(message, "params")) {
            Ok(edit) => {
                send_response(json_get(message, "id"), edit)
            }
            Err(reason) => {
                send_error(json_get(message, "id"), "-32803", reason)
            }
        }
        ret true
    }
    if method == "textDocument/completion" {
        send_response(json_get(message, "id"), completion_result(state, json_get(message, "params")))
        ret true
    }
    if method == "completionItem/resolve" {
        send_response(json_get(message, "id"), resolve_completion_item(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/codeAction" {
        send_response(json_get(message, "id"), code_action_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/inlayHint" {
        send_response(json_get(message, "id"), inlay_hint_result(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/documentLink" {
        send_response(json_get(message, "id"), document_links(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/foldingRange" {
        send_response(json_get(message, "id"), folding_ranges(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/selectionRange" {
        send_response(json_get(message, "id"), selection_ranges(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/semanticTokens/full" {
        send_response(json_get(message, "id"), semantic_tokens_full(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/formatting" || method == "textDocument/rangeFormatting" {
        send_response(json_get(message, "id"), formatting_edits(state, json_get(message, "params")))
        ret true
    }
    if method == "textDocument/diagnostic" {
        let uri = request_uri(json_get(message, "params"))
        if analysis_pending_for_uri(state, uri) {
            state.deferred_requests.push(message)
            ret true
        }
        match semantic_result_for_uri(state, uri) {
            Some(_diagnostics) => {
            }
            None => {
                let scheduled = queue_semantic_analysis(state, uri)
                if scheduled || project_graph_pending_for_uri(state, uri) {
                    state.deferred_requests.push(message)
                    ret true
                }
            }
        }
        send_response(json_get(message, "id"), document_diagnostic_result(state, json_get(message, "params")))
        ret true
    }
    if method == "workspace/diagnostic" {
        send_response(json_get(message, "id"), workspace_diagnostic_result(state))
        ret true
    }
    if method == "textDocument/prepareCallHierarchy" {
        send_response(json_get(message, "id"), prepare_call_hierarchy_result(state, json_get(message,
                    "params",)))
        ret true
    }
    if method == "callHierarchy/outgoingCalls" {
        send_response(json_get(message, "id"), outgoing_calls_result(state, json_get(message, "params")))
        ret true
    }
    if method == "callHierarchy/incomingCalls" {
        send_response(json_get(message, "id"), incoming_calls_result(state, json_get(message, "params")))
        ret true
    }

    send_error(json_get(message, "id"), "-32601", "Method not found: " + method)
    ret true
}

fn configure_server(state: mut ServerState, params: Json) ->() {
    let workspace = json_get(json_get(params, "capabilities"), "workspace")
    state.supports_document_changes = json_get(json_get(workspace, "workspaceEdit"), "documentChanges").as_bool().unwrap_or(false)
    let completion = json_get(json_get(json_get(params, "capabilities"), "textDocument"), "completion")
    let support = json_get(json_get(completion, "completionItem"), "resolveSupport")
    match json_get(support, "properties").as_array() {
        Some(properties) => {
            for property in properties {
                if property.as_str().unwrap_or("") == "documentation" {
                    state.resolve_completion_documentation = true
                }
            }
        }
        None => {
        }
    }
    let options = json_get(params, "initializationOptions")
    match options.as_object() {
        Some(_fields) => {
            match json_get(options, "cache").as_bool() {
                Some(enabled) => {
                    state.cache_enabled = enabled
                }
                None => {
                }
            }
            let cache_root = json_get_str(options, "cacheDir", "")
            if cache_root != "" {
                state.cache_root = cache_root
            }
            let jobs = json_number_usize(json_get(options, "jobs"), 0_usize)
            if jobs > 0_usize {
                state.max_analysis_tasks = jobs
            }
            state.analysis_debounce_ms = json_number_usize(json_get(options, "debounceMs"),
                state.analysis_debounce_ms,)
        }
        None => {
        }
    }
    ret()
}

fn index_workspace_roots_shallow(state: mut ServerState) ->() {
    state.workspace_documents = Vec[Document]::new()
    state.workspace_projects = Vec[ProjectRoot]::new()
    state.indexed_project_roots = Vec[str]::new()
    state.autoimport_scopes = Vec[AutoimportScope]::new()
    let mut root_index = 0_usize
    while root_index < state.workspace_roots.len() {
        match state.workspace_roots.get(root_index) {
            Some(root) => {
                discover_workspace_projects_shallow(state, root)
                if !workspace_root_was_discovered(state, root) {
                    state.discovered_workspace_roots.push(root)
                }
            }
            None => {
            }
        }
        root_index = root_index + 1_usize
    }
    ret()
}

fn handle_did_open(state: mut ServerState, params: Json) ->() {
    let text_document = json_get(params, "textDocument")
    let uri = json_get_str(text_document, "uri", "")
    let text = json_get_str(text_document, "text", "")
    if uri != "" {
        ensure_workspace_for_uri(state, uri)
        queue_open_analysis(state, uri, text, source_matches_disk(uri, text))
        set_client_document_version(state, uri, json_get(text_document, "version"))
    }
    ret()
}

fn handle_did_change(state: mut ServerState, params: Json) ->() {
    let text_document = json_get(params, "textDocument")
    let uri = json_get_str(text_document, "uri", "")
    let changes = json_get(params, "contentChanges")
    let text = apply_content_changes(current_document_text(state, uri), changes)
    if uri != "" {
        ensure_workspace_for_uri(state, uri)
        queue_open_analysis(state, uri, text, false)
        set_client_document_version(state, uri, json_get(text_document, "version"))
    }
    ret()
}

fn handle_did_close(state: mut ServerState, params: Json) ->() {
    let text_document = json_get(params, "textDocument")
    let uri = json_get_str(text_document, "uri", "")
    if uri != "" {
        clear_semantic_token_cache(state, uri)
        advance_document_generation(state, uri)
        remove_queued_analysis_for_uri(state, uri)
        state.remove_document(uri)
        send_notification("textDocument/publishDiagnostics", publish_diagnostics_params(uri, Vec[Json]::new()))
        let path = uri_to_path(uri)
        if file_exists(path) {
            queue_workspace_analysis(state, uri, read_file(path))
        }
    }
    ret()
}

fn handle_did_save(state: mut ServerState, params: Json) ->() {
    let text_document = json_get(params, "textDocument")
    let uri = json_get_str(text_document, "uri", "")
    if uri == "" {
        ret()
    }

    let text = json_get_str(params, "text", "")
    ensure_workspace_for_uri(state, uri)
    if text != "" {
        queue_open_analysis(state, uri, text, true)
    } else {
        let path = uri_to_path(uri)
        if file_exists(path) {
            queue_open_analysis(state, uri, read_file(path), true)
        }
    }
    ret()
}

fn current_document_text(state: ServerState, uri: str) -> str {
    match state.document(uri) {
        Some(document) => {
            ret document.text
        }
        None => {
            ret ""
        }
    }
}

fn source_matches_disk(uri: str, source: str) -> bool {
    let path = uri_to_path(uri)
    ret file_exists(path) && read_file(path) == source
}

fn apply_content_changes(original: str, value: Json) -> str {
    let mut text = original
    match value.as_array() {
        Some(items) => {
            for change in items {
                let replacement = json_get_str(change, "text", "")
                let range = json_get(change, "range")
                match range.as_object() {
                    Some(_fields) => {
                        let start = json_get(range, "start")
                        let end = json_get(range, "end")
                        let start_index = text_position_index(text,
                            json_number_usize(json_get(start, "line"), 0_usize),
                            json_number_usize(json_get(start, "character"), 0_usize),)
                        let end_index = text_position_index(text,
                            json_number_usize(json_get(end, "line"), 0_usize),
                            json_number_usize(json_get(end, "character"), 0_usize),)
                        if end_index >= start_index && start_index <= text.char_len() {
                            let prefix = text.slice(0_usize, start_index)
                            let suffix_start = min_usize(end_index, text.char_len())
                            text = prefix + replacement + text.slice(suffix_start, text.char_len() - suffix_start)
                        }
                    }
                    None => {
                        text = replacement
                    }
                }
            }
        }
        None => {
        }
    }
    ret text
}

fn handle_initialize_workspace(state: mut ServerState, params: Json) ->() {
    let root_uri = json_get_str(params, "rootUri", "")
    if root_uri != "" {
        state.add_workspace_root(uri_to_path(root_uri))
    }

    match json_get(params, "workspaceFolders").as_array() {
        Option[Vec[Json]]::Some(folders) => {
            let mut index = 0_usize
            while index < folders.len() {
                match folders.get(index) {
                    Option[Json]::Some(folder) => {
                        let uri = json_get_str(folder, "uri", "")
                        if uri != "" {
                            state.add_workspace_root(uri_to_path(uri))
                        }
                    }
                    Option[Json]::None => {
                    }
                }
                index += 1_usize
            }
        }
        Option[Vec[Json]]::None => {
        }
    }

    if state.workspace_roots.len() == 0_usize {
        state.add_workspace_root(cwd())
    }

    state.workspace_documents = Vec[Document]::new()
    state.workspace_projects = Vec[ProjectRoot]::new()
    state.indexed_project_roots = Vec[str]::new()
    state.autoimport_scopes = Vec[AutoimportScope]::new()
    state.discovered_workspace_roots = Vec[str]::new()
    ret()
}

fn handle_workspace_folders_changed(state: mut ServerState, params: Json) ->() {
    let event = json_get(params, "event")
    match json_get(event, "removed").as_array() {
        Some(folders) => {
            let mut index = 0_usize
            while index < folders.len() {
                match folders.get(index) {
                    Some(folder) => {
                        let uri = json_get_str(folder, "uri", "")
                        if uri != "" {
                            remove_workspace_root(state, uri_to_path(uri))
                        }
                    }
                    None => {
                    }
                }
                index += 1_usize
            }
        }
        None => {
        }
    }
    match json_get(event, "added").as_array() {
        Some(folders) => {
            let mut index = 0_usize
            while index < folders.len() {
                match folders.get(index) {
                    Some(folder) => {
                        let uri = json_get_str(folder, "uri", "")
                        if uri != "" {
                            state.add_workspace_root(uri_to_path(uri))
                        }
                    }
                    None => {
                    }
                }
                index += 1_usize
            }
        }
        None => {
        }
    }
    state.analysis = AnalysisDatabase::new()
    state.project_graphs = Vec[ProjectGraphState]::new()
    state.semantic_results = Vec[SemanticAnalysisResult]::new()
    index_workspace_roots_shallow(state)
    let mut open_documents = Vec[Document]::new()
    for doc in state.documents {
        open_documents.push(doc)
    }
    for doc in open_documents {
        ensure_workspace_for_uri(state, doc.uri)
        queue_open_analysis(state, doc.uri, doc.text, false)
    }
    ret()
}

fn register_project_file_watchers() ->() {
    let mut watchers = Vec[Json]::new()
    let mut manifest = Vec[(str, Json)]::new()
    manifest.push(field("globPattern", Json::String("**/encore.toml")))
    watchers.push(Json::Object(manifest))
    let mut lock = Vec[(str, Json)]::new()
    lock.push(field("globPattern", Json::String("**/encore.lock")))
    watchers.push(Json::Object(lock))

    let mut options = Vec[(str, Json)]::new()
    options.push(field("watchers", Json::Array(watchers)))
    let mut registration = Vec[(str, Json)]::new()
    registration.push(field("id", Json::String("encore-project-files")))
    registration.push(field("method", Json::String("workspace/didChangeWatchedFiles")))
    registration.push(field("registerOptions", Json::Object(options)))
    let mut registrations = Vec[Json]::new()
    registrations.push(Json::Object(registration))
    let mut params = Vec[(str, Json)]::new()
    params.push(field("registrations", Json::Array(registrations)))
    send_request("encore-register-project-files", "client/registerCapability", Json::Object(params))
    ret()
}

fn handle_project_files_changed(state: mut ServerState) ->() {
    state.analysis = AnalysisDatabase::new()
    state.semantic_results = Vec[SemanticAnalysisResult]::new()
    state.project_graphs = Vec[ProjectGraphState]::new()
    state.workspace_projects = Vec[ProjectRoot]::new()
    state.indexed_project_roots = Vec[str]::new()
    state.autoimport_scopes = Vec[AutoimportScope]::new()
    state.discovered_workspace_roots = Vec[str]::new()
    state.completion_documents = Vec[Document]::new()
    index_workspace_roots_shallow(state)
    let mut open_documents = Vec[Document]::new()
    for doc in state.documents {
        open_documents.push(doc)
    }
    for doc in open_documents {
        queue_open_analysis(state, doc.uri, doc.text, false)
    }
    ret()
}

fn remove_workspace_root(state: mut ServerState, root: str) ->() {
    let mut roots = Vec[str]::new()
    let mut index = 0_usize
    while index < state.workspace_roots.len() {
        match state.workspace_roots.get(index) {
            Some(existing) => {
                if existing != root {
                    roots.push(existing)
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    state.workspace_roots = roots
    ret()
}

fn ensure_workspace_for_uri(state: mut ServerState, uri: str) ->() {
    let path = uri_to_path(uri)
    ensure_workspace_roots_for_path(state, path)
    match project_root_for_path(path) {
        Option[str]::Some(root) => {
            if !workspace_project_root_exists(state, root) {
                state_add_workspace_project(state, root)
            }
            index_workspace_project_once(state, root)
            ensure_autoimport_scopes(state, root)
        }
        Option[str]::None => {
        }
    }
    ret()
}

fn ensure_autoimport_scopes(state: mut ServerState, root: str) ->() {
    for scope in state.autoimport_scopes {
        if scope.owner == root {
            ret()
        }
    }
    state.autoimport_scopes.push(AutoimportScope {
            root, root, "refrain"
        }
        ,
    )
    match try_read_project_manifest(Path::new(root)) {
        Ok(manifest) => {
            for reference in project_manifest_dependencies(manifest) {
                match try_cached_project_dependency_root(Path::new(root), reference) {
                    Ok(dependency) => {
                        match try_read_project_manifest(dependency) {
                            Ok(package) => {
                                let path = dependency.resolve().as_str()
                                state.autoimport_scopes.push(AutoimportScope {
                                        root, path, package.name
                                    }
                                    ,
                                )
                                state_add_workspace_project(state, path)
                                index_workspace_project_once(state, path)
                            }
                            Err(_) => {
                            }
                        }
                    }
                    Err(_) => {
                    }
                }
            }
        }
        Err(_) => {
        }
    }
    ret()
}

fn index_workspace_project_once(state: mut ServerState, root: str) ->() {
    let mut index = 0_usize
    while index < state.indexed_project_roots.len() {
        match state.indexed_project_roots.get(index) {
            Option[str]::Some(existing) => {
                if existing == root {
                    ret()
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    state.indexed_project_roots.push(root)
    index_workspace_dir(state, join_path(root, "src"))
    ret()
}

fn ensure_workspace_roots_for_path(state: mut ServerState, path: str) ->() {
    let mut index = 0_usize
    while index < state.workspace_roots.len() {
        match state.workspace_roots.get(index) {
            Option[str]::Some(root) => {
                if starts_with(path, root) && !workspace_root_was_discovered(state, root) {
                    discover_workspace_projects_shallow(state, root)
                    state.discovered_workspace_roots.push(root)
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn workspace_root_was_discovered(state: ServerState, root: str) -> bool {
    let mut index = 0_usize
    while index < state.discovered_workspace_roots.len() {
        match state.discovered_workspace_roots.get(index) {
            Option[str]::Some(existing) => {
                if existing == root {
                    ret true
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn discover_workspace_projects_shallow(state: mut ServerState, root: str) ->() {
    if file_exists(join_path(root, "encore.toml")) {
        state_add_workspace_project(state, root)
    }

    let entries = read_dir(root)
    let mut index = 0_usize
    while index < entries.len() {
        match entries.get(index) {
            Option[str]::Some(entry) => {
                if should_descend_workspace_entry(entry) {
                    let path = join_path(root, entry)
                    if file_exists(join_path(path, "encore.toml")) {
                        state_add_workspace_project(state, path)
                    }
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }

    discover_workspace_projects_one_level(state, join_path(root, "index"))
    ret()
}

fn discover_workspace_projects_one_level(state: mut ServerState, dir: str) ->() {
    if !file_exists(dir) {
        ret()
    }
    let entries = read_dir(dir)
    let mut index = 0_usize
    while index < entries.len() {
        match entries.get(index) {
            Option[str]::Some(entry) => {
                if should_descend_workspace_entry(entry) {
                    let path = join_path(dir, entry)
                    if file_exists(join_path(path, "encore.toml")) {
                        state_add_workspace_project(state, path)
                    }
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn workspace_project_root_exists(state: ServerState, root: str) -> bool {
    let mut index = 0_usize
    while index < state.workspace_projects.len() {
        match state.workspace_projects.get(index) {
            Option[ProjectRoot]::Some(project) => {
                if project.root == root {
                    ret true
                }
            }
            Option[ProjectRoot]::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn project_root_for_path(path: str) -> Option[str] {
    let mut cursor = if ends_with(path, ".enq") {
        parent_path(path)
    } else {
        path
    }
    loop {
        if cursor == "" {
            break
        }
        if file_exists(join_path(cursor, "encore.toml")) {
            ret Option[str]::Some(cursor)
        }
        let parent = parent_path(cursor)
        if parent == cursor || parent == "" {
            break
        }
        cursor = parent
    }
    ret Option[str]::None
}

fn index_workspace_roots(state: mut ServerState) ->() {
    state.workspace_documents = Vec[Document]::new()
    state.workspace_projects = Vec[ProjectRoot]::new()
    let mut index = 0_usize
    while index < state.workspace_roots.len() {
        match state.workspace_roots.get(index) {
            Option[str]::Some(root) => {
                discover_workspace_projects(state, root)
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }

    if state.workspace_projects.len() == 0_usize {
        let mut fallback_index = 0_usize
        while fallback_index < state.workspace_roots.len() {
            match state.workspace_roots.get(fallback_index) {
                Option[str]::Some(root) => {
                    let src = join_path(root, "src")
                    index_workspace_dir(state, src)
                }
                Option[str]::None => {
                }
            }
            fallback_index += 1_usize
        }
        ret()
    }

    let mut project_index = 0_usize
    while project_index < state.workspace_projects.len() {
        match state.workspace_projects.get(project_index) {
            Option[ProjectRoot]::Some(project) => {
                index_workspace_dir(state, join_path(project.root, "src"))
            }
            Option[ProjectRoot]::None => {
            }
        }
        project_index += 1_usize
    }
    ret()
}

fn index_workspace_dir(state: mut ServerState, dir: str) ->() {
    if !file_exists(dir) {
        ret()
    }
    let entries = read_dir(dir)
    let mut index = 0_usize
    while index < entries.len() {
        match entries.get(index) {
            Option[str]::Some(entry) => {
                if should_index_workspace_entry(entry) {
                    let path = join_path(dir, entry)
                    if ends_with(path, ".enq") {
                        queue_workspace_analysis(state, path_to_uri(path), read_file(path))
                    } elif file_exists(join_path(path, ".")) {
                        index_workspace_dir(state, path)
                    }
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn should_index_workspace_entry(entry: str) -> bool {
    if entry == "." || entry == ".." {
        ret false
    }
    if entry == ".git" || entry == ".venv" || entry == ".ruff_cache" || entry == ".encore_cache" || entry == "target" || entry ==
    "__pycache__" {
        ret false
    }
    if ends_with(entry, ".enq") {
        ret true
    }
    if contains_substring(entry, ".") {
        ret false
    }
    ret true
}

fn discover_workspace_projects(state: mut ServerState, root: str) ->() {
    if file_exists(join_path(root, "encore.toml")) {
        state_add_workspace_project(state, root)
    }
    discover_workspace_projects_in_dir(state, root)
    ret()
}

fn discover_workspace_projects_in_dir(state: mut ServerState, dir: str) ->() {
    let entries = read_dir(dir)
    let mut index = 0_usize
    while index < entries.len() {
        match entries.get(index) {
            Option[str]::Some(entry) => {
                if should_descend_workspace_entry(entry) {
                    let path = join_path(dir, entry)
                    if file_exists(join_path(path, "encore.toml")) {
                        state_add_workspace_project(state, path)
                    }
                    discover_workspace_projects_in_dir(state, path)
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn should_descend_workspace_entry(entry: str) -> bool {
    if entry == "." || entry == ".." {
        ret false
    }
    if entry == ".git" || entry == ".venv" || entry == ".ruff_cache" || entry == ".encore_cache" || entry == "target" || entry == "__pycache__" {
        ret false
    }
    if ends_with(entry, ".enq") || ends_with(entry, ".py") || ends_with(entry, ".md") || ends_with(entry,
        ".toml",) {
        ret false
    }
    ret true
}

fn state_add_workspace_project(state: mut ServerState, root: str) ->() {
    let mut index = 0_usize
    while index < state.workspace_projects.len() {
        match state.workspace_projects.get(index) {
            Option[ProjectRoot]::Some(existing) => {
                if existing.root == root {
                    ret()
                }
            }
            Option[ProjectRoot]::None => {
            }
        }
        index += 1_usize
    }
    let name = project_name_for_root(root)
    state.workspace_projects.push(ProjectRoot {
            root, name
        }
        ,
    )
    ret()
}

fn initialize_result() -> Json {
    let mut sync_fields = Vec[(str, Json)]::new()
    sync_fields.push(field("openClose", Json::Bool(true)))
    sync_fields.push(field("change", Json::Number("2")))
    let mut save_fields = Vec[(str, Json)]::new()
    save_fields.push(field("includeText", Json::Bool(true)))
    sync_fields.push(field("save", Json::Object(save_fields)))

    let mut completion_fields = Vec[(str, Json)]::new()
    completion_fields.push(field("resolveProvider", Json::Bool(true)))
    completion_fields.push(field("triggerCharacters", completion_trigger_characters()))

    let mut capabilities = Vec[(str, Json)]::new()
    capabilities.push(field("textDocumentSync", Json::Object(sync_fields)))
    capabilities.push(field("definitionProvider", Json::Bool(true)))
    capabilities.push(field("declarationProvider", Json::Bool(true)))
    capabilities.push(field("implementationProvider", Json::Bool(true)))
    capabilities.push(field("hoverProvider", Json::Bool(true)))
    capabilities.push(field("referencesProvider", Json::Bool(true)))
    capabilities.push(field("documentHighlightProvider", Json::Bool(true)))
    capabilities.push(field("renameProvider", rename_provider()))
    capabilities.push(field("codeActionProvider", Json::Bool(true)))
    capabilities.push(field("signatureHelpProvider", signature_help_provider()))
    capabilities.push(field("documentSymbolProvider", Json::Bool(true)))
    capabilities.push(field("workspaceSymbolProvider", Json::Bool(true)))
    capabilities.push(field("completionProvider", Json::Object(completion_fields)))
    capabilities.push(field("inlayHintProvider", Json::Bool(true)))
    capabilities.push(field("documentLinkProvider", bool_provider(false)))
    capabilities.push(field("foldingRangeProvider", Json::Bool(true)))
    capabilities.push(field("selectionRangeProvider", Json::Bool(true)))
    capabilities.push(field("semanticTokensProvider", semantic_tokens_provider()))
    capabilities.push(field("documentFormattingProvider", Json::Bool(true)))
    capabilities.push(field("documentRangeFormattingProvider", Json::Bool(true)))
    capabilities.push(field("callHierarchyProvider", Json::Bool(true)))
    // Diagnostics use the broadly supported publish model. Advertising pull
    // diagnostics at the same time makes clients such as Zed render every
    // diagnostic twice.

    let mut workspace_folders = Vec[(str, Json)]::new()
    workspace_folders.push(field("supported", Json::Bool(true)))
    workspace_folders.push(field("changeNotifications", Json::Bool(true)))
    let mut workspace = Vec[(str, Json)]::new()
    workspace.push(field("workspaceFolders", Json::Object(workspace_folders)))
    capabilities.push(field("workspace", Json::Object(workspace)))

    let mut server_info = Vec[(str, Json)]::new()
    server_info.push(field("name", Json::String("encore-lsp")))
    server_info.push(field("version", Json::String(compiler_release_version())))

    let mut result = Vec[(str, Json)]::new()
    result.push(field("capabilities", Json::Object(capabilities)))
    result.push(field("serverInfo", Json::Object(server_info)))
    ret Json::Object(result)
}

fn document_symbols(state: ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            let mut items = Vec[Json]::new()
            let mut index = 0_usize
            while index < doc.analysis.symbols.len() {
                match doc.analysis.symbols.get(index) {
                    Option[FrontendSymbol]::Some(symbol) => {
                        items.push(symbol_to_lsp(doc, symbol))
                    }
                    Option[FrontendSymbol]::None => {
                    }
                }
                index += 1_usize
            }
            ret Json::Array(items)
        }
        Option[Document]::None => {
            ret Json::Array(Vec[Json]::new())
        }
    }
}

fn symbol_to_lsp(doc: Document, symbol: FrontendSymbol) -> Json {
    let range = symbol_range(doc, symbol)
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("name", Json::String(symbol.name)))
    fields.push(field("kind", json_usize(symbol.kind)))
    fields.push(field("range", range))
    fields.push(field("selectionRange", range))
    ret Json::Object(fields)
}

fn workspace_symbols(state: ServerState, params: Json) -> Json {
    let query = json_get_str(params, "query", "")
    let mut items = Vec[Json]::new()
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                push_workspace_symbols_for_doc(items, doc, query)
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }
    let mut workspace_doc_index = 0_usize
    while workspace_doc_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_doc_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    push_workspace_symbols_for_doc(items, doc, query)
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_doc_index += 1_usize
    }
    ret Json::Array(items)
}

fn push_workspace_symbols_for_doc(items: mut Vec[Json], doc: Document, query: str) ->() {
    let mut symbol_index = 0_usize
    while symbol_index < doc.analysis.symbols.len() {
        match doc.analysis.symbols.get(symbol_index) {
            Option[FrontendSymbol]::Some(symbol) => {
                if query == "" || contains_substring(symbol.name, query) {
                    items.push(workspace_symbol_item(doc, symbol))
                }
            }
            Option[FrontendSymbol]::None => {
            }
        }
        symbol_index += 1_usize
    }
    ret()
}

fn open_document_exists(state: ServerState, uri: str) -> bool {
    let mut index = 0_usize
    while index < state.documents.len() {
        match state.documents.get(index) {
            Option[Document]::Some(doc) => {
                if doc.uri == uri {
                    ret true
                }
            }
            Option[Document]::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn workspace_symbol_item(doc: Document, symbol: FrontendSymbol) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("name", Json::String(symbol.name)))
    fields.push(field("kind", json_usize(symbol.kind)))
    fields.push(field("location", location_json(doc.uri, symbol_range(doc, symbol))))
    ret Json::Object(fields)
}

fn code_action_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match json_get(json_get(params, "context"), "only").as_array() {
        Option[Vec[Json]]::Some(kinds) => {
            let mut allowed = kinds.len() == 0_usize
            for kind in kinds {
                if kind.as_str().unwrap_or("") == "quickfix" {
                    allowed = true
                }
            }
            if !allowed {
                ret Json::Array(Vec[Json]::new())
            }
        }
        Option[Vec[Json]]::None => {
        }
    }
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            let diagnostics = document_diagnostics_json(state, doc, true)
            let version = client_document_version(state, uri)
            let range = json_get(params, "range")
            let mut actions = diagnostic_actions(uri, version, diagnostics, range)
            for diagnostic in diagnostics {
                let code = json_get_str(diagnostic, "code", "")
                if code != "unknown-type" && code != "unknown-trait" && code != "unknown-variable"
                && code != "unresolved-call" {
                    continue
                }
                let location = json_get(diagnostic, "range")
                if !ranges_overlap(location, range) {
                    continue
                }
                let mut query = Vec[(str, Json)]::new()
                query.push(field("position", json_get(location, "end")))
                let query_params = Json::Object(query)
                let name = completion_prefix(doc, query_params)
                if name == "" {
                    continue
                }
                let mut candidates = Vec[Json]::new()
                push_autoimport_items(state, candidates, doc, query_params,
                    code == "unknown-type" || code == "unknown-trait",)
                for candidate in candidates {
                    if json_get_str(candidate, "label", "") != name {
                        continue
                    }
                    match json_get(candidate, "additionalTextEdits").as_array() {
                        Some(edits) => {
                            let mut related = Vec[Json]::new()
                            related.push(diagnostic)
                            let mut action = Vec[(str, Json)]::new()
                            action.push(field("title", json_get(candidate, "detail")))
                            action.push(field("kind", Json::String("quickfix")))
                            action.push(field("diagnostics", Json::Array(related)))
                            action.push(field("edit", versioned_edit(uri, version, edits)))
                            actions.push(Json::Object(action))
                        }
                        None => {
                        }
                    }
                }
            }
            ret Json::Array(actions)
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn completion_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match import_completion_items(state, doc, params) {
                Some(import_items) => {
                    let mut result = Vec[(str, Json)]::new()
                    result.push(field("isIncomplete", Json::Bool(analysis_is_pending(state))))
                    result.push(field("items", Json::Array(import_items)))
                    ret Json::Object(result)
                }
                None => {
                }
            }
            if type_completion_requested(doc, params) {
                let items = type_completion_items(state, doc, params)
                let mut result = Vec[(str, Json)]::new()
                result.push(field("isIncomplete", Json::Bool(analysis_is_pending(state))))
                result.push(field("items", Json::Array(items)))
                ret Json::Object(result)
            }
            let position = json_get(params, "position")
            let line = json_number_usize(json_get(position, "line"), 0_usize)
            let column = request_character_index(doc, line, json_number_usize(json_get(position, "character"), 0_usize))
            match cursor_associated_context(doc.analysis.tokens, line, column) {
                Some(context) => {
                    let visited = encore_strset_new()
                    index_query_module(state, doc, visited, true)
                    encore_strset_free(visited)
                    let query_owner = associated_query_owner(state, doc, context.0)
                    match state.analysis.associated_owner_type(doc.uri, query_owner) {
                        Some(receiver) => {
                            let members = state.analysis.associated_members_for_type(doc.uri, query_owner)
                            let mut items = semantic_member_completion_items(members, context.1)
                            for variant in state.analysis.enum_variant_definitions(doc.uri, query_owner) {
                                if starts_with(variant.name(), context.1) && !completion_item_exists(items, variant.name()) {
                                    items.push(completion_item(variant.name(), 20_usize, context.0 + "::" + variant.name()))
                                }
                            }
                            let mut result = Vec[(str, Json)]::new()
                            result.push(field("isIncomplete", Json::Bool(analysis_is_pending(state))))
                            result.push(field("items", Json::Array(items)))
                            ret Json::Object(result)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
            match cursor_member_context(doc.analysis.tokens, line, column) {
                Some(context) => {
                    let mut result = Vec[(str, Json)]::new()
                    result.push(field("isIncomplete", Json::Bool(analysis_is_pending(state))))
                    result.push(field("items", Json::Array(member_completion_items(state, doc, context))))
                    ret Json::Object(result)
                }
                None => {
                }
            }
        }
        None => {
        }
    }
    let mut items = keyword_completion_items()
    let seen = encore_strset_new()
    for item in items {
        encore_strset_insert(seen, json_get_str(item, "label", ""))
    }
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            push_visible_completion_items(state, items, doc, params, false)
            push_autoimport_items(state, items, doc, params, false)
        }
        Option[Document]::None => {
        }
    }
    encore_strset_free(seen)

    let mut result = Vec[(str, Json)]::new()
    result.push(field("isIncomplete", Json::Bool(analysis_is_pending(state))))
    result.push(field("items", Json::Array(items)))
    ret Json::Object(result)
}

fn completion_definition_allowed(definition: HirDefinition, types_only: bool) -> bool {
    if types_only && definition.namespace() != DefinitionNamespace::Type
    && definition.namespace() != DefinitionNamespace::Trait {
        ret false
    }
    match definition.kind() {
        DefinitionKind::Method => {
            ret false
        }
        DefinitionKind::Field => {
            ret false
        }
        DefinitionKind::Parameter => {
            ret false
        }
        DefinitionKind::GenericParameter => {
            ret false
        }
        DefinitionKind::Variant => {
            ret false
        }
        _ => {
            ret true
        }
    }
}

fn definition_completion_item(state: mut ServerState, definition: HirDefinition) -> Json {
    let origin = document_for_path(state, uri_to_path(definition.source_name()))
    for symbol in origin.analysis.symbols {
        if symbol.line == definition.line() && symbol.column == definition.column() {
            let mut renamed = symbol
            renamed.name = definition.name()
            if state.resolve_completion_documentation {
                ret deferred_symbol_completion_item(origin, renamed)
            }
            ret symbol_completion_item(renamed)
        }
    }
    ret completion_item(definition.name(), 6_usize, "Encore declaration")
}

fn push_visible_completion_items(state: mut ServerState, items: mut Vec[Json], doc: Document,
    params: Json, types_only: bool,) ->() {
    let prefix = completion_prefix(doc, params)
    let seen = encore_strset_new()
    let source_hash = if state.resolve_completion_documentation {
        Debug::fmt(doc.text.hash())
    } else {
        ""
    }
    for item in items {
        encore_strset_insert(seen, json_get_str(item, "label", ""))
    }
    // The outline already contains local declarations and their documentation.
    // Do not rediscover each one by scanning the document's symbols again.
    for symbol in doc.analysis.symbols {
        if symbol.scope == "" && starts_with(symbol.name, prefix)
        &&(!types_only || is_type_symbol(symbol)) && encore_strset_insert(seen, symbol.name) {
            if state.resolve_completion_documentation {
                items.push(deferred_symbol_completion_with_hash(doc, symbol, source_hash))
            } else {
                items.push(symbol_completion_item(symbol))
            }
        }
    }
    push_imported_visible_completion_items(state, items, doc, prefix, types_only, seen)
    if !types_only {
        let visited = encore_strset_new()
        index_query_module(state, doc, visited, true)
        encore_strset_free(visited)
        let position = json_get(params, "position")
        let line = json_number_usize(json_get(position, "line"), 0_usize)
        let column = request_character_index(doc, line, json_number_usize(json_get(position, "character"), 0_usize))
        for binding in state.analysis.semantic_bindings_at(doc.uri, line, column) {
            if !starts_with(binding.name, prefix) {
                continue
            }
            let item = completion_item(binding.name, 6_usize, binding.typ)
            if encore_strset_insert(seen, binding.name) {
                items.push(item)
            } else {
                let mut index = 0_usize
                while index < items.len() {
                    if json_get_str(items.get(index).unwrap_or(Json::Null), "label", "") == binding.name {
                        items.set(index, item)
                        break
                    }
                    index += 1_usize
                }
            }
        }
    }
    encore_strset_free(seen)
    ret()
}

fn push_imported_visible_completion_items(state: mut ServerState, items: mut Vec[Json], doc: Document,
    prefix: str, types_only: bool, seen: usize,) ->() {
    for request in import_requests_from_doc(doc) {
        let original_name = last_scope_segment(request.target)
        let local_name = request.alias.unwrap_or(original_name)
        if !request.wildcard && !starts_with(local_name, prefix) {
            continue
        }
        match resolve_import_request_uri(state, doc, request) {
            Some(uri) => {
                // Only imported modules need a definition map here, not the
                // potentially huge, still-being-analyzed current document.
                let imported = document_for_path(state, uri_to_path(uri))
                let visited = encore_strset_new()
                index_navigation_module(state, imported, visited)
                encore_strset_free(visited)
                for definition in state.analysis.module_exports(imported.uri) {
                    let label = if request.wildcard {
                        definition.name()
                    } else {
                        local_name
                    }
                    if (!request.wildcard && definition.name() != original_name)
                    || !starts_with(label, prefix) || !completion_definition_allowed(definition, types_only)
                    || !encore_strset_insert(seen, label) {
                        continue
                    }
                    let original = definition_completion_item(state, definition)
                    let mut fields = Vec[(str, Json)]::new()
                    match original.as_object() {
                        Some(values) => {
                            for value in values {
                                if value.0 != "label" {
                                    fields.push(value)
                                }
                            }
                        }
                        None => {
                        }
                    }
                    fields.push(field("label", Json::String(label)))
                    items.push(Json::Object(fields))
                }
            }
            None => {
            }
        }
    }
    ret()
}

fn completion_prefix(doc: Document, params: Json) -> str {
    let position = json_get(params, "position")
    let line = json_number_usize(json_get(position, "line"), 0_usize)
    let column = request_character_index(doc, line, json_number_usize(json_get(position, "character"), 0_usize))
    for token in doc.analysis.tokens {
        if token.type == TokenType::IDENTIFIER && token.line == line && token.column <= column
        && column <= token.column + token.value.char_len() {
            ret token.value.slice(0_usize, column - token.column)
        }
    }
    ret ""
}

fn push_autoimport_items(state: mut ServerState, items: mut Vec[Json], doc: Document,
    params: Json, types_only: bool,) ->() {
    let prefix = completion_prefix(doc, params)
    if prefix == "" {
        ret()
    }
    match module_ref_for_uri(state, doc.uri) {
        Some(owner) => {
            for scope in state.autoimport_scopes {
                if scope.owner != owner.project_root {
                    continue
                }
                for candidate in state.workspace_documents {
                    if candidate.uri == doc.uri {
                        continue
                    }
                    let relative = path_relative_to(join_path(scope.root, "src"), uri_to_path(candidate.uri))
                    if relative == "" {
                        continue
                    }
                    let current = document_for_path(state, uri_to_path(candidate.uri))
                    let mut matches = current.analysis.dependencies.all().len() > 0_usize
                    for symbol in current.analysis.symbols {
                        if symbol.scope == "" && starts_with(symbol.name, prefix) {
                            matches = true break
                        }
                    }
                    if !matches {
                        continue
                    }
                    let visited = encore_strset_new()
                    index_navigation_module(state, current, visited)
                    encore_strset_free(visited)
                    for definition in state.analysis.module_exports(current.uri) {
                        if !completion_definition_allowed(definition, types_only)
                        || !starts_with(definition.name(), prefix)
                        || completion_item_exists(items, definition.name()) {
                            continue
                        }
                        let module = module_name_from_relative_path(relative)
                        let target = scope.name + "::" + if module == "" {
                            definition.name()
                        } else {
                            module + "::" + definition.name()
                        }
                        match plan_import_insertion(doc.text, target) {
                            Some(insertion) => {
                                let original = definition_completion_item(state, definition)
                                let mut fields = Vec[(str, Json)]::new()
                                match original.as_object() {
                                    Some(values) => {
                                        for value in values {
                                            if value.0 != "detail" {
                                                fields.push(value)
                                            }
                                        }
                                    }
                                    None => {
                                    }
                                }
                                let mut edits = Vec[Json]::new()
                                edits.push(text_edit(lsp_range(doc, insertion.line, insertion.column, 0_usize), insertion.text))
                                fields.push(field("additionalTextEdits", Json::Array(edits)))
                                fields.push(field("detail", Json::String("Import " + target)))
                                items.push(Json::Object(fields))
                            }
                            None => {
                            }
                        }
                    }
                }
            }
        }
        None => {
        }
    }
    ret()
}

fn member_completion_items(state: mut ServerState, doc: Document, context: MemberCompletionContext) -> Vec[Json] {
    let visited = encore_strset_new()
    index_query_module(state, doc, visited, true)
    encore_strset_free(visited)
    ret semantic_member_completion_items(state.analysis.members_at(doc.uri, context.line, context.column), context.prefix)
}

fn semantic_member_completion_items(members: Vec[SemanticMember], prefix: str) -> Vec[Json] {
    let mut items = Vec[Json]::new()
    for member in members {
        if !starts_with(member.name, prefix) || completion_item_exists(items, member.name) {
            continue
        }
        let mut detail = member.typ
        if member.is_method {
            detail = "fn " + member.name + "("
            let mut first = true
            for param in member.params {
                if !first {
                    detail += ", "
                }
                detail += param
                first = false
            }
            detail += ") -> " + member.typ
        }
        items.push(completion_item(member.name, if member.is_method {
                    2_usize
                } else {
                    5_usize
                }
                , detail,))
    }
    ret items
}

fn import_completion_items(state: mut ServerState, doc: Document, params: Json) -> Option[Vec[Json]] {
    let position = json_get(params, "position")
    let line = json_number_usize(json_get(position, "line"), 0_usize)
    let lsp_character = json_number_usize(json_get(position, "character"), 0_usize)
    let text = line_text_at(doc.text, line).unwrap_or("")
    let character = character_index_from_utf16(text, lsp_character)
    let before = text.slice(0_usize, min_usize(character, text.char_len()))
    let trimmed = trim_spaces(before)
    if trimmed == "import" && before.char_len() > 6_usize {
        ret Option[Vec[Json]]::Some(package_completion_items(state, doc, ""))
    }
    if !starts_with(trimmed, "import ") {
        ret Option[Vec[Json]]::None
    }

    let target = trim_spaces(trimmed.slice(7_usize, trimmed.char_len() - 7_usize))
    let brace = find_char(target, "{", 0_usize)
    if brace < target.char_len() {
        let mut base = trim_spaces(target.slice(0_usize, brace))
        if ends_with(base, "::") {
            base = base.slice(0_usize, base.len() - 2_usize)
        }
        let tail = target.slice(brace + 1_usize, target.char_len() - brace - 1_usize)
        let comma = last_char_index(tail, ",")
        let prefix = trim_spaces(if comma < tail.char_len() {
                tail.slice(comma + 1_usize, tail.char_len() - comma - 1_usize)
            } else {
                tail
            }
        )
        let mut items = Vec[Json]::new()
        push_import_symbol_items(state, doc, items, base, prefix)
        ret Option[Vec[Json]]::Some(items)
    }
    let trailing_scope = ends_with(target, "::")
    let parts = split_scope_path(target)
    if parts.len() == 0_usize {
        ret Option[Vec[Json]]::Some(package_completion_items(state, doc, ""))
    }
    if parts.len() == 1_usize && !trailing_scope {
        ret Option[Vec[Json]]::Some(package_completion_items(state, doc, parts.get(0_usize).unwrap_or("")))
    }
    let prefix = if trailing_scope {
        ""
    } else {
        parts.get(parts.len() - 1_usize).unwrap_or("")
    }
    let parent_count = if trailing_scope {
        parts.len()
    } else {
        parts.len() - 1_usize
    }
    let parent = join_scope_parts(parts, parent_count)
    let mut items = Vec[Json]::new()
    push_child_module_items(state, doc, items, parent, prefix)
    push_import_symbol_items(state, doc, items, parent, prefix)
    ret Option[Vec[Json]]::Some(items)
}

fn package_completion_items(state: mut ServerState, doc: Document, prefix: str) -> Vec[Json] {
    let mut items = Vec[Json]::new()
    match module_ref_for_uri(state, doc.uri) {
        Some(module) => {
            if starts_with("refrain", prefix) {
                items.push(package_completion_item(state, "refrain", module.project_root,
                        "Current Encore project",))
            }
            if starts_with("repo", prefix) {
                items.push(package_completion_item(state, "repo", module.project_root,
                        "Current Encore project",))
            }
            for dependency in path_dependency_projects(module.project_root) {
                if starts_with(dependency.name, prefix) && !completion_item_exists(items, dependency.name) {
                    items.push(package_completion_item(state, dependency.name, dependency.root, "Encore package"))
                }
            }
        }
        None => {
        }
    }
    for project in state.workspace_projects {
        if starts_with(project.name, prefix) && !completion_item_exists(items, project.name) {
            items.push(package_completion_item(state, project.name, project.root, "Encore package"))
        }
    }
    for system in system_index_roots() {
        for name in read_dir(system) {
            if starts_with(name, prefix) && file_exists(join_path(join_path(system, name), "encore.toml"))
            && !completion_item_exists(items, name) {
                items.push(package_completion_item(state, name, join_path(system, name), "Encore package"))
            }
        }
    }
    ret items
}

fn push_child_module_items(state: mut ServerState, doc: Document, items: mut Vec[Json], parent: str,
    prefix: str,) ->() {
    let parts = split_scope_path(parent)
    if parts.len() == 0_usize {
        ret()
    }
    match import_directory(state, doc, parent) {
        Some(directory) => {
            for name in read_dir(directory) {
                let mut label = name
                if ends_with(label, ".enq") {
                    label = label.slice(0_usize, label.len() - 4_usize)
                }
                if label != "mod" && label != "lib" && starts_with(label, prefix)
                &&(ends_with(name, ".enq") || file_exists(join_path(join_path(directory, name), "mod.enq")))
                && !completion_item_exists(items, label) {
                    let path = if ends_with(name, ".enq") {
                        join_path(directory, name)
                    } else {
                        join_path(join_path(directory, name), "mod.enq")
                    }
                    items.push(module_completion_item(state, label, path, parent + "::" + label))
                }
            }
        }
        None => {
        }
    }
    ret()
}

fn push_import_symbol_items(state: mut ServerState, doc: Document, items: mut Vec[Json], module_path: str,
    prefix: str,) ->() {
    match completion_module_file_for_doc(state, doc, module_path) {
        Some(path) => {
            let module_doc = document_for_path(state, path)
            push_module_export_items(state, items, module_doc, prefix)
            // A directory module may expose declarations from its sibling
            // source files. This is how imports such as
            // `frontend::parser::Documentation` are represented on disk.
            if basename_path(path) == "mod.enq" {
                let directory = parent_path(path)
                for entry in read_dir(directory) {
                    if entry != "mod.enq" && ends_with(entry, ".enq") {
                        let sibling_path = join_path(directory, entry)
                        let sibling = document_for_path(state, sibling_path)
                        push_module_export_items(state, items, sibling, prefix)
                    }
                }
            }
        }
        None => {
        }
    }
    ret()
}

fn push_module_export_items(state: mut ServerState, items: mut Vec[Json], doc: Document, prefix: str) ->() {
    let visited = encore_strset_new()
    index_navigation_module(state, doc, visited)
    encore_strset_free(visited)
    for definition in state.analysis.module_exports(doc.uri) {
        if !starts_with(definition.name(), prefix) || completion_item_exists(items, definition.name()) {
            continue
        }
        let origin = document_for_path(state, definition.source_name())
        for symbol in origin.analysis.symbols {
            if symbol.scope == "" && symbol.line == definition.line() && symbol.column == definition.column() {
                let mut exported = symbol
                exported.name = definition.name()
                if state.resolve_completion_documentation {
                    items.push(deferred_symbol_completion_item(origin, exported))
                } else {
                    items.push(symbol_completion_item(exported))
                }
                break
            }
        }
    }
    ret()
}

fn completion_module_file_for_doc(state: ServerState, doc: Document, target: str) -> Option[str] {
    let request = ImportRequest {
        "", target, Option[str]::None, false, 0_usize, 0_usize, 0_usize
    }
    match resolve_import_request_uri(state, doc, request) {
        Some(uri) => {
            ret Option[str]::Some(uri_to_path(uri))
        }
        None => {
            ret completion_module_file(state, target)
        }
    }
}

fn import_directory(state: ServerState, doc: Document, target: str) -> Option[str] {
    let parts = split_scope_path(target)
    if parts.len() == 0_usize {
        ret Option[str]::None
    }
    let first = parts.get(0_usize).unwrap_or("")
    let mut directory = ""
    let mut start = 1_usize
    if first == "refrain" || first == "repo" {
        match module_ref_for_uri(state, doc.uri) {
            Some(module) => {
                directory = module.source_dir
            }
            None => {
                ret Option[str]::None
            }
        }
    } else {
        match completion_package_root_for_doc(state, doc, first) {
            Some(root) => {
                directory = join_path(root, "src")
            }
            None => {
                ret Option[str]::None
            }
        }
    }
    while start < parts.len() {
        directory = join_path(directory, parts.get(start).unwrap_or(""))
        start += 1_usize
    }
    if file_exists(join_path(directory, ".")) {
        ret Option[str]::Some(directory)
    }
    ret Option[str]::None
}

fn completion_package_root_for_doc(state: ServerState, doc: Document, name: str) -> Option[str] {
    match module_ref_for_uri(state, doc.uri) {
        Some(module) => {
            if name == "refrain" || name == "repo" || name == module.project_name {
                ret Option[str]::Some(module.project_root)
            }
            match path_dependency_project(module.project_root, name) {
                Some(project) => {
                    ret Option[str]::Some(project.root)
                }
                None => {
                }
            }
        }
        None => {
        }
    }
    ret completion_package_root(state, name)
}

fn package_completion_item(state: mut ServerState, label: str, root: str, fallback: str) -> Json {
    let description = project_string_from_manifest(read_file(join_path(root, "encore.toml")), "description")
    if description != "" {
        ret completion_item_documented(label, 9_usize, description, description)
    }
    let lib = join_path(join_path(root, "src"), "lib.enq")
    if file_exists(lib) {
        ret module_completion_item(state, label, lib, fallback)
    }
    ret completion_item(label, 9_usize, fallback)
}

fn module_completion_item(state: mut ServerState, label: str, path: str, fallback: str) -> Json {
    let analyzed = document_for_path(state, path).analysis
    match analyzed.module_documentation {
        Some(documentation) => {
            if documentation.text != "" {
                let summary = line_text_at(documentation.text, 0_usize).unwrap_or(documentation.text)
                ret completion_item_documented(label, 9_usize, summary, documentation.text)
            }
        }
        None => {
        }
    }
    ret completion_item(label, 9_usize, fallback)
}

fn document_for_path(state: mut ServerState, path: str) -> Document {
    let uri = path_to_uri(path)
    match state.document(uri) {
        Some(doc) => {
            ret doc
        }
        None => {
        }
    }
    for cached in state.completion_documents {
        if cached.uri == uri {
            ret cached
        }
    }
    let document = Document::new(uri, read_file(path))
    state.completion_documents.push(document)
    ret document
}

fn symbol_completion_item(symbol: FrontendSymbol) -> Json {
    match symbol.documentation {
        Some(documentation) => {
            if documentation.text != "" {
                let summary = line_text_at(documentation.text, 0_usize).unwrap_or(documentation.text)
                ret completion_item_documented(symbol.name, symbol_completion_kind(symbol.kind), summary,
                    documentation.text,)
            }
        }
        None => {
        }
    }
    ret completion_item(symbol.name, symbol_completion_kind(symbol.kind), "Encore import")
}

fn deferred_symbol_completion_item(doc: Document, symbol: FrontendSymbol) -> Json {
    ret deferred_symbol_completion_with_hash(doc, symbol, Debug::fmt(doc.text.hash()))
}

fn deferred_symbol_completion_with_hash(doc: Document, symbol: FrontendSymbol, source_hash: str) -> Json {
    let mut data = Vec[(str, Json)]::new()
    data.push(field("uri", Json::String(doc.uri)))
    data.push(field("sourceHash", Json::String(source_hash)))
    data.push(field("line", json_usize(symbol.line)))
    data.push(field("column", json_usize(symbol.column)))
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("label", Json::String(symbol.name)))
    fields.push(field("kind", json_usize(symbol_completion_kind(symbol.kind))))
    fields.push(field("data", Json::Object(data)))
    ret Json::Object(fields)
}

fn resolve_completion_item(state: mut ServerState, item: Json) -> Json {
    let data = json_get(item, "data")
    let uri = json_get_str(data, "uri", "")
    if uri == "" {
        ret item
    }
    let doc = document_for_path(state, uri_to_path(uri))
    if json_get_str(data, "sourceHash", "") != Debug::fmt(doc.text.hash()) {
        ret item
    }
    for symbol in doc.analysis.symbols {
        if symbol.line != json_number_usize(json_get(data, "line"), 0_usize)
        || symbol.column != json_number_usize(json_get(data, "column"), 0_usize) {
            continue
        }
        match symbol.documentation {
            Some(documentation) => {
                let mut fields = Vec[(str, Json)]::new()
                match item.as_object() {
                    Some(original) => {
                        for entry in original {
                            if entry.0 != "documentation" {
                                fields.push(entry)
                            }
                        }
                    }
                    None => {
                        ret item
                    }
                }
                let mut markup = Vec[(str, Json)]::new()
                markup.push(field("kind", Json::String("markdown")))
                markup.push(field("value", Json::String(documentation.text)))
                fields.push(field("documentation", Json::Object(markup)))
                ret Json::Object(fields)
            }
            None => {
                ret item
            }
        }
    }
    ret item
}

fn completion_module_file(state: ServerState, target: str) -> Option[str] {
    let parts = split_scope_path(target)
    if parts.len() == 0_usize {
        ret Option[str]::None
    }
    match completion_package_root(state, parts.get(0_usize).unwrap_or("")) {
        Some(root) => {
            let mut base = join_path(root, "src")
            let mut index = 1_usize
            while index < parts.len() {
                base = join_path(base, parts.get(index).unwrap_or(""))
                index += 1_usize
            }
            if parts.len() == 1_usize {
                let lib = join_path(base, "lib.enq")
                if file_exists(lib) {
                    ret Option[str]::Some(lib)
                }
            }
            let direct = base + ".enq"
            if file_exists(direct) {
                ret Option[str]::Some(direct)
            }
            let module = join_path(base, "mod.enq")
            if file_exists(module) {
                ret Option[str]::Some(module)
            }
        }
        None => {
        }
    }
    ret Option[str]::None
}

fn completion_package_root(state: ServerState, name: str) -> Option[str] {
    match workspace_project_by_name(state, name) {
        Some(project) => {
            ret Option[str]::Some(project.root)
        }
        None => {
        }
    }
    for system in system_index_roots() {
        let root = join_path(system, name)
        if file_exists(join_path(root, "encore.toml")) {
            ret Option[str]::Some(root)
        }
    }
    ret Option[str]::None
}

fn system_index_roots() -> Vec[str] {
    let mut roots = Vec[str]::new()
    let configured = unsafe {
        encore_os_getenv("ENCORE_HOME")
    }
    if configured != "" {
        roots.push(join_path(join_path(configured, "lib"), "encore/index"))
    }
    let home = home_directory()
    if home != "" {
        let standard = join_path(join_path(join_path(home, ".encore"), "lib"), "encore/index")
        if !contains_string(roots, standard) {
            roots.push(standard)
        }
    }
    let executable = unsafe {
        encore_os_executable_path()
    }
    let install_root = parent_path(parent_path(executable))
    if install_root != "" {
        let adjacent = join_path(join_path(install_root, "lib"), "encore/index")
        if !contains_string(roots, adjacent) {
            roots.push(adjacent)
        }
    }
    ret roots
}

fn contains_string(values: Vec[str], needle: str) -> bool {
    for value in values {
        if value == needle {
            ret true
        }
    }
    ret false
}

fn join_scope_parts(parts: Vec[str], count: usize) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < count {
        if index > 0_usize {
            out += "::"
        }
        out += parts.get(index).unwrap_or("")
        index += 1_usize
    }
    ret out
}

fn last_char_index(value: str, needle: str) -> usize {
    let mut index = value.char_len()
    while index > 0_usize {
        index -= 1_usize
        if value.get(index).unwrap_or("") == needle {
            ret index
        }
    }
    ret value.char_len()
}

fn completion_trigger_characters() -> Json {
    let mut values = Vec[Json]::new()
    let letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let mut index = 0_usize
    while index < letters.char_len() {
        values.push(Json::String(letters.get(index).unwrap_or("")))
        index += 1_usize
    }
    values.push(Json::String("_"))
    values.push(Json::String(":"))
    values.push(Json::String("."))
    ret Json::Array(values)
}

fn inlay_hint_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            let range = json_get(params, "range")
            let start_line = json_number_usize(json_get(json_get(range, "start"), "line"), 0_usize)
            let end_line = json_number_usize(json_get(json_get(range, "end"), "line"), document_last_line(doc.text) + 1_usize)
            let start_column = json_number_usize(json_get(json_get(range, "start"), "character"), 0_usize)
            let end_column = json_number_usize(json_get(json_get(range, "end"), "character"), 0_usize)
            ret inferred_let_hints(state, doc, start_line, start_column, end_line, end_column)
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn inferred_let_hints(state: mut ServerState, doc: Document, start_line: usize, start_column: usize,
    end_line: usize, end_column: usize,) -> Json {
    let mut hints = Vec[Json]::new()
    let mut indexed = false
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Some(token) => {
                if token.type == TokenType::KW_LET {
                    let mut name_index = index + 1_usize
                    if token_has_type(doc, name_index, TokenType::KW_MUT) {
                        name_index += 1_usize
                    }
                    match doc.analysis.tokens.get(name_index) {
                        Some(name) => {
                            if name.type == TokenType::IDENTIFIER && name.line >= start_line
                            && name.line <= end_line && token_has_type(doc, name_index + 1_usize, TokenType::ASSIGN) {
                                let column = utf16_column(line_text_at(doc.text, name.line).unwrap_or(""),
                                    actual_token_column_at_index(doc, name_index, name),) + utf16_len(name.value)
                                if (name.line == start_line && column < start_column)
                                ||(name.line == end_line && column >= end_column) {
                                    index += 1_usize
                                    continue
                                }
                                if !indexed {
                                    let visited = encore_strset_new()
                                    index_query_module(state, doc, visited, true)
                                    encore_strset_free(visited)
                                    indexed = true
                                }
                                // The same recovered body and declaration identity serve
                                // hover, navigation, rename and inferred type hints.
                                match state.analysis.semantic_binding_at(doc.uri, name.value, name.line, name.column) {
                                    Some(binding) => {
                                        if binding.name == name.value && binding.line == name.line
                                        && binding.column == name.column && binding.typ != "" {
                                            hints.push(type_inlay_hint(doc, name_index, name, binding.typ))
                                        }
                                    }
                                    None => {
                                    }
                                }
                            }
                        }
                        None => {
                        }
                    }
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    ret Json::Array(hints)
}

fn type_inlay_hint(doc: Document, token_index: usize, token: Token, typ: str) -> Json {
    let column = actual_token_column_at_index(doc, token_index, token)
    let mut position = Vec[(str, Json)]::new()
    position.push(field("line", json_usize(token.line)))
    position.push(field("character", json_usize(utf16_column(line_text_at(doc.text, token.line).unwrap_or(""),
                    column,) + utf16_len(token.value))))
    let mut hint = Vec[(str, Json)]::new()
    hint.push(field("position", Json::Object(position)))
    hint.push(field("label", Json::String(": " + typ)))
    hint.push(field("kind", json_usize(1_usize)))
    hint.push(field("paddingLeft", Json::Bool(false)))
    hint.push(field("paddingRight", Json::Bool(false)))
    ret Json::Object(hint)
}

fn completion_item_exists(items: Vec[Json], label: str) -> bool {
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[Json]::Some(item) => {
                if json_get_str(item, "label", "") == label {
                    ret true
                }
            }
            Option[Json]::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn definition_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match identifier_at_request(doc, params) {
                Option[Token]::Some(token) => {
                    match resolved_symbol_at(state, doc, token) {
                        Option[ResolvedReference]::Some(reference) => {
                            let mut items = Vec[Json]::new()
                            items.push(location_json(reference.uri, reference.range))
                            ret Json::Array(items)
                        }
                        Option[ResolvedReference]::None => {
                        }
                    }
                }
                Option[Token]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn implementation_result(state: ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match identifier_at_request(doc, params) {
                Option[Token]::Some(token) => {
                    ret Json::Array(implementation_locations(state, token.value))
                }
                Option[Token]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn implementation_locations(state: ServerState, name: str) -> Vec[Json] {
    let mut items = Vec[Json]::new()
    let impl_name = "impl " + name

    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                push_implementation_locations_for_doc(items, doc, impl_name)
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }

    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    push_implementation_locations_for_doc(items, doc, impl_name)
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret items
}

fn push_implementation_locations_for_doc(items: mut Vec[Json], doc: Document, impl_name: str) ->() {
    let mut index = 0_usize
    while index < doc.analysis.symbols.len() {
        match doc.analysis.symbols.get(index) {
            Option[FrontendSymbol]::Some(symbol) => {
                if symbol.name == impl_name {
                    items.push(location_json(doc.uri, symbol_range(doc, symbol)))
                }
            }
            Option[FrontendSymbol]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn hover_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match identifier_at_request(doc, params) {
                Option[Token]::Some(token) => {
                    let mut value = token.value
                    match import_module_hover(state, doc, token) {
                        Option[str]::Some(module_hover) => {
                            value = module_hover
                        }
                        Option[str]::None => {
                            match import_package_hover(state, doc, token.value, token.line) {
                                Option[str]::Some(package_hover) => {
                                    value = package_hover
                                }
                                Option[str]::None => {
                                    match resolved_symbol_at(state, doc, token) {
                                        Option[ResolvedReference]::Some(reference) => {
                                            value = reference.hover
                                        }
                                        Option[ResolvedReference]::None => {
                                        }
                                    }
                                }
                            }
                        }
                    }

                    let mut contents = Vec[(str, Json)]::new()
                    contents.push(field("kind", Json::String("markdown")))
                    contents.push(field("value", Json::String(value)))

                    let mut result = Vec[(str, Json)]::new()
                    result.push(field("contents", Json::Object(contents)))
                    result.push(field("range", token_range(doc, token)))
                    ret Json::Object(result)
                }
                Option[Token]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Null
}

fn import_module_hover(state: mut ServerState, doc: Document, token: Token) -> Option[str] {
    let line = line_text_at(doc.text, token.line).unwrap_or("")
    let import_start = find_substring(line, "import ")
    if import_start >= line.char_len() {
        ret Option[str]::None
    }
    let target_start = import_start + 7_usize
    let token_end = actual_token_column(doc, token) + token.value.char_len()
    if token_end <= target_start || token_end > line.char_len() {
        ret Option[str]::None
    }
    let target = line.slice(target_start, token_end - target_start)
    if contains_substring(target, "{") || contains_substring(target, " ") {
        ret Option[str]::None
    }
    let parts = split_scope_path(target)
    if parts.len() == 1_usize && target != "refrain" && target != "repo" {
        ret Option[str]::None
    }
    match completion_module_file_for_doc(state, doc, target) {
        Some(path) => {
            let analyzed = document_for_path(state, path).analysis
            let mut hover = "### `" + target + "`"
            match analyzed.module_documentation {
                Some(documentation) => {
                    if documentation.text != "" {
                        hover += "\n\n" + documentation.text
                    }
                }
                None => {
                }
            }
            ret Option[str]::Some(hover)
        }
        None => {
        }
    }
    ret Option[str]::None
}

fn import_package_hover(state: ServerState, doc: Document, package: str, line_number: usize) -> Option[str] {
    let line = trim_spaces(line_text_at(doc.text, line_number).unwrap_or(""))
    if !starts_with(line, "import " + package) {
        ret Option[str]::None
    }
    match completion_package_root(state, package) {
        Some(root) => {
            let manifest = read_file(join_path(root, "encore.toml"))
            let version = project_string_from_manifest(manifest, "version")
            let description = project_string_from_manifest(manifest, "description")
            let mut hover = "### `" + package + "`\n\nEncore package"
            if version != "" {
                hover += " · version `" + version + "`"
            }
            if description != "" {
                hover += "\n\n" + description
            }
            ret Option[str]::Some(hover)
        }
        None => {
        }
    }
    ret Option[str]::None
}

fn signature_help_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            let position = json_get(params, "position")
            let line = json_number_usize(json_get(position, "line"), 0_usize)
            let column = request_character_index(doc, line, json_number_usize(json_get(position, "character"), 0_usize))
            match cursor_call_context(doc.analysis.tokens, line, column) {
                Some(call) => {
                    match resolved_symbol_at(state, doc, call.0) {
                        Option[ResolvedReference]::Some(reference) => {
                            match reference.callable {
                                Option[FrontendCallable]::Some(callable) => {
                                    ret signature_help_for_callable(callable, call.1)
                                }
                                Option[FrontendCallable]::None => {
                                }
                            }
                        }
                        Option[ResolvedReference]::None => {
                        }
                    }
                }
                None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret empty_signature_help()
}

fn signature_help_for_callable(callable: FrontendCallable, active_parameter: usize) -> Json {
    let signature = signature_json(callable)
    let mut signatures = Vec[Json]::new()
    signatures.push(signature)

    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("signatures", Json::Array(signatures)))
    fields.push(field("activeSignature", Json::Number("0")))
    let last_parameter = if callable.params.len() > 0_usize {
        callable.params.len() - 1_usize
    } else {
        0_usize
    }
    fields.push(field("activeParameter", json_usize(min_usize(active_parameter, last_parameter))))
    ret Json::Object(fields)
}

fn signature_json(callable: FrontendCallable) -> Json {
    let mut parameters = Vec[Json]::new()
    let mut label = callable.name + "("
    let mut index = 0_usize
    while index < callable.params.len() {
        match callable.params.get(index) {
            Option[str]::Some(param) => {
                if index > 0_usize {
                    label += ", "
                }
                label += param
                parameters.push(parameter_json(param))
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    label += ")"
    match callable.ret_type {
        Option[str]::Some(ret_type) => {
            label += " -> " + ret_type
        }
        Option[str]::None => {
        }
    }

    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("label", Json::String(label)))
    fields.push(field("parameters", Json::Array(parameters)))
    ret Json::Object(fields)
}

fn parameter_json(label: str) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("label", Json::String(label)))
    ret Json::Object(fields)
}

fn empty_signature_help() -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("signatures", Json::Array(Vec[Json]::new())))
    fields.push(field("activeSignature", Json::Number("0")))
    fields.push(field("activeParameter", Json::Number("0")))
    ret Json::Object(fields)
}

fn prepare_call_hierarchy_result(state: ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match callable_at_request(doc, params) {
                Option[FrontendCallable]::Some(callable) => {
                    let mut items = Vec[Json]::new()
                    items.push(call_hierarchy_item(doc, callable))
                    ret Json::Array(items)
                }
                Option[FrontendCallable]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn outgoing_calls_result(state: ServerState, params: Json) -> Json {
    let item = json_get(params, "item")
    let uri = call_hierarchy_item_uri(item)
    let name = call_hierarchy_item_name(item)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match callable_by_name(doc, name) {
                Option[FrontendCallable]::Some(callable) => {
                    ret Json::Array(outgoing_calls_for_callable(state, doc, callable))
                }
                Option[FrontendCallable]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn incoming_calls_result(state: ServerState, params: Json) -> Json {
    let item = json_get(params, "item")
    let target = call_hierarchy_item_name(item)
    if target == "" {
        ret Json::Array(Vec[Json]::new())
    }
    ret Json::Array(incoming_calls_for_name(state, target))
}

fn outgoing_calls_for_callable(state: ServerState, doc: Document, callable: FrontendCallable) -> Vec[Json]
{
    let mut items = Vec[Json]::new()
    let start = callable_body_start_index(doc, callable)
    let end = callable_body_end_index(doc, start)
    let mut index = start
    while index < end {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER && token_is_call_expression(doc, index) {
                    match callable_doc_by_name(state, token.value) {
                        Option[(Document, FrontendCallable)]::Some(target) => {
                            if !call_hierarchy_call_exists(items, token.value) {
                                items.push(outgoing_call_item(target.0, target.1, token_range(doc, token)))
                            }
                        }
                        Option[(Document, FrontendCallable)]::None => {
                        }
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret items
}

fn incoming_calls_for_name(state: ServerState, target: str) -> Vec[Json] {
    let mut items = Vec[Json]::new()
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                push_incoming_calls_for_doc(items, doc, target)
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }
    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    push_incoming_calls_for_doc(items, doc, target)
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret items
}

fn push_incoming_calls_for_doc(items: mut Vec[Json], doc: Document, target: str) ->() {
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER && token.value == target && token_is_call_expression(doc,
                    index,) {
                    match enclosing_callable(doc, token.line) {
                        Option[FrontendCallable]::Some(caller) => {
                            let call_range = token_range(doc, token)
                            let existing = incoming_call_index(items, caller.name)
                            match existing {
                                Option[usize]::Some(item_index) => {
                                    append_from_range(items, item_index, call_range)
                                }
                                Option[usize]::None => {
                                    items.push(incoming_call_item(doc, caller, call_range))
                                }
                            }
                        }
                        Option[FrontendCallable]::None => {
                        }
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn call_hierarchy_item(doc: Document, callable: FrontendCallable) -> Json {
    let range = callable_range(doc, callable)
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("name", Json::String(callable.name)))
    fields.push(field("kind", Json::Number("12")))
    fields.push(field("uri", Json::String(doc.uri)))
    fields.push(field("range", range))
    fields.push(field("selectionRange", range))
    fields.push(field("data", call_hierarchy_data(doc.uri, callable.name, callable.line, callable.column)))
    ret Json::Object(fields)
}

fn call_hierarchy_data(uri: str, name: str, line: usize, character: usize) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("uri", Json::String(uri)))
    fields.push(field("name", Json::String(name)))
    fields.push(field("line", json_usize(line)))
    fields.push(field("character", json_usize(character)))
    ret Json::Object(fields)
}

fn outgoing_call_item(doc: Document, callable: FrontendCallable, from_range: Json) -> Json {
    let mut ranges = Vec[Json]::new()
    ranges.push(from_range)
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("to", call_hierarchy_item(doc, callable)))
    fields.push(field("fromRanges", Json::Array(ranges)))
    ret Json::Object(fields)
}

fn incoming_call_item(doc: Document, callable: FrontendCallable, from_range: Json) -> Json {
    let mut ranges = Vec[Json]::new()
    ranges.push(from_range)
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("from", call_hierarchy_item(doc, callable)))
    fields.push(field("fromRanges", Json::Array(ranges)))
    ret Json::Object(fields)
}

fn append_from_range(items: mut Vec[Json], item_index: usize, call_range: Json) ->() {
    match items.get(item_index) {
        Option[Json]::Some(item) => {
            let mut ranges = Vec[Json]::new()
            match json_get(item, "fromRanges").as_array() {
                Option[Vec[Json]]::Some(existing_ranges) => {
                    let mut index = 0_usize
                    while index < existing_ranges.len() {
                        match existing_ranges.get(index) {
                            Option[Json]::Some(existing_range) => {
                                ranges.push(existing_range)
                            }
                            Option[Json]::None => {
                            }
                        }
                        index += 1_usize
                    }
                }
                Option[Vec[Json]]::None => {
                }
            }
            ranges.push(call_range)
            let mut fields = Vec[(str, Json)]::new()
            fields.push(field("from", json_get(item, "from")))
            fields.push(field("fromRanges", Json::Array(ranges)))
            items.set(item_index, Json::Object(fields))
        }
        Option[Json]::None => {
        }
    }
    ret()
}

fn call_hierarchy_item_uri(item: Json) -> str {
    let data_uri = json_get_str(json_get(item, "data"), "uri", "")
    if data_uri != "" {
        ret data_uri
    }
    ret json_get_str(item, "uri", "")
}

fn call_hierarchy_item_name(item: Json) -> str {
    let data_name = json_get_str(json_get(item, "data"), "name", "")
    if data_name != "" {
        ret data_name
    }
    ret json_get_str(item, "name", "")
}

fn callable_at_request(doc: Document, params: Json) -> Option[FrontendCallable] {
    match identifier_at_request(doc, params) {
        Option[Token]::Some(token) => {
            ret callable_at_position(doc, token.line, actual_token_column(doc, token))
        }
        Option[Token]::None => {
        }
    }
    ret Option[FrontendCallable]::None
}

fn callable_at_position(doc: Document, line: usize, character: usize) -> Option[FrontendCallable] {
    let mut index = 0_usize
    while index < doc.analysis.callables.len() {
        match doc.analysis.callables.get(index) {
            Option[FrontendCallable]::Some(callable) => {
                if callable.line == line && callable.column <= character && character <= callable.column
                + callable.length {
                    ret Option[FrontendCallable]::Some(callable)
                }
            }
            Option[FrontendCallable]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[FrontendCallable]::None
}

fn callable_doc_by_name(state: ServerState, name: str) -> Option[(Document, FrontendCallable)] {
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                match callable_by_name(doc, name) {
                    Option[FrontendCallable]::Some(callable) => {
                        ret Option[(Document, FrontendCallable)]::Some((doc, callable))
                    }
                    Option[FrontendCallable]::None => {
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }
    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    match callable_by_name(doc, name) {
                        Option[FrontendCallable]::Some(callable) => {
                            ret Option[(Document, FrontendCallable)]::Some((doc, callable))
                        }
                        Option[FrontendCallable]::None => {
                        }
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret Option[(Document, FrontendCallable)]::None
}

fn callable_body_start_index(doc: Document, callable: FrontendCallable) -> usize {
    let mut index = 0_usize
    let mut seen_name = false
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.line == callable.line && token.type == TokenType::IDENTIFIER && token.value
                == callable.name {
                    seen_name = true
                } elif seen_name && token.type == TokenType::LEFT_BRACE {
                    ret index + 1_usize
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret doc.analysis.tokens.len()
}

fn callable_body_end_index(doc: Document, start: usize) -> usize {
    let mut depth = 1_i32
    let mut index = start
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::LEFT_BRACE {
                    depth += 1_i32
                } elif token.type == TokenType::RIGHT_BRACE {
                    depth -= 1_i32
                    if depth == 0_i32 {
                        ret index
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret doc.analysis.tokens.len()
}

fn enclosing_callable(doc: Document, line: usize) -> Option[FrontendCallable] {
    let mut best = Option[FrontendCallable]::None
    let mut index = 0_usize
    while index < doc.analysis.callables.len() {
        match doc.analysis.callables.get(index) {
            Option[FrontendCallable]::Some(callable) => {
                if callable.line <= line {
                    match best {
                        Option[FrontendCallable]::Some(existing) => {
                            if callable.line > existing.line {
                                best = Option[FrontendCallable]::Some(callable)
                            }
                        }
                        Option[FrontendCallable]::None => {
                            best = Option[FrontendCallable]::Some(callable)
                        }
                    }
                }
            }
            Option[FrontendCallable]::None => {
            }
        }
        index += 1_usize
    }
    ret best
}

fn callable_range(doc: Document, callable: FrontendCallable) -> Json {
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER && token.line == callable.line && token.value
                == callable.name {
                    ret token_range(doc, token)
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret lsp_range(doc, callable.line, callable.column, callable.length)
}

fn call_hierarchy_call_exists(items: Vec[Json], name: str) -> bool {
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[Json]::Some(item) => {
                if json_get_str(json_get(item, "to"), "name", "") == name {
                    ret true
                }
            }
            Option[Json]::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn token_is_call_expression(doc: Document, token_index: usize) -> bool {
    if !token_is_call(doc, token_index) {
        ret false
    }
    if token_index > 0_usize {
        match doc.analysis.tokens.get(token_index - 1_usize) {
            Option[Token]::Some(previous) => {
                if previous.type == TokenType::KW_FN {
                    ret false
                }
            }
            Option[Token]::None => {
            }
        }
    }
    ret true
}

fn incoming_call_index(items: Vec[Json], name: str) -> Option[usize] {
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[Json]::Some(item) => {
                if json_get_str(json_get(item, "from"), "name", "") == name {
                    ret Option[usize]::Some(index)
                }
            }
            Option[Json]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[usize]::None
}

fn references_with_declaration_policy(locations: Vec[Json], reference: ResolvedReference, params: Json) -> Json {
    if json_get(json_get(params, "context"), "includeDeclaration").as_bool().unwrap_or(false) {
        ret Json::Array(locations)
    }
    let declaration = json_get(reference.range, "start")
    let mut uses = Vec[Json]::new()
    for location in locations {
        let start = json_get(json_get(location, "range"), "start")
        if json_get_str(location, "uri", "") == reference.uri
        && json_number_usize(json_get(start, "line"), 0_usize) == json_number_usize(json_get(declaration, "line"), 0_usize)
        && json_number_usize(json_get(start, "character"), 0_usize) == json_number_usize(json_get(declaration, "character"), 0_usize) {
            continue
        }
        uses.push(location)
    }
    ret Json::Array(uses)
}

fn references_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match identifier_at_request(doc, params) {
                Option[Token]::Some(token) => {
                    if token_is_extern_function_declaration(doc, token) {
                        ret Json::Array(Vec[Json]::new())
                    }
                    match resolved_symbol_at(state, doc, token) {
                        Option[ResolvedReference]::Some(reference) => {
                            if resolved_reference_is_extern_function(state, reference) {
                                ret Json::Array(Vec[Json]::new())
                            }
                            if starts_with(reference.id, doc.uri + "#local:") {
                                let mut locations = Vec[Json]::new()
                                push_reference_locations_for_doc(state, locations, doc, reference.id, reference.label)
                                ret references_with_declaration_policy(locations, reference, params)
                            }
                            ret references_with_declaration_policy(reference_locations_in_workspace(state, reference.id, reference.label), reference, params)
                        }
                        Option[ResolvedReference]::None => {
                        }
                    }
                }
                Option[Token]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn token_is_extern_function_declaration(doc: Document, target: Token) -> bool {
    let mut seen_extern = false
    let mut seen_fn = false
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.line == target.line {
                    if token.type == TokenType::KW_EXTERN {
                        seen_extern = true
                    } elif seen_extern && token.type == TokenType::KW_FN {
                        seen_fn = true
                    } elif seen_fn && token.type == TokenType::IDENTIFIER {
                        ret token.value == target.value
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn resolved_reference_is_extern_function(state: ServerState, reference: ResolvedReference) -> bool {
    match state.document(reference.uri) {
        Option[Document]::Some(doc) => {
            let mut index = 0_usize
            while index < doc.analysis.tokens.len() {
                match doc.analysis.tokens.get(index) {
                    Option[Token]::Some(token) => {
                        if token.type == TokenType::IDENTIFIER && token.value == reference.label && token_is_extern_function_declaration(doc,
                            token,) {
                            ret true
                        }
                    }
                    Option[Token]::None => {
                    }
                }
                index += 1_usize
            }
        }
        Option[Document]::None => {
        }
    }
    ret false
}

fn document_highlight_result(state: mut ServerState, params: Json) -> Json {
    let mut highlights = Vec[Json]::new()
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match identifier_at_request(doc, params) {
                Option[Token]::Some(token) => {
                    let mut refs = Vec[Json]::new()
                    match resolved_symbol_at(state, doc, token) {
                        Some(reference) => {
                            push_reference_locations_for_doc(state, refs, doc, reference.id, reference.label)
                        }
                        None => {
                            ret Json::Array(highlights)
                        }
                    }
                    let mut index = 0_usize
                    while index < refs.len() {
                        match refs.get(index) {
                            Option[Json]::Some(location) => {
                                let mut item = Vec[(str, Json)]::new()
                                item.push(field("range", json_get(location, "range")))
                                item.push(field("kind", Json::Number("1")))
                                highlights.push(Json::Object(item))
                            }
                            Option[Json]::None => {
                            }
                        }
                        index += 1_usize
                    }
                }
                Option[Token]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(highlights)
}

fn push_identifier_locations_for_workspace(state: ServerState, items: mut Vec[Json], name: str) ->()
{
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                push_identifier_locations_for_doc(items, doc, name)
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }
    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    push_identifier_locations_for_doc(items, doc, name)
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret()
}

fn identifier_locations_for_doc(doc: Document, name: str) -> Vec[Json] {
    let mut items = Vec[Json]::new()
    push_identifier_locations_for_doc(items, doc, name)
    ret items
}

fn reference_locations_in_workspace(state: mut ServerState, target_id: str, name: str) -> Vec[Json] {
    let mut items = Vec[Json]::new()
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                push_reference_locations_for_doc(state, items, doc, target_id, name)
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }
    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    push_reference_locations_for_doc(state, items, doc, target_id, name)
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret items
}

fn push_reference_locations_for_doc(state: mut ServerState, items: mut Vec[Json], doc: Document, target_id:
    str, name: str,) ->() {
    let visited = encore_strset_new()
    index_query_module(state, doc, visited, true)
    encore_strset_free(visited)
    let exact_name = starts_with(target_id, "member:") || starts_with(target_id, doc.uri + "#local:")
    let names = if exact_name {
        Vec[str]::new()
    } else {
        reference_candidate_names(doc, name)
    }
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(candidate) => {
                if candidate.type == TokenType::IDENTIFIER &&
                ((exact_name && candidate.value == name) ||(!exact_name && reference_candidate_token(doc, index, candidate, names))) {
                    if !reference_candidate_matches_kind(state, doc, index, candidate, target_id) {
                        index += 1_usize continue
                    }
                    match reference_identity_in_index(state, doc, candidate, target_id) {
                        Option[str]::Some(identity) => {
                            if identity == target_id {
                                items.push(location_json(doc.uri, token_range_at_index(doc, index, candidate)))
                            }
                        }
                        Option[str]::None => {
                        }
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn push_identifier_locations_for_doc(items: mut Vec[Json], doc: Document, name: str) ->() {
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(candidate) => {
                if candidate.type == TokenType::IDENTIFIER && candidate.value == name {
                    items.push(location_json(doc.uri, token_range(doc, candidate)))
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn prepare_rename_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match identifier_at_request(doc, params) {
                Option[Token]::Some(token) => {
                    if token.value == "self" {
                        ret Json::Null
                    }
                    match resolved_symbol_at(state, doc, token) {
                        Some(reference) => {
                            // Member navigation is available before owner collision
                            // and trait-implementation rename checks are complete.
                            if starts_with(reference.id, "member:") {
                                ret Json::Null
                            }
                        }
                        None => {
                            ret Json::Null
                        }
                    }
                    let mut fields = Vec[(str, Json)]::new()
                    fields.push(field("range", token_range(doc, token)))
                    fields.push(field("placeholder", Json::String(token.value)))
                    ret Json::Object(fields)
                }
                Option[Token]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Null
}

fn rename_result(state: mut ServerState, params: Json) -> Result[Json, str] {
    let uri = request_uri(params)
    let new_name = json_get_str(params, "newName", "")
    let mut lexer = Lexer::new()
    let name_tokens = lexer.tokenize(new_name)
    let name_token = name_tokens.get(0_usize).unwrap_or(Token::new(TokenType::EOF, "", 0_usize, 0_usize))
    if !is_identifier_name(new_name) || name_tokens.len() != 2_usize
    || name_token.type != TokenType::IDENTIFIER || new_name == "self" || new_name == "Self" {
        ret Result[Json, str]::Ok(empty_workspace_edit())
    }

    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match identifier_at_request(doc, params) {
                Option[Token]::Some(token) => {
                    if token.value == "self" {
                        ret Result[Json, str]::Ok(empty_workspace_edit())
                    }
                    match resolved_symbol_at(state, doc, token) {
                        Option[ResolvedReference]::Some(reference) => {
                            let mut changes = Vec[(str, Json)]::new()
                            if starts_with(reference.id, "member:") {
                                ret Result[Json, str]::Err("Member rename requires owner collision and trait implementation checks; no files were changed.")
                            }
                            if starts_with(reference.id, doc.uri + "#local:") {
                                if !local_rename_is_safe(state, doc, token, reference.label, new_name) {
                                    ret Result[Json, str]::Err("Cannot rename '" + reference.label + "' to '" + new_name
                                        + "': the new name would change which declaration an existing reference resolves to.")
                                }
                                push_rename_edits_for_reference_doc(state, changes, doc, reference.id, reference.label, new_name)
                            } else {
                                push_rename_edits_for_reference(state, changes, reference.rename_id, token.value, new_name)
                            }

                            ret Result[Json, str]::Ok(rename_workspace_edit(state, changes))
                        }
                        Option[ResolvedReference]::None => {
                        }
                    }
                }
                Option[Token]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Result[Json, str]::Ok(empty_workspace_edit())
}

fn local_rename_is_safe(state: mut ServerState, doc: Document, selected: Token,
    old_name: str, new_name: str,) -> bool {
    match state.analysis.semantic_binding_at(doc.uri, old_name, selected.line, selected.column) {
        Some(binding) => {
            for token in doc.analysis.tokens {
                if token.type != TokenType::IDENTIFIER ||(token.value != old_name && token.value != new_name) {
                    continue
                }
                if split_scope_path(cursor_symbol_path(doc.analysis.tokens, token.line, token.column)).len() > 1_usize
                || cursor_expects_type(doc.analysis.tokens, token.line, token.column)
                || cursor_member_context(doc.analysis.tokens, token.line, token.column + token.value.char_len()).is_some() {
                    continue
                }
                if !state.analysis.local_rename_preserves_binding(doc.uri, token.value,
                    token.line, token.column, binding.line, binding.column, new_name,) {
                    ret false
                }
            }
            ret true
        }
        None => {
            ret false
        }
    }
}

fn rename_workspace_edit(state: ServerState, changes: Vec[(str, Json)]) -> Json {
    let mut result = Vec[(str, Json)]::new()
    if !state.supports_document_changes {
        result.push(field("changes", Json::Object(changes)))
        ret Json::Object(result)
    }
    let mut documents = Vec[Json]::new()
    for entry in changes {
        let uri = entry.0
        let edits = entry.1
        let mut document = Vec[(str, Json)]::new()
        document.push(field("uri", Json::String(uri)))
        // Closed files have no client-owned version, even if previously open.
        let version = if open_document_exists(state, uri) {
            client_document_version(state, uri)
        } else {
            Json::Null
        }
        document.push(field("version", version))
        let mut change = Vec[(str, Json)]::new()
        change.push(field("textDocument", Json::Object(document)))
        change.push(field("edits", edits))
        documents.push(Json::Object(change))
    }
    result.push(field("documentChanges", Json::Array(documents)))
    ret Json::Object(result)
}

fn push_rename_edits_for_workspace(state: ServerState, changes: mut Vec[(str, Json)], old_name: str,
    new_name: str,) ->() {
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                push_rename_edits_for_doc(changes, doc, old_name, new_name)
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }
    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    push_rename_edits_for_doc(changes, doc, old_name, new_name)
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret()
}

fn push_rename_edits_for_reference(state: mut ServerState, changes: mut Vec[(str, Json)], target_id: str,
    old_name: str, new_name: str,) ->() {
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                push_rename_edits_for_reference_doc(state, changes, doc, target_id, old_name, new_name)
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }
    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    push_rename_edits_for_reference_doc(state, changes, doc, target_id, old_name, new_name)
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret()
}

fn push_rename_edits_for_reference_doc(state: mut ServerState, changes: mut Vec[(str, Json)], doc: Document,
    target_id: str, old_name: str, new_name: str,) ->() {
    let visited = encore_strset_new()
    index_query_module(state, doc, visited, true)
    encore_strset_free(visited)
    let exact_name = starts_with(target_id, "member:") || starts_with(target_id, doc.uri + "#local:")
    let names = if exact_name {
        Vec[str]::new()
    } else {
        reference_candidate_names(doc, old_name)
    }
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(candidate) => {
                if candidate.type == TokenType::IDENTIFIER &&
                ((exact_name && candidate.value == old_name) ||(!exact_name && reference_candidate_token(doc, index, candidate, names))) {
                    if !reference_candidate_matches_kind(state, doc, index, candidate, target_id) {
                        index += 1_usize continue
                    }
                    match resolved_symbol_in_index(state, doc, candidate) {
                        Option[ResolvedReference]::Some(reference) => {
                            if reference.rename_id == target_id {
                                add_text_edit_to_changes(changes, doc.uri, text_edit(token_range_at_index(doc,
                                            index, candidate,), new_name))
                            }
                        }
                        Option[ResolvedReference]::None => {
                        }
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

// Reference searches need identity, not hover text, documentation or call tips.
fn reference_identity_in_index(state: mut ServerState, doc: Document, token: Token, target: str) -> Option[str] {
    if starts_with(target, "member:") {
        let owner = associated_query_owner(state, doc, cursor_associated_owner(doc.analysis.tokens, token.line, token.column))
        if owner != "" {
            match state.analysis.associated_owner_type(doc.uri, owner) {
                Some(receiver) => {
                    match state.analysis.associated_member_definition(doc.uri, owner, token.value) {
                        Some(definition) => {
                            ret Option[str]::Some("member:" + definition.source_identity().key())
                        }
                        None => {
                            ret Option[str]::None
                        }
                    }
                }
                None => {
                }
            }
        }
        let definition = if cursor_member_context(doc.analysis.tokens, token.line, token.column + token.value.char_len()).is_some() {
            state.analysis.member_definition_at(doc.uri, token.value, token.line, token.column)
        } else {
            state.analysis.member_declaration_at(doc.uri, token.value, token.line, token.column)
        }
        match definition {
            Some(value) => {
                ret Option[str]::Some("member:" + value.source_identity().key())
            }
            None => {
                ret Option[str]::None
            }
        }
    }
    match resolved_symbol_in_index(state, doc, token) {
        Some(reference) => {
            ret Option[str]::Some(reference.id)
        }
        None => {
            ret Option[str]::None
        }
    }
}

fn reference_candidate_matches_kind(state: mut ServerState, doc: Document, index: usize, token: Token, target: str) -> bool {
    if starts_with(target, "member:") {
        if index > 0_usize {
            let previous = doc.analysis.tokens.get(index - 1_usize).unwrap_or(token)
            if previous.type == TokenType::DOT || previous.type == TokenType::SCOPE {
                ret true
            }
        }
        // A local parameter named `tokens` cannot refer to a field named
        // `tokens`. Do not analyze that parameter's entire function body.
        ret state.analysis.member_declaration_at(doc.uri, token.value, token.line, token.column).is_some()
    }
    if starts_with(target, doc.uri + "#local:") {
        ret cursor_member_context(doc.analysis.tokens, token.line, token.column + token.value.char_len()).is_none()
        && !cursor_expects_type(doc.analysis.tokens, token.line, token.column)
    }
    ret true
}

fn reference_candidate_names(doc: Document, name: str) -> Vec[str] {
    let mut names = Vec[str]::new()
    names.push(name)
    // Aliases are candidates, never matches by themselves: semantic identity
    // is still checked below, so unrelated aliases cannot produce edits.
    for imported in import_requests_from_doc(doc) {
        names.push(last_scope_segment(imported.target))
        match imported.alias {
            Some(alias) => {
                names.push(alias)
            }
            None => {
            }
        }
    }
    ret names
}

fn reference_name_matches(names: Vec[str], candidate: str) -> bool {
    for name in names {
        if name == candidate {
            ret true
        }
    }
    ret false
}

fn reference_candidate_token(doc: Document, index: usize, token: Token, names: Vec[str]) -> bool {
    if reference_name_matches(names, token.value) {
        ret true
    }
    if index > 0_usize {
        match doc.analysis.tokens.get(index - 1_usize) {
            Some(previous) => {
                ret previous.type == TokenType::SCOPE
            }
            None => {
            }
        }
    }
    ret false
}

fn push_rename_edits_for_doc(changes: mut Vec[(str, Json)], doc: Document, old_name: str, new_name: str)
->() {
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(candidate) => {
                if candidate.type == TokenType::IDENTIFIER && candidate.value == old_name {
                    add_text_edit_to_changes(changes, doc.uri, text_edit(token_range(doc, candidate),
                            new_name,))
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn add_text_edit_to_changes(changes: mut Vec[(str, Json)], uri: str, edit: Json) ->() {
    let mut index = 0_usize
    while index < changes.len() {
        match changes.get(index) {
            Option[(str, Json)]::Some(entry) => {
                if entry.0 == uri {
                    let mut edits = Vec[Json]::new()
                    match entry.1.as_array() {
                        Option[Vec[Json]]::Some(existing) => {
                            if text_edit_exists(existing, edit) {
                                ret()
                            }
                            let mut edit_index = 0_usize
                            while edit_index < existing.len() {
                                match existing.get(edit_index) {
                                    Option[Json]::Some(existing_edit) => {
                                        edits.push(existing_edit)
                                    }
                                    Option[Json]::None => {
                                    }
                                }
                                edit_index += 1_usize
                            }
                        }
                        Option[Vec[Json]]::None => {
                        }
                    }
                    edits.push(edit)
                    changes.set(index, field(uri, Json::Array(edits)))
                    ret()
                }
            }
            Option[(str, Json)]::None => {
            }
        }
        index += 1_usize
    }
    let mut edits = Vec[Json]::new()
    edits.push(edit)
    changes.push(field(uri, Json::Array(edits)))
    ret()
}

fn text_edit_exists(edits: Vec[Json], target: Json) -> bool {
    let target_range = json_get(target, "range")
    let target_text = json_get_str(target, "newText", "")
    let target_start = json_get(target_range, "start")
    let target_end = json_get(target_range, "end")
    let target_start_line = json_number_usize(json_get(target_start, "line"), 0_usize)
    let target_start_character = json_number_usize(json_get(target_start, "character"), 0_usize)
    let target_end_line = json_number_usize(json_get(target_end, "line"), 0_usize)
    let target_end_character = json_number_usize(json_get(target_end, "character"), 0_usize)
    let mut index = 0_usize
    while index < edits.len() {
        match edits.get(index) {
            Option[Json]::Some(edit) => {
                let edit_range = json_get(edit, "range")
                let edit_start = json_get(edit_range, "start")
                let edit_end = json_get(edit_range, "end")
                if json_get_str(edit, "newText", "") == target_text
                && json_number_usize(json_get(edit_start, "line"), 0_usize) == target_start_line
                && json_number_usize(json_get(edit_start, "character"), 0_usize) == target_start_character
                && json_number_usize(json_get(edit_end, "line"), 0_usize) == target_end_line
                && json_number_usize(json_get(edit_end, "character"), 0_usize) == target_end_character
                {
                    ret true
                }
            }
            Option[Json]::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn empty_workspace_edit() -> Json {
    let mut changes = Vec[(str, Json)]::new()
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("changes", Json::Object(changes)))
    ret Json::Object(fields)
}

fn document_links(state: ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            let mut items = Vec[Json]::new()
            let requests = import_requests_from_doc(doc)
            let mut index = 0_usize
            while index < requests.len() {
                match requests.get(index) {
                    Option[ImportRequest]::Some(request) => {
                        items.push(document_link_for_import(state, doc, request))
                    }
                    Option[ImportRequest]::None => {
                    }
                }
                index += 1_usize
            }
            ret Json::Array(items)
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn document_link_for_import(state: ServerState, doc: Document, request: ImportRequest) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("range", lsp_range(doc, request.line, request.column, request.length)))
    match resolve_import_request_uri(state, doc, request) {
        Option[str]::Some(target_uri) => {
            fields.push(field("target", Json::String(target_uri)))
        }
        Option[str]::None => {
        }
    }
    fields.push(field("tooltip", Json::String("Encore import: " + request.target)))
    ret Json::Object(fields)
}

fn resolve_import_target_uri(state: ServerState, target: str) -> Option[str] {
    let relative = import_target_to_relative_path(target)
    if relative == "" {
        ret Option[str]::None
    }
    let mut index = 0_usize
    while index < state.workspace_roots.len() {
        match state.workspace_roots.get(index) {
            Option[str]::Some(root) => {
                let src = join_path(root, "src")
                let direct = join_path(src, relative + ".enq")
                if file_exists(direct) {
                    ret Option[str]::Some(path_to_uri(direct))
                }
                let mod_file = join_path(join_path(src, relative), "mod.enq")
                if file_exists(mod_file) {
                    ret Option[str]::Some(path_to_uri(mod_file))
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[str]::None
}

fn import_target_to_relative_path(target: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < target.len() {
        let ch = target.get(index).unwrap_or("")
        if ch == ":" && index + 1_usize < target.len() {
            if target.get(index + 1_usize).unwrap_or("") == ":" {
                out += "/"
                index += 2_usize
                continue
            }
        }
        if ch == "," || ch == " " {
            break
        }
        out += ch
        index += 1_usize
    }
    ret out
}

fn import_range(doc: Document, edge: DependencyEdge) -> Json {
    match line_text_at(doc.text, edge.line) {
        Option[str]::Some(line) => {
            let column = find_in_line_at_or_after(line, edge.target, 0_usize)
            ret lsp_range(doc, edge.line, column, edge.target.char_len())
        }
        Option[str]::None => {
        }
    }
    ret lsp_range(doc, edge.line, edge.column, edge.length)
}

fn project_name_for_root(root: str) -> str {
    let manifest = join_path(root, "encore.toml")
    if file_exists(manifest) {
        let content = read_file(manifest)
        let name = project_name_from_manifest(content)
        if name != "" {
            ret name
        }
    }
    ret basename_path(root)
}

fn project_name_from_manifest(content: str) -> str {
    ret project_string_from_manifest(content, "name")
}

fn project_string_from_manifest(content: str, field_name: str) -> str {
    let last_line = document_last_line(content)
    let mut line = 0_usize
    while line <= last_line {
        match line_text_at(content, line) {
            Option[str]::Some(text) => {
                let trimmed = trim_spaces(text)
                if starts_with(trimmed, field_name) {
                    let eq = find_char(trimmed, "=", 0_usize)
                    if eq < trimmed.len() {
                        let raw = trim_spaces(trimmed.slice(eq + 1_usize, trimmed.len() - eq - 1_usize))
                        ret strip_wrapping_quotes(raw)
                    }
                }
            }
            Option[str]::None => {
            }
        }
        if line == last_line {
            break
        }
        line += 1_usize
    }
    ret ""
}

fn strip_wrapping_quotes(value: str) -> str {
    if value.len() >= 2_usize && starts_with(value, "\"") && ends_with(value, "\"") {
        ret value.slice(1_usize, value.len() - 2_usize)
    }
    ret value
}

fn basename_path(path: str) -> str {
    let mut index = path.len()
    while index > 0_usize {
        index -= 1_usize
        let ch = path.get(index).unwrap_or("")
        if ch == "/" {
            ret path.slice(index + 1_usize, path.len() - index - 1_usize)
        }
    }
    ret path
}

fn parent_path(path: str) -> str {
    let mut index = path.len()
    while index > 0_usize {
        index -= 1_usize
        let character = path.get(index).unwrap_or("")
        if character == "/" || character == "\\" {
            if index == 0_usize {
                ret character
            }
            ret path.slice(0_usize, index)
        }
    }
    ret ""
}

fn path_relative_to(base: str, path: str) -> str {
    if path == base {
        ret ""
    }
    let prefix = if ends_with(base, "/") {
        base
    } else {
        base + "/"
    }
    if starts_with(path, prefix) {
        ret path.slice(prefix.len(), path.len() - prefix.len())
    }
    ret ""
}

fn path_without_suffix(path: str, suffix: str) -> str {
    if ends_with(path, suffix) {
        ret path.slice(0_usize, path.len() - suffix.len())
    }
    ret path
}

fn module_ref_for_uri(state: ServerState, uri: str) -> Option[ModuleRef] {
    let path = uri_to_path(uri)
    let mut matched_root = ""
    let mut matched_name = ""
    let mut index = 0_usize
    while index < state.workspace_projects.len() {
        match state.workspace_projects.get(index) {
            Option[ProjectRoot]::Some(project) => {
                let prefix = if ends_with(project.root, "/") {
                    project.root
                } else {
                    project.root + "/"
                }
                if path == project.root || starts_with(path, prefix) {
                    if project.root.len() > matched_root.len() {
                        matched_root = project.root
                        matched_name = project.name
                    }
                }
            }
            Option[ProjectRoot]::None => {
            }
        }
        index += 1_usize
    }
    if matched_root == "" {
        ret Option[ModuleRef]::None
    }
    let source_dir = join_path(matched_root, "src")
    let relative = path_relative_to(source_dir, path)
    if relative == "" && path != join_path(source_dir, "main.enq") && path != join_path(source_dir, "lib.enq")
    {
        ret Option[ModuleRef]::None
    }
    let module_name = module_name_from_relative_path(relative)
    ret Option[ModuleRef]::Some(ModuleRef {
            matched_root, matched_name, source_dir, module_name, uri, path
        }
        ,
    )
}

fn analysis_module_name(state: ServerState, uri: str) -> str {
    match module_ref_for_uri(state, uri) {
        Option[ModuleRef]::Some(module) => {
            if module.module_name == "" {
                ret module.project_name
            }
            ret module.project_name + "::" + module.module_name
        }
        Option[ModuleRef]::None => {
            ret uri
        }
    }
}

fn module_name_from_relative_path(relative: str) -> str {
    if relative == "" || relative == "main.enq" || relative == "lib.enq" {
        ret ""
    }
    let mut trimmed = relative
    if ends_with(trimmed, "/mod.enq") {
        trimmed = trimmed.slice(0_usize, trimmed.len() - 8_usize)
    } elif ends_with(trimmed, ".enq") {
        trimmed = trimmed.slice(0_usize, trimmed.len() - 4_usize)
    }
    ret replace_slash_with_scope(trimmed)
}

fn replace_slash_with_scope(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.get(index).unwrap_or("")
        if ch == "/" {
            out += "::"
        } else {
            out += ch
        }
        index += 1_usize
    }
    ret out
}

fn import_requests_from_doc(doc: Document) -> Vec[ImportRequest] {
    let mut out = Vec[ImportRequest]::new()
    let edges = doc.analysis.dependencies.all()
    let mut index = 0_usize
    while index < edges.len() {
        match edges.get(index) {
            Option[DependencyEdge]::Some(edge) => {
                push_import_requests_from_edge(out, doc, edge)
            }
            Option[DependencyEdge]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn push_import_requests_from_edge(out: mut Vec[ImportRequest], doc: Document, edge: DependencyEdge) ->()
{
    let items = expand_import_path_targets(edge.target)
    let mut search_from = 0_usize
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[ExpandedImportTarget]::Some(item) => {
                match line_text_at(doc.text, edge.line) {
                    Option[str]::Some(line) => {
                        let label = import_request_label(item.target, item.alias, item.wildcard)
                        let column = find_in_line_at_or_after(line, label, search_from)
                        search_from = column + label.len()
                        out.push(ImportRequest {
                                edge.source, item.target, item.alias, item.wildcard, edge.line, column,
                                label.len()
                            }
                            ,
                        )
                    }
                    Option[str]::None => {
                        out.push(ImportRequest {
                                edge.source, item.target, item.alias, item.wildcard, edge.line, edge.column,
                                edge.length
                            }
                            ,
                        )
                    }
                }
            }
            Option[ExpandedImportTarget]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn import_request_label(target: str, alias: Option[str], wildcard: bool) -> str {
    let mut out = target
    if wildcard {
        out += "::*"
    }
    match alias {
        Option[str]::Some(value) => {
            out += " as " + value
        }
        Option[str]::None => {
        }
    }
    ret out
}

fn expand_import_path_targets(raw: str) -> Vec[ExpandedImportTarget] {
    let cleaned = trim_spaces(raw)
    let brace_start = find_char(cleaned, "{", 0_usize)
    if brace_start >= cleaned.len() {
        let mut out = Vec[ExpandedImportTarget]::new()
        let stripped = strip_import_suffixes(cleaned)
        let wildcard = ends_with(stripped, "::*")
        let target = if wildcard {
            stripped.slice(0_usize, stripped.len() - 3_usize)
        } else {
            stripped
        }
        out.push(ExpandedImportTarget {
                target, import_alias(cleaned), wildcard
            }
            ,
        )
        ret out
    }

    let brace_end = find_matching_brace(cleaned, brace_start)
    let prefix = trim_spaces(cleaned.slice(0_usize, brace_start))
    let inner = cleaned.slice(brace_start + 1_usize, brace_end - brace_start - 1_usize)
    let items = split_top_level_csv(inner)

    let mut out = Vec[ExpandedImportTarget]::new()
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[str]::Some(item) => {
                let nested = expand_import_path_targets(prefix + "::" + item)
                let mut nested_index = 0_usize
                while nested_index < nested.len() {
                    match nested.get(nested_index) {
                        Option[ExpandedImportTarget]::Some(expanded) => {
                            out.push(expanded)
                        }
                        Option[ExpandedImportTarget]::None => {
                        }
                    }
                    nested_index += 1_usize
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn import_alias(value: str) -> Option[str] {
    let alias_index = find_substring(value, " as ")
    if alias_index < value.len() {
        ret Option[str]::Some(trim_spaces(value.slice(alias_index + 4_usize, value.len() - alias_index
                    - 4_usize,)))
    }
    ret Option[str]::None
}

fn strip_import_suffixes(value: str) -> str {
    let mut out = trim_spaces(value)
    let alias_index = find_substring(out, " as ")
    if alias_index < out.len() {
        out = out.slice(0_usize, alias_index)
    }
    ret trim_spaces(out)
}

fn resolve_import_request_uri(state: ServerState, doc: Document, request: ImportRequest) -> Option[str]
{
    match module_ref_for_uri(state, doc.uri) {
        Option[ModuleRef]::Some(module) => {
            ret resolve_import_request_uri_from_module(state, module, request.target)
        }
        Option[ModuleRef]::None => {
            match project_root_for_path(uri_to_path(doc.uri)) {
                Option[str]::Some(root) => {
                    let module = ModuleRef {
                        root, project_name_for_root(root), join_path(root, "src"), "", doc.uri, uri_to_path(doc.uri)
                    }
                    ret resolve_import_request_uri_from_module(state, module, request.target)
                }
                Option[str]::None => {
                }
            }
            ret resolve_import_target_uri(state, request.target)
        }
    }
}

fn resolve_import_request_uri_from_module(state: ServerState, module: ModuleRef, target: str) -> Option[str]
{
    let parts = split_scope_path(strip_import_suffixes(target))
    if parts.len() == 0_usize {
        ret Option[str]::None
    }

    let mut first = ""
    match parts.get(0_usize) {
        Option[str]::Some(value) => {
            first = value
        }
        Option[str]::None => {
            ret Option[str]::None
        }
    }

    let mut source_dir = module.source_dir
    let mut start = 1_usize
    if first == "mod" {
        source_dir = parent_path(module.path)
    } elif first == "refrain" || first == "repo" || first == module.project_name {
        source_dir = module.source_dir
    } else {
        match workspace_project_by_name(state, first) {
            Option[ProjectRoot]::Some(project) => {
                source_dir = join_path(project.root, "src")
            }
            Option[ProjectRoot]::None => {
                match ancestor_project_candidate_by_name(module.project_root, first) {
                    Option[ProjectRoot]::Some(project) => {
                        source_dir = join_path(project.root, "src")
                    }
                    Option[ProjectRoot]::None => {
                        match workspace_project_candidate_by_name(state, first) {
                            Option[ProjectRoot]::Some(project) => {
                                source_dir = join_path(project.root, "src")
                            }
                            Option[ProjectRoot]::None => {
                                // Packages from the installed Encore index are
                                // not workspace projects, but must participate
                                // in the same resolver as local dependencies.
                                match path_dependency_project(module.project_root, first) {
                                    Option[ProjectRoot]::Some(project) => {
                                        source_dir = join_path(project.root, "src")
                                    }
                                    Option[ProjectRoot]::None => {
                                        match completion_package_root(state, first) {
                                            Option[str]::Some(root) => {
                                                source_dir = join_path(root, "src")
                                            }
                                            Option[str]::None => {
                                                ret Option[str]::None
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    let mut module_part_count = parts.len() - start
    loop {
        match resolve_module_uri_from_parts(source_dir, parts, start, module_part_count) {
            Option[str]::Some(uri) => {
                ret Option[str]::Some(uri)
            }
            Option[str]::None => {
            }
        }
        if module_part_count == 0_usize {
            break
        }
        module_part_count -= 1_usize
    }
    ret Option[str]::None
}

fn workspace_project_by_name(state: ServerState, name: str) -> Option[ProjectRoot] {
    let mut index = 0_usize
    while index < state.workspace_projects.len() {
        match state.workspace_projects.get(index) {
            Option[ProjectRoot]::Some(project) => {
                if project.name == name {
                    ret Option[ProjectRoot]::Some(project)
                }
            }
            Option[ProjectRoot]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[ProjectRoot]::None
}

fn path_dependency_project(project_root: str, name: str) -> Option[ProjectRoot] {
    for project in path_dependency_projects(project_root) {
        if project.name == name {
            ret Option[ProjectRoot]::Some(project)
        }
    }
    ret Option[ProjectRoot]::None
}

fn path_dependency_projects(project_root: str) -> Vec[ProjectRoot] {
    let mut projects = Vec[ProjectRoot]::new()
    let manifest = read_file(join_path(project_root, "encore.toml"))
    let marker = "\"path@"
    let mut remaining = manifest
    while remaining.len() > 0_usize {
        let marker_index = find_substring(remaining, marker)
        if marker_index >= remaining.char_len() {
            break
        }
        let value_start = marker_index + marker.char_len()
        let tail = remaining.slice(value_start, remaining.char_len() - value_start)
        let value_end = find_char(tail, "\"", 0_usize)
        if value_end >= tail.char_len() {
            break
        }
        let dependency_root = join_path(project_root, tail.slice(0_usize, value_end))
        if file_exists(join_path(dependency_root, "encore.toml")) {
            let dependency_name = project_name_for_root(dependency_root)
            if dependency_name != "" {
                projects.push(ProjectRoot {
                        dependency_root, dependency_name
                    }
                    ,
                )
            }
        }
        let consumed = value_start + value_end + 1_usize
        if consumed >= remaining.char_len() {
            break
        }
        remaining = remaining.slice(consumed, remaining.char_len() - consumed)
    }
    ret projects
}

fn workspace_project_candidate_by_name(state: ServerState, name: str) -> Option[ProjectRoot] {
    let mut index = 0_usize
    while index < state.workspace_roots.len() {
        match state.workspace_roots.get(index) {
            Option[str]::Some(root) => {
                match project_candidate_at_path(name, join_path(root, name)) {
                    Option[ProjectRoot]::Some(project) => {
                        ret Option[ProjectRoot]::Some(project)
                    }
                    Option[ProjectRoot]::None => {
                    }
                }
                match project_candidate_at_path(name, join_path(join_path(root, "index"), name)) {
                    Option[ProjectRoot]::Some(project) => {
                        ret Option[ProjectRoot]::Some(project)
                    }
                    Option[ProjectRoot]::None => {
                    }
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[ProjectRoot]::None
}

fn ancestor_project_candidate_by_name(start_path: str, name: str) -> Option[ProjectRoot] {
    let mut cursor = start_path
    let mut depth = 0_usize
    while depth < 12_usize {
        match project_candidate_at_path(name, join_path(cursor, name)) {
            Option[ProjectRoot]::Some(project) => {
                ret Option[ProjectRoot]::Some(project)
            }
            Option[ProjectRoot]::None => {
            }
        }
        match project_candidate_at_path(name, join_path(join_path(cursor, "index"), name)) {
            Option[ProjectRoot]::Some(project) => {
                ret Option[ProjectRoot]::Some(project)
            }
            Option[ProjectRoot]::None => {
            }
        }
        let parent = parent_path(cursor)
        if parent == cursor || parent == "" {
            break
        }
        cursor = parent
        depth += 1_usize
    }
    ret Option[ProjectRoot]::None
}

fn project_candidate_at_path(name: str, root: str) -> Option[ProjectRoot] {
    if !file_exists(join_path(root, "encore.toml")) {
        ret Option[ProjectRoot]::None
    }
    let project_name = project_name_for_root(root)
    if project_name == name || basename_path(root) == name {
        ret Option[ProjectRoot]::Some(ProjectRoot {
                root, project_name
            }
            ,
        )
    }
    ret Option[ProjectRoot]::None
}

fn resolve_module_uri_from_parts(base_dir: str, parts: Vec[str], start: usize, count: usize) -> Option[str]
{
    let mut module_base = base_dir
    if count == 0_usize {
        module_base = join_path(module_base, "lib")
    } else {
        let mut index = 0_usize
        while index < count {
            match parts.get(start + index) {
                Option[str]::Some(part) => {
                    module_base = join_path(module_base, part)
                }
                Option[str]::None => {
                    ret Option[str]::None
                }
            }
            index += 1_usize
        }
    }

    let direct = module_base + ".enq"
    if file_exists(direct) {
        ret Option[str]::Some(path_to_uri(direct))
    }
    let mod_file = join_path(module_base, "mod.enq")
    if file_exists(mod_file) {
        ret Option[str]::Some(path_to_uri(mod_file))
    }
    ret Option[str]::None
}

fn index_navigation_module(state: mut ServerState, doc: Document, visited: usize) ->() {
    index_query_module(state, doc, visited, false)
    ret()
}

// Source discovery stays in the adapter. Type and member identity stay in the
// database, including public re-exports of a fully qualified type.
fn associated_query_owner(state: mut ServerState, doc: Document, owner: str) -> str {
    if owner == "" || state.analysis.associated_owner_type(doc.uri, owner).is_some() {
        ret owner
    }
    let mut end = 0_usize
    while end < owner.len() && owner.slice(end, 1_usize) != "[" {
        end += 1_usize
    }
    let base = owner.slice(0_usize, end)
    if !contains_substring(base, "::") {
        ret owner
    }
    match completion_module_file_for_doc(state, doc, base) {
        Some(path) => {
            let target = document_for_path(state, path)
            let visited = encore_strset_new()
            index_navigation_module(state, target, visited)
            encore_strset_free(visited)
            ret target.uri + "::" + last_scope_segment(base) + owner.slice(end, owner.len() - end)
        }
        None => {
            ret owner
        }
    }
}

fn index_query_module(state: mut ServerState, doc: Document, visited: usize, include_private: bool) ->() {
    if !encore_strset_insert(visited, doc.uri) {
        ret()
    }
    state.analysis.set_module(doc.uri, uri_to_path(doc.uri), doc.text)
    let mut targets = Vec[ModuleImportTarget]::new()
    for edge in doc.analysis.dependencies.all() {
        if !include_private && !edge.is_public {
            continue
        }
        for expanded in expand_import_path_targets(edge.target) {
            let mut module_target = expanded.target
            if expanded.wildcard && ends_with(module_target, "::*") {
                module_target = module_target.slice(0_usize, module_target.len() - 3_usize)
            }
            match completion_module_file_for_doc(state, doc, module_target) {
                Option[str]::Some(path) => {
                    let imported = document_for_path(state, path)
                    if !expanded.wildcard {
                        let mut physical_name = basename_path(path)
                        if physical_name == "mod.enq" || physical_name == "lib.enq" {
                            physical_name = basename_path(parent_path(path))
                        } elif ends_with(physical_name, ".enq") {
                            physical_name = physical_name.slice(0_usize, physical_name.len() - 4_usize)
                        }
                        if last_scope_segment(module_target) != physical_name {
                            let parts = split_scope_path(module_target)
                            module_target = join_scope_parts(parts, parts.len() - 1_usize)
                        }
                    }
                    targets.push(ModuleImportTarget {
                            module_target, imported.uri
                        }
                        ,
                    )
                    index_navigation_module(state, imported, visited)
                }
                Option[str]::None => {
                }
            }
        }
    }
    state.analysis.set_module_import_targets(doc.uri, targets)
    ret()
}

fn resolved_symbol_at(state: mut ServerState, doc: Document, token: Token) -> Option[ResolvedReference] {
    if cursor_associated_owner(doc.analysis.tokens, token.line, token.column) != ""
    || split_scope_path(cursor_symbol_path(doc.analysis.tokens, token.line, token.column)).len() <= 1_usize {
        let visited = encore_strset_new()
        index_query_module(state, doc, visited, true)
        encore_strset_free(visited)
    }
    ret resolved_symbol_in_index(state, doc, token)
}

// Batch reference queries prepare the document graph once, then resolve every
// candidate against that same index instead of repeating filesystem traversal.
fn resolved_symbol_in_index(state: mut ServerState, doc: Document, token: Token) -> Option[ResolvedReference] {
    let owner = associated_query_owner(state, doc, cursor_associated_owner(doc.analysis.tokens, token.line, token.column))
    if owner != "" {
        match state.analysis.associated_owner_type(doc.uri, owner) {
            Some(receiver) => {
                match state.analysis.associated_member_details(doc.uri, owner, token.value) {
                    Some(details) => {
                        ret Option[ResolvedReference]::Some(member_definition_reference(state, details))
                    }
                    None => {
                        ret Option[ResolvedReference]::None
                    }
                }
            }
            None => {
            }
        }
    }
    let path = cursor_symbol_path(doc.analysis.tokens, token.line, token.column)
    let parts = split_scope_path(path)
    if parts.len() <= 1_usize {
        if cursor_member_context(doc.analysis.tokens, token.line, token.column + token.value.char_len()).is_some() {
            match state.analysis.member_details_at(doc.uri, token.value, token.line, token.column) {
                Some(details) => {
                    ret Option[ResolvedReference]::Some(member_definition_reference(state, details))
                }
                None => {
                    ret Option[ResolvedReference]::None
                }
            }
        }
        match state.analysis.member_declaration_at(doc.uri, token.value, token.line, token.column) {
            Some(definition) => {
                let details = state.analysis.member_declaration_details(definition)
                ret Option[ResolvedReference]::Some(member_definition_reference(state, details))
            }
            None => {
            }
        }
        if !cursor_expects_type(doc.analysis.tokens, token.line, token.column)
        && cursor_member_context(doc.analysis.tokens, token.line, token.column + token.value.char_len()).is_none() {
            match state.analysis.semantic_binding_at(doc.uri, token.value, token.line, token.column) {
                Some(binding) => {
                    // Legacy synthetic bindings do not yet carry declaration spans.
                    // Never turn those fallback coordinates into an incorrect jump.
                    for declaration in doc.analysis.tokens {
                        if declaration.line == binding.line && declaration.column == binding.column
                        && declaration.type == TokenType::IDENTIFIER && declaration.value == binding.name {
                            ret Option[ResolvedReference]::Some(ResolvedReference {
                                    doc.uri + "#local:" + Debug::fmt(binding.line) + ":" + Debug::fmt(binding.column),
                                    binding.name, doc.uri, token_range(doc, declaration),
                                    binding.name + ": " + binding.typ, Option[FrontendCallable]::None,
                                    doc.uri + "#local:" + Debug::fmt(binding.line) + ":" + Debug::fmt(binding.column)
                                }
                                ,)
                        }
                    }
                }
                None => {
                }
            }
        }
        ret module_symbol_reference(state, doc.uri, token.value, false)
    }
    let first = parts.get(0_usize).unwrap_or("")
    let mut target = path
    for imported in import_requests_from_doc(doc) {
        let local = imported.alias.unwrap_or(last_scope_segment(imported.target))
        if !imported.wildcard && local == first {
            target = imported.target + path.slice(first.char_len(), path.char_len() - first.char_len())
            break
        }
    }
    let request = ImportRequest {
        "", target, Option[str]::None, false,
        token.line, token.column, token.value.char_len()
    }
    match resolve_import_request_uri(state, doc, request) {
        Option[str]::Some(uri) => {
            let target_doc = document_for_path(state, uri_to_path(uri))
            // URI identity isolates identically named packages in different
            // workspaces. The frontend owns definition IDs and source spans.
            let visited = encore_strset_new()
            index_navigation_module(state, target_doc, visited)
            encore_strset_free(visited)
            ret module_symbol_reference(state, uri, token.value, target_doc.uri != doc.uri)
        }
        Option[str]::None => {
        }
    }
    // A qualified path must never fall back to an unrelated same-named symbol.
    ret Option[ResolvedReference]::None
}

fn member_definition_reference(state: mut ServerState, details: MemberDetails) -> ResolvedReference {
    let definition = details.definition
    let origin = document_for_path(state, definition.source_name())
    let id = "member:" + definition.source_identity().key()
    let mut signature = definition.name() + ": " + details.typ
    let mut callable = Option[FrontendCallable]::None
    if definition.kind() == DefinitionKind::Variant {
        signature = details.typ + "::" + definition.name()
    }
    if details.is_method {
        signature = "fn " + definition.name() + "("
        let mut first = true
        for param in details.params {
            if !first {
                signature += ", "
            }
            signature += param
            first = false
        }
        signature += ") -> " + details.typ
        callable = Option[FrontendCallable]::Some(FrontendCallable {
                definition.name(), details.params,
                Option[str]::Some(details.typ), definition.line(), definition.column(), definition.length()
            }
            ,)
    }
    let mut hover = "```encore\n" + signature + "\n```"
    if details.documentation != "" {
        hover += "\n\n" + details.documentation
    }
    ret ResolvedReference {
        id, definition.name(), origin.uri,
        lsp_range(origin, definition.line(), definition.column(), definition.length()), hover, callable, id
    }
}

fn module_symbol_reference(state: mut ServerState, uri: str, name: str, public_only: bool) -> Option[ResolvedReference] {
    let mut spaces = Vec[DefinitionNamespace]::new()
    spaces.push(DefinitionNamespace::Value)
    spaces.push(DefinitionNamespace::Type)
    spaces.push(DefinitionNamespace::Trait)
    for namespace in spaces {
        match state.analysis.module_definition(uri, name, namespace) {
            Some(definition) => {
                if public_only && !definition.is_public() {
                    continue
                }
                let origin = document_for_path(state, definition.source_name())
                for symbol in origin.analysis.symbols {
                    if symbol.line == definition.line() && symbol.column == definition.column() {
                        let mut reference = symbol_reference(state, origin, symbol)
                        if definition.rename_binding() != "" {
                            reference.rename_id = definition.rename_binding()
                        }
                        ret Option[ResolvedReference]::Some(reference)
                    }
                }
            }
            None => {
            }
        }
    }
    ret Option[ResolvedReference]::None
}

fn resolved_symbol_by_name(state: ServerState, current_doc: Document, name: str) -> Option[ResolvedReference]
{
    match local_symbol_reference(state, current_doc, name) {
        Option[ResolvedReference]::Some(reference) => {
            ret Option[ResolvedReference]::Some(reference)
        }
        Option[ResolvedReference]::None => {
        }
    }

    let imports = import_requests_from_doc(current_doc)
    let mut import_index = 0_usize
    while import_index < imports.len() {
        match imports.get(import_index) {
            Option[ImportRequest]::Some(request) => {
                match imported_symbol_reference(state, current_doc, request, name) {
                    Option[ResolvedReference]::Some(reference) => {
                        ret Option[ResolvedReference]::Some(reference)
                    }
                    Option[ResolvedReference]::None => {
                    }
                }
            }
            Option[ImportRequest]::None => {
            }
        }
        import_index += 1_usize
    }

    ret workspace_symbol_reference_by_name(state, name)
}

fn local_symbol_reference(state: ServerState, doc: Document, name: str) -> Option[ResolvedReference]
{
    match symbol_by_name(doc, name) {
        Option[FrontendSymbol]::Some(symbol) => {
            ret Option[ResolvedReference]::Some(symbol_reference(state, doc, symbol))
        }
        Option[FrontendSymbol]::None => {
        }
    }
    ret Option[ResolvedReference]::None
}

fn symbol_reference(state: ServerState, doc: Document, symbol: FrontendSymbol) -> ResolvedReference {
    let id = canonical_symbol_id(state, doc, symbol)
    let hover = symbol_hover_text(symbol)
    let callable = callable_by_name(doc, symbol.name)
    ret ResolvedReference {
        id, symbol.name, doc.uri, symbol_range(doc, symbol), hover, callable, id
    }
}

fn imported_symbol_reference(state: ServerState, doc: Document, request: ImportRequest, name: str) ->
Option[ResolvedReference] {
    match request.alias {
        Option[str]::Some(alias) => {
            if alias != name {
                ret Option[ResolvedReference]::None
            }
            match resolve_symbol_reference_from_import(state, doc, request) {
                Option[ResolvedReference]::Some(reference) => {
                    ret Option[ResolvedReference]::Some(reference)
                }
                Option[ResolvedReference]::None => {
                }
            }
        }
        Option[str]::None => {
        }
    }

    if request.wildcard {
        match resolve_import_request_uri(state, doc, request) {
            Option[str]::Some(uri) => {
                match state.document(uri) {
                    Option[Document]::Some(target_doc) => {
                        match local_symbol_reference(state, target_doc, name) {
                            Option[ResolvedReference]::Some(reference) => {
                                ret Option[ResolvedReference]::Some(reference)
                            }
                            Option[ResolvedReference]::None => {
                            }
                        }
                    }
                    Option[Document]::None => {
                    }
                }
            }
            Option[str]::None => {
            }
        }
    } elif last_scope_segment(request.target) == name {
        match resolve_symbol_reference_from_import(state, doc, request) {
            Option[ResolvedReference]::Some(reference) => {
                ret Option[ResolvedReference]::Some(reference)
            }
            Option[ResolvedReference]::None => {
            }
        }
    }
    ret Option[ResolvedReference]::None
}

fn resolve_symbol_reference_from_import(state: ServerState, doc: Document, request: ImportRequest) ->
Option[ResolvedReference] {
    let target_name = last_scope_segment(request.target)
    match resolve_import_request_uri(state, doc, request) {
        Option[str]::Some(uri) => {
            match state.document(uri) {
                Option[Document]::Some(target_doc) => {
                    if request.wildcard {
                        ret Option[ResolvedReference]::None
                    }
                    match local_symbol_reference(state, target_doc, target_name) {
                        Option[ResolvedReference]::Some(reference) => {
                            ret Option[ResolvedReference]::Some(reference)
                        }
                        Option[ResolvedReference]::None => {
                        }
                    }
                }
                Option[Document]::None => {
                    let path = uri_to_path(uri)
                    if file_exists(path) {
                        let target_doc = Document::new(uri, read_file(path))
                        if request.wildcard {
                            ret Option[ResolvedReference]::None
                        }
                        match local_symbol_reference(state, target_doc, target_name) {
                            Option[ResolvedReference]::Some(reference) => {
                                ret Option[ResolvedReference]::Some(reference)
                            }
                            Option[ResolvedReference]::None => {
                            }
                        }
                    }
                }
            }
        }
        Option[str]::None => {
        }
    }
    ret Option[ResolvedReference]::None
}

fn workspace_symbol_reference_by_name(state: ServerState, name: str) -> Option[ResolvedReference] {
    let mut found = Option[ResolvedReference]::None
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                match local_symbol_reference(state, doc, name) {
                    Option[ResolvedReference]::Some(reference) => {
                        match found {
                            Option[ResolvedReference]::Some(existing) => {
                                if existing.id != reference.id {
                                    ret Option[ResolvedReference]::None
                                }
                            }
                            Option[ResolvedReference]::None => {
                                found = Option[ResolvedReference]::Some(reference)
                            }
                        }
                    }
                    Option[ResolvedReference]::None => {
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }

    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    match local_symbol_reference(state, doc, name) {
                        Option[ResolvedReference]::Some(reference) => {
                            match found {
                                Option[ResolvedReference]::Some(existing) => {
                                    if existing.id != reference.id {
                                        ret Option[ResolvedReference]::None
                                    }
                                }
                                Option[ResolvedReference]::None => {
                                    found = Option[ResolvedReference]::Some(reference)
                                }
                            }
                        }
                        Option[ResolvedReference]::None => {
                        }
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret found
}

fn canonical_symbol_id(state: ServerState, doc: Document, symbol: FrontendSymbol) -> str {
    let module_name = analysis_module_name(state, doc.uri)
    match state.analysis.symbol_id_for(module_name, symbol) {
        Option::Some(id) => {
            ret "symbol:" + Debug::fmt(analysis_root_identity(doc.uri)) + ":" + id.key()
        }
        Option::None => {
        }
    }
    // Files read outside an indexed workspace still need request-local
    // identity, but every registered module uses the stable database ID.
    ret doc.uri + "#" + symbol.name
}

fn analysis_root_identity(uri: str) -> u64 {
    match project_root_for_path(uri_to_path(uri)) {
        Some(root) => {
            ret root.hash()
        }
        None => {
            ret uri.hash()
        }
    }
}

fn last_scope_segment(value: str) -> str {
    let parts = split_scope_path(value)
    if parts.len() == 0_usize {
        ret value
    }
    match parts.get(parts.len() - 1_usize) {
        Option[str]::Some(part) => {
            ret part
        }
        Option[str]::None => {
            ret value
        }
    }
}

fn split_scope_path(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut current = ""
    let mut index = 0_usize
    while index < value.char_len() {
        if index + 1_usize < value.char_len() && value.get(index).unwrap_or("") == ":" && value.get(index
            + 1_usize).unwrap_or("") == ":" {
            if current != "" {
                out.push(current)
                current = ""
            }
            index += 2_usize
            continue
        }
        current += value.get(index).unwrap_or("")
        index += 1_usize
    }
    if current != "" {
        out.push(current)
    }
    ret out
}

fn find_matching_brace(value: str, start: usize) -> usize {
    let mut depth = 0_usize
    let mut index = start
    while index < value.char_len() {
        let ch = value.get(index).unwrap_or("")
        if ch == "{" {
            depth += 1_usize
        } elif ch == "}" {
            depth -= 1_usize
            if depth == 0_usize {
                ret index
            }
        }
        index += 1_usize
    }
    ret value.char_len()
}

fn split_top_level_csv(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut current = ""
    let mut depth = 0_usize
    let mut index = 0_usize
    while index < value.char_len() {
        let ch = value.get(index).unwrap_or("")
        if ch == "{" {
            depth += 1_usize
        } elif ch == "}" {
            if depth > 0_usize {
                depth -= 1_usize
            }
        } elif ch == "," && depth == 0_usize {
            out.push(trim_spaces(current))
            current = ""
            index += 1_usize
            continue
        }
        current += ch
        index += 1_usize
    }
    if trim_spaces(current) != "" {
        out.push(trim_spaces(current))
    }
    ret out
}

fn trim_spaces(value: str) -> str {
    let mut start = 0_usize
    while start < value.char_len() && is_space(value.get(start).unwrap_or("")) {
        start += 1_usize
    }
    let mut end = value.char_len()
    while end > start && is_space(value.get(end - 1_usize).unwrap_or("")) {
        end -= 1_usize
    }
    ret value.slice(start, end - start)
}

fn is_space(ch: str) -> bool {
    ret ch == " " || ch == "\n" || ch == "\t" || ch == "\r"
}

fn find_char(value: str, needle: str, start: usize) -> usize {
    let mut index = start
    while index < value.char_len() {
        if value.get(index).unwrap_or("") == needle {
            ret index
        }
        index += 1_usize
    }
    ret value.char_len()
}

fn find_substring(value: str, needle: str) -> usize {
    if needle.char_len() == 0_usize {
        ret 0_usize
    }
    if needle.char_len() > value.char_len() {
        ret value.char_len()
    }
    let mut index = 0_usize
    while index + needle.char_len() <= value.char_len() {
        if value.slice(index, needle.char_len()) == needle {
            ret index
        }
        index += 1_usize
    }
    ret value.char_len()
}

fn folding_ranges(state: ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            let mut stack = Vec[Token]::new()
            let mut ranges = Vec[Json]::new()
            let mut index = 0_usize
            while index < doc.analysis.tokens.len() {
                match doc.analysis.tokens.get(index) {
                    Option[Token]::Some(token) => {
                        if token.type == TokenType::LEFT_BRACE {
                            stack.push(token)
                        } elif token.type == TokenType::RIGHT_BRACE {
                            match stack.pop() {
                                Option[Token]::Some(opened) => {
                                    if token.line > opened.line {
                                        ranges.push(folding_range_json(doc, opened, token))
                                    }
                                }
                                Option[Token]::None => {
                                }
                            }
                        }
                    }
                    Option[Token]::None => {
                    }
                }
                index += 1_usize
            }
            ret Json::Array(ranges)
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn folding_range_json(doc: Document, opened: Token, closed: Token) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("startLine", json_usize(opened.line)))
    fields.push(field("startCharacter", json_usize(actual_token_column(doc, opened))))
    fields.push(field("endLine", json_usize(closed.line)))
    fields.push(field("endCharacter", json_usize(actual_token_column(doc, closed) + closed.value.char_len())))
    ret Json::Object(fields)
}

fn selection_ranges(state: ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    let positions = json_get(params, "positions")
    let mut items = Vec[Json]::new()
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            match positions.as_array() {
                Option[Vec[Json]]::Some(values) => {
                    let mut index = 0_usize
                    while index < values.len() {
                        match values.get(index) {
                            Option[Json]::Some(position) => {
                                items.push(selection_range_for_position(doc, position))
                            }
                            Option[Json]::None => {
                            }
                        }
                        index += 1_usize
                    }
                }
                Option[Vec[Json]]::None => {
                }
            }
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(items)
}

fn selection_range_for_position(doc: Document, position: Json) -> Json {
    let line = json_number_usize(json_get(position, "line"), 0_usize)
    let lsp_character = json_number_usize(json_get(position, "character"), 0_usize)
    let character = request_character_index(doc, line, lsp_character)
    let mut fields = Vec[(str, Json)]::new()
    match identifier_at(doc, line, character) {
        Option[Token]::Some(token) => {
            fields.push(field("range", token_range(doc, token)))
        }
        Option[Token]::None => {
            fields.push(field("range", make_range(line, lsp_character, 0_usize)))
        }
    }
    ret Json::Object(fields)
}

fn clear_semantic_token_cache(state: mut ServerState, uri: str) ->() {
    let mut retained = Vec[SemanticTokenCache]::new()
    for entry in state.semantic_token_cache {
        if entry.uri != uri {
            retained.push(entry)
        }
    }
    state.semantic_token_cache = retained
    ret()
}

fn semantic_tokens_full(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    let generation = document_generation(state, uri)
    match state.document(uri) {
        Some(doc) => {
            for entry in state.semantic_token_cache {
                if entry.uri == uri && entry.generation == generation
                && entry.token_count == doc.analysis.tokens.len()
                && entry.symbol_count == doc.analysis.symbols.len() {
                    ret entry.response
                }
            }
            let response = compute_semantic_tokens(state, params)
            clear_semantic_token_cache(state, uri)
            if !analysis_pending_for_uri(state, uri) {
                state.semantic_token_cache.push(SemanticTokenCache {
                        uri, generation, doc.analysis.tokens.len(), doc.analysis.symbols.len(), response
                    }
                    ,)
            }
            ret response
        }
        None => {
            ret compute_semantic_tokens(state, params)
        }
    }
}

fn compute_semantic_tokens(state: ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    let mut data = Vec[Json]::new()
    match state.document(uri) {
        Some(original) => {
            let mut lexer = Lexer::new()
            let tokens = lexer.tokenize_lossless(original.text)
            let analysis = original.analysis
            let doc = Document {
                uri, original.text, FrontendDocument {
                    tokens, analysis.ast, analysis.module_documentation, analysis.diagnostics,
                    analysis.symbols, analysis.callables, analysis.dependencies, analysis.parsed
                }
            }
            let symbols = encore_strmap_new()
            let mut ordinal = 0_usize
            for symbol in analysis.symbols {
                if encore_strmap_get(symbols, symbol.name) == 0_usize {
                    encore_strmap_put(symbols, symbol.name, ordinal + 1_usize)
                }
                ordinal += 1_usize
            }
            let lines = semantic_source_lines(doc.text)
            let mut indexed_line = 0_usize
            let mut columns = semantic_utf16_columns(lines.get(0_usize).unwrap_or(""))
            let mut previous_line = 0_usize
            let mut previous_start = 0_usize
            let mut previous_end = 0_usize
            let mut first = true
            let mut in_import = false
            let mut formatted_string = false
            let mut index = 0_usize
            for token in tokens {
                if token.type == TokenType::NEWLINE {
                    in_import = false
                }
                if token.type == TokenType::KW_IMPORT {
                    in_import = true
                }
                if token.type == TokenType::KW_AS {
                    in_import = false
                }
                // Tree-sitter owns interpolated-string syntax. Never cover its
                // expression captures with one opaque semantic string span.
                let prefix = token.type == TokenType::IDENTIFIER && token.value == "f"
                && match tokens.get(index + 1_usize) {
                    Some(next) => next.type == TokenType::STRING
                    None => false
                }
                let skip = prefix ||(formatted_string && token.type == TokenType::STRING)
                formatted_string = prefix
                if !skip {
                    match semantic_token_kind(doc, token, index, symbols, in_import) {
                        Some(kind) => {
                            let parts = semantic_source_lines(token.value)
                            let mut part_index = 0_usize
                            for part in parts {
                                let line = token.line + part_index
                                if indexed_line != line {
                                    columns = semantic_utf16_columns(lines.get(line).unwrap_or(""))
                                    indexed_line = line
                                }
                                let character = if part_index == 0_usize {
                                    token.column
                                } else {
                                    0_usize
                                }
                                let start = columns.get(character).unwrap_or(0_usize)
                                let length = utf16_len(part)
                                if length > 0_usize &&(first || line > previous_line || start >= previous_end) {
                                    let delta_line = if first {
                                        line
                                    } else {
                                        line - previous_line
                                    }
                                    let delta_start = if first || delta_line > 0_usize {
                                        start
                                    } else {
                                        start - previous_start
                                    }
                                    data.push(json_usize(delta_line))
                                    data.push(json_usize(delta_start))
                                    data.push(json_usize(length))
                                    data.push(json_usize(kind))
                                    data.push(json_usize(semantic_token_modifier_bits(doc, token, symbols)))
                                    previous_line = line
                                    previous_start = start
                                    previous_end = start + length
                                    first = false
                                }
                                part_index += 1_usize
                            }
                        }
                        None => {
                        }
                    }
                }
                index += 1_usize
            }
            encore_strmap_free(symbols)
        }
        None => {
        }
    }
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("data", Json::Array(data)))
    ret Json::Object(fields)
}

fn semantic_utf16_columns(text: str) -> Vec[usize] {
    let mut columns = Vec[usize]::new()
    let mut units = 0_usize
    columns.push(units)
    let mut index = 0_usize
    while index < text.byte_len() {
        let byte = text.byte_at(index)
        if byte < 128_u8 || byte >= 192_u8 {
            units += if byte >= 240_u8 {
                2_usize
            } else {
                1_usize
            }
            columns.push(units)
        }
        index += 1_usize
    }
    ret columns
}

fn semantic_source_lines(text: str) -> Vec[str] {
    let mut lines = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    while index < text.byte_len() {
        if text.byte_at(index) == 10_u8 {
            let end = if index > start && text.byte_at(index - 1_usize) == 13_u8 {
                index - 1_usize
            } else {
                index
            }
            lines.push(text.slice_bytes(start, end - start))
            start = index + 1_usize
        }
        index += 1_usize
    }
    lines.push(text.slice_bytes(start, text.byte_len() - start))
    ret lines
}

fn semantic_token_kind(doc: Document, token: Token, token_index: usize, symbols: usize, in_import: bool) -> Option[usize] {
    if is_keyword_token(token.type) {
        ret Option[usize]::Some(0_usize)
    }
    if token.type == TokenType::INTEGER || token.type == TokenType::FLOAT {
        ret Option[usize]::Some(7_usize)
    }
    if token.type == TokenType::STRING {
        ret Option[usize]::Some(8_usize)
    }
    if token.type == TokenType::ONE_LINE_COMMENT || token.type == TokenType::MULTI_LINE_COMMENT ||
    token.type == TokenType::DOC_COMMENT || token.type == TokenType::MODULE_DOC_COMMENT {
        ret Option[usize]::Some(10_usize)
    }
    if is_operator_token(token.type) {
        ret Option[usize]::Some(9_usize)
    }
    if token.type == TokenType::IDENTIFIER {
        if in_import {
            if semantic_type_name(token.value) {
                ret Option[usize]::Some(2_usize)
            }
            ret Option[usize]::Some(11_usize)
        }
        let ordinal = encore_strmap_get(symbols, token.value)
        if ordinal > 0_usize {
            match doc.analysis.symbols.get(ordinal - 1_usize) {
                Option[FrontendSymbol]::Some(symbol) => {
                    ret Option[usize]::Some(semantic_kind_for_symbol(symbol))
                }
                Option[FrontendSymbol]::None => {
                }
            }
        }
        if token_is_call(doc, token_index) {
            ret Option[usize]::Some(1_usize)
        }
        if semantic_type_name(token.value) {
            ret Option[usize]::Some(2_usize)
        }
        // Unresolved names are left to syntax highlighting, not mislabeled as variables.
        ret Option[usize]::None
    }
    ret Option[usize]::None
}

fn semantic_type_name(name: str) -> bool {
    if name == "bool" || name == "str" || name == "char" || name == "usize" || name == "isize"
    || name == "u8" || name == "u16" || name == "u32" || name == "u64"
    || name == "i8" || name == "i16" || name == "i32" || name == "i64"
    || name == "f32" || name == "f64" {
        ret true
    }
    if name.byte_len() == 0_usize {
        ret false
    }
    ret name.byte_at(0_usize) >= 65_u8 && name.byte_at(0_usize) <= 90_u8
}

fn semantic_kind_for_symbol(symbol: FrontendSymbol) -> usize {
    if symbol.kind == 12_usize {
        ret 1_usize
    }
    if symbol.kind == 23_usize {
        ret 3_usize
    }
    if symbol.kind == 10_usize {
        ret 4_usize
    }
    if symbol.kind == 11_usize {
        ret 5_usize
    }
    ret 6_usize
}

fn semantic_token_modifier_bits(doc: Document, token: Token, symbols: usize) -> usize {
    if token.type != TokenType::IDENTIFIER {
        ret 0_usize
    }
    let ordinal = encore_strmap_get(symbols, token.value)
    if ordinal > 0_usize {
        match doc.analysis.symbols.get(ordinal - 1_usize) {
            Option[FrontendSymbol]::Some(symbol) => {
                if symbol.line == token.line && symbol.column == token.column {
                    ret 3_usize
                }
            }
            Option[FrontendSymbol]::None => {
            }
        }
    }
    ret 0_usize
}

fn token_is_call(doc: Document, token_index: usize) -> bool {
    let mut index = token_index + 1_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(next) => {
                if next.type == TokenType::WHITESPACE {
                    index += 1_usize
                    continue
                }
                ret next.type == TokenType::LEFT_PAREN
            }
            Option[Token]::None => {
                ret false
            }
        }
    }
    ret false
}

fn formatting_edits(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            let module_name = analysis_module_name(state, doc.uri)
            let syntax = if analysis_pending_for_uri(state, doc.uri) {
                SyntaxDocument::parse(doc.text)
            } else {
                match state.analysis.syntax_document(module_name) {
                    Option[SyntaxDocument]::Some(value) => value
                    Option[SyntaxDocument]::None => SyntaxDocument::parse(doc.text)
                }
            }
            let result = format_syntax(syntax, doc.analysis.diagnostics, format_config_for_uri(doc.uri))
            if !result.is_valid() || !result.is_changed() {
                ret Json::Array(Vec[Json]::new())
            }
            let last_line = document_last_line(doc.text)
            let mut last_character = 0_usize
            match line_text_at(doc.text, last_line) {
                Option[str]::Some(text) => {
                    last_character = utf16_len(text)
                }
                Option[str]::None => {
                }
            }
            let mut edits = Vec[Json]::new()
            edits.push(text_edit(range_between(0_usize, 0_usize, last_line, last_character), result.text()))
            ret Json::Array(edits)
        }
        Option[Document]::None => {
        }
    }
    ret Json::Array(Vec[Json]::new())
}

fn format_config_for_uri(uri: str) -> FormatConfig {
    match project_root_for_path(uri_to_path(uri)) {
        Option[str]::Some(root) => {
            let tooling = read_project_tooling_config_at(root)
            if tooling.is_valid() {
                ret tooling.format_config()
            }
        }
        Option[str]::None => {
        }
    }
    ret FormatConfig::new()
}

fn identifier_at_request(doc: Document, params: Json) -> Option[Token] {
    let position = json_get(params, "position")
    let line = json_number_usize(json_get(position, "line"), 0_usize)
    let character = request_character_index(doc, line, json_number_usize(json_get(position, "character"),
            0_usize,))
    ret identifier_at(doc, line, character)
}

fn identifier_at(doc: Document, line: usize, character: usize) -> Option[Token] {
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER && token.line == line {
                    let column = actual_token_column_at_index(doc, index, token)
                    if column <= character && character <= column + token.value.char_len() {
                        ret Option[Token]::Some(token)
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[Token]::None
}

fn symbol_by_name(doc: Document, name: str) -> Option[FrontendSymbol] {
    let mut index = 0_usize
    while index < doc.analysis.symbols.len() {
        match doc.analysis.symbols.get(index) {
            Option[FrontendSymbol]::Some(symbol) => {
                if symbol.name == name {
                    ret Option[FrontendSymbol]::Some(symbol)
                }
            }
            Option[FrontendSymbol]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[FrontendSymbol]::None
}

fn symbol_by_name_in_workspace(state: ServerState, current_doc: Document, name: str) -> Option[FrontendSymbol]
{
    match symbol_by_name(current_doc, name) {
        Option[FrontendSymbol]::Some(symbol) => {
            ret Option[FrontendSymbol]::Some(symbol)
        }
        Option[FrontendSymbol]::None => {
        }
    }

    let mut index = 0_usize
    while index < state.documents.len() {
        match state.documents.get(index) {
            Option[Document]::Some(doc) => {
                match symbol_by_name(doc, name) {
                    Option[FrontendSymbol]::Some(symbol) => {
                        ret Option[FrontendSymbol]::Some(symbol)
                    }
                    Option[FrontendSymbol]::None => {
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        index += 1_usize
    }

    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    match symbol_by_name(doc, name) {
                        Option[FrontendSymbol]::Some(symbol) => {
                            ret Option[FrontendSymbol]::Some(symbol)
                        }
                        Option[FrontendSymbol]::None => {
                        }
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret Option[FrontendSymbol]::None
}

fn symbol_location_in_open_documents(state: ServerState, current_doc: Document, name: str) -> Option[Json]
{
    match symbol_by_name(current_doc, name) {
        Option[FrontendSymbol]::Some(symbol) => {
            ret Option[Json]::Some(location_json(current_doc.uri, symbol_range(current_doc, symbol)))
        }
        Option[FrontendSymbol]::None => {
        }
    }

    let mut index = 0_usize
    while index < state.documents.len() {
        match state.documents.get(index) {
            Option[Document]::Some(doc) => {
                match symbol_by_name(doc, name) {
                    Option[FrontendSymbol]::Some(symbol) => {
                        ret Option[Json]::Some(location_json(doc.uri, symbol_range(doc, symbol)))
                    }
                    Option[FrontendSymbol]::None => {
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        index += 1_usize
    }
    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    match symbol_by_name(doc, name) {
                        Option[FrontendSymbol]::Some(symbol) => {
                            ret Option[Json]::Some(location_json(doc.uri, symbol_range(doc, symbol)))
                        }
                        Option[FrontendSymbol]::None => {
                        }
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret Option[Json]::None
}

fn callable_by_name_in_open_documents(state: ServerState, name: str) -> Option[FrontendCallable] {
    let mut doc_index = 0_usize
    while doc_index < state.documents.len() {
        match state.documents.get(doc_index) {
            Option[Document]::Some(doc) => {
                match callable_by_name(doc, name) {
                    Option[FrontendCallable]::Some(callable) => {
                        ret Option[FrontendCallable]::Some(callable)
                    }
                    Option[FrontendCallable]::None => {
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        doc_index += 1_usize
    }
    let mut workspace_index = 0_usize
    while workspace_index < state.workspace_documents.len() {
        match state.workspace_documents.get(workspace_index) {
            Option[Document]::Some(doc) => {
                if !open_document_exists(state, doc.uri) {
                    match callable_by_name(doc, name) {
                        Option[FrontendCallable]::Some(callable) => {
                            ret Option[FrontendCallable]::Some(callable)
                        }
                        Option[FrontendCallable]::None => {
                        }
                    }
                }
            }
            Option[Document]::None => {
            }
        }
        workspace_index += 1_usize
    }
    ret Option[FrontendCallable]::None
}

fn callable_by_name(doc: Document, name: str) -> Option[FrontendCallable] {
    let mut callable_index = 0_usize
    while callable_index < doc.analysis.callables.len() {
        match doc.analysis.callables.get(callable_index) {
            Option[FrontendCallable]::Some(callable) => {
                if callable.name == name {
                    ret Option[FrontendCallable]::Some(callable)
                }
            }
            Option[FrontendCallable]::None => {
            }
        }
        callable_index += 1_usize
    }
    ret Option[FrontendCallable]::None
}

fn token_cursor_index(doc: Document, line: usize, character: usize) -> usize {
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.line > line {
                    ret index
                }
                if token.line == line {
                    let column = actual_token_column(doc, token)
                    if column >= character {
                        ret index
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret doc.analysis.tokens.len()
}

fn symbol_hover_text(symbol: FrontendSymbol) -> str {
    let mut signature = symbol.name
    if symbol.kind == 12_usize {
        signature = "fn " + symbol.name
    } elif symbol.kind == 23_usize {
        signature = "struct " + symbol.name
    } elif symbol.kind == 10_usize {
        signature = "enum " + symbol.name
    } elif symbol.kind == 11_usize {
        signature = "trait " + symbol.name
    }
    let mut hover = "```encore\n" + signature + "\n```"
    match symbol.documentation {
        Option::Some(documentation) => {
            if documentation.text != "" {
                hover = hover + "\n\n" + documentation.text
            }
        }
        Option::None => {
        }
    }
    ret hover
}

fn symbol_range(doc: Document, symbol: FrontendSymbol) -> Json {
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER && token.line == symbol.line && token.value ==
                symbol.name {
                    ret token_range(doc, token)
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret lsp_range(doc, symbol.line, symbol.column, symbol.length)
}

fn token_range(doc: Document, token: Token) -> Json {
    let column = actual_token_column(doc, token)
    ret lsp_range(doc, token.line, column, token.value.char_len())
}

fn token_range_at_index(doc: Document, token_index: usize, token: Token) -> Json {
    let column = actual_token_column_at_index(doc, token_index, token)
    ret lsp_range(doc, token.line, column, token.value.char_len())
}

fn request_character_index(doc: Document, line: usize, lsp_character: usize) -> usize {
    match line_text_at(doc.text, line) {
        Some(text) => {
            ret character_index_from_utf16(text, lsp_character)
        }
        None => {
            ret lsp_character
        }
    }
}

fn lsp_column(doc: Document, line: usize, character: usize) -> usize {
    match line_text_at(doc.text, line) {
        Some(text) => {
            ret utf16_column(text, character)
        }
        None => {
            ret character
        }
    }
}

fn lsp_range(doc: Document, line: usize, character: usize, length: usize) -> Json {
    match line_text_at(doc.text, line) {
        Some(text) => {
            let start = utf16_column(text, character)
            let end = utf16_column(text, character + length)
            ret range_between(line, start, line, end)
        }
        None => {
            ret make_range(line, character, length)
        }
    }
}

fn actual_token_column(doc: Document, token: Token) -> usize {
    let _document = doc
    ret token.column
}

fn actual_token_column_at_index(doc: Document, token_index: usize, token: Token) -> usize {
    let _document = doc
    let _index = token_index
    ret token.column
}

fn find_token_in_line_at_or_after(line: str, token: Token, start: usize) -> usize {
    let mut column = start
    loop {
        let found = find_in_line_at_or_after(line, token.value, column)
        if !is_identifier_name(token.value) {
            ret found
        }
        let before_is_identifier = found > 0_usize && is_identifier_name(line.get(found - 1_usize).unwrap_or(""))
        let after = found + token.value.char_len()
        let after_is_identifier = after < line.char_len() && is_identifier_name(line.get(after).unwrap_or(""))
        if !before_is_identifier && !after_is_identifier {
            ret found
        }
        if found + 1_usize >= line.char_len() {
            ret start
        }
        column = found + 1_usize
    }
    ret start
}

fn type_completion_requested(doc: Document, params: Json) -> bool {
    let position = json_get(params, "position")
    let line = json_number_usize(json_get(position, "line"), 0_usize)
    let character = request_character_index(doc, line, json_number_usize(json_get(position, "character"),
            0_usize,))
    ret cursor_expects_type(doc.analysis.tokens, line, character)
}

fn type_completion_items(state: mut ServerState, doc: Document, params: Json) -> Vec[Json] {
    let mut items = Vec[Json]::new()
    push_builtin_type_items(items)
    push_visible_generic_type_items(items, doc, params)
    push_visible_completion_items(state, items, doc, params, true)
    push_autoimport_items(state, items, doc, params, true)
    ret items
}

fn push_builtin_type_items(items: mut Vec[Json]) ->() {
    let mut builtins = Vec[str]::new()
    builtins.push("bool")
    builtins.push("char")
    builtins.push("str")
    builtins.push("usize")
    builtins.push("isize")
    builtins.push("u8")
    builtins.push("u16")
    builtins.push("u32")
    builtins.push("u64")
    builtins.push("u128")
    builtins.push("i8")
    builtins.push("i16")
    builtins.push("i32")
    builtins.push("i64")
    builtins.push("i128")
    builtins.push("f32")
    builtins.push("f64")
    for builtin in builtins {
        items.push(completion_item(builtin, 7_usize, "Encore built-in type"))
    }
    ret()
}

fn is_type_symbol(symbol: FrontendSymbol) -> bool {
    ret symbol.kind == 23_usize || symbol.kind == 10_usize || symbol.kind == 11_usize
}

fn push_visible_generic_type_items(items: mut Vec[Json], doc: Document, params: Json) ->() {
    let position = json_get(params, "position")
    let line = json_number_usize(json_get(position, "line"), 0_usize)
    let character = request_character_index(doc, line, json_number_usize(json_get(position, "character"),
            0_usize,))
    let cursor = token_cursor_index(doc, line, character)
    let mut fn_index = cursor
    let mut found = false
    while fn_index > 0_usize {
        fn_index -= 1_usize
        match doc.analysis.tokens.get(fn_index) {
            Some(token) => {
                if token.type == TokenType::KW_FN {
                    found = true
                    break
                }
                if token.type == TokenType::LEFT_BRACE || token.type == TokenType::RIGHT_BRACE {
                    ret()
                }
            }
            None => {
            }
        }
    }
    if !found {
        ret()
    }
    let mut index = fn_index + 1_usize
    let mut bracket_depth = 0_i32
    while index < cursor {
        match doc.analysis.tokens.get(index) {
            Some(token) => {
                if token.type == TokenType::LEFT_PAREN && bracket_depth == 0_i32 {
                    break
                }
                if token.type == TokenType::LEFT_BRACKET {
                    bracket_depth += 1_i32
                } elif token.type == TokenType::RIGHT_BRACKET {
                    bracket_depth -= 1_i32
                } elif bracket_depth == 1_i32 && token.type == TokenType::IDENTIFIER {
                    if !completion_item_exists(items, token.value) {
                        items.push(completion_item(token.value, 25_usize, "Function generic type"))
                    }
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn keyword_completion_items() -> Vec[Json] {
    let mut items = Vec[Json]::new()
    push_keyword_completion(items, "as")
    push_keyword_completion(items, "async")
    push_keyword_completion(items, "await")
    push_keyword_completion(items, "break")
    push_keyword_completion(items, "continue")
    push_keyword_completion(items, "do")
    push_keyword_completion(items, "dyn")
    push_keyword_completion(items, "ehir")
    push_keyword_completion(items, "elif")
    push_keyword_completion(items, "else")
    push_keyword_completion(items, "enum")
    push_keyword_completion(items, "extern")
    push_keyword_completion(items, "false")
    push_keyword_completion(items, "fn")
    push_keyword_completion(items, "for")
    push_keyword_completion(items, "if")
    push_keyword_completion(items, "impl")
    push_keyword_completion(items, "import")
    push_keyword_completion(items, "in")
    push_keyword_completion(items, "let")
    push_keyword_completion(items, "loop")
    push_keyword_completion(items, "match")
    push_keyword_completion(items, "mut")
    push_keyword_completion(items, "pub")
    push_keyword_completion(items, "ret")
    push_keyword_completion(items, "spawn")
    push_keyword_completion(items, "static")
    push_keyword_completion(items, "struct")
    push_keyword_completion(items, "trait")
    push_keyword_completion(items, "true")
    push_keyword_completion(items, "unsafe")
    push_keyword_completion(items, "while")
    push_keyword_completion(items, "with")
    ret items
}

fn push_keyword_completion(items: mut Vec[Json], label: str) ->() {
    items.push(completion_item(label, 14_usize, "Encore keyword"))
    ret()
}

fn completion_item(label: str, kind: usize, detail: str) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("label", Json::String(label)))
    fields.push(field("kind", json_usize(kind)))
    fields.push(field("detail", Json::String(detail)))
    ret Json::Object(fields)
}

fn completion_item_documented(label: str, kind: usize, detail: str, documentation: str) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("label", Json::String(label)))
    fields.push(field("kind", json_usize(kind)))
    fields.push(field("detail", Json::String(detail)))
    let mut markup = Vec[(str, Json)]::new()
    markup.push(field("kind", Json::String("markdown")))
    markup.push(field("value", Json::String(documentation)))
    fields.push(field("documentation", Json::Object(markup)))
    ret Json::Object(fields)
}

fn symbol_completion_kind(symbol_kind: usize) -> usize {
    if symbol_kind == 12_usize {
        ret 3_usize
    }
    if symbol_kind == 23_usize {
        ret 7_usize
    }
    if symbol_kind == 10_usize {
        ret 13_usize
    }
    if symbol_kind == 11_usize {
        ret 8_usize
    }
    ret 9_usize
}

fn document_diagnostics_json(state: mut ServerState, doc: Document,
    include_typed: bool,) -> Vec[Json] {
    let mut items = diagnostics_to_lsp(doc, doc.analysis.diagnostics)
    let analyzer_diagnostics = analyzer_frontend_diagnostics(analyze_source_document(doc.uri, doc.text,
            doc.analysis, analyzer_config_for_uri(doc.uri),))
    items.extend(diagnostics_to_lsp(doc, analyzer_diagnostics))
    items.extend(diagnostics_to_lsp(doc, tolerant_import_diagnostics(state, doc)))
    for graph in state.project_graphs {
        if graph.entry == uri_to_path(doc.uri) && graph.ready {
            items.extend(diagnostics_to_lsp(doc, graph.diagnostics))
        }
    }
    // Only schedule typed checks when
    // the tolerant frontend has established that the document is syntactically
    // complete; buffers between two keystrokes keep lightweight diagnostics.
    if include_typed && doc.analysis.diagnostics.len() == 0_usize && doc.analysis.parsed {
        let typed_diagnostics = semantic_result_for_uri(state, doc.uri).unwrap_or(Vec[FrontendDiagnostic]::new())
        let mut typed_without_imports = Vec[FrontendDiagnostic]::new()
        for diagnostic in typed_diagnostics {
            // Import availability is resolved against the live manifest and
            // package index above. The semantic database only contains source
            // modules loaded into this LSP process and can therefore be stale
            // immediately after `encore add`.
            let mut resolved_external_call = false
            if diagnostic.code == "unresolved-call" {
                match identifier_at(doc, diagnostic.line, diagnostic.column) {
                    Some(token) => {
                        resolved_external_call = imported_symbol_resolves(state, doc, token.value)
                    }
                    None => {
                    }
                }
            }
            if diagnostic.code != "unresolved-import" && !resolved_external_call {
                typed_without_imports.push(diagnostic)
            }
        }
        items.extend(diagnostics_to_lsp(doc, typed_without_imports))
    }
    ret items
}

fn imported_symbol_resolves(state: mut ServerState, doc: Document, name: str) -> bool {
    for edge in doc.analysis.dependencies.all() {
        let mut target = edge.target
        if ends_with(target, "::*") {
            target = target.slice(0_usize, target.len() - 3_usize)
        } else {
            let parts = split_scope_path(target)
            if parts.len() < 2_usize || parts.get(parts.len() - 1_usize).unwrap_or("") != name {
                continue
            }
            target = join_scope_parts(parts, parts.len() - 1_usize)
        }
        let mut items = Vec[Json]::new()
        push_import_symbol_items(state, doc, items, target, name)
        if completion_item_exists(items, name) {
            ret true
        }
    }
    ret false
}

fn tolerant_import_diagnostics(state: ServerState, doc: Document) -> Vec[FrontendDiagnostic] {
    let mut diagnostics = Vec[FrontendDiagnostic]::new()
    for edge in doc.analysis.dependencies.all() {
        if !tolerant_import_resolves(state, doc, edge.target) {
            diagnostics.push(FrontendDiagnostic::new(1_usize, "unresolved-import", "unresolved import `"
                    + edge.target + "`", edge.line, edge.column, if edge.length == 0_usize {
                        1_usize
                    } else {
                        edge.length
                    }
                    ,).with_label("", edge.line, edge.column, edge.length,
                    DiagnosticLabelKind::Primary, "cannot resolve this import",))
        }
    }
    ret diagnostics
}

fn tolerant_import_resolves(state: ServerState, doc: Document, target: str) -> bool {
    let mut cleaned = target
    if ends_with(cleaned, "::*") {
        cleaned = cleaned.slice(0_usize, cleaned.len() - 3_usize)
    }
    let parts = split_scope_path(cleaned)
    if parts.len() == 0_usize {
        ret false
    }
    let package = parts.get(0_usize).unwrap_or("")
    if !project_declares_package(doc, package) {
        ret false
    }
    let request = ImportRequest {
        "", cleaned, Option[str]::None, false, 0_usize, 0_usize, 0_usize
    }
    match resolve_import_request_uri(state, doc, request) {
        Some(_) => {
            ret true
        }
        None => {
        }
    }
    ret false
}

fn project_declares_package(doc: Document, package: str) -> bool {
    // `refrain` and `repo` address modules in the current project's source
    // tree; they are not manifest dependencies.
    if package == "core" || package == "refrain" || package == "repo" {
        ret true
    }
    match project_root_for_path(uri_to_path(doc.uri)) {
        Some(root) => {
            if project_name_for_root(root) == package {
                ret true
            }
            match path_dependency_project(root, package) {
                Some(_) => {
                    ret true
                }
                None => {
                }
            }
            let manifest = read_file(join_path(root, "encore.toml"))
            if contains_substring(manifest, "\"index@" + package + "\"")
            || contains_substring(manifest, "\"index@" + package + "@")
            || contains_substring(manifest, "\"index@" + package + "[")
            || contains_substring(manifest, "\"sys@" + package + "\"")
            || contains_substring(manifest, "\"workspace@" + package + "\"") {
                ret true
            }
        }
        None => {
        }
    }
    ret false
}

fn analyzer_config_for_uri(uri: str) -> AnalyzerConfig {
    match project_root_for_path(uri_to_path(uri)) {
        Option[str]::Some(root) => {
            let tooling = read_project_tooling_config_at(root)
            if tooling.is_valid() {
                ret tooling.lint_config()
            }
        }
        Option[str]::None => {
        }
    }
    ret AnalyzerConfig::new()
}

fn token_has_type(doc: Document, token_index: usize, kind: TokenType) -> bool {
    match doc.analysis.tokens.get(token_index) {
        Option[Token]::Some(token) => {
            ret token.type == kind
        }
        Option[Token]::None => {
            ret false
        }
    }
}

fn usize_text(value: usize) -> str {
    ret Debug::fmt(value)
}

fn document_diagnostic_result(state: mut ServerState, params: Json) -> Json {
    let uri = request_uri(params)
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("kind", Json::String("full")))
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            fields.push(field("items", Json::Array(document_diagnostics_json(state, doc,
                            !analysis_pending_for_uri(state, uri),))))
        }
        Option[Document]::None => {
            fields.push(field("items", Json::Array(Vec[Json]::new())))
        }
    }
    ret Json::Object(fields)
}

fn workspace_diagnostic_result(_state: ServerState) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("items", Json::Array(Vec[Json]::new())))
    ret Json::Object(fields)
}

fn publish_diagnostics_for_uri(state: mut ServerState, uri: str) ->() {
    match state.document(uri) {
        Option[Document]::Some(doc) => {
            send_notification("textDocument/publishDiagnostics", publish_diagnostics_params(uri, document_diagnostics_json(state,
                        doc, false,)))
        }
        Option[Document]::None => {
        }
    }
    ret()
}

fn publish_semantic_diagnostics_for_uri(state: mut ServerState, uri: str) ->() {
    // Only open buffers receive push diagnostics. Workspace-only documents
    // may still be checked to answer an explicit pull request.
    for doc in state.documents {
        if doc.uri == uri {
            send_notification("textDocument/publishDiagnostics", publish_diagnostics_params(uri,
                    document_diagnostics_json(state, doc, true),))
            ret()
        }
    }
    ret()
}

fn publish_diagnostics_params(uri: str, diagnostics: Vec[Json]) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("uri", Json::String(uri)))
    fields.push(field("diagnostics", Json::Array(diagnostics)))
    ret Json::Object(fields)
}

fn diagnostics_to_lsp(doc: Document, diagnostics: Vec[FrontendDiagnostic]) -> Vec[Json] {
    let mut items = Vec[Json]::new()
    let mut index = 0_usize
    while index < diagnostics.len() {
        match diagnostics.get(index) {
            Option[FrontendDiagnostic]::Some(diagnostic) => {
                items.push(diagnostic_to_lsp(doc, diagnostic))
            }
            Option[FrontendDiagnostic]::None => {
            }
        }
        index += 1_usize
    }
    ret items
}

fn diagnostic_source_uri(doc: Document, source_name: str) -> str {
    if source_name == "" {
        ret doc.uri
    }
    if starts_with(source_name, "file://") {
        ret source_name
    }
    ret path_to_uri(source_name)
}

fn diagnostic_to_lsp(doc: Document, diagnostic: FrontendDiagnostic) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("range", diagnostic_primary_range(doc, diagnostic)))
    fields.push(field("severity", json_usize(diagnostic.severity)))
    fields.push(field("code", Json::String(diagnostic.code)))
    fields.push(field("source", Json::String("encore-lsp")))
    fields.push(field("message", Json::String(diagnostic_lsp_message(diagnostic))))

    let mut related = Vec[Json]::new()
    for label in diagnostic.labels {
        if label.kind == DiagnosticLabelKind::Secondary {
            let uri = diagnostic_source_uri(doc, label.source_name)
            let mut location = Vec[(str, Json)]::new()
            location.push(field("uri", Json::String(uri)))
            location.push(field("range", range_between(label.line, label.column, label.line, label.column
                        + max_usize(label.length, 1_usize),)))
            let mut item = Vec[(str, Json)]::new()
            item.push(field("location", Json::Object(location)))
            item.push(field("message", Json::String(label.message)))
            related.push(Json::Object(item))
        }
    }
    if related.len() > 0_usize {
        fields.push(field("relatedInformation", Json::Array(related)))
    }

    let mut suggestions = Vec[Json]::new()
    for suggestion in diagnostic.suggestions {
        let mut item = Vec[(str, Json)]::new()
        item.push(field("uri", Json::String(diagnostic_source_uri(doc, suggestion.source_name))))
        item.push(field("range", lsp_range(doc, suggestion.line, suggestion.column, suggestion.length)))
        item.push(field("replacement", Json::String(suggestion.replacement)))
        item.push(field("message", Json::String(suggestion.message)))
        item.push(field("applicability", Json::String(applicability_name(suggestion.applicability))))
        suggestions.push(Json::Object(item))
    }
    if suggestions.len() > 0_usize {
        let mut data = Vec[(str, Json)]::new()
        data.push(field("suggestions", Json::Array(suggestions)))
        fields.push(field("data", Json::Object(data)))
    }
    ret Json::Object(fields)
}

fn diagnostic_primary_range(doc: Document, diagnostic: FrontendDiagnostic) -> Json {
    for label in diagnostic.labels {
        if label.kind == DiagnosticLabelKind::Primary {
            ret lsp_range(doc, label.line, label.column, label.length)
        }
    }
    ret diagnostic_range(doc, diagnostic)
}

fn diagnostic_lsp_message(diagnostic: FrontendDiagnostic) -> str {
    let mut message = diagnostic.message
    for note in diagnostic.notes {
        message += "\nnote: " + note
    }
    for help in diagnostic.helps {
        message += "\nhelp: " + help
    }
    ret message
}

fn max_usize(left: usize, right: usize) -> usize {
    if left > right {
        ret left
    }
    ret right
}

fn diagnostic_range(doc: Document, diagnostic: FrontendDiagnostic) -> Json {
    if starts_with(diagnostic.code, "unclosed-") {
        match line_text_at(doc.text, diagnostic.line) {
            Option[str]::Some(line) => {
                ret range_between(diagnostic.line, utf16_len(line), diagnostic.line, utf16_len(line)
                    + 1_usize,)
            }
            Option[str]::None => {
            }
        }
    }
    ret lsp_range(doc, diagnostic.line, diagnostic.column, diagnostic.length)
}

fn request_uri(params: Json) -> str {
    ret json_get_str(json_get(params, "textDocument"), "uri", "")
}

fn exit_process(code: i32) -> i32 {
    unsafe {
        ret encore_proc_exit(code)
    }
}

fn cwd() -> str {
    unsafe {
        ret encore_os_cwd()
    }
}

fn home_directory() -> str {
    unsafe {
        ret encore_os_home_dir()
    }
}

fn read_file(path: str) -> str {
    unsafe {
        ret encore_fs_read_file(path)
    }
}

fn file_exists(path: str) -> bool {
    unsafe {
        ret encore_fs_status(path) == 0_i32
    }
}

fn read_dir(path: str) -> Vec[str] {
    let raw = unsafe {
        encore_fs_read_dir(path)
    }
    ret split_lines(raw)
}

fn split_lines(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let total = value.len()
    if total == 0_usize {
        ret out
    }

    let mut start = 0_usize
    let mut index = 0_usize
    loop {
        if index >= total {
            break
        }
        match value.get(index) {
            Option[str]::Some(ch) => {
                if ch == "\n" {
                    if index > start {
                        out.push(value.slice(start, index - start))
                    }
                    start = index + 1_usize
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    if start < total {
        out.push(value.slice(start, total - start))
    }
    ret out
}
