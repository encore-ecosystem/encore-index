//! Provides the `iter` module.

import core::option::Option

/// Defines the behavior required by `Iterator` implementations.
pub trait Iterator[T] {
    fn next(self: Self) -> (Self, Option[T])
}

/// Defines the behavior required by `IntoIterator` implementations.
pub trait IntoIterator[T, Iter] {
    fn into_iter(self: Self) -> Iter
}

/// Stores the state of a `Enumerate` value.
pub struct Enumerate[T, Iter] {
    iter: Iter
    index: usize
}

/// Stores the state of a `Range` value.
pub struct Range {
    current: usize
    end: usize
    inclusive: bool
    done: bool
}

impl Iterator[usize] for Range {
    /// Performs the `next` operation.
    pub fn next(self: Range) -> (Range, Option[usize]) {
        if self.done {
            ret (self, Option[usize]::None)
        }

        if self.inclusive {
            if self.current > self.end {
                ret (Range{self.current, self.end, self.inclusive, true}, Option[usize]::None)
            }
        } else {
            if self.current >= self.end {
                ret (Range{self.current, self.end, self.inclusive, true}, Option[usize]::None)
            }
        }

        let out = self.current
        ret (
            Range{self.current + 1_usize, self.end, self.inclusive, false},
            Option[usize]::Some(out),
        )
    }
}

impl for Range {
    /// Performs the `iter` operation.
    pub fn iter(self: Range) -> Range {
        ret self
    }

    /// Performs the `next` operation.
    pub fn next(self: Range) -> (Range, Option[usize]) {
        if self.done {
            ret (self, Option[usize]::None)
        }

        if self.inclusive {
            if self.current > self.end {
                ret (Range{self.current, self.end, self.inclusive, true}, Option[usize]::None)
            }
        } else {
            if self.current >= self.end {
                ret (Range{self.current, self.end, self.inclusive, true}, Option[usize]::None)
            }
        }

        let out = self.current
        ret (
            Range{self.current + 1_usize, self.end, self.inclusive, false},
            Option[usize]::Some(out),
        )
    }

    /// Performs the `into_iter` operation.
    pub fn into_iter(self: Range) -> Range {
        ret self
    }
}

impl IntoIterator[usize, Range] for Range {
    /// Performs the `into_iter` operation.
    pub fn into_iter(self: Range) -> Range {
        ret self
    }
}

impl[T, Iter: Iterator[T]] Iterator[(usize, T)] for Enumerate[T, Iter] {
    /// Performs the `next` operation.
    pub fn next(self: Enumerate[T, Iter]) -> (Enumerate[T, Iter], Option[(usize, T)]) {
        let step = self.iter.next()
        let next_iter = step.0
        match step.1 {
            Option[T]::Some(value) => {
                ret (
                    Enumerate[T, Iter]{next_iter, self.index + 1_usize},
                    Option[(usize, T)]::Some((self.index, value)),
                )
            }
            Option[T]::None => {
                ret (
                    Enumerate[T, Iter]{next_iter, self.index},
                    Option[(usize, T)]::None,
                )
            }
        }
    }
}

impl[T, Iter: Iterator[T]] for Enumerate[T, Iter] {
    /// Performs the `iter` operation.
    pub fn iter(self: Enumerate[T, Iter]) -> Enumerate[T, Iter] {
        ret self
    }

    /// Performs the `next` operation.
    pub fn next(self: Enumerate[T, Iter]) -> (Enumerate[T, Iter], Option[(usize, T)]) {
        let step = self.iter.next()
        let next_iter = step.0
        match step.1 {
            Option[T]::Some(value) => {
                ret (
                    Enumerate[T, Iter]{next_iter, self.index + 1_usize},
                    Option[(usize, T)]::Some((self.index, value)),
                )
            }
            Option[T]::None => {
                ret (
                    Enumerate[T, Iter]{next_iter, self.index},
                    Option[(usize, T)]::None,
                )
            }
        }
    }

    /// Performs the `into_iter` operation.
    pub fn into_iter(self: Enumerate[T, Iter]) -> Enumerate[T, Iter] {
        ret self
    }
}

impl[T, Iter: Iterator[T]] IntoIterator[(usize, T), Enumerate[T, Iter]] for Enumerate[T, Iter] {
    /// Performs the `into_iter` operation.
    pub fn into_iter(self: Enumerate[T, Iter]) -> Enumerate[T, Iter] {
        ret self
    }
}

/// Performs the `enumerate` operation.
pub fn enumerate[T, Iter: Iterator[T]](iter: Iter) -> Enumerate[T, Iter] {
    ret Enumerate[T, Iter]{iter, 0_usize}
}

/// Performs the `range` operation.
pub fn range(start: usize, end: usize) -> Range {
    ret Range{start, end, false, false}
}

/// Performs the `range_inclusive` operation.
pub fn range_inclusive(start: usize, end: usize) -> Range {
    ret Range{start, end, true, false}
}
