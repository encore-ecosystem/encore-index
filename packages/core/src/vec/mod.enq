//! Provides growable vectors and vector iterators.

import core::fmt::Debug
import core::iter::IntoIterator
import core::iter::Iterator
import core::option::Option

extern fn encore_heap_is_unique(ptr: usize) -> bool

/// Owns a contiguous growable sequence of values.
///
/// Mutation uses copy-on-write when the backing allocation is shared.
pub struct Vec[T] {
    ptr: T*
    len: usize
    cap: usize
}

/// Traverses a vector without modifying its elements.
pub struct VecIter[T] {
    vec: Vec[T]
    index: usize
}

#attr(safe)
fn __vec_null_ptr[T]() -> T* {
    unsafe {
        unsafe ehir {
            zero: usize = lcpos 0_usize
            ptr: T* = pcast zero: usize, T*
        }
        ret ptr
    }
}

#attr(safe)
fn __vec_realloc[T](ptr: T*, count: usize) -> T* {
    unsafe {
        unsafe ehir {
            next_ptr: T* = hrealloc ptr: T*, count: usize
        }
        ret next_ptr
    }
}

#attr(safe)
#attr(borrowed_return)
fn __vec_load[T](ptr: T*, index: usize) -> T {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            value: T = load elem_ptr: T*
        }
        ret value
    }
}

#attr(safe)
fn __vec_get_handle[T](ptr: T*, index: usize) -> usize {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            handle: usize = pcast elem_ptr: T*, usize
        }
        ret handle
    }
}

#attr(safe)
fn __vec_load_retained[T](ptr: T*, index: usize) -> T {
    unsafe {
        let value = __vec_load[T](ptr, index)
        ret value
    }
}

#attr(safe)
fn __vec_store[T](ptr: T*, index: usize, value: T) -> bool {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            store value: T, elem_ptr: T*
        }
        ret true
    }
}

#attr(safe)
fn __vec_replace[T](ptr: T*, index: usize, value: T) -> bool {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            old: T = load elem_ptr: T*
            drop old: T
            store value: T, elem_ptr: T*
        }
        ret true
    }
}

#attr(safe)
fn __vec_drop_at[T](ptr: T*, index: usize) -> bool {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            old: T = load elem_ptr: T*
            drop old: T
        }
        ret true
    }
}

#attr(safe)
fn __vec_free_ptr[T](ptr: T*) -> bool {
    unsafe {
        unsafe ehir {
            hfree ptr: T*
        }
        ret true
    }
}

#attr(safe)
fn __vec_is_unique[T](ptr: T*) -> bool {
    unsafe {
        unsafe ehir {
            raw: usize = pcast ptr: T*, usize
        }
        ret encore_heap_is_unique(raw)
    }
}

fn __vec_next_cap(current: usize) -> usize {
    if current == 0_usize {
        ret 4_usize
    }
    ret current * 2_usize
}

fn __vec_reserve_exact[T](vec: mut Vec[T], new_cap: usize) -> () {
    if new_cap <= vec.cap && __vec_is_unique[T](vec.ptr) {
        ret ()
    }

    unsafe {
        // Mutating a shared buffer would give aliases inconsistent lengths or
        // elements. Clone through the typed ownership path before any write.
        let old = Vec[T]{vec.ptr, vec.len, vec.cap}
        let next_ptr = __vec_realloc[T](__vec_null_ptr[T](), new_cap)
        let mut index = 0_usize
        while index < old.len {
            let value = __vec_load_retained[T](old.ptr, index)
            __vec_store[T](next_ptr, index, value)
            index = index + 1_usize
        }
        vec.ptr = next_ptr
        vec.cap = new_cap
    }
    ret ()
}

impl[T] for Vec[T] {
    /// Creates an empty vector without preallocated capacity.
    pub fn new() -> Vec[T] {
        ret Vec[T]::with_capacity(0_usize)
    }

    /// Creates an empty vector able to hold at least `cap` values.
    pub fn with_capacity(cap: usize) -> Vec[T] {
        unsafe {
            if cap > 0_usize {
                let ptr = __vec_realloc[T](__vec_null_ptr[T](), cap)
                ret Vec[T]{ptr, 0_usize, cap}
            }
            ret Vec[T]{__vec_null_ptr[T](), 0_usize, 0_usize}
        }
    }

    /// Creates a vector containing exactly `value`.
    pub fn singleton(value: T) -> Vec[T] {
        let mut out = Vec[T]::new()
        out.push(value)
        ret out
    }

    #attr(borrowed_self)
    /// Returns the number of initialized elements.
    pub fn len(self: Vec[T]) -> usize {
        ret self.len
    }

    #attr(borrowed_self)
    /// Returns the number of elements the current allocation can hold.
    pub fn capacity(self: Vec[T]) -> usize {
        ret self.cap
    }

    #attr(borrowed_self)
    /// Returns whether the vector contains no elements.
    pub fn is_empty(self: Vec[T]) -> bool {
        ret self.len() == 0_usize
    }

    /// Ensures capacity for at least `additional` more elements.
    pub fn reserve(self: mut Vec[T], additional: usize) -> () {
        let required = self.len() + additional
        if required <= self.capacity() && __vec_is_unique[T](self.ptr) {
            ret ()
        }

        let mut next_cap = self.capacity()
        if next_cap == 0_usize { next_cap = __vec_next_cap(0_usize) }
        while next_cap < required {
            next_cap = __vec_next_cap(next_cap)
        }

        __vec_reserve_exact[T](self, next_cap)
        ret ()
    }

    /// Appends `value` to the end of the vector.
    pub fn push(self: mut Vec[T], value: T) -> () {
        self.reserve(1_usize)
        unsafe {
            __vec_store[T](self.ptr, self.len, value)
        }
        self.len = self.len + 1_usize
        ret ()
    }

    /// Replaces the element at `index`; out-of-bounds indices are ignored.
    pub fn set(self: mut Vec[T], index: usize, value: T) -> () {
        if index >= self.len {
            ret ()
        }
        self.reserve(0_usize)

        unsafe {
            __vec_replace[T](self.ptr, index, value)
        }
        ret ()
    }

    #attr(borrowed_self)
    /// Returns the element at `index`, or `None` when it is out of bounds.
    pub fn get(self: Vec[T], index: usize) -> Option[T] {
        if index >= self.len {
            ret Option[T]::None
        }

        unsafe {
            let value = __vec_load[T](self.ptr, index)
            ret Option[T]::Some(value)
        }
    }

    #attr(borrowed_self)
    /// Returns an internal element handle, or zero for an invalid index.
    ///
    /// This low-level API is intended for runtime integrations.
    pub fn get_handle(self: Vec[T], index: usize) -> usize {
        unsafe {
            if index >= self.len {
                ret 0_usize
            }
            ret __vec_get_handle[T](self.ptr, index)
        }
    }

    #attr(borrowed_self)
    /// Returns the first element, or `None` when the vector is empty.
    pub fn first(self: Vec[T]) -> Option[T] {
        ret self.get(0_usize)
    }

    #attr(borrowed_self)
    /// Returns the last element, or `None` when the vector is empty.
    pub fn last(self: Vec[T]) -> Option[T] {
        if self.len == 0_usize {
            ret Option[T]::None
        }
        ret self.get(self.len - 1_usize)
    }

    /// Drops every element while retaining the allocation.
    pub fn clear(self: mut Vec[T]) -> () {
        self.reserve(0_usize)
        let mut index = 0_usize
        while index < self.len {
            unsafe {
                __vec_drop_at[T](self.ptr, index)
            }
            index = index + 1_usize
        }
        self.len = 0_usize
        ret ()
    }

    /// Removes and returns the last element when present.
    pub fn pop(self: mut Vec[T]) -> Option[T] {
        if self.len == 0_usize {
            ret Option[T]::None
        }
        self.reserve(0_usize)

        let index = self.len - 1_usize
        match self.get(index) {
            Some(value) => {
                unsafe {
                    __vec_drop_at[T](self.ptr, index)
                }
                self.len = index
                ret Option[T]::Some(value)
            }
            None => {
                ret Option[T]::None
            }
        }
    }

    /// Appends every element from `other` in iteration order.
    pub fn extend(self: mut Vec[T], other: Vec[T]) -> () {
        self.reserve(other.len)
        let mut index = 0_usize
        while index < other.len {
            let value = unsafe { __vec_load_retained[T](other.ptr, index) }
            self.push(value)
            index = index + 1_usize
        }
        ret ()
    }

    /// Clears all elements and reports successful cleanup.
    pub fn free(self: mut Vec[T]) -> bool {
        self.clear()
        ret true
    }

    /// Creates an iterator positioned before the first element.
    pub fn iter(self: Vec[T]) -> VecIter[T] {
        ret VecIter[T]{self, 0_usize}
    }

    /// Converts this vector into its iterator representation.
    pub fn into_iter(self: Vec[T]) -> VecIter[T] {
        ret self.iter()
    }
}

impl[T] IntoIterator[T, VecIter[T]] for Vec[T] {
    /// Converts this vector into its iterator representation.
    pub fn into_iter(self: Vec[T]) -> VecIter[T] {
        ret self.iter()
    }
}

impl[T] Iterator[T] for VecIter[T] {
    /// Advances the iterator and returns the next element.
    pub fn next(self: VecIter[T]) -> (VecIter[T], Option[T]) {
        if self.index >= self.vec.len {
            ret (self, Option[T]::None)
        }
        unsafe {
            let value = __vec_load_retained[T](self.vec.ptr, self.index)
            ret (VecIter[T]{self.vec, self.index + 1_usize}, Option[T]::Some(value))
        }
    }
}

impl[T] for VecIter[T] {
    /// Returns this iterator without changing its position.
    pub fn iter(self: VecIter[T]) -> VecIter[T] {
        ret self
    }

    /// Advances the iterator and returns the next element.
    pub fn next(self: VecIter[T]) -> (VecIter[T], Option[T]) {
        if self.index >= self.vec.len {
            ret (self, Option[T]::None)
        }
        unsafe {
            let value = __vec_load_retained[T](self.vec.ptr, self.index)
            ret (VecIter[T]{self.vec, self.index + 1_usize}, Option[T]::Some(value))
        }
    }

    /// Returns this iterator as an `IntoIterator` value.
    pub fn into_iter(self: VecIter[T]) -> VecIter[T] {
        ret self
    }
}

impl[T] IntoIterator[T, VecIter[T]] for VecIter[T] {
    /// Returns this iterator as an `IntoIterator` value.
    pub fn into_iter(self: VecIter[T]) -> VecIter[T] {
        ret self
    }
}

/// Advances `iter`, returning its new state and optional element.
pub fn iter_next[T](iter: VecIter[T]) -> (VecIter[T], Option[T]) {
    if iter.index >= iter.vec.len {
        ret (iter, Option[T]::None)
    }
    unsafe {
        let value = __vec_load_retained[T](iter.vec.ptr, iter.index)
        ret (VecIter[T]{iter.vec, iter.index + 1_usize}, Option[T]::Some(value))
    }
}

/// Advances `iter` and returns only the updated iterator state.
pub fn iter_next_iter[T](iter: VecIter[T]) -> VecIter[T] {
    let step = iter_next[T](iter)
    ret step.0
}

/// Advances `iter` and returns only the optional element.
pub fn iter_next_item[T](iter: VecIter[T]) -> Option[T] {
    let step = iter_next[T](iter)
    ret step.1
}

impl[T:Debug] Debug for Vec[T] {
    /// Formats the value as text.
    pub fn fmt(self: Vec[T]) -> str {
        let mut out: str = "["
        let mut index: usize = 0_usize

        loop {
            match self.get(index) {
                Some(value) => {
                    if index > 0_usize {
                        out = out + ", "
                    }
                    let item_str: str = Debug::fmt(value)
                    out = out + item_str
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        ret out + "]"
    }
}

#attr(test)
fn vec_contract() -> bool {
    let mut vec = Vec[u32]::new()
    let initial_len = vec.len()
    vec.push(3_u32)
    vec.push(5_u32)
    vec.push(8_u32)
    vec.reserve(2_usize)
    ret initial_len == 0_usize
        && vec.len() == 3_usize
        && !vec.is_empty()
        && vec.capacity() >= 3_usize
}
