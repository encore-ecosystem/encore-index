impl Add[f32] for f32 { pub fn op(self: f32, other: f32) -> f32 { ehir { result: f32 = add self: f32, other: f32 } ret result } }
impl Sub[f32] for f32 { pub fn op(self: f32, other: f32) -> f32 { ehir { result: f32 = sub self: f32, other: f32 } ret result } }
impl Mul[f32] for f32 { pub fn op(self: f32, other: f32) -> f32 { ehir { result: f32 = mul self: f32, other: f32 } ret result } }
impl Div[f32] for f32 { pub fn op(self: f32, other: f32) -> f32 { ehir { result: f32 = div self: f32, other: f32 } ret result } }
impl Pow[i32] for f32 {
    /// Applies this operator implementation.
    pub fn op(self: f32, other: i32) -> f32 {
        let mut result = 1.0_f32
        let mut i = 0_i32
        let mut limit = other
        if other < 0_i32 {
            limit = 0_i32 - other
        }
        while i < limit {
            result = result * self
            i = i + 1_i32
        }
        if other < 0_i32 {
            ret 1.0_f32 / result
        }
        ret result
    }
}

impl Add[f64] for f64 { pub fn op(self: f64, other: f64) -> f64 { ehir { result: f64 = add self: f64, other: f64 } ret result } }
