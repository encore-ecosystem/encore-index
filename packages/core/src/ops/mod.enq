//! Defines Encore operator traits and primitive implementations.

import core::option::Option
pub import core::iter::*

/// Defines the behavior required by `Add` implementations.
pub trait Add[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `Sub` implementations.
pub trait Sub[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `Mul` implementations.
pub trait Mul[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `Div` implementations.
pub trait Div[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `Rem` implementations.
pub trait Rem[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `Pow` implementations.
pub trait Pow[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `BitAnd` implementations.
pub trait BitAnd[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `BitOr` implementations.
pub trait BitOr[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `BitXor` implementations.
pub trait BitXor[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `Shl` implementations.
pub trait Shl[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `Shr` implementations.
pub trait Shr[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

/// Defines the behavior required by `Eq` implementations.
pub trait Eq[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}

/// Defines the behavior required by `Ne` implementations.
pub trait Ne[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}

/// Defines the behavior required by `Lt` implementations.
pub trait Lt[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}

/// Defines the behavior required by `Le` implementations.
pub trait Le[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}

/// Defines the behavior required by `Gt` implementations.
pub trait Gt[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}

/// Defines the behavior required by `Ge` implementations.
pub trait Ge[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}

/// Defines the behavior required by `ContextManager` implementations.
pub trait ContextManager {
    fn with_enter(self: Self) -> Self
    fn with_exit(self: Self) -> bool
}

extern fn encore_str_len(value: str) -> usize
extern fn encore_str_byte_at(value: str, index: usize) -> u8
extern fn encore_str_concat(lhs: str, rhs: str) -> str
extern fn encore_str_slice(value: str, start: usize, slice_len: usize) -> str
extern fn encore_str_char_len(value: str) -> usize
extern fn encore_str_char_at(value: str, index: usize) -> str
extern fn encore_str_slice_chars(value: str, start: usize, char_len: usize) -> str

impl Add[str] for str {
    fn op(self: str, other: str) -> str {
        unsafe {
            ret encore_str_concat(self, other)
        }
    }
}

impl for str {
    /// Returns the len of this value.
    pub fn len(self: str) -> usize {
        // Raw string length in bytes.
        unsafe {
            ret encore_str_len(self)
        }
    }

    /// Returns the byte len of this value.
    pub fn byte_len(self: str) -> usize {
        ret self.len()
    }

    /// Returns the char len of this value.
    pub fn char_len(self: str) -> usize {
        unsafe {
            ret encore_str_char_len(self)
        }
    }

    /// Returns get when it is available.
    pub fn get(self: str, n: usize) -> Option[str] {
        if n >= self.char_len() {
            ret Option[str]::None
        }
        unsafe {
            ret Option[str]::Some(encore_str_char_at(self, n))
        }
    }

    /// Returns get byte when it is available.
    pub fn get_byte(self: str, n: usize) -> Option[u8] {
        if n >= self.len() {
            ret Option[u8]::None
        }
        unsafe {
            ret Option[u8]::Some(encore_str_byte_at(self, n))
        }
    }

    /// Returns get byte at when it is available.
    pub fn get_byte_at(self: str, n: usize) -> Option[u8] {
        ret self.get_byte(n)
    }

    /// Performs the `byte_at` operation.
    pub fn byte_at(self: str, n: usize) -> u8 {
        match self.get_byte(n) {
            Option[u8]::Some(b) => {
                ret b
            }
            Option[u8]::None => {
                ret 0_u8
            }
        }
    }

    /// Performs the `slice` operation.
    pub fn slice(self: str, start: usize, slice_len: usize) -> str {
        // Character-based slice.
        unsafe {
            ret encore_str_slice_chars(self, start, slice_len)
        }
    }

    /// Performs the `slice_bytes` operation.
    pub fn slice_bytes(self: str, start: usize, slice_len: usize) -> str {
        // Byte-based slice for raw-string use-cases.
        unsafe {
            ret encore_str_slice(self, start, slice_len)
        }
    }

    /// Performs the `slice_chars` operation.
    pub fn slice_chars(self: str, start: usize, slice_len: usize) -> str {
        ret self.slice(start, slice_len)
    }

    /// Performs the `concat` operation.
    pub fn concat(self: str, rhs: str) -> str {
        ret self + rhs
    }

    /// Returns whether empty.
    pub fn is_empty(self: str) -> bool {
        ret self.len() == 0_usize
    }

    /// Returns whether contains.
    pub fn contains(self: str, needle: str) -> bool {
        let needle_len = needle.char_len()
        if needle_len == 0_usize {
            ret true
        }

        let self_len = self.char_len()
        if needle_len > self_len {
            ret false
        }

        let limit = self_len - needle_len
        let mut index = 0_usize
        loop {
            if self.slice(index, needle_len) == needle {
                ret true
            }
            if index >= limit {
                break
            }
            index = index + 1_usize
        }
        ret false
    }
}

impl Eq[str] for str {
    /// Applies this operator implementation.
    pub fn op(self: str, other: str) -> bool {
        let lhs_len = self.len()
        if lhs_len != other.len() {
            ret false
        }
        let mut i = 0_usize
        while i < lhs_len {
            match self.get_byte(i) {
                Option[u8]::Some(lhs_b) => {
                    match other.get_byte(i) {
                        Option[u8]::Some(rhs_b) => {
                            if lhs_b != rhs_b {
                                ret false
                            }
                        }
                        Option[u8]::None => {
                            ret false
                        }
                    }
                }
                Option[u8]::None => {
                    ret false
                }
            }
            i = i + 1_usize
        }
        ret true
    }
}

impl Ne[str] for str {
    /// Applies this operator implementation.
    pub fn op(self: str, other: str) -> bool {
        ret !(self == other)
    }
}

impl Eq[bool] for bool {
    /// Applies this operator implementation.
    pub fn op(self: bool, other: bool) -> bool {
        ehir {
            result: bool = ieq self: bool, other: bool
        }
        ret result
    }
}

impl Ne[bool] for bool {
    /// Applies this operator implementation.
    pub fn op(self: bool, other: bool) -> bool {
        ehir {
            result: bool = neq self: bool, other: bool
        }
        ret result
    }
}

impl Add[u8] for u8 { pub fn op(self: u8, other: u8) -> u8 { ehir { result: u8 = add self: u8, other: u8 } ret result } }
impl Sub[u8] for u8 { pub fn op(self: u8, other: u8) -> u8 { ehir { result: u8 = sub self: u8, other: u8 } ret result } }
impl Mul[u8] for u8 { pub fn op(self: u8, other: u8) -> u8 { ehir { result: u8 = mul self: u8, other: u8 } ret result } }
impl Div[u8] for u8 { pub fn op(self: u8, other: u8) -> u8 { ehir { result: u8 = div self: u8, other: u8 } ret result } }
impl Rem[u8] for u8 { pub fn op(self: u8, other: u8) -> u8 { ehir { result: u8 = mod self: u8, other: u8 } ret result } }
impl Pow[u8] for u8 { pub fn op(self: u8, other: u8) -> u8 { let mut result = 1_u8 let mut i = 0_u8 while i < other { result = result * self i = i + 1_u8 } ret result } }

