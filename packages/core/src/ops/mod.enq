impl Div[f64] for f64 { pub fn op(self: f64, other: f64) -> f64 { ehir { result: f64 = div self: f64, other: f64 } ret result } }
impl Pow[i32] for f64 {
    /// Applies this operator implementation.
    pub fn op(self: f64, other: i32) -> f64 {
        let mut result = 1.0_f64
        let mut i = 0_i32
        let mut limit = other
        if other < 0_i32 {
            limit = 0_i32 - other
        }
        while i < limit {
            result = result * self
            i = i + 1_i32
        }
        if other < 0_i32 {
            ret 1.0_f64 / result
        }
        ret result
    }
}

