import rich::{Console, Traceback}

fn main() -> u32 {
    let console = Console::new()

    console.inspect_compiler_state("typecheck", "frontend", 42_usize, "resolving generic bounds")

    let mut traceback = Traceback::compiler_error("trait method `fmt` is not implemented")
    traceback.add_context_frame(
        "frontend/pretty.enq",
        "render_value",
        33_usize,
        15_usize,
        "let value = lower(expr)",
        "ret value.fmt()",
        "ret output",
    )
    traceback.add_note("the inferred type does not satisfy the formatting contract")
    traceback.add_hint("add an explicit formatter or reduce the generic surface")
    console.traceback(traceback)

    console.compiler_traceback(
        "unresolved import",
        "frontend/imports.enq",
        "resolve_import",
        12_usize,
        8_usize,
        "use std::fs",
        "import foo::bar",
        "ret manifest",
    )
    ret 0_u32
}
