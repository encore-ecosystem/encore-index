import core::fmt::Debug
import core::option::Option
import core::testing::assert
import core::vec::Vec

import refrain::style::{accent, error_text, muted}

pub struct TraceFrame {
    module: str
    function_name: str
    line: usize
    column: usize
    before_source: str
    source: str
    after_source: str
}

pub struct Traceback {
    title: str
    message: str
    frames: Vec[TraceFrame]
    notes: Vec[str]
    hints: Vec[str]
}

impl for TraceFrame {
    pub fn new(module: str, function_name: str, line: usize, column: usize, source: str) -> Self {
        ret Self{module, function_name, line, column, "", source, ""}
    }

    pub fn with_context(module: str, function_name: str, line: usize, column: usize, before_source: str, source: str, after_source: str) -> Self {
        ret Self{module, function_name, line, column, before_source, source, after_source}
    }

    pub fn render(self, is_current: bool) -> str {
        let prefix = if is_current { error_text("->") } else { muted("  ") }
        let mut out = prefix + " " + self.module + ":" + usize_to_str(self.line) + ":" + usize_to_str(self.column)
            + " in " + accent(self.function_name)
        if self.before_source != "" {
            out += "\n" + muted("   " + self.before_source)
        }
        out += "\n" + "   " + self.source + "\n"
        out += "   " + caret_line(self.column)
        if self.after_source != "" {
            out += "\n" + muted("   " + self.after_source)
        }
        ret out
    }
}

impl for Traceback {
    pub fn new(title: str, message: str) -> Self {
        ret Self{title, message, Vec[TraceFrame]::new(), Vec[str]::new(), Vec[str]::new()}
    }

    pub fn compiler_error(message: str) -> Self {
        ret Self::new("CompileError", message)
    }

    pub fn add_frame(self: mut Self, module: str, function_name: str, line: usize, column: usize, source: str) -> () {
        self.frames.push(TraceFrame::new(module, function_name, line, column, source))
        ret ()
    }

    pub fn push_frame(self: mut Self, frame: TraceFrame) -> () {
        self.frames.push(frame)
        ret ()
    }

    pub fn add_context_frame(self: mut Self, module: str, function_name: str, line: usize, column: usize, before_source: str, source: str, after_source: str) -> () {
        self.frames.push(TraceFrame::with_context(module, function_name, line, column, before_source, source, after_source))
        ret ()
    }

    pub fn add_note(self: mut Self, note: str) -> () {
        self.notes.push(note)
        ret ()
    }

    pub fn add_hint(self: mut Self, hint: str) -> () {
        self.hints.push(hint)
        ret ()
    }

    pub fn render(self) -> str {
        let mut out = error_text(self.title) + ": " + self.message
        let total = self.frames.len()
        let mut index = 0_usize
        loop {
            match self.frames.get(index) {
                Option[TraceFrame]::Some(frame) => {
                    out += "\n" + frame.render(index + 1_usize == total)
                    index = index + 1_usize
                }
                Option[TraceFrame]::None => {
                    break
                }
            }
        }
        index = 0_usize
        loop {
            match self.notes.get(index) {
                Option[str]::Some(note) => {
                    out += "\n" + accent("note:") + " " + note
                    index = index + 1_usize
                }
                Option[str]::None => {
                    break
                }
            }
        }
        index = 0_usize
        loop {
            match self.hints.get(index) {
                Option[str]::Some(hint) => {
                    out += "\n" + muted("help:") + " " + hint
                    index = index + 1_usize
                }
                Option[str]::None => {
                    break
                }
            }
        }
        ret out
    }
}

pub fn compiler_traceback(message: str, module: str, function_name: str, line: usize, column: usize, before_source: str, source: str, after_source: str) -> Traceback {
    let mut traceback = Traceback::compiler_error(message)
    traceback.add_context_frame(module, function_name, line, column, before_source, source, after_source)
    ret traceback
}

pub fn render_traceback(title: str, message: str, frames: Vec[TraceFrame]) -> str {
    let mut traceback = Traceback::new(title, message)
    let mut index = 0_usize
    loop {
        match frames.get(index) {
            Option[TraceFrame]::Some(frame) => {
                traceback.frames.push(frame)
                index = index + 1_usize
            }
            Option[TraceFrame]::None => {
                break
            }
        }
    }
    ret traceback.render()
}

fn usize_to_str(value: usize) -> str {
    ret Debug::fmt(value)
}

fn caret_line(column: usize) -> str {
    let mut out = ""
    let mut index = 1_usize
    while index < column {
        out += " "
        index = index + 1_usize
    }
    ret out + error_text("^")
}

#attr(test)
fn traceback_renders_frames() -> bool {
    let mut traceback = Traceback::compiler_error("unknown symbol")
    traceback.frames.push(TraceFrame::with_context("frontend/parser.enq", "parse_expr", 12_usize, 4_usize, "let x = 1", "foo(bar)", "ret x"))
    traceback.add_frame("main.enq", "main", 2_usize, 1_usize, "parse()")
    traceback.add_note("symbol `foo` is not defined in this scope")
    traceback.add_hint("check imported modules and local bindings")
    let rendered = traceback.render()
    let single = compiler_traceback("missing import", "frontend/imports.enq", "resolve_import", 8_usize, 3_usize, "use std::fs", "import foo::bar", "ret module").render()
    ret assert(str_contains(rendered, "CompileError"))
        && assert(str_contains(rendered, "unknown symbol"))
        && assert(str_contains(rendered, "parse_expr"))
        && assert(str_contains(rendered, "foo(bar)"))
        && assert(str_contains(rendered, "let x = 1"))
        && assert(str_contains(rendered, "ret x"))
        && assert(str_contains(rendered, "^"))
        && assert(str_contains(rendered, "note:"))
        && assert(str_contains(rendered, "help:"))
        && assert(str_contains(single, "missing import"))
}

fn str_contains(value: str, needle: str) -> bool {
    let needle_len = needle.char_len()
    let value_len = value.char_len()
    if needle_len == 0_usize {
        ret true
    }
    if needle_len > value_len {
        ret false
    }
    let mut start = 0_usize
    while start + needle_len <= value_len {
        if value.slice(start, needle_len) == needle {
            ret true
        }
        start = start + 1_usize
    }
    ret false
}
