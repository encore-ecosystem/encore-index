import core::option::Option
import std::os

fn meta_path() -> Option[str] {
    ret os::argv(1_usize)
}

fn payload() -> str {
    ret "{\n  \"native\": {\n    \"libraries\": [{\"name\":\"encore_rich_native\",\"path\":\"runtime.c\"}],\n    \"search_paths\": [],\n    \"frameworks\": [],\n    \"link_args\": []\n  }\n}\n"
}

fn main() -> u32 {
    match meta_path() {
        Option[str]::Some(path) => {
            if os::write_file(path, payload()) != 0_i32 {
                ret 1_u32
            }
            ret 0_u32
        }
        Option[str]::None => {
            ret 2_u32
        }
    }
}
