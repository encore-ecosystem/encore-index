pub struct Point {
    x: f32
    y: f32
}

pub struct Size {
    width: f32
    height: f32
}

pub struct Rect {
    x: f32
    y: f32
    width: f32
    height: f32
}

pub struct Insets {
    top: f32
    right: f32
    bottom: f32
    left: f32
}

impl for Point {
    pub fn new(x: f32, y: f32) -> Point { ret Point { x, y } }
    pub fn x(self: Self) -> f32 { ret self.x }
    pub fn y(self: Self) -> f32 { ret self.y }
}

impl for Size {
    pub fn new(width: f32, height: f32) -> Size { ret Size { width, height } }
    pub fn zero() -> Size { ret Size { 0.0_f32, 0.0_f32 } }
    pub fn width(self: Self) -> f32 { ret self.width }
    pub fn height(self: Self) -> f32 { ret self.height }
}

impl for Rect {
    pub fn new(x: f32, y: f32, width: f32, height: f32) -> Rect {
        ret Rect { x, y, width, height }
    }
    pub fn x(self: Self) -> f32 { ret self.x }
    pub fn y(self: Self) -> f32 { ret self.y }
    pub fn width(self: Self) -> f32 { ret self.width }
    pub fn height(self: Self) -> f32 { ret self.height }
    pub fn right(self: Self) -> f32 { ret self.x + self.width }
    pub fn bottom(self: Self) -> f32 { ret self.y + self.height }
    pub fn contains(self: Self, point: Point) -> bool {
        ret point.x() >= self.x && point.y() >= self.y &&
            point.x() < self.right() && point.y() < self.bottom()
    }
    pub fn inset(self: Self, insets: Insets) -> Rect {
        let width = self.width - insets.left() - insets.right()
        let height = self.height - insets.top() - insets.bottom()
        ret Rect::new(
            self.x + insets.left(),
            self.y + insets.top(),
            if width > 0.0_f32 { width } else { 0.0_f32 },
            if height > 0.0_f32 { height } else { 0.0_f32 }
        )
    }
}

impl for Insets {
    pub fn all(value: f32) -> Insets { ret Insets { value, value, value, value } }
    pub fn symmetric(vertical: f32, horizontal: f32) -> Insets {
        ret Insets { vertical, horizontal, vertical, horizontal }
    }
    pub fn only(top: f32, right: f32, bottom: f32, left: f32) -> Insets {
        ret Insets { top, right, bottom, left }
    }
    pub fn top(self: Self) -> f32 { ret self.top }
    pub fn right(self: Self) -> f32 { ret self.right }
    pub fn bottom(self: Self) -> f32 { ret self.bottom }
    pub fn left(self: Self) -> f32 { ret self.left }
}
