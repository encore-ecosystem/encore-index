import core::testing::assert
import geometry::{Insets, Point, Rect}

fn main() -> u32 {
    let rect = Rect::new(10.0_f32, 20.0_f32, 100.0_f32, 80.0_f32)
    if !assert(rect.contains(Point::new(20.0_f32, 30.0_f32))) { ret 1_u32 }
    let inner = rect.inset(Insets::symmetric(10.0_f32, 5.0_f32))
    if !assert(inner.x() == 15.0_f32 && inner.y() == 30.0_f32) { ret 1_u32 }
    if !assert(inner.width() == 90.0_f32 && inner.height() == 60.0_f32) { ret 1_u32 }
    ret 0_u32
}
