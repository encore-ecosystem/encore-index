//! Provides native threads and join handles.

// A handle owns one native thread and its eventual result. The compiler
// implements spawn and join so T keeps its native Encore layout.
/// Stores the state of a `JoinHandle` value.
pub struct JoinHandle[T] {
    token: usize
}

extern fn encore_thread_available_parallelism() -> usize

/// Performs the `available_parallelism` operation.
pub fn available_parallelism() -> usize {
    unsafe { ret encore_thread_available_parallelism() }
}
