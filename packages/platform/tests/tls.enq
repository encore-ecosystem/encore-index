//! Verifies TLS configuration invariants without external networking.

import core::testing::assert
import platform::tls::{TlsClientConfig, TlsStream}

fn main() -> u32 {
    let invalid = TlsStream::connect("localhost", 443_usize, TlsClientConfig::system().with_timeout_ms(0_usize))
    if !assert(invalid.is_err()) { ret 1_u32 }
    ret 0_u32
}
