//! Provides hashable keys and a linear dictionary.

import std::ops::Eq
import std::option::Option
import std::vec::Vec

/// Defines the behavior required by `Hashable` implementations.
pub trait Hashable {
    fn hash(self: Self) -> u64
}

impl Hashable for str {
    /// Performs the `hash` operation.
    pub fn hash(self: str) -> u64 {
        let mut h = 1469598103934665603_u64
        let prime = 1099511628211_u64
        for i in 0..self.byte_len() {
            match self.get_byte(i) {
                Option::Some(b) => {
                    h = h ^(b as u64)
                    h = h * prime
                }
                Option::None => {
                    break
                }
            }
        }
        ret h
    }
}

impl Hashable for bool {
    /// Performs the `hash` operation.
    pub fn hash(self: bool) -> u64 {
        if self {
            ret 1_u64
        }
        ret 0_u64
    }
}

impl Hashable for u8 {
    pub fn hash(self: u8) -> u64 {
        ret self as u64
    }
}
impl Hashable for u16 {
    pub fn hash(self: u16) -> u64 {
        ret self as u64
    }
}
impl Hashable for u32 {
    pub fn hash(self: u32) -> u64 {
        ret self as u64
    }
}
impl Hashable for u64 {
    pub fn hash(self: u64) -> u64 {
        ret self
    }
}
impl Hashable for usize {
    pub fn hash(self: usize) -> u64 {
        ret self as u64
    }
}
impl Hashable for i8 {
    pub fn hash(self: i8) -> u64 {
        ret self as u64
    }
}
impl Hashable for i16 {
    pub fn hash(self: i16) -> u64 {
        ret self as u64
    }
}
impl Hashable for i32 {
    pub fn hash(self: i32) -> u64 {
        ret self as u64
    }
}
impl Hashable for i64 {
    pub fn hash(self: i64) -> u64 {
        ret self as u64
    }
}
impl Hashable for isize {
    pub fn hash(self: isize) -> u64 {
        ret self as u64
    }
}

/// A linear dictionary backed by a vector of key/value pairs.
/// Copies share storage; clone creates an independent collection.
/// Lookup, insertion and removal are O(n). Hash-table storage is deferred.
pub struct Dict[K, V] {
    entries: Vec[(K, V)]
}

impl[K: Hashable + Eq, V] for Dict[K, V] {
    pub fn new() -> Self {
        ret Self::with_capacity(16)
    }
    pub fn with_capacity(capacity: usize) -> Self {
        ret Self {
            Vec[(K, V)]::with_capacity(capacity)
        }
    }
    pub fn len(self: Self) -> usize {
        ret self.entries.len()
    }
    pub fn is_empty(self: Self) -> bool {
        ret self.entries.is_empty()
    }
    pub fn capacity(self: Self) -> usize {
        ret self.entries.capacity()
    }
    pub fn reserve(self: mut Self, additional: usize) ->() {
        self.entries.reserve(additional)
    }
    pub fn clear(self: mut Self) ->() {
        self.entries.clear()
    }

    fn find_entry(self: Self, key: K) -> Option[usize] {
        for i in 0..self.entries.len() {
            match self.entries.get(i) {
                Option::Some(entry) => {
                    if entry.0 == key {
                        ret Option::Some(i)
                    }
                }
                Option::None => {
                }
            }
        }
        ret Option::None
    }
    pub fn get(self: Self, key: K) -> Option[V] {
        match self.find_entry(key) {
            Option::Some(i) => {
                match self.entries.get(i) {
                    Option::Some(entry) => {
                        ret Option::Some(entry.1)
                    }
                    Option::None => {
                    }
                }
            }
            Option::None => {
            }
        }
        ret Option::None
    }
    pub fn contains_key(self: Self, key: K) -> bool {
        ret self.find_entry(key).is_some()
    }

    /// Inserts or replaces a value, returning the previous value.
    pub fn insert(self: mut Self, key: K, value: V) -> Option[V] {
        let old = self.get(key)
        match self.find_entry(key) {
            Option::Some(i) => {
                self.entries.set(i,(key, value))
            }
            Option::None => {
                self.entries.push((key, value))
            }
        }
        ret old
    }
    /// Removes a value in place so every shared copy observes the change.
    pub fn remove(self: mut Self, key: K) -> Option[V] {
        match self.find_entry(key) {
            Option::Some(i) => {
                let old = self.get(key)
                let mut cursor = i + 1
                while cursor < self.entries.len() {
                    match self.entries.get(cursor) {
                        Option::Some(entry) => {
                            self.entries.set(cursor - 1, entry)
                        }
                        Option::None => {
                        }
                    }
                    cursor += 1
                }
                self.entries.pop()
                ret old
            }
            Option::None => {
                ret Option::None
            }
        }
    }
    pub fn items(self: Self) -> Vec[(K, V)] {
        let mut out = Vec[(K, V)]::with_capacity(self.len())
        for entry in self.entries {
            out.push(entry)
        }
        ret out
    }
    pub fn keys(self: Self) -> Vec[K] {
        let mut out = Vec[K]::with_capacity(self.len())
        for entry in self.entries {
            out.push(entry.0)
        }
        ret out
    }
    pub fn values(self: Self) -> Vec[V] {
        let mut out = Vec[V]::with_capacity(self.len())
        for entry in self.entries {
            out.push(entry.1)
        }
        ret out
    }
    pub fn clone(self: Self) -> Self {
        ret Self {
            self.items()
        }
    }
}
