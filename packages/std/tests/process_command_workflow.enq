import core::testing:: *
import std::process::Command

fn main() -> u32 {
    let captured = Command::new("sh")
    .arg("-c")
    .arg("printf zodiac; exit 7")
    .output()
    if !assert(captured.code() == 7_i32) || !assert(captured.text() == "zodiac") {
        ret 1_u32
    }

    let parent = Command::new("pwd").output()
    if !assert(parent.success()) || !assert(parent.text().len() > 1_usize) {
        ret 1_u32
    }
    let expected = parent.text().slice(0_usize, parent.text().len() - 1_usize) + "/src\n"
    let located = Command::new("pwd").cwd("src").output()
    if !assert(located.success()) || !assert(located.text() == expected) {
        ret 1_u32
    }
    ret 0_u32
}
