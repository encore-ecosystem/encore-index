import core::option::Option
import core::testing::*
import std::string::String


fn main() -> u32 {
    let a = String::from_str("hello")
    let b = String::new()

    if a.as_str() != "hello" {
        ret 1_u32
    }
    if a.len() != 5_usize {
        ret 1_u32
    }
    if !b.is_empty() {
        ret 1_u32
    }

    if !assert(a.starts_with("he")) {
        ret 1_u32
    }
    if !assert(a.ends_with("lo")) {
        ret 1_u32
    }
    if !assert(a.contains("ell")) {
        ret 1_u32
    }
    if !assert(!a.contains("world")) {
        ret 1_u32
    }
    if !assert(a.slice(1_usize, 3_usize).as_str() == "ell") {
        ret 1_u32
    }

    let padded = String::from_str(" \n\t hello \r\n")
    if !assert(padded.trim().as_str() == "hello") {
        ret 1_u32
    }

    let parts = String::from_str("alpha beta\n gamma").split_whitespace()
    if !assert(parts.len() == 3_usize) {
        ret 1_u32
    }
    match parts.get(2_usize) {
        Option[String]::Some(value) => {
            if !assert(value.as_str() == "gamma") {
                ret 1_u32
            }
        }
        Option[String]::None => {
            ret 1_u32
        }
    }

    let emoji = String::from_str("a🙂b")
    if !assert(emoji.len() == 3_usize) {
        ret 1_u32
    }
    if !assert(emoji.byte_len() > emoji.len()) {
        ret 1_u32
    }
    match emoji.char_at(1_usize) {
        Option[str]::Some(ch) => {
            if !assert(ch == "🙂") {
                ret 1_u32
            }
        }
        Option[str]::None => {
            ret 1_u32
        }
    }
    if !assert(emoji.slice(1_usize, 1_usize).as_str() == "🙂") {
        ret 1_u32
    }

    ret 0_u32
}
