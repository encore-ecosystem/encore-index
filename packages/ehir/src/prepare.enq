//! Canonical preparation of a parsed EHIR module.
//!
//! This is deliberately part of the standalone EHIR package.  Frontends may
//! produce `Module` values in any way they choose; neither this pass nor the
//! EHIR validator knows about Encore.  Backends consume the prepared graph and
//! therefore do not need to duplicate the ownership/control-flow preparation
//! sequence.

import refrain::core::Module
import refrain::validate::validate_module
import refrain::coroutine::lower_coroutines
import refrain::normalize::normalize_control_flow

/// The local outcome avoids coupling the public EHIR API to a frontend's
/// error type.  It also keeps the validation message available to a driver
/// without terminating the process inside the reusable library.
pub enum PreparationOutcome {
    Ready(Module)
    Error(str)
}

/// Validates and lowers one module into the canonical backend input form.
///
/// The first validation checks the frontend contract.  Coroutine lowering and
/// control-flow normalization then run exactly once.  The final validation is
/// intentional: it is the boundary proof that the lowering passes preserved
/// EHIR invariants before a backend starts code generation.
pub fn prepare_module(module: Module) -> PreparationOutcome {
    match validate_module(module) {
        Err(message) => { ret PreparationOutcome::Error(message) }
        Ok(validated) => {
            let lowered = lower_coroutines(validated)
            let normalized = normalize_control_flow(lowered)
            match validate_module(normalized) {
                Err(message) => { ret PreparationOutcome::Error(message) }
                Ok(prepared) => { ret PreparationOutcome::Ready(prepared) }
            }
        }
    }
}
