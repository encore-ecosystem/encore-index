import std::vec::Vec

import refrain::core::instructions::Instruction
import refrain::core::instructions::Terminator


pub struct Block {
    name: str
    instructions: Vec[Instruction]
    terminator: Terminator
}

pub fn block(name: str, instructions: Vec[Instruction], terminator: Terminator) -> Block {
    ret Block{name, instructions, terminator}
}
