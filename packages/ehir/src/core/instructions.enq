import core::option::Option
import std::vec::Vec

import refrain::core::enum_value::EnumValue
import refrain::core::types::Type
import refrain::core::variable::Variable


pub struct CommentInstruction {
    text: str
}

pub struct LcposInstruction {
    out: Variable
    value: str
}

pub struct AliasInstruction {
    out: Variable
    src: Variable
}

pub struct LcsosInstruction {
    out: Variable
    typ: Type
    args: Vec[Variable]
}

pub struct LceosInstruction {
    out: Variable
    value: EnumValue
}

pub struct CallInstruction {
    out: Variable
    name: str
    generics: Vec[Type]
    args: Vec[Variable]
    is_unsafe: bool
}

pub struct AwaitInstruction {
    out: Variable
    future: Variable
}

pub struct StoreInstruction {
    src: Variable
    dst: Variable
}

pub struct LoadInstruction {
    out: Variable
    src: Variable
}

pub struct GetFieldInstruction {
    out: Variable
    src: Variable
    field: Variable
}

pub struct SetFieldInstruction {
    src: Variable
    field: Variable
    value: Variable
}

pub struct GetFieldPtrInstruction {
    out: Variable
    src: Variable
    field: Variable
}

pub struct SGetFieldInstruction {
    out: Variable
    src: Variable
    field: Variable
}

pub struct SGetFieldPtrInstruction {
    out: Variable
    src: Variable
    field: Variable
}

pub struct GetPtrInstruction {
    out: Variable
    src: Variable
}

pub struct GepInstruction {
    out: Variable
    src: Variable
    offset: Variable
}

pub struct PtrCastInstruction {
    out: Variable
    src: Variable
    target_type: Type
}

pub struct StackAllocInstruction {
    out: Variable
    typ: Type
}

pub struct HeapAllocInstruction {
    out: Variable
    typ: Type
}

pub struct HeapReallocInstruction {
    out: Variable
    src: Variable
    count: Variable
}

pub struct HeapFreeInstruction {
    src: Variable
}

pub struct PutInstruction {
    primitive: str
    dst: Variable
}

pub enum BinaryOpKind {
    ADD
    SUB
    MUL
    DIV
    MOD
    SHL
    SHR
    LES
    LEQ
    GRT
    GEQ
    IEQ
    NEQ
    AND
    OR
    XOR
}

pub struct BinaryInstruction {
    out: Variable
    lhs: Variable
    rhs: Variable
    op: BinaryOpKind
}

pub struct PhiPair {
    value: Variable
    label: str
}

pub struct PhiInstruction {
    out: Variable
    pairs: Vec[PhiPair]
}

pub struct CfreeInstruction {
    value: Variable
}

pub struct DropInstruction {
    value: Variable
}

pub struct RetainInstruction {
    value: Variable
}

pub struct ReturnInstruction {
    value: Variable
}

pub struct BranchInstruction {
    label: str
}

pub struct ConditionalBranchInstruction {
    cond: Variable
    true_label: str
    false_label: str
}

pub struct MatchArm {
    variant: str
    payload_var: Option[Variable]
    label: str
}

pub struct MatchInstruction {
    scrutinee: Variable
    default_label: str
    arms: Vec[MatchArm]
}

pub struct SwitchCase {
    value: str
    label: str
}

pub struct SwitchInstruction {
    scrutinee: Variable
    default_label: str
    cases: Vec[SwitchCase]
}

pub enum Instruction {
    Comment(CommentInstruction)
    Lcpos(LcposInstruction)
    Alias(AliasInstruction)
    Lcsos(LcsosInstruction)
    Lceos(LceosInstruction)
    Call(CallInstruction)
    Await(AwaitInstruction)
    Store(StoreInstruction)
    Load(LoadInstruction)
    GetField(GetFieldInstruction)
    SetField(SetFieldInstruction)
    GetFieldPtr(GetFieldPtrInstruction)
    SGetField(SGetFieldInstruction)
    SGetFieldPtr(SGetFieldPtrInstruction)
    GetPtr(GetPtrInstruction)
    Gep(GepInstruction)
    PtrCast(PtrCastInstruction)
    StackAlloc(StackAllocInstruction)
    HeapAlloc(HeapAllocInstruction)
    HeapRealloc(HeapReallocInstruction)
    HeapFree(HeapFreeInstruction)
    Put(PutInstruction)
    Binary(BinaryInstruction)
    Phi(PhiInstruction)
    Cfree(CfreeInstruction)
    Drop(DropInstruction)
    Retain(RetainInstruction)
}

pub enum Terminator {
    Unreachable
    Ret(ReturnInstruction)
    Br(BranchInstruction)
    Cbr(ConditionalBranchInstruction)
    Match(MatchInstruction)
    Switch(SwitchInstruction)
}

pub fn unreachable_term() -> Terminator {
    ret Terminator::Unreachable
}

pub fn comment(text: str) -> Instruction {
    ret Instruction::Comment(CommentInstruction{text})
}

pub fn lcpos(out: Variable, value: str) -> Instruction {
    ret Instruction::Lcpos(LcposInstruction{out, value})
}

pub fn alias(out: Variable, src: Variable) -> Instruction {
    ret Instruction::Alias(AliasInstruction{out, src})
}

pub fn lcsos(out: Variable, typ: Type, args: Vec[Variable]) -> Instruction {
    ret Instruction::Lcsos(LcsosInstruction{out, typ, args})
}

pub fn lceos(out: Variable, value: EnumValue) -> Instruction {
    ret Instruction::Lceos(LceosInstruction{out, value})
}

pub fn call(out: Variable, name: str, generics: Vec[Type], args: Vec[Variable], is_unsafe: bool) -> Instruction {
    ret Instruction::Call(CallInstruction{out, name, generics, args, is_unsafe})
}

pub fn await_value(out: Variable, future: Variable) -> Instruction {
    ret Instruction::Await(AwaitInstruction{out, future})
}

pub fn store(src: Variable, dst: Variable) -> Instruction {
    ret Instruction::Store(StoreInstruction{src, dst})
}

pub fn load(out: Variable, src: Variable) -> Instruction {
    ret Instruction::Load(LoadInstruction{out, src})
}

pub fn getfield(out: Variable, src: Variable, field: Variable) -> Instruction {
    ret Instruction::GetField(GetFieldInstruction{out, src, field})
}

pub fn setfield(src: Variable, field: Variable, value: Variable) -> Instruction {
    ret Instruction::SetField(SetFieldInstruction{src, field, value})
}

pub fn getfieldptr(out: Variable, src: Variable, field: Variable) -> Instruction {
    ret Instruction::GetFieldPtr(GetFieldPtrInstruction{out, src, field})
}

pub fn sgetfield(out: Variable, src: Variable, field: Variable) -> Instruction {
    ret Instruction::SGetField(SGetFieldInstruction{out, src, field})
}

pub fn sgetfieldptr(out: Variable, src: Variable, field: Variable) -> Instruction {
    ret Instruction::SGetFieldPtr(SGetFieldPtrInstruction{out, src, field})
}

pub fn getptr(out: Variable, src: Variable) -> Instruction {
    ret Instruction::GetPtr(GetPtrInstruction{out, src})
}

pub fn gep(out: Variable, src: Variable, offset: Variable) -> Instruction {
    ret Instruction::Gep(GepInstruction{out, src, offset})
}

pub fn pcast(out: Variable, src: Variable, target_type: Type) -> Instruction {
    ret Instruction::PtrCast(PtrCastInstruction{out, src, target_type})
}

pub fn salloc(out: Variable, typ: Type) -> Instruction {
    ret Instruction::StackAlloc(StackAllocInstruction{out, typ})
}

pub fn halloc(out: Variable, typ: Type) -> Instruction {
    ret Instruction::HeapAlloc(HeapAllocInstruction{out, typ})
}

pub fn hrealloc(out: Variable, src: Variable, count: Variable) -> Instruction {
    ret Instruction::HeapRealloc(HeapReallocInstruction{out, src, count})
}

pub fn hfree(src: Variable) -> Instruction {
    ret Instruction::HeapFree(HeapFreeInstruction{src})
}

pub fn put(primitive: str, dst: Variable) -> Instruction {
    ret Instruction::Put(PutInstruction{primitive, dst})
}

pub fn binary(out: Variable, lhs: Variable, rhs: Variable, op: BinaryOpKind) -> Instruction {
    ret Instruction::Binary(BinaryInstruction{out, lhs, rhs, op})
}

pub fn add(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::ADD)
}

pub fn sub(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::SUB)
}

pub fn mul(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::MUL)
}

pub fn div(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::DIV)
}

pub fn mod_op(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::MOD)
}

pub fn shl(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::SHL)
}

pub fn shr(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::SHR)
}

pub fn les(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::LES)
}

pub fn leq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::LEQ)
}

pub fn grt(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::GRT)
}

pub fn geq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::GEQ)
}

pub fn ieq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::IEQ)
}

pub fn neq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::NEQ)
}

pub fn and_op(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::AND)
}

pub fn or_op(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::OR)
}

pub fn xor_op(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::XOR)
}

pub fn phi_pair(value: Variable, label: str) -> PhiPair {
    ret PhiPair{value, label}
}

pub fn phi(out: Variable, pairs: Vec[PhiPair]) -> Instruction {
    ret Instruction::Phi(PhiInstruction{out, pairs})
}

pub fn cfree(value: Variable) -> Instruction {
    ret Instruction::Cfree(CfreeInstruction{value})
}

pub fn drop_value(value: Variable) -> Instruction {
    ret Instruction::Drop(DropInstruction{value})
}

pub fn retain_value(value: Variable) -> Instruction {
    ret Instruction::Retain(RetainInstruction{value})
}

pub fn ret_term(value: Variable) -> Terminator {
    ret Terminator::Ret(ReturnInstruction{value})
}

pub fn br_term(label: str) -> Terminator {
    ret Terminator::Br(BranchInstruction{label})
}

pub fn cbr_term(cond: Variable, true_label: str, false_label: str) -> Terminator {
    ret Terminator::Cbr(ConditionalBranchInstruction{cond, true_label, false_label})
}

pub fn match_arm(variant: str, payload_var: Option[Variable], label: str) -> MatchArm {
    ret MatchArm{variant, payload_var, label}
}

pub fn match_term(scrutinee: Variable, default_label: str, arms: Vec[MatchArm]) -> Terminator {
    ret Terminator::Match(MatchInstruction{scrutinee, default_label, arms})
}

pub fn switch_case(value: str, label: str) -> SwitchCase {
    ret SwitchCase{value, label}
}

pub fn switch_term(scrutinee: Variable, default_label: str, cases: Vec[SwitchCase]) -> Terminator {
    ret Terminator::Switch(SwitchInstruction{scrutinee, default_label, cases})
}
