import core::option::Option

import refrain::core::types::Type


pub struct Parameter {
    name: str
    typ: Type
}

pub struct Variable {
    name: str
    typ: Option[Type]
}

pub fn param(name: str, typ: Type) -> Parameter {
    ret Parameter{name, typ}
}

pub fn var(name: str, typ: Type) -> Variable {
    ret Variable{name, Option[Type]::Some(typ)}
}

pub fn untyped_var(name: str) -> Variable {
    ret Variable{name, Option[Type]::None}
}
