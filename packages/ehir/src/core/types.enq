import core::option::Option
import std::vec::Vec


pub enum RepresentationKind {
    Inline
    NodeStack
    NodeHeap
    NodeAny
    Raw
    // Transitional addressable local emitted before local-to-SSA lowering.
    // This is a place category, not an EHIR value representation.
    LocalPlace
}

pub struct Type {
    name: str
    generics: Vec[Type]
    representation: RepresentationKind
}

pub fn make_type(name: str, generics: Vec[Type], representation: RepresentationKind) -> Type {
    ret Type{name, generics, representation}
}

pub fn plain_type(name: str, generics: Vec[Type]) -> Type {
    ret Type{name, generics, RepresentationKind::Inline}
}

pub fn heap_type(inner: Type) -> Type {
    ret Type{inner.name, inner.generics, RepresentationKind::NodeHeap}
}

pub fn stack_type(inner: Type) -> Type {
    ret Type{inner.name, inner.generics, RepresentationKind::NodeStack}
}

pub fn any_node_type(inner: Type) -> Type {
    ret Type{inner.name, inner.generics, RepresentationKind::NodeAny}
}

pub fn raw_type(inner: Type) -> Type {
    ret Type{inner.name, inner.generics, RepresentationKind::Raw}
}

pub fn local_place_type(inner: Type) -> Type {
    ret Type{inner.name, inner.generics, RepresentationKind::LocalPlace}
}

fn join_mangled_generics(generics: frozen Vec[Type]) -> str {
    let mut out = ""
    let mut index = 0_usize

    loop {
        match generics.get(index) {
            Some(generic) => {
                if index > 0_usize {
                    out = out + "_"
                }
                out = out + mangle_type_name(generic)
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}

pub fn mangle_plain_type_name(name: str, generics: frozen Vec[Type]) -> str {
    if generics.len() == 0_usize { ret name }
    ret name + "_" + join_mangled_generics(generics)
}

pub fn mangle_type_name(typ: frozen Type) -> str {
    let mut out = mangle_plain_type_name("" + typ.name, typ.generics)
    match typ.representation {
        RepresentationKind::NodeHeap => { out = out + "_H" }
        RepresentationKind::NodeStack => { out = out + "_S" }
        RepresentationKind::NodeAny => { out = out + "_A" }
        RepresentationKind::Raw => { out = out + "_ptr" }
        RepresentationKind::LocalPlace => { out = out + "_local" }
        RepresentationKind::Inline => {}
    }
    ret out
}
