fn enum_value_to_string(value: EnumValue) -> str {
    let mut out = value.name
    if value.generics.len() > 0_usize {
        out = out + "["
        out = out + join_strings(collect_type_strings(value.generics), ", ")
        out = out + "]"
    }
    out = out + "::"
    out = out + value.variant
    out = out + "("
    match value.payload {
        Some(payload) => {
            out = out + variable_to_string(payload)
        }
        None => {}
    }
    out = out + ")"
    ret out
}

fn collect_trait_method_strings(items: Vec[TraitMethod]) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut index = 0_usize

    loop {
        match items.get(index) {
