import core::option::Option
import core::fmt::Debug
import refrain::core::*

extern fn encore_text_builder_new() -> usize
extern fn encore_text_builder_append(builder: usize, value: str) -> ()
extern fn encore_text_builder_append_builder(builder: usize, other: usize) -> ()
extern fn encore_text_builder_finish(builder: usize) -> str
extern fn encore_text_builder_set_suppressed(suppressed: bool) -> ()

/// Enables or disables allocation-heavy text output for validation-only
/// compiler passes on the current native thread.
pub fn suppress_text_builder_output(suppressed: bool) -> () {
    unsafe { encore_text_builder_set_suppressed(suppressed) }
    ret ()
}

pub struct EhirTextBuilder {
    handle: usize
}

impl for EhirTextBuilder {
    pub fn new() -> Self {
        ret Self {unsafe { encore_text_builder_new() }}
    }

    pub fn append(self: Self, other: Self) -> Self {
        unsafe { encore_text_builder_append_builder(self.handle, other.handle) }
        ret self
    }

    pub fn append_str(self: Self, value: str) -> Self {
        if value == "" { ret self }
        unsafe { encore_text_builder_append(self.handle, value) }
        ret self
    }

    pub fn line(self: Self, value: str) -> Self {
        unsafe {
            encore_text_builder_append(self.handle, value)
            encore_text_builder_append(self.handle, "\n")
        }
        ret self
    }

    pub fn instr(self: Self, value: str) -> Self {
        ret self.line("    " + value)
    }

    pub fn label(self: Self, value: str) -> Self {
        ret self.line("  $" + value + ":")
    }

    pub fn empty_line(self: Self) -> Self {
        ret self.line("")
    }

    pub fn finish(self: Self) -> str {
        ret unsafe { encore_text_builder_finish(self.handle) }
    }
}


fn newline() -> str {
    ret "\n"
}

fn join_strings(items: Vec[str], separator: str) -> str {
    let mut out = ""
    let mut index = 0_usize

    loop {
        match items.get(index) {
            Option[str]::Some(item) => {
                if index > 0_usize {
                    out = out + separator
                }
                out = out + item
                index = index + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }

    ret out
}

fn push_text(items: Vec[str], value: str) -> Vec[str] {
    let mut out = items
    out.push(value)
    ret out
}

fn collect_type_strings(items: Vec[Type]) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut index = 0_usize

    loop {
        match items.get(index) {
            Some(item) => {
                out = push_text(out, type_to_string(item))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}

