extern fn encore_str_slice_bytes(value: str, start: usize, byte_len: usize) -> str
extern fn encore_text_builder_new() -> usize
extern fn encore_text_builder_append(builder: usize, value: str) ->()
extern fn encore_text_builder_finish(builder: usize) -> str

/// Stable textual input for one virtual EHIR module in a bundle.
pub struct EhirModuleSource {
    module_id: str
    text: str
}

impl for EhirModuleSource {
    pub fn id(self: Self) -> str {
        ret self.module_id
    }
    pub fn source(self: Self) -> str {
        ret self.text
    }
}

fn byte_slice(value: str, start: usize, byte_len: usize) -> str {
    ret unsafe {
        encore_str_slice_bytes(value, start, byte_len)
    }
}

fn join_line_range(lines: Vec[str], start: usize, end: usize) -> str {
    let builder = unsafe {
        encore_text_builder_new()
    }
    let mut index = start
    while index < end && index < lines.len() {
        unsafe {
            encore_text_builder_append(builder, required_part(lines, index))
            encore_text_builder_append(builder, "\n")
        }
        index = index + 1_usize
    }
    ret unsafe {
        encore_text_builder_finish(builder)
    }
}

