import refrain::formatter::Formatter
import refrain::level::LogLevel
import refrain::sink::{LogSink, Writable}
import core::os::{file_exists, read_file, write_file}
import core::testing::assert

pub struct WriterSink {
    writer: dyn Writable
    formatter: Formatter
}

impl for WriterSink {
    pub fn new(writer: dyn Writable) -> Self {
        ret Self{writer, Formatter::plain()}
    }

    pub fn with_formatter(writer: dyn Writable, formatter: Formatter) -> Self {
        ret Self{writer, formatter}
    }
}

impl LogSink for WriterSink {
    fn write(self: WriterSink, level: LogLevel, target: str, message: str) -> i32 {
        let rendered = self.formatter.format(level, target, message)
        ret self.writer.write(rendered)
    }
}

struct CaptureWriter {
    path: str
}

impl Writable for CaptureWriter {
    fn write(self: CaptureWriter, value: str) -> i32 {
        let mut current = ""
        if file_exists(self.path) {
            current = read_file(self.path)
        }
        ret write_file(self.path, current + value)
    }
}

#attr(test)
fn writer_sink_uses_writable_trait_object() -> bool {
    let path = "target/log_writer_sink_contract.txt"
    write_file(path, "")
    let sink = WriterSink::new(CaptureWriter{path} as dyn Writable)
    sink.write(LogLevel::Warn, "writer", "hello")
    let text = read_file(path)
    ret assert(str_contains(text, "[WARN] [writer] hello"))
}

fn str_contains(value: str, needle: str) -> bool {
    let needle_len = needle.char_len()
    let value_len = value.char_len()
    if needle_len == 0_usize {
        ret true
    }
    if needle_len > value_len {
        ret false
    }

    let mut start = 0_usize
    while start + needle_len <= value_len {
        if value.slice(start, needle_len) == needle {
            ret true
        }
        start = start + 1_usize
    }
    ret false
}
