//! Builtin spawn handles need ownership helpers without an imported struct.
import ehirlib::parse_module_text
import refrain::codegen::{emit_ir, emit_ir_for_target}

fn verify(ir: str) -> bool {
    ret ir.contains("@__add_edges_JoinHandle_u32(") &&
        ir.contains("define void @__add_edges_JoinHandle_u32(") &&
        ir.contains("define void @__remove_edges_JoinHandle_u32(") &&
        ir.contains("define void @__drop_JoinHandle_u32(") &&
        ir.contains("define void @__retain_JoinHandle_u32(") &&
        ir.contains("@encore_thread_release(")
}

fn main() -> u32 {
    let source = "fn replace(slot: mut JoinHandle[u32], value: JoinHandle[u32]) -> () {\n  $entry:\n    store value, slot\n    ret void: ()\n}\n"
    if !verify(emit_ir(parse_module_text("implicit_thread", source))) { ret 1 }
    for target in vec!["x86_64-unknown-linux-gnu", "aarch64-w64-windows-gnu", "x86_64-pc-windows-msvc"] {
        if !verify(emit_ir_for_target(parse_module_text("implicit_thread", source), target, 64)) { ret 2 }
    }
    ret 0
}
