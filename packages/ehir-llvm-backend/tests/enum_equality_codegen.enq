//! Used equality helpers have a single support owner and typed payload access.
import ehirlib::{parse_module_bundle_text, make_module_bundle, make_module, Module, Directive}
import refrain::codegen::{emit_ir, prepare_unit_codegen, emit_unit_codegen, unit_codegen_context, unit_codegen_requirements, emit_program_support}
import std::vec::Vec

fn main() -> u32 {
    let source = "entry probe\nmodule probe {\n"
    + "struct Unused {\nvalue: u32\n}\nenum Maybe[T] {\nSome(T)\nNone\n}\n"
    + "fn equal[T](left: T, right: T) -> bool {\n$entry:\n"
    + "result: bool = ieq left: T, right: T\nret result: bool\n}\n"
    + "fn capitalized(Left: Maybe[u32], Right: Maybe[u32]) -> bool {\n$entry:\n"
    + "result: bool = ieq Left: Maybe[u32], Right: Maybe[u32]\nret result: bool\n}\n"
    + "fn has_payload(value: Maybe[u32]) -> bool {\n$entry:\n"
    + "result: bool = ieq value: Maybe[u32], Some\nret result: bool\n}\n"
    + "fn probe(left: Maybe[str], right: Maybe[str], a: Maybe[u32], b: Maybe[u32]) -> bool {\n$entry:\n"
    + "text: bool = ieq left: Maybe[str], right: Maybe[str]\n"
    + "different: bool = neq a: Maybe[u32], b: Maybe[u32]\n"
    + "result: bool = call equal[Maybe[str]](left: Maybe[str], right: Maybe[str])\nret result: bool\n}\n}\n"
    let bundle = parse_module_bundle_text("", source)
    let monolithic = emit_ir(bundle.modules.get(0).unwrap_or(make_module("invalid", Vec[Directive]::new())))
    if !monolithic.contains("define zeroext i1 @__equal_Maybe_str") || !monolithic.contains("define zeroext i1 @__equal_Maybe_u32") {
        ret 1
    }
    if !monolithic.contains("call zeroext i1 @encore_str_eq") || !monolithic.contains("ptrtoint i8*") {
        ret 2
    }
    if monolithic.contains("@__equal_Unused") || monolithic.contains("@__equal_Maybe_T") {
        ret 3
    }
    if !monolithic.contains("@__equal_Maybe_u32(%Maybe_u32 %Left, %Maybe_u32 %Right)") {
        ret 10
    }
    let unit = prepare_unit_codegen(bundle, make_module_bundle("", Vec[Module]::new()), "x86_64-unknown-linux-gnu", 64, 1)
    let emitted = emit_unit_codegen(unit, "x86_64-unknown-linux-gnu", 64)
    for module in emitted {
        if !module.ir.contains("declare zeroext i1 @__equal_Maybe_str") || !module.ir.contains("declare zeroext i1 @__equal_Maybe_u32") {
            ret 4
        }
        if module.ir.contains("define zeroext i1 @__equal_Maybe_str") {
            ret 5
        }
        if !module.ir.contains("xor i1") {
            ret 6
        }
    }
    let requirements = unit_codegen_requirements(unit)
    if requirements.equality_types.len() != 2 {
        ret 7
    }
    let support = emit_program_support(unit_codegen_context(unit, "probe"), vec![requirements], "x86_64-unknown-linux-gnu", 64)
    if !support.ir.contains("define zeroext i1 @__equal_Maybe_str") || !support.ir.contains("define zeroext i1 @__equal_Maybe_u32") {
        ret 8
    }
    if support.ir.contains("@__equal_Unused") || support.ir.contains("@__equal_Maybe_T") {
        ret 9
    }
    ret 0
}
