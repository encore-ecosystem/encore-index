import refrain::types::BackendConfig
import refrain::types::BackendTarget
import refrain::types::CompiledRefrain
import refrain::types::BuildArtifact
import refrain::types::build_artifact
import refrain::codegen::emit_ir
import refrain::optimizer::optimize_ir
import refrain::assembler::assemble
import refrain::archiver::archive_payload
import refrain::linker::link_payload

pub struct EHIRLLVMBackend {
    config: BackendConfig
}

pub fn new(config: BackendConfig) -> EHIRLLVMBackend {
    ret EHIRLLVMBackend{config}
}

pub fn compile_to_file(backend: EHIRLLVMBackend, input: CompiledRefrain, output_path: str) -> BuildArtifact {
    let config = backend.config
    let raw_ir = emit_ir(input.module)
    let optimized_ir = optimize_ir(raw_ir, config.profile)
    let status = emit_target_payload(input.target, optimized_ir, output_path)
    ret build_artifact(output_path, input.target, status)
}

fn emit_target_payload(target: BackendTarget, payload: str, output_path: str) -> i32 {
    match target {
        OBJECT => {
            ret assemble(payload, output_path)
        }
        STATIC_LIB => {
            ret archive_payload(payload, output_path)
        }
        EXECUTABLE => {
            ret link_payload(payload, output_path)
        }
    }
}
