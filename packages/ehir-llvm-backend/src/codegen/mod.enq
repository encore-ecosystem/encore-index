pub struct LoweredModule {
    ir: str
}

/// Program-wide helpers are materialized once in the support CGU. Other CGUs
/// only need their declarations, avoiding O(module_count) generic, trait and
/// ownership lowering as well as recompiling identical linkonce bodies.
struct SupportIr {
    definitions: str
    declarations: str
}

pub struct EmittedIrModule {
    module_id: str
    ir: str
    weight: usize
}

struct EmittedIrChunk {
    index: usize
    module: EmittedIrModule
}

struct ModulePrepareJob {
    index: usize
    weight: usize
}

struct PreparedModuleChunk {
    index: usize
    module: Module
}

fn odr_function(function: LLVMFunction) -> LLVMFunction {
    if function.is_extern { ret function }
    ret llvm_with_linkage(function, "linkonce_odr")
}

struct GenericCall {
    name: str
    args: Vec[Type]
    key: str
}

struct StringGlobal {
    body: str
    tag: usize
}

struct ConcreteTypeEntry {
    typ: Type
    key: str
    tag: usize
}

