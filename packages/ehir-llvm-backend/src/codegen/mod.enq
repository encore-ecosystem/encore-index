fn concat_instructions(left: Vec[LLVMInstruction], right: Vec[LLVMInstruction]) -> Vec[LLVMInstruction] {
    let mut out = Vec[LLVMInstruction]::new()
    out.extend(left)
    out.extend(right)
    ret out
}

fn concat_values(left: Vec[LLVMValue], right: Vec[LLVMValue]) -> Vec[LLVMValue] {
    let mut out = Vec[LLVMValue]::new()
    out.extend(left)
    out.extend(right)
    ret out
}
