fn profile_codegen_memory(stage: str) -> () {
    if env("ENCORE_CODEGEN_PROFILE").is_some() {
        eprintln("codegen-memory " + stage + ": " + Debug::fmt(unsafe { encore_codegen_rss_kb() }) + " KiB")
    }
    ret ()
}

fn profile_codegen_duration(stage: str, started_ms: u64) -> () {
    if env("ENCORE_CODEGEN_PROFILE").is_some() {
        eprintln("codegen-time " + stage + ": " +
            Debug::fmt(perf_counter_ms() - started_ms) + " ms")
    }
    ret ()
}

fn byte_slice(value: str, start: usize, byte_len: usize) -> str {
    ret unsafe { encore_str_slice_bytes(value, start, byte_len) }
}

pub fn lower(module: Module) -> LoweredModule {
    ret lower_with_analysis(module, module.directives)
}

fn lower_with_analysis(module: Module, analysis_directives: Vec[Directive]) -> LoweredModule {
    profile_codegen_memory("lower-start")
    let generic_started = perf_counter_ms()
    let mut generic_calls = collect_generic_calls(analysis_directives)
    profile_codegen_duration("generic-calls-collected", generic_started)
    profile_codegen_memory("generic-calls-collected")
    let expansion_started = perf_counter_ms()
    expand_generic_calls(analysis_directives, generic_calls)
    profile_codegen_duration("generic-calls-expanded", expansion_started)
    profile_codegen_memory("generic-calls-expanded")
    let types_started = perf_counter_ms()
    let concrete_types = collect_concrete_types(analysis_directives, generic_calls)
    profile_codegen_duration("concrete-types-collected", types_started)
    profile_codegen_memory("concrete-types-collected")
    let lowering_started = perf_counter_ms()
    let support = build_support_ir(analysis_directives, generic_calls, concrete_types)
    let lowered = lower_with_precomputed_analysis(module, concrete_types, support, true)
    profile_codegen_duration("llvm-lowered", lowering_started)
    ret lowered
}

fn lower_with_precomputed_analysis(module: Module, concrete_types: Vec[Type], support: SupportIr,
    define_support: bool,) -> LoweredModule {
    let directives = module.directives
    let module_name = module.name
    let mut type_declarations = lower_type_declarations(directives, concrete_types)
    type_declarations.extend(thread_context_declarations(directives))
    profile_codegen_memory("types-lowered")
    let safe_module_name = sanitize_symbol(module_name)
    let builder = unsafe { encore_text_builder_new() }
    append_builder_line(builder, "; ModuleID = '" + safe_module_name + "'")
    for declaration in type_declarations { append_builder_line(builder, declaration) }
    append_builder_line(builder, "")
    let seen = unsafe { encore_strset_new() }
    let mut emitted = false
    emitted = append_lowered_directives(builder, directives, seen, emitted)
    profile_codegen_memory("directives-lowered")
    let support_text = if define_support { support.definitions } else { support.declarations }
    if support_text != "" {
        if emitted { append_builder_line(builder, "") }
        append_builder_line(builder, support_text)
        emitted = true
    }
    profile_codegen_memory("generics-lowered")
    profile_codegen_memory("traits-lowered")
    profile_codegen_memory("ownership-lowered")
    profile_codegen_memory("graph-edges-lowered")
    emitted = append_unique_functions(builder, thread_trampolines(directives), seen, emitted, 0_usize)
    emitted = append_unique_functions(builder, runtime_declarations(), seen, emitted, 0_usize)
    unsafe { encore_strset_free(seen) }
    ret LoweredModule{unsafe { encore_text_builder_finish(builder) }}
}

fn append_unique_functions(builder: usize, functions: Vec[LLVMFunction], seen: usize, emitted: bool,
    declaration_builder: usize,) -> bool {
    let mut any = emitted
    for function in functions {
        if unsafe { encore_strset_insert(seen, function.name) } {
            if any {
                append_builder_line(builder, "")
                if declaration_builder != 0_usize { append_builder_line(declaration_builder, "") }
            }
            if declaration_builder != 0_usize {
                append_function_to_builder(declaration_builder,
                    llvm_declare_fn(function.name, function.ret_type, function.params,
                        Vec[LLVMBasicBlock]::new(),))
            }
            // Helpers used to be emitted into every CGU as linkonce_odr. The
            // support-CGU owns the sole definition now, so give it ordinary
            // external linkage. LLVM may legally discard an unreferenced
            // linkonce body while compiling the owner object, leaving calls
            // from other objects undefined at final link time.
            append_function_to_builder(builder, if declaration_builder != 0_usize {
                    llvm_with_linkage(function, "")
                } else { function })
            any = true
        }
    }
    ret any
}

fn append_lowered_directives(builder: usize, directives: Vec[Directive], seen: usize, emitted: bool) -> bool {
    let mut any = emitted
    for directive in directives {
        any = append_unique_functions(builder, lower_directive(directive), seen, any, 0_usize)
    }
    ret any
}

fn build_support_ir(directives: Vec[Directive], generic_calls: Vec[GenericCall],
    concrete_types: Vec[Type],) -> SupportIr {
    let definitions = unsafe { encore_text_builder_new() }
    let declarations = unsafe { encore_text_builder_new() }
    let seen = unsafe { encore_strset_new() }
    let mut emitted = false
    emitted = append_lowered_generic_functions(definitions, directives, generic_calls, seen,
        emitted, declarations,)
    emitted = append_lowered_trait_dispatch_functions(definitions, directives, concrete_types,
        seen, emitted, declarations,)
    emitted = append_lowered_drop_functions(definitions, directives, concrete_types, seen,
        emitted, declarations,)
    let _emitted = append_lowered_edge_functions(definitions, directives, concrete_types, seen,
        emitted, declarations,)
    unsafe { encore_strset_free(seen) }
    ret SupportIr{unsafe { encore_text_builder_finish(definitions) },
        unsafe { encore_text_builder_finish(declarations) }}
}

fn append_lowered_trait_dispatch_functions(builder: usize, directives: Vec[Directive], concrete_types: Vec[Type],
    seen: usize, emitted: bool, declaration_builder: usize,) -> bool {
    let mut any = emitted
    for directive in directives {
        match directive {
            Directive::Trait(item) => {
                if trait_is_used_dynamically(concrete_types, item.name) {
                    any = append_unique_functions(builder, vec_singleton(odr_function(lower_dyn_ownership_function(directives, item.name, false))), seen, any, declaration_builder)
                    any = append_unique_functions(builder, vec_singleton(odr_function(lower_dyn_ownership_function(directives, item.name, true))), seen, any, declaration_builder)
                    any = append_unique_functions(builder, vec_singleton(odr_function(lower_dyn_edge_function(directives, item.name, true))), seen, any, declaration_builder)
                    any = append_unique_functions(builder, vec_singleton(odr_function(lower_dyn_edge_function(directives, item.name, false))), seen, any, declaration_builder)
                    for method in item.methods {
                        any = append_unique_functions(builder, vec_singleton(odr_function(lower_trait_dispatch_function(directives, item.name, method))), seen, any, declaration_builder)
                    }
                }
            }
            _ => {}
        }
    }
    ret any
}

fn lower_dyn_ownership_function(directives: Vec[Directive], trait_name: str, retain: bool) -> LLVMFunction {
    let dyn_type = Type{"dyn " + trait_name, Vec[Type]::new(), RepresentationKind::Inline}
    let dyn_llvm_type = lower_type(dyn_type)
    let self_value = reg("self", dyn_llvm_type)
    let raw_data = reg("data", ptr_type(i8_type()))
    let type_id = reg("type_id", i64_type())
    let mut entry_instructions = Vec[LLVMInstruction]::new()
    entry_instructions.push(llvm_inst_extractvalue(raw_data, self_value, "0"))
    entry_instructions.push(llvm_inst_extractvalue(type_id, self_value, "1"))
    let mut implementations = Vec[Type]::new()
    for directive in directives {
        match directive {
            Directive::Impl(item) => {
                if item.trait_name == trait_name && item.generics.len() == 0_usize { implementations.push(item.for_type) }
            }
            _ => {}
        }
    }
    let mut blocks = Vec[LLVMBasicBlock]::new()
    if implementations.len() == 0_usize {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_ret_void()))
    } else {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_br("check_0")))
        let mut index = 0_usize
        for concrete in implementations {
            let suffix = Debug::fmt(index)
            let check_name = "check_" + suffix
            let action_name = "action_" + suffix
            let next_name = if index + 1_usize < implementations.len() { "check_" + Debug::fmt(index + 1_usize) } else { "done" }
            let matches = reg("matches_" + suffix, i1_type())
            let expected = const_text(enum_variant_tag(mangle_type_name(concrete)), i64_type())
            blocks.push(llvm_block(check_name, vec_singleton(llvm_inst_binary("icmp eq", matches, type_id, expected)), llvm_term_cbr(matches, action_name, next_name)))
            let concrete_type = lower_type(concrete)
            let typed_data = reg("typed_data_" + suffix, ptr_type(concrete_type))
            let concrete_value = reg("concrete_" + suffix, concrete_type)
            let mut instructions = Vec[LLVMInstruction]::new()
            instructions.push(llvm_inst_cast("bitcast", typed_data, raw_data))
            instructions.push(llvm_inst_load(concrete_value, typed_data))
            let callee = if retain { retain_symbol(concrete) } else { drop_symbol(concrete) }
            instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), callee, vec_singleton(concrete_value)))
            blocks.push(llvm_block(action_name, instructions, llvm_term_ret_void()))
            index = index + 1_usize
        }
        blocks.push(llvm_block("done", Vec[LLVMInstruction]::new(), llvm_term_ret_void()))
    }
    let name = if retain { retain_symbol(dyn_type) } else { drop_symbol(dyn_type) }
    ret llvm_define_fn(name, void_type(), vec_singleton(llvm_make_param("self", dyn_llvm_type)), blocks)
}

fn lower_dyn_edge_function(directives: Vec[Directive], trait_name: str,
    adding: bool,) -> LLVMFunction {
    let dyn_type = Type{"dyn " + trait_name, Vec[Type]::new(), RepresentationKind::Inline}
    let dyn_llvm_type = lower_type(dyn_type)
    let raw_ptr = ptr_type(i8_type())
    let owner = reg("owner", raw_ptr)
    let self_value = reg("self", dyn_llvm_type)
    let raw_data = reg("data", raw_ptr)
    let type_id = reg("type_id", i64_type())
    let mut entry_instructions = Vec[LLVMInstruction]::new()
    entry_instructions.push(llvm_inst_extractvalue(raw_data, self_value, "0"))
    entry_instructions.push(llvm_inst_extractvalue(type_id, self_value, "1"))
    let mut implementations = Vec[Type]::new()
    for directive in directives {
        match directive {
            Directive::Impl(item) => {
                if item.trait_name == trait_name && item.generics.len() == 0_usize {
                    implementations.push(item.for_type)
                }
            }
            _ => {}
        }
    }
    let mut blocks = Vec[LLVMBasicBlock]::new()
    if implementations.len() == 0_usize {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_ret_void()))
    } else {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_br("check_0")))
        let mut index = 0_usize
        for concrete in implementations {
            let suffix = Debug::fmt(index)
            let check_name = "check_" + suffix
            let action_name = "action_" + suffix
            let next_name = if index + 1_usize < implementations.len() {
                "check_" + Debug::fmt(index + 1_usize)
            } else {
                "done"
            }
            let matches = reg("matches_" + suffix, i1_type())
            let expected = const_text(enum_variant_tag(mangle_type_name(concrete)), i64_type())
            blocks.push(llvm_block(check_name,
                vec_singleton(llvm_inst_binary("icmp eq", matches, type_id, expected)),
                llvm_term_cbr(matches, action_name, next_name),))
            let concrete_type = lower_type(concrete)
            let typed_data = reg("typed_data_" + suffix, ptr_type(concrete_type))
            let concrete_value = reg("concrete_" + suffix, concrete_type)
            let mut instructions = Vec[LLVMInstruction]::new()
            instructions.push(llvm_inst_cast("bitcast", typed_data, raw_data))
            instructions.push(llvm_inst_load(concrete_value, typed_data))
            instructions.extend(lower_edge_value(owner, concrete_value, concrete,
                "concrete_" + suffix, adding,))
            blocks.push(llvm_block(action_name, instructions, llvm_term_ret_void()))
            index += 1_usize
        }
        blocks.push(llvm_block("done", Vec[LLVMInstruction]::new(), llvm_term_ret_void()))
    }
    let mut params_data = Vec[LLVMParam]::new()
    params_data.push(llvm_make_param("owner", raw_ptr))
    params_data.push(llvm_make_param("self", dyn_llvm_type))
    ret llvm_define_fn(edge_symbol(dyn_type, adding), void_type(), params_data, blocks)
}

fn trait_is_used_dynamically(types: Vec[Type], trait_name: str) -> bool {
    for typ in types {
        if is_dyn_type(typ) && sanitize_symbol(typ.name) == "dyn_" + sanitize_symbol(trait_name) { ret true }
    }
    ret false
}

fn lower_trait_dispatch_function(directives: Vec[Directive], trait_name: str, method: TraitMethod) -> LLVMFunction {
    let dyn_type = Type{"dyn " + trait_name, Vec[Type]::new(), RepresentationKind::Inline}
    let dyn_llvm_type = lower_type(dyn_type)
    let ret_type = lower_type(method.ret_type)
    let mut params_data = Vec[LLVMParam]::new()
    let mut call_tail = Vec[LLVMValue]::new()
    let mut param_index = 0_usize
    for parameter in method.params {
        if param_index == 0_usize {
            params_data.push(llvm_make_param(parameter.name, dyn_llvm_type))
        } else {
            let param_type = lower_type(parameter.typ)
            params_data.push(llvm_make_param(parameter.name, param_type))
            call_tail.push(reg(sanitize_symbol(parameter.name), param_type))
        }
        param_index = param_index + 1_usize
    }

    let self_value = reg("self", dyn_llvm_type)
    let raw_data = reg("data", ptr_type(i8_type()))
    let type_id = reg("type_id", i64_type())
    let mut entry_instructions = Vec[LLVMInstruction]::new()
    entry_instructions.push(llvm_inst_extractvalue(raw_data, self_value, "0"))
    entry_instructions.push(llvm_inst_extractvalue(type_id, self_value, "1"))

    let mut implementations = Vec[Type]::new()
    for directive in directives {
        match directive {
            Directive::Impl(item) => {
                if item.trait_name == trait_name && item.generics.len() == 0_usize {
                    for impl_method in item.methods {
                        if impl_method.name == method.name { implementations.push(item.for_type) }
                    }
                }
            }
            _ => {}
        }
    }

    let mut blocks = Vec[LLVMBasicBlock]::new()
    if implementations.len() == 0_usize {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_unreachable()))
    } else {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_br("check_0")))
        let mut index = 0_usize
        for concrete in implementations {
            let suffix = Debug::fmt(index)
            let check_name = "check_" + suffix
            let dispatch_name = "dispatch_" + suffix
            let next_name = if index + 1_usize < implementations.len() { "check_" + Debug::fmt(index + 1_usize) } else { "missing" }
            let matches = reg("matches_" + suffix, i1_type())
            let expected = const_text(enum_variant_tag(mangle_type_name(concrete)), i64_type())
            blocks.push(llvm_block(check_name, vec_singleton(llvm_inst_binary("icmp eq", matches, type_id, expected)), llvm_term_cbr(matches, dispatch_name, next_name)))

            let concrete_llvm_type = lower_type(concrete)
            let concrete_ptr_type = ptr_type(concrete_llvm_type)
            let typed_data = reg("typed_data_" + suffix, concrete_ptr_type)
            let concrete_value = reg("concrete_" + suffix, concrete_llvm_type)
            let mut dispatch_instructions = Vec[LLVMInstruction]::new()
            dispatch_instructions.push(llvm_inst_cast("bitcast", typed_data, raw_data))
            dispatch_instructions.push(llvm_inst_load(concrete_value, typed_data))
            let args = concat_values(vec_singleton(concrete_value), call_tail)
            let callee = sanitize_symbol(concrete.name + "::" + method.name)
            if method.ret_type.name == "void" || method.ret_type.name == "()" {
                dispatch_instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), callee, args))
                blocks.push(llvm_block(dispatch_name, dispatch_instructions, llvm_term_ret_void()))
            } else {
                let result = reg("result_" + suffix, ret_type)
                dispatch_instructions.push(llvm_inst_call(Option[LLVMValue]::Some(result), ret_type, callee, args))
                blocks.push(llvm_block(dispatch_name, dispatch_instructions, llvm_term_ret(Option[LLVMValue]::Some(result), ret_type)))
            }
            index = index + 1_usize
        }
        blocks.push(llvm_block("missing", Vec[LLVMInstruction]::new(), llvm_term_unreachable()))
    }
    ret llvm_define_fn(sanitize_symbol(trait_name + "::" + method.name), ret_type, params_data, blocks)
}

fn runtime_declarations() -> Vec[LLVMFunction] {
    let mut out = Vec[LLVMFunction]::new()
    let usize_type = pointer_int_type()
    let raw_ptr = ptr_type(i8_type())
    let mut realloc_params = Vec[LLVMParam]::new()
    realloc_params.push(llvm_make_param("ptr", raw_ptr))
    realloc_params.push(llvm_make_param("bytes", usize_type))
    out.push(llvm_declare_fn("__ehir_hrealloc", raw_ptr, realloc_params, Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("__ehir_hfree", void_type(), vec_singleton(llvm_make_param("ptr", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_box_alloc", raw_ptr, vec_singleton(llvm_make_param("bytes", usize_type)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_box_retain", void_type(), vec_singleton(llvm_make_param("ptr", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_box_drop", void_type(), vec_singleton(llvm_make_param("ptr", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_heap_retain", void_type(), vec_singleton(llvm_make_param("ptr", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_heap_release", i1_type(), vec_singleton(llvm_make_param("ptr", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_heap_free_released", void_type(), vec_singleton(llvm_make_param("ptr", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_node_alloc_heap", raw_ptr, vec_singleton(llvm_make_param("bytes", usize_type)), Vec[LLVMBasicBlock]::new()))
    let mut stack_node_params = Vec[LLVMParam]::new()
    stack_node_params.push(llvm_make_param("payload", raw_ptr))
    stack_node_params.push(llvm_make_param("bytes", usize_type))
    out.push(llvm_declare_fn("encore_node_register_stack", void_type(), stack_node_params, Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_node_retain", void_type(), vec_singleton(llvm_make_param("payload", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_node_release", i1_type(), vec_singleton(llvm_make_param("payload", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_node_free_released", void_type(), vec_singleton(llvm_make_param("payload", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    let mut node_edge_params = Vec[LLVMParam]::new()
    node_edge_params.push(llvm_make_param("owner", raw_ptr))
    node_edge_params.push(llvm_make_param("target", raw_ptr))
    out.push(llvm_declare_fn("encore_node_add_edge", void_type(), node_edge_params, Vec[LLVMBasicBlock]::new()))
    let mut node_remove_edge_params = Vec[LLVMParam]::new()
    node_remove_edge_params.push(llvm_make_param("owner", raw_ptr))
    node_remove_edge_params.push(llvm_make_param("target", raw_ptr))
    out.push(llvm_declare_fn("encore_node_remove_edge", void_type(), node_remove_edge_params, Vec[LLVMBasicBlock]::new()))
    let mut node_replace_edge_params = Vec[LLVMParam]::new()
    node_replace_edge_params.push(llvm_make_param("owner", raw_ptr))
    node_replace_edge_params.push(llvm_make_param("old_target", raw_ptr))
    node_replace_edge_params.push(llvm_make_param("new_target", raw_ptr))
    out.push(llvm_declare_fn("encore_node_replace_edge", void_type(), node_replace_edge_params, Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_str_drop", void_type(), vec_singleton(llvm_make_param("value", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_str_retain", void_type(), vec_singleton(llvm_make_param("value", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_str_from_cstr", raw_ptr, vec_singleton(llvm_make_param("value", raw_ptr)), Vec[LLVMBasicBlock]::new()))
    let mut str_eq_params = Vec[LLVMParam]::new()
    str_eq_params.push(llvm_make_param("lhs", raw_ptr))
    str_eq_params.push(llvm_make_param("rhs", raw_ptr))
    out.push(llvm_declare_fn("encore_str_eq", i1_type(), str_eq_params, Vec[LLVMBasicBlock]::new()))
    let mut str_concat_params = Vec[LLVMParam]::new()
    str_concat_params.push(llvm_make_param("lhs", raw_ptr))
    str_concat_params.push(llvm_make_param("rhs", raw_ptr))
    out.push(llvm_declare_fn("encore_str_concat", raw_ptr, str_concat_params, Vec[LLVMBasicBlock]::new()))
    let fn_ptr = llvm_raw_type(LLVMTypeKind::POINTER, "void (i8*)*")
    let mut spawn_params = Vec[LLVMParam]::new()
    spawn_params.push(llvm_make_param("entry", fn_ptr))
    spawn_params.push(llvm_make_param("payload", raw_ptr))
    spawn_params.push(llvm_make_param("cleanup", fn_ptr))
    out.push(llvm_declare_fn("encore_thread_spawn", usize_type, spawn_params, Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_thread_join", raw_ptr, vec_singleton(llvm_make_param("token", usize_type)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_thread_retain", void_type(), vec_singleton(llvm_make_param("token", usize_type)), Vec[LLVMBasicBlock]::new()))
    out.push(llvm_declare_fn("encore_thread_release", void_type(), vec_singleton(llvm_make_param("token", usize_type)), Vec[LLVMBasicBlock]::new()))
    ret out
}

fn is_thread_spawn_name(name: str) -> bool {
    ret has_prefix(name, "__encore_thread_spawn__")
}

fn thread_spawn_target(name: str) -> str {
    let prefix_len = 23_usize
    if name.len() <= prefix_len { ret "" }
    ret name.slice(prefix_len, name.len() - prefix_len)
}

fn thread_result_type(out: Variable) -> Type {
    let handle = required_variable_type(out)
    match handle.generics.get(0_usize) {
        Some(result) => { ret result }
        None => {
            eprintln("internal compiler error: thread handle '" + handle.name + "' has no result type")
            exit(1_i32)
            ret Type{"usize", Vec[Type]::new(), RepresentationKind::Inline}
        }
    }
}

fn thread_result_is_void(result: Type) -> bool { ret result.name == "void" || result.name == "()" }

fn thread_result_storage_type(result: Type) -> LLVMType {
    if thread_result_is_void(result) { ret i8_type() }
    ret lower_type(result)
}

fn thread_site_key(name: str, out: Variable, generics: Vec[Type], args: Vec[Variable]) -> str {
    let mut raw = thread_spawn_target(name) + "_" + mangle_type_name(thread_result_type(out))
    for generic in generics { raw = raw + "_g_" + mangle_type_name(generic) }
    for arg in args { raw = raw + "_a_" + mangle_type_name(required_variable_type(arg)) }
    ret sanitize_symbol(raw)
}

fn thread_context_type(name: str, out: Variable, generics: Vec[Type], args: Vec[Variable]) -> LLVMType {
    ret named_struct_type("__encore_thread_context_" + thread_site_key(name, out, generics, args))
}

fn append_thread_context_declaration(out: mut Vec[str], seen: usize, instruction: Instruction) -> () {
    match instruction {
        Instruction::Call(data) => {
            if required_variable_type(data.out).name != "JoinHandle" { ret () }
            if !is_thread_spawn_name(data.name) { ret () }
            let key = thread_site_key(data.name, data.out, data.generics, data.args)
            if !unsafe { encore_strset_insert(seen, key) } { ret () }
            let mut fields = type_text(thread_result_storage_type(thread_result_type(data.out)))
            for arg in data.args { fields = fields + ", " + type_text(lower_type(required_variable_type(arg))) }
            out.push("%__encore_thread_context_" + key + " = type { " + fields + " }")
        }
        _ => {}
    }
    ret ()
}

fn thread_context_declarations(directives: Vec[Directive]) -> Vec[str] {
    let mut out = Vec[str]::new()
    let seen = unsafe { encore_strset_new() }
    for directive in directives {
        match directive {
            Directive::Function(function) => { for block_item in function.blocks { for instruction in block_item.instructions { append_thread_context_declaration(out, seen, instruction) } } }
            Directive::Impl(item) => { for method in item.methods { for block_item in method.blocks { for instruction in block_item.instructions { append_thread_context_declaration(out, seen, instruction) } } } }
            _ => {}
        }
    }
    unsafe { encore_strset_free(seen) }
    ret out
}

fn make_thread_trampoline(data: CallInstruction) -> LLVMFunction {
    let key = thread_site_key(data.name, data.out, data.generics, data.args)
    let context_type = thread_context_type(data.name, data.out, data.generics, data.args)
    let context_ptr_type = ptr_type(context_type)
    let raw_ptr_type = ptr_type(i8_type())
    let raw_payload = reg("payload", raw_ptr_type)
    let context = reg("context", context_ptr_type)
    let mut instructions = vec_singleton(llvm_inst_cast("bitcast", context, raw_payload))
    let mut args = Vec[LLVMValue]::new()
    let mut index = 0_usize
    for argument in data.args {
        let arg_type = lower_type(required_variable_type(argument))
        let arg_ptr = reg("arg_" + Debug::fmt(index) + "_ptr", ptr_type(arg_type))
        let arg_value = reg("arg_" + Debug::fmt(index), arg_type)
        instructions.push(llvm_inst_gep(arg_ptr, context_type, context, field_indices(Debug::fmt(index + 1_usize)), true))
        instructions.push(llvm_inst_load(arg_value, arg_ptr))
        args.push(arg_value)
        index = index + 1_usize
    }
    let result_ehir_type = thread_result_type(data.out)
    let result_type = lower_type(result_ehir_type)
    let target = if data.generics.len() > 0_usize { generic_symbol(thread_spawn_target(data.name), data.generics) } else { function_symbol(thread_spawn_target(data.name)) }
    if thread_result_is_void(result_ehir_type) {
        instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), target, args))
    } else {
        let result = reg("result", result_type)
        instructions.push(llvm_inst_call(Option[LLVMValue]::Some(result), result_type, target, args))
        let result_ptr = reg("result_ptr", ptr_type(result_type))
        instructions.push(llvm_inst_gep(result_ptr, context_type, context, field_indices("0"), true))
        instructions.push(llvm_inst_store(result, result_ptr))
    }
    let params = vec_singleton(llvm_make_param("payload", raw_ptr_type))
    let blocks = vec_singleton(llvm_block("entry", instructions, llvm_term_ret_void()))
    ret llvm_define_fn("__encore_thread_trampoline_" + key, void_type(), params, blocks)
}

fn make_thread_cleanup(data: CallInstruction) -> LLVMFunction {
    let key = thread_site_key(data.name, data.out, data.generics, data.args)
    let context_type = thread_context_type(data.name, data.out, data.generics, data.args)
    let raw_ptr_type = ptr_type(i8_type())
    let raw_payload = reg("payload", raw_ptr_type)
    let context = reg("context", ptr_type(context_type))
    let mut instructions = vec_singleton(llvm_inst_cast("bitcast", context, raw_payload))
    let result_type = thread_result_type(data.out)
    if !thread_result_is_void(result_type) {
        let result_ptr = reg("result_ptr", ptr_type(lower_type(result_type)))
        let result = reg("result", lower_type(result_type))
        instructions.push(llvm_inst_gep(result_ptr, context_type, context, field_indices("0"), true))
        instructions.push(llvm_inst_load(result, result_ptr))
        instructions.extend(lower_drop_value(result, result_type, "thread_result"))
    }
    instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "__ehir_hfree", vec_singleton(raw_payload)))
    let params = vec_singleton(llvm_make_param("payload", raw_ptr_type))
    ret llvm_define_fn("__encore_thread_cleanup_" + key, void_type(), params,
        vec_singleton(llvm_block("entry", instructions, llvm_term_ret_void())))
}

fn append_thread_trampoline(out: mut Vec[LLVMFunction], seen: usize, instruction: Instruction) -> () {
    match instruction {
        Instruction::Call(data) => {
            if required_variable_type(data.out).name == "JoinHandle" {
                if is_thread_spawn_name(data.name) && unsafe { encore_strset_insert(seen, thread_site_key(data.name, data.out, data.generics, data.args)) } {
                    out.push(odr_function(make_thread_trampoline(data)))
                    out.push(odr_function(make_thread_cleanup(data)))
                }
            }
        }
        _ => {}
    }
    ret ()
}

fn thread_trampolines(directives: Vec[Directive]) -> Vec[LLVMFunction] {
    let mut out = Vec[LLVMFunction]::new()
    let seen = unsafe { encore_strset_new() }
    for directive in directives {
        match directive {
            Directive::Function(function) => { for block_item in function.blocks { for instruction in block_item.instructions { append_thread_trampoline(out, seen, instruction) } } }
            Directive::Impl(item) => { for method in item.methods { for block_item in method.blocks { for instruction in block_item.instructions { append_thread_trampoline(out, seen, instruction) } } } }
            _ => {}
        }
    }
    unsafe { encore_strset_free(seen) }
    ret out
}

fn append_lowered_drop_pair(builder: usize, drop_function: LLVMFunction, retain_function: LLVMFunction,
    seen: usize, emitted: bool, declaration_builder: usize,) -> bool {
    let mut any = append_unique_functions(builder, vec_singleton(odr_function(drop_function)), seen,
        emitted, declaration_builder,)
    any = append_unique_functions(builder, vec_singleton(odr_function(retain_function)), seen, any,
        declaration_builder,)
    ret any
}

fn append_lowered_drop_functions(builder: usize, directives: Vec[Directive], concrete_types: Vec[Type],
    seen: usize, emitted: bool, declaration_builder: usize,) -> bool {
    let mut any = emitted
    for directive in directives {
        match directive {
            Directive::Struct(item) => {
                if item.generics.len() == 0_usize {
                    let concrete = Type{item.name, Vec[Type]::new(), RepresentationKind::Inline}
                    any = append_lowered_drop_pair(builder, lower_struct_drop_function(item.generics, item.fields, concrete),
                        lower_struct_retain_function(item.generics, item.fields, concrete), seen, any,
                        declaration_builder,)
                } else {
                    for concrete in concrete_types {
                        if concrete.name == item.name && concrete.generics.len() == item.generics.len() &&
                            concrete.representation == RepresentationKind::Inline {
                            any = append_lowered_drop_pair(builder, lower_struct_drop_function(item.generics, item.fields, concrete),
                                lower_struct_retain_function(item.generics, item.fields, concrete), seen, any,
                                declaration_builder,)
                        }
                    }
                }
            }
            Directive::Enum(item) => {
                if item.generics.len() == 0_usize {
                    let concrete = Type{item.name, Vec[Type]::new(), RepresentationKind::Inline}
                    any = append_lowered_drop_pair(builder, lower_enum_drop_function(item.generics, item.variants, concrete),
                        lower_enum_retain_function(item.generics, item.variants, concrete), seen, any,
                        declaration_builder,)
                } else {
                    for concrete in concrete_types {
                        if concrete.name == item.name && concrete.generics.len() == item.generics.len() &&
                            concrete.representation == RepresentationKind::Inline {
                            any = append_lowered_drop_pair(builder, lower_enum_drop_function(item.generics, item.variants, concrete),
                                lower_enum_retain_function(item.generics, item.variants, concrete), seen, any,
                                declaration_builder,)
                        }
                    }
                }
            }
            _ => {}
        }
    }
    for concrete in concrete_types {
        if is_node_handle_type(concrete) {
            any = append_lowered_drop_pair(builder, lower_heap_drop_function(concrete),
                lower_heap_retain_function(concrete), seen, any, declaration_builder,)
        }
        if has_prefix(concrete.name, "__tuple_") {
            let mut fields = Vec[Parameter]::new()
            let mut index = 0_usize
            for item_type in concrete.generics {
                fields.push(param("_" + Debug::fmt(index), item_type))
                index = index + 1_usize
            }
            any = append_lowered_drop_pair(builder, lower_struct_drop_function(Vec[Type]::new(), fields, concrete),
                lower_struct_retain_function(Vec[Type]::new(), fields, concrete), seen, any,
                declaration_builder,)
        }
    }
    ret any
}

fn edge_symbol(typ: Type, adding: bool) -> str {
    ret if adding {
        "__add_edges_" + sanitize_symbol(mangle_type_name(typ))
    } else {
        "__remove_edges_" + sanitize_symbol(mangle_type_name(typ))
    }
}

fn type_may_have_node_edges(typ: Type) -> bool {
    if is_node_handle_type(typ) { ret true }
    if typ.representation != RepresentationKind::Inline { ret false }
    if typ.name == "str" { ret false }
    ret is_aggregate_ehir_type(typ)
}

fn lower_edge_value(owner: LLVMValue, value: LLVMValue, typ: Type, suffix: str,
    adding: bool,) -> Vec[LLVMInstruction] {
    if is_node_handle_type(typ) {
        let raw_target = reg(sanitize_symbol(suffix) + "_edge_target_raw", ptr_type(i8_type()))
        let mut instructions = vec_singleton(llvm_inst_cast("bitcast", raw_target, value))
        let mut args = Vec[LLVMValue]::new()
        args.push(owner)
        args.push(raw_target)
        instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), if adding {
            "encore_node_add_edge"
        } else {
            "encore_node_remove_edge"
        }, args))
        ret instructions
    }
    if type_may_have_node_edges(typ) {
        let mut args = Vec[LLVMValue]::new()
        args.push(owner)
        args.push(value)
        ret vec_singleton(llvm_inst_call(Option[LLVMValue]::None, void_type(),
            edge_symbol(typ, adding), args))
    }
    ret Vec[LLVMInstruction]::new()
}

fn append_lowered_edge_pair(builder: usize, add_function: LLVMFunction,
    remove_function: LLVMFunction, seen: usize, emitted: bool,
    declaration_builder: usize,) -> bool {
    let mut any = append_unique_functions(builder,
        vec_singleton(odr_function(add_function)), seen, emitted, declaration_builder)
    any = append_unique_functions(builder,
        vec_singleton(odr_function(remove_function)), seen, any, declaration_builder)
    ret any
}

fn append_lowered_edge_functions(builder: usize, directives: Vec[Directive],
    concrete_types: Vec[Type], seen: usize, emitted: bool,
    declaration_builder: usize,) -> bool {
    let mut any = emitted
    for directive in directives {
        match directive {
            Directive::Struct(item) => {
                if item.generics.len() == 0_usize {
                    let concrete = Type{item.name, Vec[Type]::new(), RepresentationKind::Inline}
                    any = append_lowered_edge_pair(builder,
                        lower_struct_edge_function(item.generics, item.fields, concrete, true),
                        lower_struct_edge_function(item.generics, item.fields, concrete, false),
                        seen, any, declaration_builder,)
                } else {
                    for concrete in concrete_types {
                        if concrete.name == item.name &&
                            concrete.generics.len() == item.generics.len() &&
                            concrete.representation == RepresentationKind::Inline {
                            any = append_lowered_edge_pair(builder,
                                lower_struct_edge_function(item.generics, item.fields,
                                    concrete, true),
                                lower_struct_edge_function(item.generics, item.fields,
                                    concrete, false),
                                seen, any, declaration_builder,)
                        }
                    }
                }
            }
            Directive::Enum(item) => {
                if item.generics.len() == 0_usize {
                    let concrete = Type{item.name, Vec[Type]::new(), RepresentationKind::Inline}
                    any = append_lowered_edge_pair(builder,
                        lower_enum_edge_function(item.generics, item.variants, concrete, true),
                        lower_enum_edge_function(item.generics, item.variants, concrete, false),
                        seen, any, declaration_builder,)
                } else {
                    for concrete in concrete_types {
                        if concrete.name == item.name &&
                            concrete.generics.len() == item.generics.len() &&
                            concrete.representation == RepresentationKind::Inline {
                            any = append_lowered_edge_pair(builder,
                                lower_enum_edge_function(item.generics, item.variants,
                                    concrete, true),
                                lower_enum_edge_function(item.generics, item.variants,
                                    concrete, false),
                                seen, any, declaration_builder,)
                        }
                    }
                }
            }
            _ => {}
        }
    }
    for concrete in concrete_types {
        if has_prefix(concrete.name, "__tuple_") {
            let mut fields = Vec[Parameter]::new()
            let mut index = 0_usize
            for item_type in concrete.generics {
                fields.push(param("_" + Debug::fmt(index), item_type))
                index += 1_usize
            }
            any = append_lowered_edge_pair(builder,
                lower_struct_edge_function(Vec[Type]::new(), fields, concrete, true),
                lower_struct_edge_function(Vec[Type]::new(), fields, concrete, false),
                seen, any, declaration_builder,)
        }
    }
    ret any
}

fn lower_struct_edge_function(params: Vec[Type], fields: Vec[Parameter],
    concrete: Type, adding: bool,) -> LLVMFunction {
    let raw_ptr = ptr_type(i8_type())
    let owner = reg("owner", raw_ptr)
    let self_value = reg("self", lower_type(concrete))
    let mut params_data = Vec[LLVMParam]::new()
    params_data.push(llvm_make_param("owner", raw_ptr))
    params_data.push(llvm_make_param("self", lower_type(concrete)))
    let mut instructions = Vec[LLVMInstruction]::new()

    let mut index = 0_usize
    for field in fields {
        let field_type = substitute_generic_type(field.typ, params, concrete.generics)
        if type_may_have_node_edges(field_type) {
            let field_value = reg("field_" + Debug::fmt(index), lower_type(field_type))
            instructions.push(llvm_inst_extractvalue(field_value, self_value,
                Debug::fmt(index)))
            instructions.extend(lower_edge_value(owner, field_value, field_type,
                "field_" + Debug::fmt(index), adding,))
        }
        index += 1_usize
    }
    ret llvm_define_fn(edge_symbol(concrete, adding), void_type(), params_data,
        vec_singleton(llvm_block("entry", instructions, llvm_term_ret_void())))
}

fn lower_enum_edge_function(params: Vec[Type], variants: Vec[EnumVariant],
    concrete: Type, adding: bool,) -> LLVMFunction {
    let raw_ptr = ptr_type(i8_type())
    let owner = reg("owner", raw_ptr)
    let self_value = reg("self", lower_type(concrete))
    let mut params_data = Vec[LLVMParam]::new()
    params_data.push(llvm_make_param("owner", raw_ptr))
    params_data.push(llvm_make_param("self", lower_type(concrete)))
    let tag = reg("tag", i32_type())
    let mut relevant = Vec[EnumVariant]::new()
    for variant in variants {
        match variant.payload_type {
            Option[Type]::Some(raw_payload_type) => {
                let payload_type = substitute_generic_type(raw_payload_type,
                    params, concrete.generics)
                if type_may_have_node_edges(payload_type) &&
                    !enum_payload_is_inline(payload_type) {
                    relevant.push(variant)
                }
            }
            Option[Type]::None => {}
        }
    }
    let entry = vec_singleton(llvm_inst_extractvalue(tag, self_value, "0"))
    let mut blocks = Vec[LLVMBasicBlock]::new()
    if relevant.len() == 0_usize {
        blocks.push(llvm_block("entry", entry, llvm_term_ret_void()))
        ret llvm_define_fn(edge_symbol(concrete, adding), void_type(), params_data, blocks)
    }
    blocks.push(llvm_block("entry", entry, llvm_term_br("check_0")))
    let mut index = 0_usize
    for variant in relevant {
        let check_name = "check_" + Debug::fmt(index)
        let visit_name = "visit_" + Debug::fmt(index)
        let next_name = if index + 1_usize < relevant.len() {
            "check_" + Debug::fmt(index + 1_usize)
        } else {
            "done"
        }
        let matches = reg("matches_" + Debug::fmt(index), i1_type())
        blocks.push(llvm_block(check_name,
            vec_singleton(llvm_inst_binary("icmp eq", matches, tag,
                const_i32(enum_variant_tag(variant.name)))),
            llvm_term_cbr(matches, visit_name, next_name),))
        match variant.payload_type {
            Option[Type]::Some(raw_payload_type) => {
                let payload_type = substitute_generic_type(raw_payload_type,
                    params, concrete.generics)
                let payload = reg("payload_" + Debug::fmt(index), lower_type(payload_type))
                let raw = reg("payload_raw_" + Debug::fmt(index), raw_ptr)
                let typed = reg("payload_ptr_" + Debug::fmt(index),
                    ptr_type(lower_type(payload_type)))
                let mut visit = vec_singleton(llvm_inst_extractvalue(raw, self_value, "1"))
                visit.push(llvm_inst_cast("bitcast", typed, raw))
                visit.push(llvm_inst_load(payload, typed))
                visit.extend(lower_edge_value(owner, payload, payload_type,
                    "payload_" + Debug::fmt(index), adding,))
                blocks.push(llvm_block(visit_name, visit, llvm_term_ret_void()))
            }
            Option[Type]::None => {}
        }
        index += 1_usize
    }
    blocks.push(llvm_block("done", Vec[LLVMInstruction]::new(), llvm_term_ret_void()))
    ret llvm_define_fn(edge_symbol(concrete, adding), void_type(), params_data, blocks)
}

fn struct_needs_drop(fields: Vec[Parameter]) -> bool {
    for field in fields {
        if type_needs_drop(field.typ) { ret true }
    }
    ret false
}

fn specialized_struct_needs_drop(params: Vec[Type], fields: Vec[Parameter], args: Vec[Type]) -> bool {
    for field in fields {
        if type_needs_drop(substitute_generic_type(field.typ, params, args)) { ret true }
    }
    ret false
}

fn type_needs_drop(typ: Type) -> bool {
    if is_node_handle_type(typ) { ret true }
    if typ.representation != RepresentationKind::Inline { ret false }
    if typ.name == "str" { ret true }
    ret is_aggregate_ehir_type(typ)
}

fn drop_symbol(typ: Type) -> str {
    ret "__drop_" + sanitize_symbol(mangle_type_name(typ))
}

fn retain_symbol(typ: Type) -> str {
    ret "__retain_" + sanitize_symbol(mangle_type_name(typ))
}

fn lower_heap_drop_function(concrete: Type) -> LLVMFunction {
    if concrete.name == "VecStorage" && concrete.generics.len() == 1_usize {
        ret lower_vec_storage_heap_drop_function(concrete)
    }
    let self_value = reg("self", lower_type(concrete))
    let raw = reg("raw", ptr_type(i8_type()))
    let is_last = reg("is_last", i1_type())
    let mut entry = Vec[LLVMInstruction]::new()
    entry.push(llvm_inst_cast("bitcast", raw, self_value))
    entry.push(llvm_inst_call(Option[LLVMValue]::Some(is_last), i1_type(), "encore_node_release", vec_singleton(raw)))

    let plain = Type{concrete.name, concrete.generics, RepresentationKind::Inline}
    let pointee = reg("pointee", lower_type(plain))
    let mut release = vec_singleton(llvm_inst_load(pointee, self_value))
    release.extend(lower_drop_value(pointee, plain, "heap_pointee"))
    release.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_node_free_released", vec_singleton(raw)))

    let mut blocks = Vec[LLVMBasicBlock]::new()
    blocks.push(llvm_block("entry", entry, llvm_term_cbr(is_last, "release", "done")))
    blocks.push(llvm_block("release", release, llvm_term_ret_void()))
    blocks.push(llvm_block("done", Vec[LLVMInstruction]::new(), llvm_term_ret_void()))
    ret llvm_define_fn(drop_symbol(concrete), void_type(), vec_singleton(llvm_make_param("self", lower_type(concrete))), blocks)
}

fn lower_vec_storage_heap_drop_function(concrete: Type) -> LLVMFunction {
    let element_type = required_generic_type(concrete, 0_usize)
    let self_value = reg("self", lower_type(concrete))
    let raw_node = reg("raw_node", ptr_type(i8_type()))
    let is_last = reg("is_last", i1_type())
    let mut entry = Vec[LLVMInstruction]::new()
    entry.push(llvm_inst_cast("bitcast", raw_node, self_value))
    entry.push(llvm_inst_call(Option[LLVMValue]::Some(is_last), i1_type(),
        "encore_node_release", vec_singleton(raw_node)))

    let plain = Type{concrete.name, concrete.generics, RepresentationKind::Inline}
    let data_ptr_ptr = reg("data_ptr_ptr", ptr_type(ptr_type(lower_type(element_type))))
    let data = reg("data", ptr_type(lower_type(element_type)))
    let raw_data = reg("raw_data", ptr_type(i8_type()))
    let len_ptr = reg("len_ptr", ptr_type(pointer_int_type()))
    let len = reg("len", pointer_int_type())
    let mut release = Vec[LLVMInstruction]::new()
    release.push(llvm_inst_gep(data_ptr_ptr, lower_type(plain), self_value,
        field_indices("0"), true))
    release.push(llvm_inst_load(data, data_ptr_ptr))
    release.push(llvm_inst_cast("bitcast", raw_data, data))
    release.push(llvm_inst_gep(len_ptr, lower_type(plain), self_value,
        field_indices("1"), true))
    release.push(llvm_inst_load(len, len_ptr))

    let mut free = Vec[LLVMInstruction]::new()
    free.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "__ehir_hfree",
        vec_singleton(raw_data)))
    free.push(llvm_inst_call(Option[LLVMValue]::None, void_type(),
        "encore_node_free_released", vec_singleton(raw_node)))

    let mut blocks = Vec[LLVMBasicBlock]::new()
    if type_needs_drop(element_type) {
        let index_ptr = reg("index_ptr", ptr_type(pointer_int_type()))
        release.push(llvm_inst_alloca(index_ptr, pointer_int_type()))
        release.push(llvm_inst_store(const_text("0", pointer_int_type()), index_ptr))

        let index = reg("index", pointer_int_type())
        let has_next = reg("has_next", i1_type())
        let mut check = vec_singleton(llvm_inst_load(index, index_ptr))
        check.push(llvm_inst_binary("icmp ult", has_next, index, len))

        let element_ptr = reg("element_ptr", ptr_type(lower_type(element_type)))
        let element = reg("element", lower_type(element_type))
        let next_index = reg("next_index", pointer_int_type())
        let mut drop_element = vec_singleton(llvm_inst_gep(element_ptr,
            lower_type(element_type), data, vec_singleton(index), true))
        drop_element.push(llvm_inst_load(element, element_ptr))
        drop_element.extend(lower_drop_value(element, element_type, "element"))
        drop_element.push(llvm_inst_add(next_index, index,
            const_text("1", pointer_int_type())))
        drop_element.push(llvm_inst_store(next_index, index_ptr))

        blocks.push(llvm_block("entry", entry,
            llvm_term_cbr(is_last, "release", "done")))
        blocks.push(llvm_block("release", release, llvm_term_br("check")))
        blocks.push(llvm_block("check", check,
            llvm_term_cbr(has_next, "drop_element", "free")))
        blocks.push(llvm_block("drop_element", drop_element, llvm_term_br("check")))
    } else {
        blocks.push(llvm_block("entry", entry,
            llvm_term_cbr(is_last, "release", "done")))
        blocks.push(llvm_block("release", release, llvm_term_br("free")))
    }
    blocks.push(llvm_block("free", free, llvm_term_br("done")))
    blocks.push(llvm_block("done", Vec[LLVMInstruction]::new(), llvm_term_ret_void()))
    ret llvm_define_fn(drop_symbol(concrete), void_type(),
        vec_singleton(llvm_make_param("self", lower_type(concrete))), blocks)
}

fn lower_heap_retain_function(concrete: Type) -> LLVMFunction {
    let self_value = reg("self", lower_type(concrete))
    let raw = reg("raw", ptr_type(i8_type()))
    let mut instructions = Vec[LLVMInstruction]::new()
    instructions.push(llvm_inst_cast("bitcast", raw, self_value))
    instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_node_retain", vec_singleton(raw)))
    let body = vec_singleton(llvm_block("entry", instructions, llvm_term_ret_void()))
    ret llvm_define_fn(retain_symbol(concrete), void_type(), vec_singleton(llvm_make_param("self", lower_type(concrete))), body)
}

fn lower_struct_drop_function(params: Vec[Type], fields: Vec[Parameter], concrete: Type) -> LLVMFunction {
    let self_value = reg("self", lower_type(concrete))
    let mut instructions = Vec[LLVMInstruction]::new()
    if concrete.name == "JoinHandle" && concrete.generics.len() == 1_usize {
        let token = reg("token", pointer_int_type())
        instructions.push(llvm_inst_extractvalue(token, self_value, "0"))
        instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_thread_release", vec_singleton(token)))
        let params_data = vec_singleton(llvm_make_param("self", lower_type(concrete)))
        ret llvm_define_fn(drop_symbol(concrete), void_type(), params_data, vec_singleton(llvm_block("entry", instructions, llvm_term_ret_void())))
    }
    let mut index = 0_usize
    for field in fields {
        let field_type = substitute_generic_type(field.typ, params, concrete.generics)
        if type_needs_drop(field_type) {
            let field_value = reg("field_" + Debug::fmt(index), lower_type(field_type))
            instructions.push(llvm_inst_extractvalue(field_value, self_value, Debug::fmt(index)))
            instructions.extend(lower_drop_value(field_value, field_type, "field_" + Debug::fmt(index)))
        }
        index = index + 1_usize
    }
    let params_data = vec_singleton(llvm_make_param("self", lower_type(concrete)))
    let body = vec_singleton(llvm_block("entry", instructions, llvm_term_ret_void()))
    ret llvm_define_fn(drop_symbol(concrete), void_type(), params_data, body)
}

fn lower_struct_retain_function(params: Vec[Type], fields: Vec[Parameter], concrete: Type) -> LLVMFunction {
    let self_value = reg("self", lower_type(concrete))
    let mut instructions = Vec[LLVMInstruction]::new()
    if concrete.name == "JoinHandle" && concrete.generics.len() == 1_usize {
        let token = reg("token", pointer_int_type())
        instructions.push(llvm_inst_extractvalue(token, self_value, "0"))
        instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_thread_retain", vec_singleton(token)))
        let params_data = vec_singleton(llvm_make_param("self", lower_type(concrete)))
        ret llvm_define_fn(retain_symbol(concrete), void_type(), params_data,
            vec_singleton(llvm_block("entry", instructions, llvm_term_ret_void())))
    }
    let mut index = 0_usize
    for field in fields {
        let field_type = substitute_generic_type(field.typ, params, concrete.generics)
        if type_needs_drop(field_type) {
            let field_value = reg("field_" + Debug::fmt(index), lower_type(field_type))
            instructions.push(llvm_inst_extractvalue(field_value, self_value, Debug::fmt(index)))
            instructions.extend(lower_retain_value(field_value, field_type))
        }
        index = index + 1_usize
    }
    let params_data = vec_singleton(llvm_make_param("self", lower_type(concrete)))
    let body = vec_singleton(llvm_block("entry", instructions, llvm_term_ret_void()))
    ret llvm_define_fn(retain_symbol(concrete), void_type(), params_data, body)
}

fn lower_enum_drop_function(params: Vec[Type], variants: Vec[EnumVariant], concrete: Type) -> LLVMFunction {
    let self_value = reg("self", lower_type(concrete))
    let tag = reg("tag", i32_type())
    let mut blocks = Vec[LLVMBasicBlock]::new()
    let mut droppable = Vec[EnumVariant]::new()
    for variant in variants {
        match variant.payload_type {
            Option[Type]::Some(raw_payload_type) => {
                let payload_type = substitute_generic_type(raw_payload_type, params, concrete.generics)
                if !enum_payload_is_inline(payload_type) {
                    droppable.push(variant)
                }
            }
            Option[Type]::None => {}
        }
    }
    let entry_instructions = vec_singleton(llvm_inst_extractvalue(tag, self_value, "0"))
    if droppable.len() == 0_usize {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_ret_void()))
    } else {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_br("check_0")))
        let mut index = 0_usize
        for variant in droppable {
            let check_name = "check_" + Debug::fmt(index)
            let drop_name = "drop_" + Debug::fmt(index)
            let next_name = if index + 1_usize < droppable.len() { "check_" + Debug::fmt(index + 1_usize) } else { "done" }
            let matches = reg("matches_" + Debug::fmt(index), i1_type())
            let compare = llvm_inst_binary("icmp eq", matches, tag, const_i32(enum_variant_tag(variant.name)))
            blocks.push(llvm_block(check_name, vec_singleton(compare), llvm_term_cbr(matches, drop_name, next_name)))
            match variant.payload_type {
                Option[Type]::Some(raw_payload_type) => {
                    let payload_type = substitute_generic_type(raw_payload_type, params, concrete.generics)
                    let payload = reg("payload_" + Debug::fmt(index), lower_type(payload_type))
                    let raw = reg("payload_raw_" + Debug::fmt(index), ptr_type(i8_type()))
                    let typed = reg("payload_ptr_" + Debug::fmt(index), ptr_type(lower_type(payload_type)))
                    let mut drop_instructions = vec_singleton(llvm_inst_extractvalue(raw, self_value, "1"))
                    drop_instructions.push(llvm_inst_cast("bitcast", typed, raw))
                    drop_instructions.push(llvm_inst_load(payload, typed))
                    drop_instructions.extend(lower_drop_value(payload, payload_type, "payload_" + Debug::fmt(index)))
                    drop_instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_box_drop", vec_singleton(raw)))
                    blocks.push(llvm_block(drop_name, drop_instructions, llvm_term_ret_void()))
                }
                Option[Type]::None => {}
            }
            index = index + 1_usize
        }
        blocks.push(llvm_block("done", Vec[LLVMInstruction]::new(), llvm_term_ret_void()))
    }
    let params_data = vec_singleton(llvm_make_param("self", lower_type(concrete)))
    ret llvm_define_fn(drop_symbol(concrete), void_type(), params_data, blocks)
}

fn lower_enum_retain_function(params: Vec[Type], variants: Vec[EnumVariant], concrete: Type) -> LLVMFunction {
    let self_value = reg("self", lower_type(concrete))
    let tag = reg("tag", i32_type())
    let mut blocks = Vec[LLVMBasicBlock]::new()
    let mut retainable = Vec[EnumVariant]::new()
    for variant in variants {
        match variant.payload_type {
            Option[Type]::Some(raw_payload_type) => {
                let payload_type = substitute_generic_type(raw_payload_type, params, concrete.generics)
                if !enum_payload_is_inline(payload_type) {
                    retainable.push(variant)
                }
            }
            Option[Type]::None => {}
        }
    }
    let entry_instructions = vec_singleton(llvm_inst_extractvalue(tag, self_value, "0"))
    if retainable.len() == 0_usize {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_ret_void()))
    } else {
        blocks.push(llvm_block("entry", entry_instructions, llvm_term_br("check_0")))
        let mut index = 0_usize
        for variant in retainable {
            let check_name = "check_" + Debug::fmt(index)
            let retain_name = "retain_" + Debug::fmt(index)
            let next_name = if index + 1_usize < retainable.len() { "check_" + Debug::fmt(index + 1_usize) } else { "done" }
            let matches = reg("matches_" + Debug::fmt(index), i1_type())
            let compare = llvm_inst_binary("icmp eq", matches, tag, const_i32(enum_variant_tag(variant.name)))
            blocks.push(llvm_block(check_name, vec_singleton(compare), llvm_term_cbr(matches, retain_name, next_name)))
            match variant.payload_type {
                Option[Type]::Some(raw_payload_type) => {
                    let payload_type = substitute_generic_type(raw_payload_type, params, concrete.generics)
                    let payload = reg("payload_" + Debug::fmt(index), lower_type(payload_type))
                    let raw = reg("payload_raw_" + Debug::fmt(index), ptr_type(i8_type()))
                    let typed = reg("payload_ptr_" + Debug::fmt(index), ptr_type(lower_type(payload_type)))
                    let mut retain_instructions = vec_singleton(llvm_inst_extractvalue(raw, self_value, "1"))
                    retain_instructions.push(llvm_inst_cast("bitcast", typed, raw))
                    retain_instructions.push(llvm_inst_load(payload, typed))
                    retain_instructions.extend(lower_retain_value(payload, payload_type))
                    retain_instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_box_retain", vec_singleton(raw)))
                    blocks.push(llvm_block(retain_name, retain_instructions, llvm_term_ret_void()))
                }
                Option[Type]::None => {}
            }
            index = index + 1_usize
        }
        blocks.push(llvm_block("done", Vec[LLVMInstruction]::new(), llvm_term_ret_void()))
    }
    let params_data = vec_singleton(llvm_make_param("self", lower_type(concrete)))
    ret llvm_define_fn(retain_symbol(concrete), void_type(), params_data, blocks)
}

fn lower_drop_value(value: LLVMValue, typ: Type, suffix: str) -> Vec[LLVMInstruction] {
    if is_node_handle_type(typ) {
        ret vec_singleton(llvm_inst_call(Option[LLVMValue]::None, void_type(), drop_symbol(typ), vec_singleton(value)))
    }
    if typ.representation != RepresentationKind::Inline { ret Vec[LLVMInstruction]::new() }
    if typ.name == "str" {
        ret vec_singleton(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_str_drop", vec_singleton(value)))
    }
    if is_aggregate_ehir_type(typ) {
        ret vec_singleton(llvm_inst_call(Option[LLVMValue]::None, void_type(), drop_symbol(typ), vec_singleton(value)))
    }
    ret Vec[LLVMInstruction]::new()
}

fn lower_retain_value(value: LLVMValue, typ: Type) -> Vec[LLVMInstruction] {
    if is_node_handle_type(typ) {
        ret vec_singleton(llvm_inst_call(Option[LLVMValue]::None, void_type(), retain_symbol(typ), vec_singleton(value)))
    }
    if typ.representation != RepresentationKind::Inline { ret Vec[LLVMInstruction]::new() }
    if typ.name == "str" {
        ret vec_singleton(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_str_retain", vec_singleton(value)))
    }
    if is_aggregate_ehir_type(typ) {
        ret vec_singleton(llvm_inst_call(Option[LLVMValue]::None, void_type(), retain_symbol(typ), vec_singleton(value)))
    }
    ret Vec[LLVMInstruction]::new()
}

fn collect_generic_calls(directives: Vec[Directive]) -> Vec[GenericCall] {
    let mut out = Vec[GenericCall]::new()
    let seen = unsafe { encore_strset_new() }
    for directive in directives {
        match directive {
            Directive::Function(function) => {
                if function.generics.len() == 0_usize {
                    collect_direct_generic_calls(out, seen, function)
                }
            }
            Directive::Impl(item) => {
                if item.generics.len() == 0_usize {
                    for method in item.methods { collect_direct_generic_calls(out, seen, method) }
                }
            }
            _ => {}
        }
    }
    unsafe { encore_strset_free(seen) }
    ret out
}

fn collect_direct_generic_calls(out: mut Vec[GenericCall], seen: usize, function: FnDirective) -> () {
    let mut block_index = 0_usize
    while block_index < function.blocks.len() {
        let block_handle = unsafe { function.blocks.get_handle(block_index) }
        unsafe {
            unsafe ehir {
                block_ptr: Block* = pcast block_handle: usize, Block*
                block_item: Block = load block_ptr: Block*
            }
            let mut instruction_index = 0_usize
            while instruction_index < block_item.instructions.len() {
                collect_direct_generic_call(out, seen, block_item.instructions.get_handle(instruction_index))
                instruction_index = instruction_index + 1_usize
            }
        }
        block_index = block_index + 1_usize
    }
    ret ()
}

fn collect_direct_generic_call(out: mut Vec[GenericCall], seen: usize, instruction_handle: usize) -> () {
    unsafe {
        unsafe ehir {
            instruction_ptr: Instruction* = pcast instruction_handle: usize, Instruction*
            instruction: Instruction = load instruction_ptr: Instruction*
        }
        match instruction {
            Instruction::Call(data) => {
                if data.generics.len() > 0_usize {
                    let is_spawn = required_variable_type(data.out).name == "JoinHandle" && is_thread_spawn_name(data.name)
                    let name = if is_spawn { thread_spawn_target(data.name) } else { data.name }
                    remember_generic_call(out, seen, name, data.generics)
                }
            }
            _ => {}
        }
    }
    ret ()
}

fn expand_generic_calls(directives: Vec[Directive], calls: mut Vec[GenericCall]) -> () {
    let seen = unsafe { encore_strset_new() }
    for call_data in calls {
        unsafe { encore_strset_insert(seen, call_data.key) }
    }
    let mut index = 0_usize
    while index < calls.len() {
        match calls.get(index) {
            Option[GenericCall]::Some(current) => {
                // Nested discovery can grow `calls` and reallocate its storage.
                // Snapshot the item before passing its arguments into that walk.
                let current_name = current.name
                let mut current_args = Vec[Type]::new()
                for arg in current.args { current_args.push(arg) }
                let mut directive_index = 0_usize
                while directive_index < directives.len() {
                    expand_generic_call_in_directive(calls, seen, directives.get_handle(directive_index), current_name, current_args)
                    directive_index = directive_index + 1_usize
                }
            }
            Option[GenericCall]::None => {}
        }
        index = index + 1_usize
    }
    unsafe { encore_strset_free(seen) }
    ret ()
}

fn expand_generic_call_in_directive(out: mut Vec[GenericCall], seen: usize, directive_handle: usize, name: str, args: Vec[Type]) -> () {
    unsafe {
        unsafe ehir {
            directive_ptr: Directive* = pcast directive_handle: usize, Directive*
            directive: Directive = load directive_ptr: Directive*
        }
        match directive {
            Directive::Function(function) => {
                if generic_function_name_matches(function.name, name) && function.generics.len() == args.len() {
                    collect_nested_generic_calls(out, seen, function, function.generics, args)
                }
            }
            Directive::Impl(item) => {
                let mut method_index = 0_usize
                while method_index < item.methods.len() {
                    let method_handle = item.methods.get_handle(method_index)
                    unsafe ehir {
                        method_ptr: FnDirective* = pcast method_handle: usize, FnDirective*
                        method: FnDirective = load method_ptr: FnDirective*
                    }
                    let full_name = item.for_type.name + "::" + method.name
                    if method.generics.len() == 0_usize {
                        if full_name == name && item.generics.len() == args.len() { collect_nested_generic_calls(out, seen, method, item.generics, args) }
                    } elif item.generics.len() == 0_usize {
                        if full_name == name && method.generics.len() == args.len() { collect_nested_generic_calls(out, seen, method, method.generics, args) }
                    } else {
                        let params = combined_impl_method_generics(item.generics, method.generics)
                        if full_name == name && params.len() == args.len() { collect_nested_generic_calls(out, seen, method, params, args) }
                    }
                    method_index = method_index + 1_usize
                }
            }
            _ => {}
        }
    }
    ret ()
}

fn collect_nested_generic_calls(out: mut Vec[GenericCall], seen: usize, function: FnDirective, params: Vec[Type], args: Vec[Type]) -> () {
    let mut block_index = 0_usize
    while block_index < function.blocks.len() {
        let block_handle = unsafe { function.blocks.get_handle(block_index) }
        unsafe {
            unsafe ehir {
                block_ptr: Block* = pcast block_handle: usize, Block*
                block_item: Block = load block_ptr: Block*
            }
            let mut instruction_index = 0_usize
            while instruction_index < block_item.instructions.len() {
                collect_nested_generic_call(out, seen, block_item.instructions.get_handle(instruction_index), params, args)
                instruction_index = instruction_index + 1_usize
            }
        }
        block_index = block_index + 1_usize
    }
    ret ()
}

fn collect_nested_generic_call(out: mut Vec[GenericCall], seen: usize, instruction_handle: usize, params: Vec[Type], args: Vec[Type]) -> () {
    unsafe {
        unsafe ehir {
            instruction_ptr: Instruction* = pcast instruction_handle: usize, Instruction*
            instruction: Instruction = load instruction_ptr: Instruction*
        }
        match instruction {
            Instruction::Call(data) => {
                if data.generics.len() > 0_usize {
                    let mut concrete = Vec[Type]::new()
                    for generic in data.generics { concrete.push(substitute_generic_type(generic, params, args)) }
                    remember_generic_call(out, seen, data.name, concrete)
                }
                let mut owner_index = 0_usize
                while owner_index < params.len() && owner_index < args.len() {
                    match params.get(owner_index) {
                        Some(param_type) => {
                            let prefix = param_type.name + "::"
                            if has_prefix(data.name, prefix) {
                                match args.get(owner_index) {
                                    Some(concrete_owner) => {
                                        if concrete_owner.generics.len() > 0_usize {
                                            let concrete_name = concrete_owner.name + data.name.slice(param_type.name.len(), data.name.len() - param_type.name.len())
                                            remember_generic_call(out, seen, concrete_name, concrete_owner.generics)
                                        }
                                    }
                                    None => {}
                                }
                            }
                        }
                        None => {}
                    }
                    owner_index = owner_index + 1_usize
                }
            }
            _ => {}
        }
    }
    ret ()
}

fn remember_generic_call(out: mut Vec[GenericCall], seen: usize, name: str, args: Vec[Type]) -> () {
    let key = generic_symbol(name, args)
    if !unsafe { encore_strset_insert(seen, key) } { ret () }
    out.push(GenericCall{name, args, key})
    ret ()
}

fn append_lowered_generic_functions(builder: usize, directives: Vec[Directive], calls: Vec[GenericCall],
    seen: usize, emitted: bool, declaration_builder: usize,) -> bool {
    let mut any = emitted
    for directive in directives {
        match directive {
            Directive::Function(function) => {
                if function.generics.len() > 0_usize {
                    for call_data in calls {
                        if generic_function_name_matches(function.name, call_data.name) && call_data.args.len() == function.generics.len() {
                            let template = generic_function_template_for_call(function, call_data.name)
                            any = append_unique_functions(builder,
                                vec_singleton(odr_function(lower_function(specialize_function(template,
                                            call_data.args,)))), seen, any, declaration_builder,)
                        }
                    }
                }
            }
            Directive::Impl(item) => {
                for method in item.methods {
                    let full_name = item.for_type.name + "::" + method.name
                    if method.generics.len() == 0_usize && item.generics.len() > 0_usize {
                        for call_data in calls {
                            if call_data.name == full_name && call_data.args.len() == item.generics.len() {
                                let template = fn_item(full_name, item.generics, method.params, method.ret_type, method.blocks)
                                any = append_unique_functions(builder,
                                    vec_singleton(odr_function(lower_function(specialize_function(template,
                                                call_data.args,)))), seen, any, declaration_builder,)
                            }
                        }
                    } elif item.generics.len() == 0_usize && method.generics.len() > 0_usize {
                        for call_data in calls {
                            if call_data.name == full_name && call_data.args.len() == method.generics.len() {
                                let template = fn_item(full_name, method.generics, method.params, method.ret_type, method.blocks)
                                any = append_unique_functions(builder,
                                    vec_singleton(odr_function(lower_function(specialize_function(template,
                                                call_data.args,)))), seen, any, declaration_builder,)
                            }
                        }
                    } elif item.generics.len() > 0_usize && method.generics.len() > 0_usize {
                        let params = combined_impl_method_generics(item.generics, method.generics)
                        for call_data in calls {
                            if call_data.name == full_name && call_data.args.len() == params.len() {
                                let template = fn_item(full_name, params, method.params, method.ret_type, method.blocks)
                                any = append_unique_functions(builder,
                                    vec_singleton(odr_function(lower_function(specialize_function(template,
                                                call_data.args,)))), seen, any, declaration_builder,)
                            }
                        }
                    }
                }
            }
            _ => {}
        }
    }
    ret any
}

fn generic_function_name_matches(template_name: str, call_name: str) -> bool {
    if template_name == call_name { ret true }
    if call_name.contains("::") { ret false }
    ret str_ends_with(template_name, "__" + call_name)
}

fn generic_function_template_for_call(function: FnDirective, call_name: str) -> FnDirective {
    if function.name == call_name { ret function }
    if function.is_async { ret async_fn_item(call_name, function.generics, function.params, function.ret_type, function.blocks) }
    ret fn_item(call_name, function.generics, function.params, function.ret_type, function.blocks)
}

fn combined_impl_method_generics(impl_generics: Vec[Type], method_generics: Vec[Type]) -> Vec[Type] {
    if method_generics.len() == 0_usize { ret impl_generics }
    if impl_generics.len() == 0_usize { ret method_generics }
    let mut out = Vec[Type]::new()
    for generic in impl_generics { out.push(generic) }
    for generic in method_generics { out.push(generic) }
    ret out
}

fn specialize_function(function: FnDirective, args: Vec[Type]) -> FnDirective {
    let params = function.generics
    let mut specialized_params = Vec[Parameter]::new()
    for parameter in function.params {
        specialized_params.push(param(parameter.name, substitute_generic_type(parameter.typ, params, args)))
    }
    let mut specialized_blocks = Vec[Block]::new()
    for block_item in function.blocks {
        let terminator = specialize_terminator(block_item.terminator, params, args)
        let mut instructions = Vec[Instruction]::new()
        for instruction in block_item.instructions {
            instructions.push(specialize_instruction(instruction, params, args))
        }
        specialized_blocks.push(block(block_item.name, instructions, terminator))
    }
    if function.is_async {
        ret async_fn_item(
            generic_symbol(function.name, args),
            Vec[Type]::new(),
            specialized_params,
            substitute_generic_type(function.ret_type, params, args),
            specialized_blocks
        )
    }
    ret fn_item(generic_symbol(function.name, args), Vec[Type]::new(), specialized_params, substitute_generic_type(function.ret_type, params, args), specialized_blocks)
}

fn specialize_instruction(instruction: Instruction, params: Vec[Type], args: Vec[Type]) -> Instruction {
    match instruction {
        Instruction::Lcpos(data) => { ret lcpos(specialize_variable(data.out, params, args), data.value) }
        Instruction::Alias(data) => { ret alias(specialize_variable(data.out, params, args), specialize_variable(data.src, params, args)) }
        Instruction::Lcsos(data) => {
            let mut values = Vec[Variable]::new()
            for value in data.args { values.push(specialize_variable(value, params, args)) }
            ret lcsos(specialize_variable(data.out, params, args), substitute_generic_type(data.typ, params, args), values)
        }
        Instruction::Lceos(data) => {
            let value = data.value
            let payload = match value.payload {
                Option[Variable]::Some(item) => { Option[Variable]::Some(specialize_variable(item, params, args)) }
                Option[Variable]::None => { Option[Variable]::None }
            }
            let mut generics = Vec[Type]::new()
            for generic in value.generics { generics.push(substitute_generic_type(generic, params, args)) }
            ret lceos(specialize_variable(data.out, params, args), enum_value(value.name, generics, value.variant, payload))
        }
        Instruction::Call(data) => {
            let mut values = Vec[Variable]::new()
            for value in data.args { values.push(specialize_variable(value, params, args)) }
            let mut generics = Vec[Type]::new()
            for generic in data.generics { generics.push(substitute_generic_type(generic, params, args)) }
            let mut call_name = data.name
            let mut owner_index = 0_usize
            while owner_index < params.len() && owner_index < args.len() {
                match params.get(owner_index) {
                    Some(param_type) => {
                        let prefix = param_type.name + "::"
                        if has_prefix(call_name, prefix) {
                            match args.get(owner_index) {
                                Some(concrete_owner) => {
                                    call_name = concrete_owner.name + call_name.slice(param_type.name.len(), call_name.len() - param_type.name.len())
                                    if generics.len() == 0_usize {
                                        for concrete_generic in concrete_owner.generics { generics.push(concrete_generic) }
                                    }
                                }
                                None => {}
                            }
                        }
                    }
                    None => {}
                }
                owner_index = owner_index + 1_usize
            }
            if call_name == "Debug::fmt" {
                match values.get(0_usize) {
                    Some(value) => {
                        match value.typ {
                            Some(typ) => { call_name = typ.name + "::fmt" }
                            None => {}
                        }
                    }
                    None => {}
                }
            }
            if call_name.len() == 5_usize && call_name.slice(1_usize, 4_usize) == "::op" {
                match values.get(0_usize) {
                    Some(value) => {
                        match value.typ {
                            Some(typ) => { call_name = typ.name + "::op" }
                            None => {}
                        }
                    }
                    None => {}
                }
            }
            if call_name.len() == 6_usize && call_name.slice(1_usize, 5_usize) == "::pow" {
                match values.get(0_usize) {
                    Some(value) => {
                        match value.typ {
                            Some(typ) => { call_name = typ.name + "::pow" }
                            None => {}
                        }
                    }
                    None => {}
                }
            }
            if data.name.len() == 5_usize && data.name.slice(1_usize, 4_usize) == "::op" && values.len() == 2_usize {
                match values.get(0_usize) {
                    Some(first) => {
                        match first.typ {
                            Some(first_type) => {
                                if is_numeric_ehir_type(first_type) {
                                    match values.get(1_usize) {
                                        Some(second) => { ret binary(specialize_variable(data.out, params, args), first, second, BinaryOpKind::ADD) }
                                        None => {}
                                    }
                                }
                            }
                            None => {}
                        }
                    }
                    None => {}
                }
            }
            ret call(specialize_variable(data.out, params, args), call_name, generics, values, data.is_unsafe)
        }
        Instruction::Await(data) => {
            ret await_value(specialize_variable(data.out, params, args), specialize_variable(data.future, params, args))
        }
        Instruction::Store(data) => { ret store(specialize_variable(data.src, params, args), specialize_variable(data.dst, params, args)) }
        Instruction::Load(data) => { ret load(specialize_variable(data.out, params, args), specialize_variable(data.src, params, args)) }
        Instruction::Binary(data) => {
            ret binary(
                specialize_variable(data.out, params, args),
                specialize_variable(data.lhs, params, args),
                specialize_variable(data.rhs, params, args),
                data.op
            )
        }
        Instruction::GetField(data) => {
            ret getfield(
                specialize_variable(data.out, params, args),
                specialize_variable(data.src, params, args),
                specialize_variable(data.field, params, args)
            )
        }
        Instruction::SetField(data) => {
            ret setfield(
                specialize_variable(data.src, params, args),
                specialize_variable(data.field, params, args),
                specialize_variable(data.value, params, args)
            )
        }
        Instruction::GetFieldPtr(data) => {
            ret getfieldptr(
                specialize_variable(data.out, params, args),
                specialize_variable(data.src, params, args),
                specialize_variable(data.field, params, args)
            )
        }
        Instruction::SGetField(data) => {
            ret sgetfield(
                specialize_variable(data.out, params, args),
                specialize_variable(data.src, params, args),
                specialize_variable(data.field, params, args)
            )
        }
        Instruction::SGetFieldPtr(data) => {
            ret sgetfieldptr(
                specialize_variable(data.out, params, args),
                specialize_variable(data.src, params, args),
                specialize_variable(data.field, params, args)
            )
        }
        Instruction::GetPtr(data) => {
            ret getptr(
                specialize_variable(data.out, params, args),
                specialize_variable(data.src, params, args)
            )
        }
        Instruction::StackAlloc(data) => {
            ret salloc(specialize_variable(data.out, params, args), substitute_generic_type(data.typ, params, args))
        }
        Instruction::HeapAlloc(data) => {
            ret halloc(specialize_variable(data.out, params, args), substitute_generic_type(data.typ, params, args))
        }
        Instruction::Gep(data) => {
            ret gep(specialize_variable(data.out, params, args), specialize_variable(data.src, params, args), specialize_variable(data.offset, params, args))
        }
        Instruction::PtrCast(data) => {
            ret pcast(specialize_variable(data.out, params, args), specialize_variable(data.src, params, args), substitute_generic_type(data.target_type, params, args))
        }
        Instruction::HeapRealloc(data) => {
            ret hrealloc(specialize_variable(data.out, params, args), specialize_variable(data.src, params, args), specialize_variable(data.count, params, args))
        }
        Instruction::Put(data) => {
            ret put(data.primitive, specialize_variable(data.dst, params, args))
        }
        Instruction::Phi(data) => {
            let mut pairs = Vec[PhiPair]::new()
            for pair in data.pairs {
                pairs.push(phi_pair(specialize_variable(pair.value, params, args), pair.label))
            }
            ret phi(specialize_variable(data.out, params, args), pairs)
        }
        Instruction::Cfree(data) => {
            ret cfree(specialize_variable(data.value, params, args))
        }
        Instruction::AddEdge(data) => {
            ret add_edge(specialize_variable(data.owner, params, args), specialize_variable(data.value, params, args))
        }
        Instruction::RemoveEdge(data) => {
            ret remove_edge(specialize_variable(data.owner, params, args), specialize_variable(data.value, params, args))
        }
        Instruction::Drop(data) => {
            ret drop_value(specialize_variable(data.value, params, args))
        }
        Instruction::Retain(data) => {
            ret retain_value(specialize_variable(data.value, params, args))
        }
        Instruction::HeapFree(data) => { ret hfree(specialize_variable(data.src, params, args)) }
        _ => { ret instruction }
    }
}

fn specialize_terminator(terminator: Terminator, params: Vec[Type], args: Vec[Type]) -> Terminator {
    match terminator {
        Terminator::Ret(data) => { ret ret_term(specialize_variable(data.value, params, args)) }
        Terminator::Cbr(data) => { ret cbr_term(specialize_variable(data.cond, params, args), data.true_label, data.false_label) }
        Terminator::Match(data) => {
            let mut arms = Vec[MatchArm]::new()
            for arm in data.arms {
                let payload = match arm.payload_var {
                    Option[Variable]::Some(value) => { Option[Variable]::Some(specialize_variable(value, params, args)) }
                    Option[Variable]::None => { Option[Variable]::None }
                }
                arms.push(match_arm(arm.variant, payload, arm.label))
            }
            ret match_term(specialize_variable(data.scrutinee, params, args), data.default_label, arms)
        }
        Terminator::Switch(data) => {
            ret switch_term(specialize_variable(data.scrutinee, params, args), data.default_label, data.cases)
        }
        _ => { ret terminator }
    }
}

fn specialize_variable(value: Variable, params: Vec[Type], args: Vec[Type]) -> Variable {
    match value.typ {
        Option[Type]::Some(typ) => {
            ret Variable{value.name, Option[Type]::Some(substitute_generic_type(typ, params, args))}
        }
        Option[Type]::None => { ret value }
    }
}

fn generic_symbol(name: str, args: Vec[Type]) -> str {
    let mut out = sanitize_symbol(name) + "__"
    let mut index = 0_usize
    for arg in args {
        if index > 0_usize { out = out + "_" }
        out = out + sanitize_symbol(mangle_type_name(arg))
        index = index + 1_usize
    }
    ret out
}

pub fn emit_ir(module: Module) -> str {
    unsafe { encore_llvm_set_windows_target(0_usize) }
    ret emit_ir_current_target(module)
}

fn emit_ir_current_target(module: Module) -> str {
    profile_codegen_memory("emit-start")
    let lowered_module = prepare_module_for_codegen(module)
    profile_codegen_memory("coroutines-validated")
    let lowered = lower(lowered_module)
    ret lowered.ir
}

fn prepare_module_for_codegen(module: Module) -> Module {
    let validation_started = perf_counter_ms()
    match prepare_module(module) {
        PreparationOutcome::Error(message) => {
            eprintln("error[ehir-validation]: " + message)
            exit(1_i32)
        }
        PreparationOutcome::Ready(prepared) => {
            profile_codegen_duration("module-prepared", validation_started)
            profile_codegen_memory("module-prepared")
            ret prepared
        }
    }
    ret make_module("invalid", Vec[Directive]::new())
}

pub fn emit_ir_for_target(module: Module, triple: str, pointer_width: usize) -> str {
    unsafe { encore_llvm_set_target_pointer_width(pointer_width) }
    unsafe { encore_llvm_set_windows_target(if is_windows_triple(triple) { 1_usize } else { 0_usize }) }
    let ir = emit_ir_current_target(module)
    if triple == "" { ret ir }
    ret "target triple = \"" + triple + "\"\n\n" + ir
}

pub fn emit_ir_bundle_for_target(bundle: ModuleBundle, triple: str, pointer_width: usize) -> Vec[EmittedIrModule] {
    ret emit_ir_bundle_for_target_parallel(bundle, triple, pointer_width, 1_usize)
}

pub fn emit_ir_bundle_for_target_parallel(bundle: ModuleBundle, triple: str, pointer_width: usize,
    requested_jobs: usize) -> Vec[EmittedIrModule] {
    let mut selected = Vec[usize]::new()
    let mut index = 0_usize
    while index < bundle.modules.len() { selected.push(index) index += 1_usize }
    ret emit_ir_bundle_for_target_selected(bundle, triple, pointer_width, requested_jobs, selected)
}

/// Builds the stable, textual context used by incremental CGU codegen.  It
/// retains declarations and generic templates from every module, but replaces
/// ordinary function bodies with extern declarations.  A body-only rebuild can
/// therefore parse this compact context plus the changed source module instead
/// of reparsing every ordinary body in the workspace.
pub fn incremental_codegen_context_bundle(bundle: ModuleBundle) -> ModuleBundle {
    ret make_module_bundle(bundle.entry_module, module_codegen_context_modules(bundle.modules))
}

/// Emits only selected codegen units while retaining the complete prepared
/// bundle as declaration/generic-template context.
pub fn emit_ir_bundle_for_target_selected(bundle: ModuleBundle, triple: str, pointer_width: usize,
    requested_jobs: usize, selected: Vec[usize],) -> Vec[EmittedIrModule] {
    let analysis_directives = module_bundle_directives(bundle.modules)
    ret emit_ir_bundle_for_target_selected_impl(bundle, triple, pointer_width, requested_jobs,
        selected, analysis_directives, false)
}

/// Emits selected CGUs from a compact bundle while analysing generic and
/// ownership support against the complete source bundle. Incremental
/// frontends may replace unchanged bodies with declarations for codegen, but
/// global support discovery must still see call sites in those bodies.
pub fn emit_ir_bundle_for_target_selected_with_analysis(bundle: ModuleBundle,
    analysis_bundle: ModuleBundle, triple: str, pointer_width: usize,
    requested_jobs: usize, selected: Vec[usize],) -> Vec[EmittedIrModule] {
    let analysis_directives = module_bundle_directives(analysis_bundle.modules)
    ret emit_ir_bundle_for_target_selected_impl(bundle, triple, pointer_width, requested_jobs,
        selected, analysis_directives, true)
}

fn emit_ir_bundle_for_target_selected_impl(bundle: ModuleBundle, triple: str, pointer_width: usize,
    requested_jobs: usize, selected: Vec[usize], supplied_analysis: Vec[Directive],
    use_supplied_analysis: bool,)
-> Vec[EmittedIrModule] {
    unsafe { encore_llvm_set_target_pointer_width(pointer_width) }
    unsafe { encore_llvm_set_windows_target(if is_windows_triple(triple) { 1_usize } else { 0_usize }) }
    if selected.len() == 0_usize { ret Vec[EmittedIrModule]::new() }
    let source_modules = bundle.modules
    // CGU zero owns all program-wide support definitions. Rebuild it whenever
    // any module changes so a newly introduced generic specialization or
    // concrete ownership helper can never reuse a stale support object.
    let effective_selected = selected_with_support_cgu(selected, source_modules.len())
    let prepare_selected_view = effective_selected.len() < source_modules.len()
    // Full builds normalize every source module once and share the prepared
    // graph. Incremental builds instead construct a raw CGU view first, so
    // non-local ordinary bodies become extern declarations before expensive
    // coroutine/ownership preparation; only selected bodies and globally
    // visible generic templates are normalized.
    let prepared = if prepare_selected_view {
        source_modules
    } else {
        prepare_modules_for_codegen_parallel(source_modules, requested_jobs)
    }
    // Incremental workers normalize the compact generic/declaration context
    // once, module by module. Previously each selected CGU rebuilt one giant
    // view and validated/normalized every cached declaration again, so even a
    // one-function edit in FastWord spent minutes before LLVM emission.
    let contexts = if prepare_selected_view {
        prepare_modules_for_codegen_parallel(
            module_codegen_context_modules(prepared), requested_jobs,)
    } else {
        module_codegen_context_modules(prepared)
    }
    // Generic-call discovery and concrete-type closure describe the complete
    // linked program, not an individual CGU. Recomputing both analyses inside
    // every module worker made a cold build O(module_count * program_size).
    // Compute the immutable result once and share it with all workers.
    let analysis_started = perf_counter_ms()
    let analysis_directives = if use_supplied_analysis {
        supplied_analysis
    } else {
        module_bundle_directives(prepared)
    }
    let mut generic_calls = collect_generic_calls(analysis_directives)
    expand_generic_calls(analysis_directives, generic_calls)
    let concrete_types = collect_concrete_types(analysis_directives, generic_calls)
    let support = build_support_ir(analysis_directives, generic_calls, concrete_types)
    profile_codegen_duration("bundle-analysis", analysis_started)
    profile_codegen_memory("bundle-modules-prepared")
    // Long compiler/editor modules can outweigh dozens of leaf modules. Feed
    // workers in descending instruction weight so a single heavy tail does
    // not leave most cores idle near the end of codegen.
    let scheduled_selected = schedule_selected_codegen_modules(prepared, effective_selected)
    let worker_count = min_codegen_jobs(requested_jobs, scheduled_selected.len())
    let mut pending = Vec[JoinHandle[Vec[EmittedIrChunk]]]::new()
    let mut worker = 0_usize
    while worker < worker_count {
        pending.push(spawn emit_ir_module_batch(prepared, contexts, scheduled_selected, triple,
            prepare_selected_view, concrete_types, support, worker, worker_count,))
        worker = worker + 1_usize
    }
    let mut chunks = Vec[EmittedIrChunk]::new()
    for handle in pending { chunks.extend(handle.join()) }
    profile_codegen_memory("bundle-modules-emitted")
    let mut out = Vec[EmittedIrModule]::new()
    let mut index = 0_usize
    while index < prepared.len() {
        for chunk in chunks {
            if chunk.index == index { out.push(chunk.module) }
        }
        index = index + 1_usize
    }
    ret out
}

fn selected_with_support_cgu(selected: Vec[usize], module_count: usize) -> Vec[usize] {
    if module_count == 0_usize { ret selected }
    let mut out = Vec[usize]::new()
    out.push(0_usize)
    for index in selected {
        if index != 0_usize && index < module_count { out.push(index) }
    }
    ret out
}

fn codegen_module_is_selected(selected: Vec[usize], expected: usize) -> bool {
    for index in selected { if index == expected { ret true } }
    ret false
}

fn schedule_selected_codegen_modules(modules: Vec[Module], selected: Vec[usize]) -> Vec[usize] {
    let jobs = schedule_module_prepare_jobs(modules)
    let mut scheduled = Vec[usize]::new()
    for job in jobs {
        if codegen_module_is_selected(selected, job.index) { scheduled.push(job.index) }
    }
    ret scheduled
}

fn module_bundle_directives(modules: Vec[Module]) -> Vec[Directive] {
    let mut directives = Vec[Directive]::new()
    for module in modules { directives.extend(module.directives) }
    ret directives
}

fn prepare_modules_for_codegen_parallel(modules: Vec[Module], requested_jobs: usize) -> Vec[Module] {
    let worker_count = min_codegen_jobs(requested_jobs, modules.len())
    if worker_count <= 1_usize {
        let mut prepared = Vec[Module]::new()
        for module in modules { prepared.push(prepare_module_for_codegen(module)) }
        ret prepared
    }
    let jobs = schedule_module_prepare_jobs(modules)
    let mut pending = Vec[JoinHandle[Vec[PreparedModuleChunk]]]::new()
    let mut worker = 0_usize
    while worker < worker_count {
        pending.push(spawn prepare_module_batch(modules, jobs, worker, worker_count))
        worker += 1_usize
    }
    let mut chunks = Vec[PreparedModuleChunk]::new()
    for handle in pending { chunks.extend(handle.join()) }
    let mut prepared = Vec[Module]::new()
    let mut index = 0_usize
    while index < modules.len() {
        for chunk in chunks {
            if chunk.index == index { prepared.push(chunk.module) }
        }
        index += 1_usize
    }
    ret prepared
}

fn schedule_module_prepare_jobs(modules: Vec[Module]) -> Vec[ModulePrepareJob] {
    let mut jobs = Vec[ModulePrepareJob]::new()
    let mut index = 0_usize
    for module in modules {
        jobs.push(ModulePrepareJob{index, module_prepare_weight(module)})
        index += 1_usize
    }
    index = 1_usize
    while index < jobs.len() {
        let mut position = index
        while position > 0_usize {
            let mut swap = false
            match jobs.get(position) {
                Some(right) => {
                    match jobs.get(position - 1_usize) {
                        Some(left) => {
                            swap = right.weight > left.weight ||
                                (right.weight == left.weight && right.index < left.index)
                        }
                        None => {}
                    }
                }
                None => {}
            }
            if !swap { break }
            match jobs.get(position) {
                Some(right) => {
                    match jobs.get(position - 1_usize) {
                        Some(left) => {
                            jobs.set(position - 1_usize, right)
                            jobs.set(position, left)
                        }
                        None => {}
                    }
                }
                None => {}
            }
            position -= 1_usize
        }
        index += 1_usize
    }
    ret jobs
}

fn module_prepare_weight(module: Module) -> usize {
    let mut weight = module.directives.len()
    for directive in module.directives {
        match directive {
            Directive::Function(function) => {
                weight += function_prepare_weight(function)
            }
            Directive::Impl(item) => {
                for method in item.methods { weight += function_prepare_weight(method) }
            }
            _ => {}
        }
    }
    ret weight
}

fn function_prepare_weight(function: FnDirective) -> usize {
    let mut weight = function.blocks.len()
    for block_item in function.blocks { weight += block_item.instructions.len() }
    ret weight
}

fn prepare_module_batch(modules: Vec[Module], jobs: Vec[ModulePrepareJob], worker_index: usize,
    worker_count: usize) -> Vec[PreparedModuleChunk] {
    let mut out = Vec[PreparedModuleChunk]::new()
    let mut job_index = worker_index
    while job_index < jobs.len() {
        match jobs.get(job_index) {
            Some(job) => {
                match modules.get(job.index) {
                    Some(module) => {
                        out.push(PreparedModuleChunk{job.index, prepare_module_for_codegen(module)})
                    }
                    None => {}
                }
            }
            None => {}
        }
        job_index += worker_count
    }
    ret out
}

fn min_codegen_jobs(requested: usize, count: usize) -> usize {
    let jobs = if requested == 0_usize { 1_usize } else { requested }
    if count == 0_usize || jobs < count { ret jobs }
    ret count
}

fn emit_ir_module_batch(prepared: Vec[Module], contexts: Vec[Module], selected: Vec[usize], triple: str,
    prepare_selected_view: bool, concrete_types: Vec[Type], support: SupportIr, worker_index: usize,
    worker_count: usize,)
-> Vec[EmittedIrChunk] {
    let mut out = Vec[EmittedIrChunk]::new()
    let mut job_index = worker_index
    while job_index < selected.len() {
        match selected.get(job_index) {
            Some(index) => {
                match prepared.get(index) {
                    Some(module) => {
                        let view = if prepare_selected_view {
                            module_codegen_view(prepare_module_for_codegen(module), contexts)
                        } else {
                            module_codegen_view(module, contexts)
                        }
                        // A codegen unit contains declarations and generic
                        // templates from the complete bundle, but only the
                        // current module's ordinary function bodies.
                        let lowered = lower_with_precomputed_analysis(view, concrete_types, support,
                            index == 0_usize,)
                        let ir = if triple == "" { lowered.ir } else { "target triple = \"" + triple + "\"\n\n" + lowered.ir }
                        out.push(EmittedIrChunk{index, EmittedIrModule{module.name, ir, ir.len()}})
                    }
                    None => {}
                }
            }
            None => {}
        }
        job_index += worker_count
    }
    ret out
}

fn module_codegen_view(current: Module, modules: Vec[Module]) -> Module {
    let mut directives = Vec[Directive]::new()
    for module in modules {
        let local = module.name == current.name
        if local {
            append_module_codegen_directives(directives, current.directives, true)
        } else {
            append_module_codegen_directives(directives, module.directives, false)
        }
    }
    ret make_module_with_metadata(current.name, current.imports, current.documentation, current.symbol_documentation, directives)
}

fn append_module_codegen_directives(out: mut Vec[Directive], source: Vec[Directive],
    local: bool,) -> () {
    for directive in source {
        match directive {
            Directive::Function(function) => {
                if local || function.generics.len() > 0_usize {
                    out.push(Directive::Function(function))
                } else {
                    out.push(Directive::Function(extern_fn_item(function.name,
                        function.generics, function.params, function.ret_type)))
                }
            }
            Directive::Impl(item) => {
                let mut methods = Vec[FnDirective]::new()
                for method in item.methods {
                    if local || item.generics.len() > 0_usize || method.generics.len() > 0_usize {
                        methods.push(method)
                    } else {
                        methods.push(extern_fn_item(method.name, method.generics,
                            method.params, method.ret_type))
                    }
                }
                out.push(impl_directive(item.generics, item.trait_name,
                    item.trait_args, item.for_type, methods))
            }
            _ => { out.push(directive) }
        }
    }
    ret ()
}

fn module_codegen_context_modules(source: Vec[Module]) -> Vec[Module] {
    let mut modules = Vec[Module]::new()
    for module in source { modules.push(module_codegen_context(module)) }
    ret modules
}

fn module_codegen_context(module: Module) -> Module {
    let mut directives = Vec[Directive]::new()
    for directive in module.directives {
        match directive {
            Directive::Function(function) => {
                if function.generics.len() > 0_usize {
                    directives.push(Directive::Function(function))
                } else {
                    directives.push(Directive::Function(extern_fn_item(function.name,
                        function.generics, function.params, function.ret_type)))
                }
            }
            Directive::Impl(item) => {
                let mut methods = Vec[FnDirective]::new()
                for method in item.methods {
                    if item.generics.len() > 0_usize || method.generics.len() > 0_usize {
                        methods.push(method)
                    } else {
                        methods.push(extern_fn_item(method.name, method.generics,
                            method.params, method.ret_type))
                    }
                }
                directives.push(impl_directive(item.generics, item.trait_name,
                    item.trait_args, item.for_type, methods))
            }
            _ => { directives.push(directive) }
        }
    }
    ret make_module_with_metadata(module.name, module.imports, module.documentation,
        module.symbol_documentation, directives)
}

fn str_len(value: str) -> usize {
    ret unsafe {
        encore_str_len(value)
    }
}

fn lower_type_declarations(directives: Vec[Directive], concrete_types: Vec[Type]) -> Vec[str] {
    let mut out = Vec[str]::new()
    for directive in directives {
        match directive {
            Directive::Struct(item) => {
                if item.name == "JoinHandle" {
                    // Emitted below from the language-defined ABI.
                } elif item.generics.len() == 0_usize {
                    out.push(struct_declaration_text(item.name, item.generics, item.fields, Type{item.name, Vec[Type]::new(), RepresentationKind::Inline}))
                } else {
                    for concrete in concrete_types {
                        if concrete.name == item.name && concrete.generics.len() == item.generics.len() &&
                            concrete.representation == RepresentationKind::Inline {
                            out.push(struct_declaration_text(item.name, item.generics, item.fields, concrete))
                        }
                    }
                }
            }
            Directive::Enum(item) => {
                if item.generics.len() == 0_usize {
                    out.push(enum_declaration_text(item.name, item.generics, item.variants, Type{item.name, Vec[Type]::new(), RepresentationKind::Inline}))
                } else {
                    for concrete in concrete_types {
                        if concrete.name == item.name && concrete.generics.len() == item.generics.len() &&
                            concrete.representation == RepresentationKind::Inline {
                            out.push(enum_declaration_text(item.name, item.generics, item.variants, concrete))
                        }
                    }
                }
            }
            Directive::Trait(item) => {
                // A trait object is a small fat pointer.  The first word owns a
                // boxed concrete value; the second identifies its concrete type
                // for the generated dispatch thunks.
                out.push("%dyn_" + sanitize_symbol(item.name) + " = type { i8*, i64 }")
            }
            _ => {}
        }
    }
    // `spawn` is a language construct and may produce JoinHandle[T] without
    // an explicit source import of the platform declaration. Its ABI is one
    // target-sized token, so materialize the builtin aggregate whenever the
    // frontend references it and no imported declaration is present.
    for concrete in concrete_types {
        if concrete.name == "JoinHandle" && concrete.generics.len() == 1_usize {
            let token = type_text(lower_type(Type{"usize", Vec[Type]::new(), RepresentationKind::Inline}))
            out.push("%" + sanitize_symbol(mangle_type_name(concrete)) + " = type { " + token + " }")
        }
    }
    out.extend(lower_string_globals(directives))
    ret out
}

fn lower_string_globals(directives: Vec[Directive]) -> Vec[str] {
    let mut out = Vec[str]::new()
    let seen = unsafe { encore_strset_new() }
    for directive in directives {
        match directive {
            Directive::Function(function) => {
                for block_item in function.blocks {
                    for instruction in block_item.instructions {
                        match instruction {
                            Instruction::Lcpos(data) => {
                                if is_string_literal(data.value) {
                                    let body = string_literal_body(data.value)
                                    if unsafe { encore_strset_insert(seen, body) } {
                                        let name = string_literal_global_name(body)
                                        out.push("@" + name + " = private unnamed_addr constant [" + Debug::fmt(string_literal_byte_len(body) + 1_usize) + " x i8] c\"" + llvm_string_body(body) + "\\00\"")
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                }
            }
            Directive::Impl(item) => {
                for method in item.methods {
                    for block_item in method.blocks {
                        for instruction in block_item.instructions {
                            match instruction {
                                Instruction::Lcpos(data) => {
                                    if is_string_literal(data.value) {
                                        let body = string_literal_body(data.value)
                                        if unsafe { encore_strset_insert(seen, body) } {
                                            let name = string_literal_global_name(body)
                                            out.push("@" + name + " = private unnamed_addr constant [" + Debug::fmt(string_literal_byte_len(body) + 1_usize) + " x i8] c\"" + llvm_string_body(body) + "\\00\"")
                                        }
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                }
            }
            _ => {}
        }
    }

    unsafe { encore_strset_free(seen) }
    ret out
}

fn sort_string_globals(entries: mut Vec[StringGlobal], low: usize, high: usize) -> () {
    if low >= high { ret () }
    let pivot = match entries.get(low + (high - low) / 2_usize) {
        Option[StringGlobal]::Some(entry) => entry.tag
        Option[StringGlobal]::None => 0_usize
    }
    let mut left = low
    let mut right = high
    loop {
        loop {
            match entries.get(left) {
                Option[StringGlobal]::Some(entry) => {
                    if entry.tag < pivot { left = left + 1_usize }
                    else { break }
                }
                Option[StringGlobal]::None => { break }
            }
        }
        loop {
            match entries.get(right) {
                Option[StringGlobal]::Some(entry) => {
                    if entry.tag > pivot && right > 0_usize { right = right - 1_usize }
                    else { break }
                }
                Option[StringGlobal]::None => { break }
            }
        }
        if left > right { break }
        let left_value = match entries.get(left) {
            Option[StringGlobal]::Some(entry) => entry
            Option[StringGlobal]::None => StringGlobal{"", 0_usize}
        }
        let right_value = match entries.get(right) {
            Option[StringGlobal]::Some(entry) => entry
            Option[StringGlobal]::None => StringGlobal{"", 0_usize}
        }
        entries.set(left, right_value)
        entries.set(right, left_value)
        left = left + 1_usize
        if right == 0_usize { break }
        right = right - 1_usize
        if left > right { break }
    }
    if low < right {
        sort_string_globals(entries, low, right)
    }
    if left < high {
        sort_string_globals(entries, left, high)
    }
    ret ()
}

fn is_string_literal(value: str) -> bool {
    let chars = value.char_len()
    ret chars >= 6_usize && value.slice(0_usize, 1_usize) == "\"" && value.slice(chars - 5_usize, 5_usize) == "\"_str"
}

fn string_literal_body(value: str) -> str {
    if !is_string_literal(value) { ret "" }
    ret value.slice(1_usize, value.char_len() - 6_usize)
}

fn string_literal_global_name(body: str) -> str {
    ret "__ehir_str_" + sanitize_symbol(body) + "_" + enum_variant_tag(body)
}

fn llvm_string_body(body: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < body.char_len() {
        let ch = body.slice(index, 1_usize)
        if ch == "\\" && index + 1_usize < body.char_len() {
            let escaped = body.slice(index + 1_usize, 1_usize)
            if escaped == "n" { out = out + "\\0A" }
            elif escaped == "r" { out = out + "\\0D" }
            elif escaped == "t" { out = out + "\\09" }
            elif escaped == "0" { out = out + "\\00" }
            elif escaped == "\"" { out = out + "\\22" }
            elif escaped == "\\" { out = out + "\\5C" }
            else { out = out + "\\5C" + escaped }
            index = index + 1_usize
        }
        elif ch == "\"" { out = out + "\\22" }
        elif ch == "\\" { out = out + "\\5C" }
        else { out = out + ch }
        index = index + 1_usize
    }
    ret out
}

fn string_literal_byte_len(body: str) -> usize {
    let mut count = 0_usize
    let mut index = 0_usize
    while index < body.char_len() {
        let ch = body.slice(index, 1_usize)
        if ch == "\\" && index + 1_usize < body.char_len() {
            index = index + 1_usize
            count = count + 1_usize
        } else {
            count = count + ch.byte_len()
        }
        index = index + 1_usize
    }
    ret count
}

fn struct_declaration_text(name: str, generic_params: Vec[Type], fields_data: Vec[Parameter], concrete: Type) -> str {
    let mut fields = Vec[str]::new()
    for field in fields_data {
        fields.push(type_text(lower_type(substitute_generic_type(field.typ, generic_params, concrete.generics))))
    }
    ret "%" + sanitize_symbol(mangle_type_name(concrete)) + " = type { " + join_type_parts(fields) + " }"
}

fn enum_declaration_text(name: str, generic_params: Vec[Type], variants: Vec[EnumVariant], concrete: Type) -> str {
    ret "%" + sanitize_symbol(mangle_type_name(concrete)) + " = type { i32, i8* }"
}

fn substitute_generic_type(typ: Type, params: Vec[Type], args: Vec[Type]) -> Type {
    let mut index = 0_usize
    while index < params.len() {
        match params.get(index) {
            Option[Type]::Some(param_type) => {
                if typ.name == param_type.name && typ.generics.len() == 0_usize {
                    match args.get(index) {
                        Option[Type]::Some(arg_type) => {
                            let pointer = if typ.representation == RepresentationKind::Inline { arg_type.representation } else { typ.representation }
                            ret Type{arg_type.name, arg_type.generics, pointer}
                        }
                        Option[Type]::None => {}
                    }
                }
            }
            Option[Type]::None => {}
        }
        index = index + 1_usize
    }
    let mut generics = Vec[Type]::new()
    for generic in typ.generics { generics.push(substitute_generic_type(generic, params, args)) }
    ret Type{typ.name, generics, typ.representation}
}

fn collect_concrete_types(directives: Vec[Directive], calls: Vec[GenericCall]) -> Vec[Type] {
    let mut out = Vec[Type]::new()
    let seen = unsafe { encore_strset_new() }
    for directive in directives {
        match directive {
            Directive::Function(function) => { collect_function_types(out, seen, function) }
            Directive::Impl(item) => {
                if item.generics.len() == 0_usize {
                    for method in item.methods {
                        if method.generics.len() == 0_usize { collect_function_types(out, seen, method) }
                    }
                }
            }
            _ => {}
        }
    }
    for call_data in calls {
        for directive in directives {
            match directive {
                Directive::Function(function) => {
                    if generic_function_name_matches(function.name, call_data.name) && function.generics.len() == call_data.args.len() {
                        let template = generic_function_template_for_call(function, call_data.name)
                        collect_function_types(out, seen, specialize_function(template, call_data.args))
                    }
                }
                Directive::Impl(item) => {
                    if item.generics.len() == call_data.args.len() {
                        for method in item.methods {
                            if method.generics.len() == 0_usize {
                                let full_name = item.for_type.name + "::" + method.name
                                if full_name == call_data.name {
                                    let template = fn_item(full_name, item.generics, method.params, method.ret_type, method.blocks)
                                    collect_function_types(out, seen, specialize_function(template, call_data.args))
                                }
                            }
                        }
                    }
                    if impl_has_generic_methods(item.methods) {
                        for method in item.methods {
                            if method.generics.len() == 0_usize { continue }
                            let full_name = item.for_type.name + "::" + method.name
                            if item.generics.len() == 0_usize && full_name == call_data.name && method.generics.len() == call_data.args.len() {
                                let template = fn_item(full_name, method.generics, method.params, method.ret_type, method.blocks)
                                collect_function_types(out, seen, specialize_function(template, call_data.args))
                            } elif item.generics.len() > 0_usize {
                                let params = combined_impl_method_generics(item.generics, method.generics)
                                if full_name == call_data.name && params.len() == call_data.args.len() {
                                    let template = fn_item(full_name, params, method.params, method.ret_type, method.blocks)
                                    collect_function_types(out, seen, specialize_function(template, call_data.args))
                                }
                            }
                        }
                    }
                }
                _ => {}
            }
        }
    }
    collect_declaration_type_closure(out, seen, directives)
    unsafe { encore_strset_free(seen) }
    ret out
}

// A function can use a non-generic aggregate whose declaration contains a
// concrete generic field (for example FunctionItem -> Option[ParsedBlock]).
// Recording only instruction and signature types emits the outer declaration
// but leaves the nested named type opaque, making the aggregate unsized in
// LLVM. Close over declaration fields and enum payloads until every nested
// concrete type required by a materialized aggregate is present.
fn collect_declaration_type_closure(out: mut Vec[Type], seen: usize,
    directives: Vec[Directive],) -> () {
    let structs = unsafe { encore_strmap_new() }
    let enums = unsafe { encore_strmap_new() }
    let mut directive_index = 0_usize
    for directive in directives {
        match directive {
            Directive::Struct(item) => {
                unsafe { encore_strmap_put(structs, item.name, directive_index + 1_usize) }
            }
            Directive::Enum(item) => {
                unsafe { encore_strmap_put(enums, item.name, directive_index + 1_usize) }
            }
            _ => {}
        }
        directive_index += 1_usize
    }

    let mut index = 0_usize
    while index < out.len() {
        let concrete = match out.get(index) {
            Option[Type]::Some(value) => value
            Option[Type]::None => Type{"void", Vec[Type]::new(), RepresentationKind::Inline}
        }
        let struct_index = unsafe { encore_strmap_get(structs, concrete.name) }
        if struct_index > 0_usize {
            match directives.get(struct_index - 1_usize) {
                Option[Directive]::Some(directive) => {
                    match directive {
                        Directive::Struct(item) => {
                            if concrete.generics.len() == item.generics.len() {
                                for field in item.fields {
                                    remember_concrete_type(out, seen, substitute_generic_type(
                                        field.typ, item.generics, concrete.generics,))
                                }
                            }
                        }
                        _ => {}
                    }
                }
                Option[Directive]::None => {}
            }
        }
        let enum_index = unsafe { encore_strmap_get(enums, concrete.name) }
        if enum_index > 0_usize {
            match directives.get(enum_index - 1_usize) {
                Option[Directive]::Some(directive) => {
                    match directive {
                        Directive::Enum(item) => {
                            if concrete.generics.len() == item.generics.len() {
                                for variant in item.variants {
                                    match variant.payload_type {
                                        Option[Type]::Some(payload) => {
                                            remember_concrete_type(out, seen,
                                                substitute_generic_type(payload, item.generics, concrete.generics),)
                                        }
                                        Option[Type]::None => {}
                                    }
                                }
                            }
                        }
                        _ => {}
                    }
                }
                Option[Directive]::None => {}
            }
        }
        index += 1_usize
    }
    unsafe { encore_strmap_free(structs) encore_strmap_free(enums) }
    ret ()
}

fn impl_has_generic_methods(methods: Vec[FnDirective]) -> bool {
    let mut index = 0_usize
    while index < methods.len() {
        let method_handle = unsafe { methods.get_handle(index) }
        unsafe {
            unsafe ehir {
                method_ptr: FnDirective* = pcast method_handle: usize, FnDirective*
                method: FnDirective = load method_ptr: FnDirective*
            }
            if method.generics.len() > 0_usize { ret true }
        }
        index = index + 1_usize
    }
    ret false
}

fn collect_function_types(out: mut Vec[Type], seen: usize, function: FnDirective) -> () {
    if function.generics.len() > 0_usize { ret () }
    remember_concrete_type(out, seen, function.ret_type)
    for parameter in function.params { remember_concrete_type(out, seen, parameter.typ) }
    for block_item in function.blocks {
        let mut instruction_index = 0_usize
        while instruction_index < block_item.instructions.len() {
            let instruction_handle = unsafe { block_item.instructions.get_handle(instruction_index) }
            collect_instruction_types(out, seen, instruction_handle)
            instruction_index = instruction_index + 1_usize
        }
        match block_item.terminator {
            Terminator::Ret(data) => { remember_variable_type(out, seen, data.value) }
            Terminator::Cbr(data) => { remember_variable_type(out, seen, data.cond) }
            _ => {}
        }
    }
    ret ()
}

fn collect_instruction_types(out: mut Vec[Type], seen: usize, instruction_handle: usize) -> () {
    unsafe {
        unsafe ehir {
            instruction_ptr: Instruction* = pcast instruction_handle: usize, Instruction*
            instruction: Instruction = load instruction_ptr: Instruction*
        }
        match instruction {
            Instruction::Lcpos(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::Alias(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::Lcsos(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::Lceos(data) => { remember_variable_type(out, seen, data.out) }
            // Call results can carry their type in the required EHIR
            // annotation even when Variable.typ has not been populated yet.
            Instruction::Call(data) => { remember_concrete_type(out, seen, required_variable_type(data.out)) }
            Instruction::Await(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::Load(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::GetField(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::GetFieldPtr(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::SGetField(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::SGetFieldPtr(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::Gep(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::PtrCast(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::StackAlloc(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::HeapAlloc(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::HeapRealloc(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::Binary(data) => { remember_variable_type(out, seen, data.out) }
            Instruction::Phi(data) => { remember_variable_type(out, seen, data.out) }
            _ => {}
        }
    }
    ret ()
}

fn remember_variable_type(out: mut Vec[Type], seen: usize, value: Variable) -> () {
    match value.typ {
        Option[Type]::Some(typ) => { remember_concrete_type(out, seen, typ) }
        Option[Type]::None => {}
    }
    ret ()
}

fn remember_concrete_type(out: mut Vec[Type], seen: usize, typ: Type) -> () {
    for generic in typ.generics { remember_concrete_type(out, seen, generic) }
    if is_node_handle_type(typ) {
        let node_key = mangle_type_name(typ)
        if unsafe { encore_strset_insert(seen, node_key) } { out.push(typ) }
        // A handle lowers to a pointer to the placement-independent payload.
        // Generic payload declarations must therefore be materialized in
        // addition to the placement-specific ownership helper.
        let payload = Type{typ.name, typ.generics, RepresentationKind::Inline}
        let payload_key = mangle_type_name(payload)
        if unsafe { encore_strset_insert(seen, payload_key) } { out.push(payload) }
        ret ()
    }
    if typ.generics.len() == 0_usize && !is_dyn_type(typ) && !is_aggregate_ehir_type(typ) { ret () }
    let concrete = Type{typ.name, typ.generics, RepresentationKind::Inline}
    let key = mangle_type_name(concrete)
    if unsafe { encore_strset_insert(seen, key) } {
        out.push(concrete)
    }
    ret ()
}

fn sort_concrete_type_entries(entries: mut Vec[ConcreteTypeEntry], low: usize, high: usize) -> () {
    if low >= high { ret () }
    let pivot = match entries.get(low + (high - low) / 2_usize) {
        Option[ConcreteTypeEntry]::Some(entry) => entry.tag
        Option[ConcreteTypeEntry]::None => 0_usize
    }
    let mut left = low
    let mut right = high
    loop {
        loop {
            match entries.get(left) {
                Option[ConcreteTypeEntry]::Some(entry) => {
                    if entry.tag < pivot { left = left + 1_usize }
                    else { break }
                }
                Option[ConcreteTypeEntry]::None => { break }
            }
        }
        loop {
            match entries.get(right) {
                Option[ConcreteTypeEntry]::Some(entry) => {
                    if entry.tag > pivot && right > 0_usize { right = right - 1_usize }
                    else { break }
                }
                Option[ConcreteTypeEntry]::None => { break }
            }
        }
        if left > right { break }
        let left_value = match entries.get(left) {
            Option[ConcreteTypeEntry]::Some(entry) => entry
            Option[ConcreteTypeEntry]::None => ConcreteTypeEntry{Type{"void", Vec[Type]::new(), RepresentationKind::Inline}, "", 0_usize}
        }
        let right_value = match entries.get(right) {
            Option[ConcreteTypeEntry]::Some(entry) => entry
            Option[ConcreteTypeEntry]::None => ConcreteTypeEntry{Type{"void", Vec[Type]::new(), RepresentationKind::Inline}, "", 0_usize}
        }
        entries.set(left, right_value)
        entries.set(right, left_value)
        left = left + 1_usize
        if right == 0_usize { break }
        right = right - 1_usize
        if left > right { break }
    }
    if low < right { sort_concrete_type_entries(entries, low, right) }
    if left < high { sort_concrete_type_entries(entries, left, high) }
    ret ()
}

fn join_type_parts(parts: Vec[str]) -> str {
    let mut out = ""
    let mut index = 0_usize
    for part in parts {
        if index > 0_usize { out = out + ", " }
        out = out + part
        index = index + 1_usize
    }
    ret out
}

fn lower_directive(directive: Directive) -> Vec[LLVMFunction] {
    match directive {
        Struct(struct_data) => {
            ret Vec[LLVMFunction]::new()
        }
        Enum(enum_data) => {
            ret Vec[LLVMFunction]::new()
        }
        Function(function_data) => {
            if function_data.generics.len() > 0_usize {
                ret Vec[LLVMFunction]::new()
            }
            ret vec_singleton(lower_function(function_data))
        }
        Trait(trait_data) => {
            ret Vec[LLVMFunction]::new()
        }
        Impl(impl_data) => {
            let mut methods = Vec[LLVMFunction]::new()
            for method in impl_data.methods {
                if impl_data.generics.len() > 0_usize || method.generics.len() > 0_usize { continue }
                let full_name = impl_data.for_type.name + "::" + method.name
                let concrete = if method.is_extern {
                    extern_fn_item(full_name, Vec[Type]::new(), method.params, method.ret_type)
                } else {
                    fn_item(full_name, Vec[Type]::new(), method.params, method.ret_type, method.blocks)
                }
                methods.push(lower_function(concrete))
            }
            ret methods
        }
    }
}

fn lower_function(function: FnDirective) -> LLVMFunction {
    let function_name = function.name
    let function_ret_type = function.ret_type
    let function_params = function.params
    let function_blocks = function.blocks
    let is_extern = function.is_extern

    let fn_name = function_symbol(function_name)
    let ret_type = lower_type(function_ret_type)
    let params = lower_params(function_params)

    if (is_extern) {
        ret llvm_declare_fn(fn_name, ret_type, params, Vec[LLVMBasicBlock]::new())
    }
    let blocks = lower_blocks(function_blocks)
    let lowered = llvm_define_fn(fn_name, ret_type, params, blocks)
    if function_is_pure_numeric(function) {
        if unsafe { encore_llvm_is_windows_target() } != 0_usize {
            ret llvm_with_attributes(lowered, "nounwind memory(none)")
        }
        ret llvm_with_attributes(lowered, "nounwind memory(none) \"probe-stack\"=\"inline-asm\"")
    }
    // Large generated Encore functions must ask LLVM to probe their stack
    // frames. Without this attribute, a prologue can jump over Linux's stack
    // guard and fault later while accessing a valid local slot.
    if unsafe { encore_llvm_is_windows_target() } != 0_usize { ret lowered }
    ret llvm_with_attributes(lowered, "\"probe-stack\"=\"inline-asm\"")
}

fn is_windows_triple(triple: str) -> bool {
    ret triple == "x86_64-pc-windows-msvc" || triple == "x86_64-w64-windows-gnu"
        || triple == "aarch64-w64-windows-gnu"
}

fn function_is_pure_numeric(function: FnDirective) -> bool {
    if function.is_extern || function.is_async || !is_pure_scalar_type(function.ret_type) { ret false }
    for param in function.params {
        if !is_pure_scalar_type(param.typ) { ret false }
    }
    for block in function.blocks {
        for instruction in block.instructions {
            match instruction {
                Comment(_) => {}
                Lcpos(literal_data) => {
                    if !is_pure_scalar_type(required_variable_type(literal_data.out)) { ret false }
                }
                Alias(alias_data) => {
                    if !is_pure_scalar_type(required_variable_type(alias_data.out)) ||
                        !is_pure_scalar_type(required_variable_type(alias_data.src)) { ret false }
                }
                Binary(binary_data) => {
                    if !is_pure_scalar_type(required_variable_type(binary_data.out)) ||
                        !is_pure_scalar_type(required_variable_type(binary_data.lhs)) ||
                        !is_pure_scalar_type(required_variable_type(binary_data.rhs)) { ret false }
                }
                Phi(phi_data) => {
                    if !is_pure_scalar_type(required_variable_type(phi_data.out)) { ret false }
                    for pair in phi_data.pairs {
                        if !is_pure_scalar_type(required_variable_type(pair.value)) { ret false }
                    }
                }
                PtrCast(cast_data) => {
                    if !is_pure_scalar_type(required_variable_type(cast_data.out)) ||
                        !is_pure_scalar_type(required_variable_type(cast_data.src)) { ret false }
                }
                Call(call_data) => {
                    if function_symbol(call_data.name) != function_symbol(function.name) { ret false }
                    if !is_pure_scalar_type(required_variable_type(call_data.out)) { ret false }
                    for arg in call_data.args {
                        if !is_pure_scalar_type(required_variable_type(arg)) { ret false }
                    }
                }
                _ => { ret false }
            }
        }
    }
    ret true
}

fn is_pure_scalar_type(typ: Type) -> bool {
    ret is_numeric_ehir_type(typ) || (typ.representation == RepresentationKind::Inline && (typ.name == "bool" || typ.name == "u1"))
}

fn lower_params(params: Vec[Parameter]) -> Vec[LLVMParam] {
    let mut acc = Vec[LLVMParam]::new()
    for current in params {
        let name = sanitize_symbol(current.name)
        let typ = lower_type(current.typ)
        acc.push(llvm_make_param(name, typ))
    }
    ret acc
}

fn lower_blocks(blocks: Vec[Block]) -> Vec[LLVMBasicBlock] {
    let mut acc = Vec[LLVMBasicBlock]::new()
    for current in blocks {
        acc.extend(lower_block_items(current))
    }
    ret acc
}

fn lower_block_items(block: Block) -> Vec[LLVMBasicBlock] {
    let raw_block_name = block.name
    let raw_instructions = block.instructions
    let raw_terminator = block.terminator
    let block_name = block_symbol(raw_block_name)
    let instructions = lower_instructions(raw_instructions, block_name)
    match raw_terminator {
        Terminator::Match(data) => {
            ret lower_match_blocks(block_name, instructions, data)
        }
        _ => {}
    }
    let terminator = lower_terminator(raw_terminator)
    ret vec_singleton(llvm_block(block_name, instructions, terminator))
}

fn lower_match_blocks(block_name: str, base_instructions: Vec[LLVMInstruction], data: MatchInstruction) -> Vec[LLVMBasicBlock] {
    let mut out = Vec[LLVMBasicBlock]::new()
    if data.arms.len() == 0_usize {
        out.push(llvm_block(block_name, base_instructions, llvm_term_br(block_symbol(data.default_label))))
        ret out
    }
    let scrutinee = lower_variable(data.scrutinee)
    let tag = reg(block_name + "_match_tag", i32_type())
    let mut first_instructions = base_instructions
    first_instructions.push(llvm_inst_extractvalue(tag, scrutinee, "0"))
    let mut index = 0_usize
    for arm in data.arms {
        let check_name = if index == 0_usize { block_name } else { block_name + "_match_check_" + Debug::fmt(index) }
        let next_name = if index + 1_usize < data.arms.len() { block_name + "_match_check_" + Debug::fmt(index + 1_usize) } else { block_symbol(data.default_label) }
        let matches = reg(block_name + "_match_case_" + Debug::fmt(index), i1_type())
        let compare = llvm_inst_binary("icmp eq", matches, tag, const_i32(enum_variant_tag(arm.variant)))
        let instructions = if index == 0_usize { concat_instructions(first_instructions, vec_singleton(compare)) } else { vec_singleton(compare) }
        out.push(llvm_block(check_name, instructions, llvm_term_cbr(matches, block_symbol(arm.label), next_name)))
        index = index + 1_usize
    }
    ret out
}

fn lower_instructions(instructions: Vec[Instruction], block_name: str) -> Vec[LLVMInstruction] {
    let mut acc = Vec[LLVMInstruction]::new()
    let mut instruction_index = 0_usize
    for current in instructions {
        let instruction_scope = block_name + "_instruction_" + Debug::fmt(instruction_index)
        acc.extend(lower_instruction(current, instruction_scope))
        instruction_index = instruction_index + 1_usize
    }
    ret acc
}

fn lower_instruction(instruction: Instruction, instruction_scope: str) -> Vec[LLVMInstruction] {
    match instruction {
        Comment(comment_data) => {
            ret Vec[LLVMInstruction]::new()
        }
        Lcpos(literal_data) => {
            let out_var: Variable = literal_data.out
            let literal_value: str = literal_data.value
            ret lower_literal(out_var, literal_value)
        }
        Alias(alias_data) => {
            let out = lower_variable(alias_data.out)
            let src = lower_variable_with_fallback(alias_data.src, required_variable_type(alias_data.out))
            ret vec_singleton(llvm_inst_bitcast(out, src))
        }
        Lceos(enum_data) => {
            let out = lower_variable(enum_data.out)
            let ret_type = lower_type(required_variable_type(enum_data.out))
            let value = enum_data.value
            let tag_out = reg(sanitize_symbol(enum_data.out.name) + "_tag", ret_type)
            let undef_value = const_text("undef", ret_type)
            let tag = const_text(enum_variant_tag(value.variant), i32_type())
            let mut instructions = vec_singleton(llvm_inst_insertvalue(tag_out, undef_value, tag, "0"))
            match value.payload {
                Option[Variable]::Some(payload) => {
                    let ehir_payload_type = required_variable_type(payload)
                    let payload_type = lower_type(ehir_payload_type)
                    let payload_ptr_type = ptr_type(payload_type)
                    let safe_name = sanitize_symbol(enum_data.out.name) + "_payload"
                    if enum_payload_is_inline(ehir_payload_type) {
                        let raw = reg(safe_name + "_raw", ptr_type(i8_type()))
                        instructions.push(llvm_inst_cast("inttoptr", raw, lower_variable(payload)))
                        instructions.push(llvm_inst_insertvalue(out, tag_out, raw, "1"))
                        ret instructions
                    }
                    let size_ptr = reg(safe_name + "_size_ptr", payload_ptr_type)
                    let size = reg(safe_name + "_size", pointer_int_type())
                    let raw = reg(safe_name + "_raw", ptr_type(i8_type()))
                    let typed = reg(safe_name + "_typed", payload_ptr_type)
                    instructions.push(llvm_inst_gep(size_ptr, payload_type, const_text("null", payload_ptr_type), vec_singleton(const_text("1", i64_type())), false))
                    instructions.push(llvm_inst_cast("ptrtoint", size, size_ptr))
                    instructions.push(llvm_inst_call(Option[LLVMValue]::Some(raw), ptr_type(i8_type()), "encore_box_alloc", vec_singleton(size)))
                    instructions.push(llvm_inst_cast("bitcast", typed, raw))
                    instructions.push(llvm_inst_store(lower_variable(payload), typed))
                    instructions.push(llvm_inst_insertvalue(out, tag_out, raw, "1"))
                }
                Option[Variable]::None => {
                    instructions.push(llvm_inst_insertvalue(out, tag_out, const_text("null", ptr_type(i8_type())), "1"))
                }
            }
            ret instructions
        }
        Call(call_data) => {
            if required_variable_type(call_data.out).name == "JoinHandle" {
                if is_thread_spawn_name(call_data.name) { ret lower_thread_spawn(call_data) }
            }
            if call_data.name == "__encore_thread_join" { ret lower_thread_join(call_data) }
            let out_var: Variable = call_data.out
            let callee_name: str = call_data.name
            let call_args: Vec[Variable] = call_data.args
            let lowered: LLVMInstruction = lower_call(out_var, callee_name, call_data.generics, call_args)
            ret vec_singleton(lowered)
        }
        Await(await_data) => {
            eprintln("internal compiler error: unlowered EHIR await for '" + await_data.out.name + "' reached LLVM codegen")
            exit(1_i32)
            ret Vec[LLVMInstruction]::new()
        }
        Store(store_data) => {
            let src_var: Variable = store_data.src
            let dst_var: Variable = store_data.dst
            let value: LLVMValue = lower_variable(src_var)
            let ptr: LLVMValue = lower_variable(dst_var)
            match dst_var.typ {
                Option[Type]::Some(dst_type) => {
                    if dst_type.representation == RepresentationKind::Raw {
                        if str_ends_with(dst_var.name, "_iter_slot") {
                            ret vec_singleton(llvm_inst_store(value, ptr))
                        }
                        let mut instructions = lower_retain_value(value, required_variable_type(src_var))
                        instructions.push(llvm_inst_store(value, ptr))
                        ret instructions
                    }
                }
                Option[Type]::None => {}
            }
            ret vec_singleton(llvm_inst_store(value, ptr))
        }
        Load(load_data) => {
            let out_var: Variable = load_data.out
            let src_var: Variable = load_data.src
            let out: LLVMValue = lower_variable(out_var)
            let ptr: LLVMValue = lower_variable(src_var)
            ret vec_singleton(llvm_inst_load(out, ptr))
        }
        GetField(getfield_data) => {
            let out_var: Variable = getfield_data.out
            let src_var: Variable = getfield_data.src
            let field_var: Variable = getfield_data.field
            let out_name: str = out_var.name
            let out_type: Type = required_variable_type(out_var)

            let out_value: LLVMValue = lower_variable(out_var)
            let source_type = required_variable_type(src_var)
            if source_type.representation == RepresentationKind::Inline {
                let source = lower_variable(src_var)
                if is_variant_symbol(field_var.name) {
                    let raw = reg(sanitize_symbol(out_name) + "_payload_raw", ptr_type(i8_type()))
                    let mut instructions = vec_singleton(llvm_inst_extractvalue(raw, source, "1"))
                    if enum_payload_is_inline(out_type) {
                        instructions.push(llvm_inst_cast("ptrtoint", out_value, raw))
                        ret instructions
                    }
                    let typed = reg(sanitize_symbol(out_name) + "_payload_ptr", ptr_type(lower_type(out_type)))
                    instructions.push(llvm_inst_cast("bitcast", typed, raw))
                    instructions.push(llvm_inst_load(out_value, typed))
                    ret instructions
                }
                ret vec_singleton(llvm_inst_extractvalue(out_value, source, field_index_text(field_var.name)))
            }
            // getfield always returns the stored value, including a stored
            // raw address. Address-of-field semantics belong exclusively to
            // getfieldptr; conflating them turns a `T*` field into `T**` and
            // lets callers overwrite the enclosing node payload.
            let safe_out_name: str = sanitize_symbol(out_name)
            let ptr_name: str = safe_out_name + "_field_ptr"
            let out_llvm_type: LLVMType = lower_type(out_type)
            let ptr_llvm_type: LLVMType = ptr_type(out_llvm_type)
            let ptr_value: LLVMValue = reg(ptr_name, ptr_llvm_type)
            let gep: LLVMInstruction = lower_getfieldptr_with(ptr_value, src_var, field_var)
            let load: LLVMInstruction = llvm_inst_load(out_value, ptr_value)
            ret concat_instructions(vec_singleton(gep), vec_singleton(load))
        }
        SetField(setfield_data) => {
            let src_type = required_variable_type(setfield_data.src)
            if src_type.representation == RepresentationKind::Inline {
                ret unsupported_instruction("setfield on value")
            }
            let src = lower_variable(setfield_data.src)
            let value = lower_variable(setfield_data.value)
            let field_ptr = reg(
                instruction_scope + "_" + sanitize_symbol(setfield_data.src.name) + "_" +
                sanitize_symbol(setfield_data.field.name) + "_" +
                sanitize_symbol(setfield_data.value.name) + "_set_ptr",
                ptr_type(value_type(value))
            )
            let address = llvm_inst_gep(field_ptr, lower_pointee_type(src_type), src, field_indices(setfield_data.field.name), true)
            let mut instructions = vec_singleton(address)
            let value_ehir_type = required_variable_type(setfield_data.value)
            if is_node_handle_type(src_type) && type_may_have_node_edges(value_ehir_type) {
                let old_value = reg(instruction_scope + "_old_edge", lower_type(value_ehir_type))
                let raw_owner = reg(instruction_scope + "_edge_owner_raw", ptr_type(i8_type()))
                instructions.push(llvm_inst_load(old_value, field_ptr))
                instructions.push(llvm_inst_cast("bitcast", raw_owner, src))
                if is_node_handle_type(value_ehir_type) {
                    let raw_old = reg(instruction_scope + "_edge_old_raw", ptr_type(i8_type()))
                    let raw_new = reg(instruction_scope + "_edge_new_raw", ptr_type(i8_type()))
                    instructions.push(llvm_inst_cast("bitcast", raw_old, old_value))
                    instructions.push(llvm_inst_cast("bitcast", raw_new, value))
                    let mut replace_args = Vec[LLVMValue]::new()
                    replace_args.push(raw_owner)
                    replace_args.push(raw_old)
                    replace_args.push(raw_new)
                    instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(),
                        "encore_node_replace_edge", replace_args))
                } else {
                    instructions.extend(lower_edge_value(raw_owner, old_value,
                        value_ehir_type, instruction_scope + "_old", false,))
                    instructions.extend(lower_edge_value(raw_owner, value,
                        value_ehir_type, instruction_scope + "_new", true,))
                }
            }
            instructions.push(llvm_inst_store(value, field_ptr))
            ret instructions
        }
        GetFieldPtr(getfieldptr_data) => {
            let out_var: Variable = getfieldptr_data.out
            let src_var: Variable = getfieldptr_data.src
            let field_var: Variable = getfieldptr_data.field
            let lowered: LLVMInstruction = lower_getfieldptr(out_var, src_var, field_var)
            ret vec_singleton(lowered)
        }
        SGetField(sgetfield_data) => {
            let out_var = sgetfield_data.out
            let out_value = lower_variable(out_var)
            let ptr_value = reg(sanitize_symbol(out_var.name) + "_field_ptr", ptr_type(lower_type(required_variable_type(out_var))))
            let address = lower_getfieldptr_with(ptr_value, sgetfield_data.src, sgetfield_data.field)
            ret concat_instructions(vec_singleton(address), vec_singleton(llvm_inst_load(out_value, ptr_value)))
        }
        SGetFieldPtr(sgetfieldptr_data) => {
            ret vec_singleton(lower_getfieldptr(sgetfieldptr_data.out, sgetfieldptr_data.src, sgetfieldptr_data.field))
        }
        Lcsos(construct_data) => {
            let out_var: Variable = construct_data.out
            let raw_args: Vec[Variable] = construct_data.args
            if is_node_handle_type(construct_data.typ) {
                let plain_type = Type{construct_data.typ.name, construct_data.typ.generics, RepresentationKind::Inline}
                let aggregate_type = lower_type(plain_type)
                let aggregate_ptr_type = ptr_type(aggregate_type)
                let safe_name = sanitize_symbol(out_var.name)
                let size_ptr = reg(safe_name + "_size_ptr", aggregate_ptr_type)
                let size = reg(safe_name + "_size", pointer_int_type())
                let raw = reg(safe_name + "_raw", ptr_type(i8_type()))
                let out = lower_variable(out_var)
                let mut instructions = vec_singleton(llvm_inst_gep(size_ptr, aggregate_type, const_text("null", aggregate_ptr_type), vec_singleton(const_text("1", i64_type())), false))
                instructions.push(llvm_inst_cast("ptrtoint", size, size_ptr))
                if construct_data.typ.representation == RepresentationKind::NodeHeap {
                    instructions.push(llvm_inst_call(Option[LLVMValue]::Some(raw), ptr_type(i8_type()), "encore_node_alloc_heap", vec_singleton(size)))
                    instructions.push(llvm_inst_cast("bitcast", out, raw))
                }
                elif construct_data.typ.representation == RepresentationKind::NodeStack {
                    let storage_type = llvm_raw_type(LLVMTypeKind::STRUCT, "{ [8 x i64], " + type_text(aggregate_type) + " }")
                    let storage = reg(safe_name + "_stack_storage", ptr_type(storage_type))
                    instructions.push(llvm_inst_alloca(storage, storage_type))
                    instructions.push(llvm_inst_gep(out, storage_type, storage, field_indices("1"), true))
                    instructions.push(llvm_inst_cast("bitcast", raw, out))
                    instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_node_register_stack", concat_values(vec_singleton(raw), vec_singleton(size))))
                }
                else {
                    ret unsupported_instruction("lcsos with placement-erased node type")
                }
                let mut index = 0_usize
                for argument in raw_args {
                    let value = lower_variable(argument)
                    let field_ptr = reg(safe_name + "_field_" + Debug::fmt(index) + "_ptr", ptr_type(value_type(value)))
                    instructions.push(llvm_inst_gep(field_ptr, aggregate_type, out, field_indices(Debug::fmt(index)), true))
                    instructions.push(llvm_inst_store(value, field_ptr))
                    let argument_type = required_variable_type(argument)
                    if type_may_have_node_edges(argument_type) {
                        instructions.extend(lower_edge_value(raw, value, argument_type,
                            safe_name + "_field_" + Debug::fmt(index), true,))
                    }
                    index = index + 1_usize
                }
                ret instructions
            }
            let aggregate_type = lower_type(construct_data.typ)
            let mut aggregate = const_text("undef", aggregate_type)
            let mut instructions = Vec[LLVMInstruction]::new()
            if raw_args.len() == 0_usize {
                instructions.push(llvm_inst_bitcast(lower_variable(out_var), aggregate))
                ret instructions
            }
            let mut index = 0_usize
            for argument in raw_args {
                let value = lower_variable(argument)
                let is_last = index + 1_usize == raw_args.len()
                let next = if is_last {
                    lower_variable(out_var)
                } else {
                    reg(sanitize_symbol(out_var.name) + "_insert_" + Debug::fmt(index), aggregate_type)
                }
                instructions.push(llvm_inst_insertvalue(next, aggregate, value, Debug::fmt(index)))
                aggregate = next
                index = index + 1_usize
            }
            ret instructions
        }
        GetPtr(getptr_data) => {
            let out_var: Variable = getptr_data.out
            let src_var: Variable = getptr_data.src
            let out_type: Type = required_variable_type(out_var)

            let out: LLVMValue = lower_variable(out_var)
            let ret_type: LLVMType = lower_type(out_type)
            let src_value: LLVMValue = lower_variable(src_var)
            let args: Vec[LLVMValue] = vec_singleton(src_value)
            ret vec_singleton(llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, "__ehir_getptr", args))
        }
        PtrCast(pcast_data) => {
            let out_var: Variable = pcast_data.out
            let src_var: Variable = pcast_data.src
            let out: LLVMValue = lower_variable(out_var)
            let src_value: LLVMValue = lower_variable(src_var)
            let src_type = required_variable_type(src_var)
            let target_type = pcast_data.target_type
            if is_dyn_type(target_type) && target_type.representation == RepresentationKind::Inline && !is_dyn_type(src_type) {
                let prefix = sanitize_symbol(out_var.name)
                let concrete_type = lower_type(src_type)
                let concrete_ptr_type = ptr_type(concrete_type)
                let size_ptr = reg(prefix + "_box_size_ptr", concrete_ptr_type)
                let size = reg(prefix + "_box_size", pointer_int_type())
                let raw_box = reg(prefix + "_box_raw", ptr_type(i8_type()))
                let typed_box = reg(prefix + "_box", concrete_ptr_type)
                let with_data = reg(prefix + "_with_data", lower_type(target_type))
                let mut instructions = Vec[LLVMInstruction]::new()
                instructions.push(llvm_inst_gep(size_ptr, concrete_type, const_text("null", concrete_ptr_type), vec_singleton(const_text("1", i64_type())), false))
                instructions.push(llvm_inst_cast("ptrtoint", size, size_ptr))
                instructions.push(llvm_inst_call(Option[LLVMValue]::Some(raw_box), ptr_type(i8_type()), "__ehir_hrealloc", concat_values(vec_singleton(const_text("null", ptr_type(i8_type()))), vec_singleton(size))))
                instructions.push(llvm_inst_cast("bitcast", typed_box, raw_box))
                instructions.push(llvm_inst_store(src_value, typed_box))
                instructions.push(llvm_inst_insertvalue(with_data, const_text("undef", lower_type(target_type)), raw_box, "0"))
                instructions.push(llvm_inst_insertvalue(out, with_data, const_text(enum_variant_tag(mangle_type_name(src_type)), i64_type()), "1"))
                ret instructions
            }
            let mut op = "bitcast"
            if is_numeric_ehir_type(src_type) && target_type.representation != RepresentationKind::Inline { op = "inttoptr" }
            elif src_type.representation != RepresentationKind::Inline && is_numeric_ehir_type(target_type) { op = "ptrtoint" }
            elif is_numeric_ehir_type(src_type) && is_numeric_ehir_type(target_type) {
                if is_float_ehir_type(src_type) && !is_float_ehir_type(target_type) { op = if is_signed_ehir_type(target_type) { "fptosi" } else { "fptoui" } }
                elif !is_float_ehir_type(src_type) && is_float_ehir_type(target_type) { op = if is_signed_ehir_type(src_type) { "sitofp" } else { "uitofp" } }
                elif is_float_ehir_type(src_type) && is_float_ehir_type(target_type) {
                    if numeric_type_bits(src_type) < numeric_type_bits(target_type) { op = "fpext" }
                    elif numeric_type_bits(src_type) > numeric_type_bits(target_type) { op = "fptrunc" }
                }
                elif numeric_type_bits(src_type) < numeric_type_bits(target_type) { op = if is_signed_ehir_type(src_type) { "sext" } else { "zext" } }
                elif numeric_type_bits(src_type) > numeric_type_bits(target_type) { op = "trunc" }
            }
            ret vec_singleton(llvm_inst_cast(op, out, src_value))
        }
        Gep(gep_data) => {
            let out = lower_variable(gep_data.out)
            let src = lower_variable(gep_data.src)
            let offset = lower_variable(gep_data.offset)
            let element_type = lower_pointee_type(required_variable_type(gep_data.src))
            ret vec_singleton(llvm_inst_gep(out, element_type, src, vec_singleton(offset), true))
        }
        StackAlloc(salloc_data) => {
            let out_var: Variable = salloc_data.out
            let out: LLVMValue = lower_variable(out_var)
            let alloc_type: LLVMType = lower_type(salloc_data.typ)
            ret vec_singleton(llvm_inst_alloca(out, alloc_type))
        }
        HeapAlloc(halloc_data) => {
            let out_var: Variable = halloc_data.out
            let out_type: Type = required_variable_type(out_var)
            let out: LLVMValue = lower_variable(out_var)
            let ret_type: LLVMType = lower_type(out_type)
            ret vec_singleton(llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, "__ehir_halloc", Vec[LLVMValue]::new()))
        }
        HeapFree(hfree_data) => {
            let src_var: Variable = hfree_data.src
            let src_value: LLVMValue = lower_variable(src_var)
            let raw = reg(sanitize_symbol(src_var.name) + "_free_raw", ptr_type(i8_type()))
            let cast = llvm_inst_cast("bitcast", raw, src_value)
            let inst: LLVMInstruction = llvm_inst_call(Option[LLVMValue]::None, void_type(), "__ehir_hfree", vec_singleton(raw))
            ret concat_instructions(vec_singleton(cast), vec_singleton(inst))
        }
        HeapRealloc(realloc_data) => {
            let out = lower_variable(realloc_data.out)
            let src = lower_variable(realloc_data.src)
            let count = lower_variable(realloc_data.count)
            let element_type = lower_pointee_type(required_variable_type(realloc_data.src))
            let element_ptr_type = ptr_type(element_type)
            let prefix = sanitize_symbol(realloc_data.out.name)
            let size_ptr = reg(prefix + "_size_ptr", element_ptr_type)
            let size = reg(prefix + "_size", pointer_int_type())
            let bytes = reg(prefix + "_bytes", pointer_int_type())
            let raw_src = reg(prefix + "_raw_src", ptr_type(i8_type()))
            let raw_out = reg(prefix + "_raw_out", ptr_type(i8_type()))
            let mut instructions = Vec[LLVMInstruction]::new()
            instructions.push(llvm_inst_gep(size_ptr, element_type, const_text("null", element_ptr_type), vec_singleton(const_text("1", i64_type())), false))
            instructions.push(llvm_inst_cast("ptrtoint", size, size_ptr))
            instructions.push(llvm_inst_binary("mul", bytes, count, size))
            instructions.push(llvm_inst_cast("bitcast", raw_src, src))
            let args = concat_values(vec_singleton(raw_src), vec_singleton(bytes))
            instructions.push(llvm_inst_call(Option[LLVMValue]::Some(raw_out), ptr_type(i8_type()), "__ehir_hrealloc", args))
            instructions.push(llvm_inst_cast("bitcast", out, raw_out))
            ret instructions
        }
        Put(put_data) => {
            let args = vec_singleton(lower_variable(put_data.dst))
            let name = "__ehir_put_" + sanitize_symbol(put_data.primitive)
            ret vec_singleton(llvm_inst_call(Option[LLVMValue]::None, void_type(), name, args))
        }
        Binary(binary_data) => {
            let out_var: Variable = binary_data.out
            let lhs_var: Variable = binary_data.lhs
            let rhs_var: Variable = binary_data.rhs
            let op: BinaryOpKind = binary_data.op
            if (op == BinaryOpKind::IEQ || op == BinaryOpKind::NEQ) && is_variant_symbol(rhs_var.name) {
                match lhs_var.typ {
                    Option[Type]::Some(lhs_type) => {
                        if is_aggregate_ehir_type(lhs_type) {
                            let tag_out = reg(sanitize_symbol(out_var.name) + "_tag", i32_type())
                            let extract = llvm_inst_extractvalue(tag_out, lower_variable(lhs_var), "0")
                            let tag = const_i32(enum_variant_tag(enum_variant_symbol_name(rhs_var.name)))
                            let predicate = if op == BinaryOpKind::IEQ { "icmp eq" } else { "icmp ne" }
                            let compare = llvm_inst_binary(predicate, lower_variable(out_var), tag_out, tag)
                            ret concat_instructions(vec_singleton(extract), vec_singleton(compare))
                        }
                    }
                    Option[Type]::None => {}
                }
            }
            if op == BinaryOpKind::IEQ || op == BinaryOpKind::NEQ {
                match lhs_var.typ {
                    Option[Type]::Some(lhs_type) => {
                        if lhs_type.name == "str" {
                            let args = concat_values(vec_singleton(lower_variable(lhs_var)), vec_singleton(lower_variable(rhs_var)))
                            if op == BinaryOpKind::IEQ {
                                ret vec_singleton(llvm_inst_call(Option[LLVMValue]::Some(lower_variable(out_var)), i1_type(), "encore_str_eq", args))
                            }
                            let equal = reg(sanitize_symbol(out_var.name) + "_str_equal", i1_type())
                            let mut instructions = vec_singleton(llvm_inst_call(Option[LLVMValue]::Some(equal), i1_type(), "encore_str_eq", args))
                            instructions.push(llvm_inst_binary("xor", lower_variable(out_var), equal, const_text("1", i1_type())))
                            ret instructions
                        }
                        match rhs_var.typ {
                            Option[Type]::Some(rhs_type) => {
                                if is_aggregate_ehir_type(lhs_type) && lhs_type.name == rhs_type.name {
                                    let lhs_tag = reg(sanitize_symbol(out_var.name) + "_lhs_tag", i32_type())
                                    let rhs_tag = reg(sanitize_symbol(out_var.name) + "_rhs_tag", i32_type())
                                    let mut instructions = vec_singleton(llvm_inst_extractvalue(lhs_tag, lower_variable(lhs_var), "0"))
                                    instructions.push(llvm_inst_extractvalue(rhs_tag, lower_variable(rhs_var), "0"))
                                    let predicate = if op == BinaryOpKind::IEQ { "icmp eq" } else { "icmp ne" }
                                    instructions.push(llvm_inst_binary(predicate, lower_variable(out_var), lhs_tag, rhs_tag))
                                    ret instructions
                                }
                            }
                            Option[Type]::None => {}
                        }
                    }
                    Option[Type]::None => {}
                }
            }
            ret vec_singleton(lower_binary(out_var, lhs_var, rhs_var, op))
        }
        Phi(phi_data) => {
            let out_var: Variable = phi_data.out
            let pairs: Vec[PhiPair] = phi_data.pairs
            let out: LLVMValue = lower_variable(out_var)
            let mut incoming = Vec[LLVMPhiIncoming]::new()
            for pair in pairs {
                incoming.push(llvm_make_phi_incoming(lower_variable(pair.value), block_symbol(pair.label)))
            }
            ret vec_singleton(llvm_inst_phi(out, incoming))
        }
        Cfree(cfree_data) => {
            // `cfree` consumes one owning root.  Whether that makes an ERN
            // collectable is decided synchronously by the common node
            // runtime, through the same typed drop path used for an ordinary
            // last use.  There is intentionally no untyped `__ehir_cfree`:
            // fields must be finalized with their concrete EHIR types.
            let typ = required_variable_type(cfree_data.value)
            ret lower_drop_value(lower_variable(cfree_data.value), typ, sanitize_symbol(cfree_data.value.name) + "_cfree")
        }
        AddEdge(edge_data) => {
            ret lower_explicit_edge(edge_data, true)
        }
        RemoveEdge(edge_data) => {
            ret lower_explicit_edge(edge_data, false)
        }
        Drop(drop_data) => {
            let typ = required_variable_type(drop_data.value)
            ret lower_drop_value(lower_variable(drop_data.value), typ, sanitize_symbol(drop_data.value.name))
        }
        Retain(retain_data) => {
            let typ = required_variable_type(retain_data.value)
            ret lower_retain_value(lower_variable(retain_data.value), typ)
        }
    }
}

fn lower_explicit_edge(data: EdgeInstruction, adding: bool) -> Vec[LLVMInstruction] {
    let raw_owner = reg(sanitize_symbol(data.owner.name) + if adding { "_add_edge_owner_raw" } else { "_remove_edge_owner_raw" }, ptr_type(i8_type()))
    let mut instructions = vec_singleton(llvm_inst_cast("bitcast", raw_owner, lower_variable(data.owner)))
    instructions.extend(lower_edge_value(raw_owner, lower_variable(data.value),
        required_variable_type(data.value), sanitize_symbol(data.value.name), adding,))
    ret instructions
}

fn lower_thread_spawn(data: CallInstruction) -> Vec[LLVMInstruction] {
    let prefix = sanitize_symbol(data.out.name)
    let context_type = thread_context_type(data.name, data.out, data.generics, data.args)
    let context_ptr_type = ptr_type(context_type)
    let raw_ptr_type = ptr_type(i8_type())
    let size_ptr = reg(prefix + "_context_size_ptr", context_ptr_type)
    let size = reg(prefix + "_context_size", pointer_int_type())
    let raw_context = reg(prefix + "_context_raw", raw_ptr_type)
    let context = reg(prefix + "_context", context_ptr_type)
    let mut instructions = vec_singleton(llvm_inst_gep(size_ptr, context_type, const_text("null", context_ptr_type), vec_singleton(const_text("1", i64_type())), false))
    instructions.push(llvm_inst_cast("ptrtoint", size, size_ptr))
    instructions.push(llvm_inst_call(Option[LLVMValue]::Some(raw_context), raw_ptr_type, "__ehir_hrealloc", concat_values(vec_singleton(const_text("null", raw_ptr_type)), vec_singleton(size))))
    instructions.push(llvm_inst_cast("bitcast", context, raw_context))
    let mut index = 0_usize
    for argument in data.args {
        let value = lower_variable(argument)
        let field_ptr = reg(prefix + "_arg_" + Debug::fmt(index) + "_ptr", ptr_type(value_type(value)))
        instructions.push(llvm_inst_gep(field_ptr, context_type, context, field_indices(Debug::fmt(index + 1_usize)), true))
        instructions.push(llvm_inst_store(value, field_ptr))
        index = index + 1_usize
    }
    let function_ptr_type = llvm_raw_type(LLVMTypeKind::POINTER, "void (i8*)*")
    let entry = const_text("@__encore_thread_trampoline_" + thread_site_key(data.name, data.out, data.generics, data.args), function_ptr_type)
    let cleanup = const_text("@__encore_thread_cleanup_" + thread_site_key(data.name, data.out, data.generics, data.args), function_ptr_type)
    let token = reg(prefix + "_token", pointer_int_type())
    instructions.push(llvm_inst_call(Option[LLVMValue]::Some(token), pointer_int_type(), "encore_thread_spawn",
        concat_values(concat_values(vec_singleton(entry), vec_singleton(raw_context)), vec_singleton(cleanup))))
    let handle_type = lower_type(required_variable_type(data.out))
    instructions.push(llvm_inst_insertvalue(lower_variable(data.out), const_text("undef", handle_type), token, "0"))
    ret instructions
}

fn lower_thread_join(data: CallInstruction) -> Vec[LLVMInstruction] {
    match data.args.get(0_usize) {
        Some(handle_var) => {
            let prefix = sanitize_symbol(data.out.name)
            let handle = lower_variable(handle_var)
            let token = reg(prefix + "_token", pointer_int_type())
            let raw = reg(prefix + "_context_raw", ptr_type(i8_type()))
            let result_ehir_type = required_variable_type(data.out)
            let result_type = lower_type(result_ehir_type)
            let mut instructions = vec_singleton(llvm_inst_extractvalue(token, handle, "0"))
            instructions.push(llvm_inst_call(Option[LLVMValue]::Some(raw), ptr_type(i8_type()), "encore_thread_join", vec_singleton(token)))
            if !thread_result_is_void(result_ehir_type) {
                let result_ptr = reg(prefix + "_result_ptr", ptr_type(result_type))
                instructions.push(llvm_inst_cast("bitcast", result_ptr, raw))
                instructions.push(llvm_inst_load(lower_variable(data.out), result_ptr))
                instructions.extend(lower_retain_value(lower_variable(data.out), result_ehir_type))
            }
            instructions.push(llvm_inst_call(Option[LLVMValue]::None, void_type(), "encore_thread_release", vec_singleton(token)))
            ret instructions
        }
        None => {
            eprintln("internal compiler error: thread join has no handle")
            exit(1_i32)
            ret Vec[LLVMInstruction]::new()
        }
    }
}

fn unsupported_instruction(name: str) -> Vec[LLVMInstruction] {
    backend_invariant_error("unsupported self-hosted LLVM instruction '" + name + "'")
    ret Vec[LLVMInstruction]::new()
}

fn backend_invariant_error(message: str) -> () {
    eprintln("error[backend-invariant]: " + message)
    exit(1_i32)
    ret ()
}

fn lower_literal(out_var: Variable, value: str) -> Vec[LLVMInstruction] {
    let out = lower_variable(out_var)
    let out_type = required_variable_type(out_var)
    let ret_type = lower_type(out_type)
    if value == "\"\"_str" {
        ret vec_singleton(llvm_inst_bitcast(out, const_text("null", ret_type)))
    }
    if value.len() > 0_usize && value.slice(0_usize, 1_usize) != "\"" {
        let mut raw = numeric_literal_text(value)
        if is_float_ehir_type(out_type) {
            raw = unsafe { encore_llvm_float_literal(raw, if out_type.name == "f32" { 1_usize } else { 0_usize }) }
        }
        let zero = const_text(if is_float_ehir_type(out_type) { "0.0" } else { "0" }, ret_type)
        let literal = const_text(raw, ret_type)
        if is_float_ehir_type(out_type) {
            ret vec_singleton(llvm_inst_binary("fadd", out, zero, literal))
        }
        ret vec_singleton(llvm_inst_add(out, zero, literal))
    }
    if is_string_literal(value) {
        let body = string_literal_body(value)
        let array_type_value = array_type(Debug::fmt(string_literal_byte_len(body) + 1_usize), i8_type())
        let global = const_text("@" + string_literal_global_name(body), ptr_type(array_type_value))
        let ptr = reg(sanitize_symbol(out_var.name) + "_literal_ptr", ptr_type(i8_type()))
        let indices = concat_values(vec_singleton(const_i32("0")), vec_singleton(const_i32("0")))
        let address = llvm_inst_gep(ptr, array_type_value, global, indices, true)
        let call_inst = llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, "encore_str_from_cstr", vec_singleton(ptr))
        ret concat_instructions(vec_singleton(address), vec_singleton(call_inst))
    }
    ret vec_singleton(llvm_inst_bitcast(out, const_text("null", ret_type)))
}

fn contains_char(value: str, needle: str) -> bool {
    let mut index = 0_usize
    while index < value.len() {
        if value.slice(index, 1_usize) == needle { ret true }
        index += 1_usize
    }
    ret false
}

fn str_ends_with(value: str, suffix: str) -> bool {
    if suffix.len() > value.len() { ret false }
    ret value.slice(value.len() - suffix.len(), suffix.len()) == suffix
}

fn numeric_literal_text(value: str) -> str {
    let mut index = 0_usize
    while index < value.len() {
        if value.slice(index, 1_usize) == "_" {
            ret value.slice(0_usize, index)
        }
        index = index + 1_usize
    }
    ret value
}

fn lower_call(out_var: Variable, callee_name: str, generics: Vec[Type], args: Vec[Variable]) -> LLVMInstruction {
    let out_type = required_variable_type(out_var)
    let ret_type = lower_type(out_type)
    let callee = if generics.len() > 0_usize { generic_symbol(callee_name, generics) } else { function_symbol(callee_name) }
    let lowered_args = lower_variables(args)
    if out_type.name == "void" || out_type.name == "()" {
        ret llvm_inst_call(Option[LLVMValue]::None, void_type(), callee, lowered_args)
    }
    let out = lower_variable(out_var)
    ret llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, callee, lowered_args)
}

fn function_symbol(name: str) -> str {
    if name == "write" { ret "__encore_fn_write" }
    if name == "exit" { ret "__encore_fn_exit" }
    ret sanitize_symbol(name)
}

fn lower_getfieldptr(out_var: Variable, src_var: Variable, field_var: Variable) -> LLVMInstruction {
    let out_ptr = lower_variable(out_var)
    ret lower_getfieldptr_with(out_ptr, src_var, field_var)
}

fn lower_getfieldptr_with(out_ptr: LLVMValue, src_var: Variable, field_var: Variable) -> LLVMInstruction {
    let src_value = lower_variable(src_var)
    let src_type = required_variable_type(src_var)
    let field_name = field_var.name
    let element_type = lower_pointee_type(src_type)
    let indices = field_indices(field_name)
    ret llvm_inst_gep(out_ptr, element_type, src_value, indices, true)
}

fn lower_binary(out_var: Variable, lhs_var: Variable, rhs_var: Variable, op: BinaryOpKind) -> LLVMInstruction {
    let out = lower_variable(out_var)
    let fallback_type = binary_operand_type(lhs_var, rhs_var, out_var)
    let lhs = lower_binary_operand(lhs_var, fallback_type)
    let rhs = lower_binary_operand(rhs_var, fallback_type)
    let is_float = is_float_ehir_type(fallback_type)

    match op {
        ADD => {
            if fallback_type.name == "str" {
                ret llvm_inst_call(Option[LLVMValue]::Some(out), lower_type(fallback_type), "encore_str_concat", concat_values(vec_singleton(lhs), vec_singleton(rhs)))
            }
            if is_float { ret llvm_inst_binary("fadd", out, lhs, rhs) }
            ret llvm_inst_add(out, lhs, rhs)
        }
        SUB => {
            if is_float { ret llvm_inst_binary("fsub", out, lhs, rhs) }
            ret llvm_inst_sub(out, lhs, rhs)
        }
        MUL => { ret llvm_inst_binary(if is_float { "fmul" } else { "mul" }, out, lhs, rhs) }
        DIV => { ret llvm_inst_binary(if is_float { "fdiv" } elif is_signed_ehir_type(fallback_type) { "sdiv" } else { "udiv" }, out, lhs, rhs) }
        MOD => { ret llvm_inst_binary(if is_float { "frem" } elif is_signed_ehir_type(fallback_type) { "srem" } else { "urem" }, out, lhs, rhs) }
        SHL => { ret llvm_inst_binary("shl", out, lhs, rhs) }
        SHR => { ret llvm_inst_binary(if is_signed_ehir_type(fallback_type) { "ashr" } else { "lshr" }, out, lhs, rhs) }
        AND => { ret llvm_inst_binary("and", out, lhs, rhs) }
        OR => { ret llvm_inst_binary("or", out, lhs, rhs) }
        XOR => { ret llvm_inst_binary("xor", out, lhs, rhs) }
        IEQ => { ret llvm_inst_binary(if is_float { "fcmp oeq" } else { "icmp eq" }, out, lhs, rhs) }
        NEQ => { ret llvm_inst_binary(if is_float { "fcmp une" } else { "icmp ne" }, out, lhs, rhs) }
        LES => { ret llvm_inst_binary(if is_float { "fcmp olt" } elif is_signed_ehir_type(fallback_type) { "icmp slt" } else { "icmp ult" }, out, lhs, rhs) }
        LEQ => { ret llvm_inst_binary(if is_float { "fcmp ole" } elif is_signed_ehir_type(fallback_type) { "icmp sle" } else { "icmp ule" }, out, lhs, rhs) }
        GRT => { ret llvm_inst_binary(if is_float { "fcmp ogt" } elif is_signed_ehir_type(fallback_type) { "icmp sgt" } else { "icmp ugt" }, out, lhs, rhs) }
        GEQ => { ret llvm_inst_binary(if is_float { "fcmp oge" } elif is_signed_ehir_type(fallback_type) { "icmp sge" } else { "icmp uge" }, out, lhs, rhs) }
    }
}

fn is_float_ehir_type(typ: Type) -> bool {
    ret typ.representation == RepresentationKind::Inline && (typ.name == "f16" || typ.name == "f32" || typ.name == "f64")
}

fn binary_operand_type(lhs: Variable, rhs: Variable, out: Variable) -> Type {
    match lhs.typ {
        Option[Type]::Some(typ) => { ret typ }
        Option[Type]::None => {}
    }
    match rhs.typ {
        Option[Type]::Some(typ) => { ret typ }
        Option[Type]::None => {}
    }
    ret required_variable_type(out)
}

fn lower_binary_operand(value: Variable, fallback: Type) -> LLVMValue {
    match value.typ {
        Option[Type]::Some(_) => { ret lower_variable(value) }
        Option[Type]::None => {
            if is_variant_symbol(value.name) {
                ret const_text(enum_variant_tag(value.name), lower_type(fallback))
            }
        }
    }
    ret lower_variable_with_fallback(value, fallback)
}

fn lower_phi_values(pairs: Vec[PhiPair]) -> Vec[LLVMValue] {
    let mut acc = Vec[LLVMValue]::new()
    for current in pairs {
        acc.push(lower_variable(current.value))
    }
    ret acc
}

fn lower_terminator(terminator: Terminator) -> LLVMTerminator {
    match terminator {
        Unreachable => { ret llvm_term_unreachable() }
        Ret(ret_data) => {
            let ret_value_var: Variable = ret_data.value
            let ret_value_type: Type = required_variable_type(ret_value_var)
            if ret_value_type.name == "void" || ret_value_type.name == "()" {
                ret llvm_term_ret_void()
            }
            let value: LLVMValue = lower_variable(ret_value_var)
            let ret_type: LLVMType = lower_type(ret_value_type)
            ret llvm_term_ret(Option[LLVMValue]::Some(value), ret_type)
        }
        Br(br_data) => {
            let label: str = br_data.label
            let safe_label: str = block_symbol(label)
            ret llvm_term_br(safe_label)
        }
        Cbr(cbr_data) => {
            let cond_var: Variable = cbr_data.cond
            let true_label_raw: str = cbr_data.true_label
            let false_label_raw: str = cbr_data.false_label
            let cond: LLVMValue = lower_variable_with_fallback(cond_var, Type{"bool", Vec[Type]::new(), RepresentationKind::Inline})
            let true_label: str = block_symbol(true_label_raw)
            let false_label: str = block_symbol(false_label_raw)
            ret llvm_term_cbr(cond, true_label, false_label)
        }
        Match(match_data) => {
            let default_label: str = match_data.default_label
            let safe_default_label: str = block_symbol(default_label)
            ret llvm_term_br(safe_default_label)
        }
        Switch(switch_data) => {
            let default_label: str = switch_data.default_label
            let safe_default_label: str = block_symbol(default_label)
            ret llvm_term_br(safe_default_label)
        }
    }
}

fn block_symbol(name: str) -> str {
    ret "bb_" + sanitize_symbol(name)
}

fn lower_variables(variables: Vec[Variable]) -> Vec[LLVMValue] {
    let mut acc = Vec[LLVMValue]::new()
    for current in variables {
        acc.push(lower_variable(current))
    }
    ret acc
}

fn lower_variable(var_data: Variable) -> LLVMValue {
    let var_name = var_data.name
    let var_type = required_variable_type(var_data)
    let name = sanitize_symbol(var_name)
    let typ = lower_type(var_type)
    ret reg(name, typ)
}

fn lower_variable_with_fallback(var_data: Variable, fallback: Type) -> LLVMValue {
    match var_data.typ {
        Option[Type]::Some(_) => { ret lower_variable(var_data) }
        Option[Type]::None => {
            ret reg(sanitize_symbol(var_data.name), lower_type(fallback))
        }
    }
    ret reg("_", lower_type(fallback))
}

fn required_variable_type(value: Variable) -> Type {
    match value.typ {
        Option[Type]::Some(typ) => { ret typ }
        Option[Type]::None => {
            backend_invariant_error("LLVM lowering requires a type for variable '" + value.name + "'")
        }
    }
    ret Type{"void", Vec[Type]::new(), RepresentationKind::Inline}
}

fn required_generic_type(value: Type, index: usize) -> Type {
    match value.generics.get(index) { Some(item) => { ret item } None => { backend_invariant_error("missing concrete generic type at index " + Debug::fmt(index) + " for '" + value.name + "'") } }
    ret Type{"void", Vec[Type]::new(), RepresentationKind::Inline}
}

fn lower_type(typ: Type) -> LLVMType {
    let raw_name = typ.name
    let base = if has_prefix(raw_name, "__array_") && typ.generics.len() == 1_usize {
        let length = raw_name.slice(8_usize, raw_name.len() - 8_usize)
        match typ.generics.get(0_usize) {
            Option[Type]::Some(element) => { array_type(length, lower_type(element)) }
            Option[Type]::None => { lower_plain_type(raw_name) }
        }
    } elif has_prefix(raw_name, "__tuple_") && typ.generics.len() > 0_usize {
        llvm_raw_type(LLVMTypeKind::STRUCT, tuple_llvm_type_text(typ.generics))
    } elif typ.generics.len() > 0_usize {
        named_struct_type(sanitize_symbol(mangle_type_name(Type{typ.name, typ.generics, RepresentationKind::Inline})))
    } else {
        lower_plain_type(raw_name)
    }
    let representation = typ.representation
    match representation {
        Inline => {
            ret base
        }
        NodeStack => {
            ret ptr_type(base)
        }
        NodeHeap => {
            ret ptr_type(base)
        }
        NodeAny => {
            ret ptr_type(base)
        }
        Raw => {
            ret ptr_type(base)
        }
        LocalPlace => {
            ret ptr_type(base)
        }
    }
}

fn tuple_llvm_type_text(items: Vec[Type]) -> str {
    let mut out = "{ "
    let mut index = 0_usize
    for item in items {
        if index > 0_usize { out = out + ", " }
        out = out + type_text(lower_type(item))
        index = index + 1_usize
    }
    ret out + " }"
}

fn has_prefix(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() { ret false }
    ret value.slice(0_usize, prefix.len()) == prefix
}

fn is_dyn_type(typ: Type) -> bool {
    ret has_prefix(typ.name, "dyn_") || has_prefix(typ.name, "dyn ")
}

fn lower_pointee_type(typ: Type) -> LLVMType {
    let representation = typ.representation
    match representation {
        Inline => {
            ret lower_type(typ)
        }
        NodeStack => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
        NodeHeap => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
        NodeAny => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
        Raw => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
        LocalPlace => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
    }
}

fn alloc_target_type(typ: Type) -> LLVMType {
    let representation = typ.representation
    match representation {
        Inline => {
            ret lower_type(typ)
        }
        NodeStack => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
        NodeHeap => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
        NodeAny => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
        Raw => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
        LocalPlace => {
            ret lower_type(Type{typ.name, typ.generics, RepresentationKind::Inline})
        }
    }
}

fn lower_plain_type(type_name: str) -> LLVMType {
    if (type_name == "void" || type_name == "()") { ret void_type() }
    if (type_name == "bool" || type_name == "u1") { ret i1_type() }

    if (type_name == "u8") { ret i8_type() }
    if (type_name == "i8") { ret i8_type() }
    if (type_name == "u16") { ret i16_type() }
    if (type_name == "i16") { ret i16_type() }
    if (type_name == "u32") { ret i32_type() }
    if (type_name == "i32") { ret i32_type() }
    if (type_name == "u64") { ret i64_type() }
    if (type_name == "i64") { ret i64_type() }
    if (type_name == "usize") { ret pointer_int_type() }
    if (type_name == "isize") { ret pointer_int_type() }

    if (type_name == "f16") { ret f16_type() }
    if (type_name == "f32") { ret f32_type() }
    if (type_name == "f64") { ret f64_type() }

    if (type_name == "str") { ret ptr_type(i8_type()) }
    ret named_struct_type(sanitize_symbol(type_name))
}

fn is_aggregate_ehir_type(typ: Type) -> bool {
    let name = typ.name
    if name == "bool" || name == "u1" || name == "str" || name == "void" { ret false }
    if name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "usize" { ret false }
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "isize" { ret false }
    if name == "f16" || name == "f32" || name == "f64" { ret false }
    ret true
}

fn is_node_handle_type(typ: Type) -> bool {
    ret typ.representation == RepresentationKind::NodeStack ||
        typ.representation == RepresentationKind::NodeHeap ||
        typ.representation == RepresentationKind::NodeAny
}

fn is_numeric_ehir_type(typ: Type) -> bool {
    if typ.representation != RepresentationKind::Inline { ret false }
    let name = typ.name
    ret name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "usize" ||
        name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "isize" ||
        name == "f16" || name == "f32" || name == "f64"
}

fn enum_payload_is_inline(typ: Type) -> bool {
    if typ.representation != RepresentationKind::Inline { ret false }
    if typ.name == "bool" || typ.name == "u1" { ret true }
    if !is_numeric_ehir_type(typ) || is_float_ehir_type(typ) { ret false }
    ret numeric_type_bits(typ) <= unsafe { encore_llvm_target_pointer_width() }
}

fn is_signed_ehir_type(typ: Type) -> bool { ret typ.name == "i8" || typ.name == "i16" || typ.name == "i32" || typ.name == "i64" || typ.name == "isize" }

fn numeric_type_bits(typ: Type) -> usize {
    if typ.name == "u8" || typ.name == "i8" { ret 8_usize }
    if typ.name == "u16" || typ.name == "i16" { ret 16_usize }
    if typ.name == "f16" { ret 16_usize }
    if typ.name == "u32" || typ.name == "i32" { ret 32_usize }
    if typ.name == "f32" { ret 32_usize }
    if typ.name == "usize" || typ.name == "isize" { ret unsafe { encore_llvm_target_pointer_width() } }
    ret 64_usize
}

fn pointer_int_type() -> LLVMType {
    if unsafe { encore_llvm_target_pointer_width() } == 32_usize { ret i32_type() }
    ret i64_type()
}

fn is_variant_symbol(value: str) -> bool {
    if value.len() == 0_usize { ret false }
    let first = value.byte_at(0_usize)
    ret first >= 65_u8 && first <= 90_u8
}

fn enum_variant_symbol_name(value: str) -> str {
    let mut index = 0_usize
    let mut start = 0_usize
    while index + 1_usize < value.len() {
        if value.byte_at(index) == 58_u8 && value.byte_at(index + 1_usize) == 58_u8 {
            start = index + 2_usize
            index = index + 1_usize
        }
        index = index + 1_usize
    }
    ret value.slice(start, value.len() - start)
}

fn enum_variant_tag(value: str) -> str {
    ret Debug::fmt(enum_variant_tag_value(value))
}

fn enum_variant_tag_value(value: str) -> usize {
    let mut tag = 216613626_usize
    let mut index = 0_usize
    while index < value.len() {
        tag = (tag * 16777619_usize + value.byte_at(index) as usize) % 2147483647_usize
        index = index + 1_usize
    }
    ret tag
}

fn field_indices(field_name: str) -> Vec[LLVMValue] {
    let first = const_i32("0")
    let second = const_i32(field_index_text(field_name))
    ret concat_values(vec_singleton(first), vec_singleton(second))
}

fn field_index_text(field_name: str) -> str {
    if (str_len(field_name) == 0_usize) {
        ret "0"
    }

    let first = field_name.byte_at(0_usize)
    if first >= 65_u8 && first <= 90_u8 { ret "1" }
    if (is_digit(first)) {
        ret take_digits(field_name, 0_usize, "")
    }
    ret "0"
}

fn take_digits(text: str, index: usize, acc: str) -> str {
    if (index >= str_len(text)) {
        if (acc == "") {
            ret "0"
        }
        ret acc
    }

    let ch = text.byte_at(index)
    if (is_digit(ch)) {
        let piece = byte_slice(text, index, 1_usize)
        ret take_digits(text, index + 1_usize, acc + piece)
    }

    if (acc == "") {
        ret "0"
    }
    ret acc
}

fn binary_suffix(op: BinaryOpKind) -> str {
    match op {
        ADD => { ret "add" }
        SUB => { ret "sub" }
        MUL => { ret "mul" }
        DIV => { ret "div" }
        MOD => { ret "mod" }
        SHL => { ret "shl" }
        SHR => { ret "shr" }
        AND => { ret "and" }
        OR => { ret "or" }
        XOR => { ret "xor" }
        IEQ => { ret "ieq" }
        NEQ => { ret "neq" }
        LES => { ret "les" }
        LEQ => { ret "leq" }
        GRT => { ret "grt" }
        GEQ => { ret "geq" }
    }
}

fn sanitize_symbol(value: str) -> str {
    ret unsafe { encore_symbol_sanitize(value) }
}

fn is_digit(ch: u8) -> bool {
    if (ch >= 48_u8) {
        if (ch <= 57_u8) {
            ret true
        }
    }
    ret false
}
