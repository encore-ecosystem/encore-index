//! New Encore storage layer preserves the schema and atomic ownership updates.
import core::result::Result
import core::vec::Vec
import refrain::storage::{Store, link_github, reserve, user_add}
import refrain::storage_schema::initialize
import sqlite::{Connection, SqliteError, Value}

fn run() -> Result[bool, SqliteError] {
    with Store::open(":memory:")? as db {
        if db.scalar("PRAGMA user_version", Vec[Value]::new())? != 3_i64 {
            ret Result::Ok(false)
        }
        if db.scalar("PRAGMA foreign_keys", Vec[Value]::new())? != 1_i64 {
            ret Result::Ok(false)
        }
        let _user = user_add(db, "alice")?
        match user_add(db, "alice") {
            Result::Err(_) => {
            }
            Result::Ok(_) => {
                ret Result::Ok(false)
            }
        }
        match user_add(db, "' OR 1=1 --") {
            Result::Err(_) => {
            }
            Result::Ok(_) => {
                ret Result::Ok(false)
            }
        }
        let _reserve = reserve(db, "probe", "alice")?
        let _identity = link_github(db, "alice", "12345")?
        match reserve(db, "orphan", "missing") {
            Result::Err(_) => {
            }
            Result::Ok(_) => {
                ret Result::Ok(false)
            }
        }
        if db.scalar("SELECT count(*) FROM packages", Vec[Value]::new())? != 1_i64 {
            ret Result::Ok(false)
        }
        if db.query("PRAGMA foreign_key_check", Vec[Value]::new())?.len() != 0_usize {
            ret Result::Ok(false)
        }
    }
    with Connection::memory()? as db {
        let _future = db.execute("PRAGMA user_version=99", Vec[Value]::new())?
        match initialize(db) {
            Result::Err(_) => {
            }
            Result::Ok(_) => {
                ret Result::Ok(false)
            }
        }
    }
    ret Result::Ok(true)
}
fn main() -> u32 {
    match run() {
        Result::Ok(success) => {
            ret if success { 0_u32 } else { 1_u32 }
        }
        _ => {
            ret 1_u32
        }
    }
}
