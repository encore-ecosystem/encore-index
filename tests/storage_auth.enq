//! Authorization parity for the Encore storage implementation.
import core::result::Result
import core::vec::Vec
import refrain::storage::{Store, p1, reserve, revoke, user_add}
import refrain::storage_auth::{allows, authenticate, ci_create, credential_owner, device_decide, device_poll, device_start, digest, legacy_token}
import refrain::storage_sessions::oauth_finish
import sqlite::{SqliteError, Value}

fn run() -> Result[bool, SqliteError] {
    with Store::open(":memory:")? as db {
        let _alice = user_add(db, "alice")?
        let _bob = user_add(db, "bob")?
        let _a = reserve(db, "alpha", "alice")?
        let _b = reserve(db, "beta", "bob")?
        let legacy = legacy_token(db, "alice")?
        if authenticate(db, legacy)? != 1_i64 {
            ret Result::Ok(false)
        }
        let mut packages = Vec[str]::new()
        packages.push("alpha")
        let token = ci_create(db, 1_i64, "Build", 1_i64, true, false, packages)?
        if authenticate(db, token)? != 1_i64 || !allows(db, token, "alpha", false)? ||
        allows(db, token, "beta", false)? || allows(db, token, "alpha", true)? {
            ret Result::Ok(false)
        }
        let mut other = Vec[str]::new()
        other.push("beta")
        match ci_create(db, 1_i64, "Invalid scope", 1_i64, true, true, other) {
            Result::Err(_) => {
            }
            Result::Ok(_) => {
                ret Result::Ok(false)
            }
        }
        if db.scalar("SELECT count(*) FROM credentials", Vec[Value]::new())? != 1_i64 {
            ret Result::Ok(false)
        }
        let device = device_start(db, "Terminal")?
        let early = device_poll(db, device.0)?
        if early.error != "slow_down" {
            ret Result::Ok(false)
        }
        let _ready = db.execute("UPDATE device_authorizations SET next_poll=0", Vec[Value]::new())?
        if device_poll(db, device.0)?.error != "authorization_pending" {
            ret Result::Ok(false)
        }
        if !device_decide(db, device.1, 1_i64, true)? {
            ret Result::Ok(false)
        }
        if device_decide(db, device.1, 2_i64, true)? {
            ret Result::Ok(false)
        }
        let _clock = db.execute("UPDATE device_authorizations SET next_poll=0", Vec[Value]::new())?
        let authorized = device_poll(db, device.0)?
        if authorized.error != "" || authenticate(db, authorized.token)? != 1_i64 {
            ret Result::Ok(false)
        }
        if credential_owner(db, authorized.token, true)? != 0_i64 || !allows(db, authorized.token, "new-name", false)? {
            ret Result::Ok(false)
        }
        if device_poll(db, device.0)?.error != "expired_token" {
            ret Result::Ok(false)
        }
        let _idle = db.execute("UPDATE credentials SET last_used=unixepoch()-2592001 WHERE kind='device'", Vec[Value]::new())?
        if authenticate(db, authorized.token)? != 0_i64 {
            ret Result::Ok(false)
        }
        let _refresh = db.execute("UPDATE credentials SET last_used=unixepoch() WHERE kind='device'", Vec[Value]::new())?
        if authenticate(db, authorized.token)? != 1_i64 {
            ret Result::Ok(false)
        }
        let denied = device_start(db, "Denied")?
        if !device_decide(db, denied.1, 1_i64, false)? || device_poll(db, denied.0)?.error != "access_denied" {
            ret Result::Ok(false)
        }
        let expired = device_start(db, "Expired")?
        let _expire = db.execute("UPDATE device_authorizations SET expires=0", Vec[Value]::new())?
        if device_decide(db, expired.1, 1_i64, true)? || device_poll(db, expired.0)?.error != "expired_token" {
            ret Result::Ok(false)
        }
        let id = db.scalar("SELECT id FROM credentials WHERE digest=?1", p1(Value::Text(digest(token)?)))?
        if revoke(db, 2_i64, id)? {
            ret Result::Ok(false)
        }
        if !revoke(db, 1_i64, id)? || authenticate(db, token)? != 0_i64 {
            ret Result::Ok(false)
        }
        let browser = oauth_finish(db, "123")?
        if authenticate(db, browser)? != 0_i64 || credential_owner(db, browser, true)? != 3_i64 || allows(db, browser, "alpha", false)? {
            ret Result::Ok(false)
        }
        let _disable = db.execute("UPDATE users SET active=0 WHERE id=3", Vec[Value]::new())?
        if credential_owner(db, browser, true)? != 0_i64 {
            ret Result::Ok(false)
        }
        if db.query("PRAGMA foreign_key_check", Vec[Value]::new())?.len() != 0_usize {
            ret Result::Ok(false)
        }
    }
    ret Result::Ok(true)
}
fn main() -> u32 {
    match run() {
        Result::Ok(success) => {
            ret if success { 0_u32 } else { 1_u32 }
        }
        _ => {
            ret 1_u32
        }
    }
}
