//! OAuth state is bound, expiring and single-use; identities cannot cross accounts.
import core::result::Result
import core::vec::Vec
import refrain::storage::{Store, link_github, user_add}
import refrain::storage_sessions::{oauth_start, oauth_consume, oauth_finish, account, whoami}
import sqlite::{SqliteError, Value}

fn run() -> Result[bool, SqliteError] {
    with Store::open(":memory:")? as db {
        if !oauth_start(db, "state", "browser", "verifier", "/account")? {
            ret Result::Ok(false)
        }
        if oauth_consume(db, "state", "wrong-browser")?.0 != "" {
            ret Result::Ok(false)
        }
        let consumed = oauth_consume(db, "state", "browser")?
        if consumed.0 != "verifier" || consumed.1 != "/account" {
            ret Result::Ok(false)
        }
        if oauth_consume(db, "state", "browser")?.0 != "" {
            ret Result::Ok(false)
        }
        let _started = oauth_start(db, "expired", "browser", "verifier", "/account")?
        let _expire = db.execute("UPDATE oauth_attempts SET expires=0", Vec[Value]::new())?
        if oauth_consume(db, "expired", "browser")?.0 != "" {
            ret Result::Ok(false)
        }
        let _user = user_add(db, "alice")?
        let _identity = link_github(db, "alice", "123")?
        let first = oauth_finish(db, "123")?
        let second = oauth_finish(db, "123")?
        if first == "" || first == second {
            ret Result::Ok(false)
        }
        if db.scalar("SELECT count(*) FROM users", Vec[Value]::new())? != 1_i64 {
            ret Result::Ok(false)
        }
        let _new = oauth_finish(db, "456")?
        if db.scalar("SELECT count(*) FROM users", Vec[Value]::new())? != 2_i64 {
            ret Result::Ok(false)
        }
        if account(db, 1_i64, "csrf", "")? == "" || whoami(db, 1_i64)? == "" {
            ret Result::Ok(false)
        }
        match oauth_finish(db, "invalid") {
            Result::Err(_) => {
            }
            Result::Ok(_) => {
                ret Result::Ok(false)
            }
        }
        if db.scalar("SELECT count(*) FROM credentials", Vec[Value]::new())? != 3_i64 {
            ret Result::Ok(false)
        }
        if db.query("PRAGMA foreign_key_check", Vec[Value]::new())?.len() != 0_usize {
            ret Result::Ok(false)
        }
    }
    ret Result::Ok(true)
}
fn main() -> u32 {
    match run() {
        Result::Ok(success) => {
            ret if success { 0_u32 } else { 1_u32 }
        }
        _ => {
            ret 1_u32
        }
    }
}
