//! HTTP authorization policy without real provider networking.
import core::result::Result
import json::{Json, parse}
import refrain::storage::Store
import refrain::storage_web::{RateLimits, WebConfig, WebRequest, process, session_cookie}
import refrain::validation::string_field
import sqlite::SqliteError

fn run() -> Result[bool, SqliteError] {
    with Store::open(":memory:")? as db {
        let config = WebConfig {
            "https://index.example", "client", true, "https://github.com/login/oauth/authorize"
        }
        let mut limits = RateLimits::new()
        let request = WebRequest {
            20_i32, "device", "", "", ""
        }
        let first = process(db, request, config, limits)?
        if first.status != 200_i32 {
            ret Result::Ok(false)
        }
        let parsed = parse(first.body).unwrap_or(Json::Null)
        if string_field(parsed, "redirect") == "" || string_field(parsed, "cookie") == "" {
            ret Result::Ok(false)
        }
        let mut count = 1_usize
        while count < 30_usize {
            if process(db, request, config, limits)?.status != 200_i32 {
                ret Result::Ok(false)
            }
            count += 1_usize
        }
        if process(db, request, config, limits)?.status != 429_i32 {
            ret Result::Ok(false)
        }
        let anonymous = WebRequest {
            22_i32, "", "", "", ""
        }
        if process(db, anonymous, config, limits)?.status != 401_i32 {
            ret Result::Ok(false)
        }
        let bad_callback = WebRequest {
            21_i32, "state", "code", "cookie", ""
        }
        if process(db, bad_callback, config, limits)?.status != 400_i32 {
            ret Result::Ok(false)
        }
        if session_cookie(config, "", false, true) != "__Host-encore_session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0; Secure" {
            ret Result::Ok(false)
        }
    }
    ret Result::Ok(true)
}
fn main() -> u32 {
    match run() {
        Result::Ok(success) => {
            ret if success { 0_u32 } else { 1_u32 }
        }
        _ => {
            ret 1_u32
        }
    }
}
