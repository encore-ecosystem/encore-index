//! Bounded byte-oriented encoding at the HTTP form/query boundary.
import core::vec::Vec

extern fn encore_str_from_buffer(data: u8*, size: usize) -> str

/// Copies initialized bytes into a raw string; the runtime never retains the pointer.
#attr(safe)
pub fn bytes_string(bytes: Vec[u8]) -> str {
    if bytes.len() == 0_usize {
        ret ""
    }
    ret unsafe {
        encore_str_from_buffer(bytes.as_ptr(), bytes.len())
    }
}

fn hex_digit(byte: u8) -> i32 {
    if byte >= 48_u8 && byte <= 57_u8 {
        ret(byte - 48_u8) as i32
    }
    if byte >= 97_u8 && byte <= 102_u8 {
        ret(byte - 97_u8 + 10_u8) as i32
    }
    if byte >= 65_u8 && byte <= 70_u8 {
        ret(byte - 65_u8 + 10_u8) as i32
    }
    ret - 1_i32
}

/// Invalid escapes, control bytes and inputs over 8192 bytes produce an empty value.
#attr(safe)
pub fn query_decode(value: str) -> str {
    let size = value.byte_len()
    if size > 8192_usize {
        ret ""
    }
    let mut output = Vec[u8]::new()
    output.reserve(size)
    let mut i = 0_usize
    while i < size {
        let mut byte = value.byte_at(i)
        if byte == 43_u8 {
            byte = 32_u8
        } elif byte == 37_u8 {
            if i + 2_usize >= size {
                ret ""
            }
            let high = hex_digit(value.byte_at(i + 1_usize))
            let low = hex_digit(value.byte_at(i + 2_usize))
            if high < 0_i32 || low < 0_i32 {
                ret ""
            }
            byte =(high * 16_i32 + low) as u8
            i += 2_usize
        }
        if byte < 32_u8 || byte == 127_u8 {
            ret ""
        }
        output.push(byte)
        i += 1_usize
    }
    ret bytes_string(output)
}

pub fn hex_encode(value: str) -> str {
    let alphabet = "0123456789abcdef"
    let mut out = ""
    let mut i = 0_usize
    while i < value.byte_len() {
        let byte = value.byte_at(i) as usize
        out += alphabet.slice_bytes(byte / 16_usize, 1_usize) + alphabet.slice_bytes(byte % 16_usize, 1_usize)
        i += 1_usize
    }
    ret out
}

pub fn base64url_encode(value: str) -> str {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    let mut output = Vec[u8]::new()
    let mut bits = 0_u32
    let mut available = 0_u32
    let mut i = 0_usize
    while i < value.byte_len() {
        bits =(bits << 8_u32) | value.byte_at(i) as u32
        available += 8_u32
        while available >= 6_u32 {
            available -= 6_u32
            output.push(alphabet.byte_at(((bits >> available) & 63_u32) as usize))
        }
        bits = bits &((1_u32 << available) - 1_u32)
        i += 1_usize
    }
    if available > 0_u32 {
        output.push(alphabet.byte_at((bits <<(6_u32 - available)) as usize))
    }
    ret bytes_string(output)
}

fn base64url_digit(byte: u8) -> i32 {
    if byte >= 65_u8 && byte <= 90_u8 {
        ret(byte - 65_u8) as i32
    }
    if byte >= 97_u8 && byte <= 122_u8 {
        ret(byte - 97_u8 + 26_u8) as i32
    }
    if byte >= 48_u8 && byte <= 57_u8 {
        ret(byte - 48_u8 + 52_u8) as i32
    }
    if byte == 45_u8 {
        ret 62_i32
    }
    if byte == 95_u8 {
        ret 63_i32
    }
    ret - 1_i32
}

/// Strict unpadded Base64URL, including canonical tail bits and the JWT size bound.
pub fn base64url_decode(value: str) -> str {
    let size = value.byte_len()
    if size == 0_usize || size > 16384_usize || size % 4_usize == 1_usize {
        ret ""
    }
    let mut output = Vec[u8]::new()
    let mut bits = 0_u32
    let mut available = 0_u32
    let mut i = 0_usize
    while i < size {
        let digit = base64url_digit(value.byte_at(i))
        if digit < 0_i32 {
            ret ""
        }
        bits =(bits << 6_u32) | digit as u32
        available += 6_u32
        if available >= 8_u32 {
            available -= 8_u32
            output.push((bits >> available) as u8)
        }
        bits = bits &((1_u32 << available) - 1_u32)
        i += 1_usize
    }
    if bits != 0_u32 {
        ret ""
    }
    ret bytes_string(output)
}
